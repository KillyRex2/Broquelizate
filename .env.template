AUTH_TRUST_HOST=true
AUTH_SECRET=<32 character string>

// https://console.cloudinary.com/app/c-bb8593d1f39c3810bb3b15b1616cd6/settings/api-keys
CLOUDINARY_CLOUD_NAME =Broquelizate
CLOUDINARY_API_KEY =11111111111
CLOUDINARY_API_SECRET =secretkey

bun run dev --remote

// Correos transaccionales — https://resend.com/api-keys
// La llave se muestra UNA sola vez al crearla. Permiso: Sending access,
// restringida al dominio send.broquelizate.com.
RESEND_API_KEY=re_xxxxxxxxxx
// Remitente. El dominio tiene que estar verificado en Resend o los correos
// no salen. El buzón pedidos@ no existe en ningún lado y no hace falta:
// es solo el remitente, nadie recibe ahí.
EMAIL_FROM=Broquelizate <pedidos@send.broquelizate.com>
// A dónde llegan los avisos de venta nueva
EMAIL_ADMIN=broquelizateyu@outlook.com

// URL pública del sitio, sin barra final.
// La usan los enlaces de los correos y los retornos de Mercado Pago. Si
// falta, el aviso de venta nueva cae al dominio de producción por
// respaldo, pero conviene tenerla puesta en Netlify.
PUBLIC_SITE_URL=https://broquelizate.com
