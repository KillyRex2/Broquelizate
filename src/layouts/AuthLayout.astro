---
// src/layouts/AuthLayout.astro
import { ClientRouter } from "astro:transitions";

interface Props {
  title?: string;
}

const { title = "Broquelizate" } = Astro.props;
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <ClientRouter />
  </head>

  <body>
    <div class="auth-container">
      <!-- Imagen de fondo -->
      <div class="auth-bg"></div>
      
      <!-- Contenido -->
      <div class="auth-content">
        <!-- Lado izquierdo - Branding (solo desktop) -->
        <div class="auth-branding">
          <div class="branding-content">
            <a href="/" class="brand-logo">Broquelizate</a>
            <h1>Bienvenid@ a Broquelizate</h1>
            <p>Accede a tu cuenta para seguir comprando las mejores joyas y perforaciones exclusivas. Estilo que empodera.</p>
            
            <div class="features">
              <div class="feature">
                <svg width="24" height="24" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                </svg>
                <span>Envíos a todo México</span>
              </div>
              <div class="feature">
                <svg width="24" height="24" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                </svg>
                <span>Materiales hipoalergénicos</span>
              </div>
              <div class="feature">
                <svg width="24" height="24" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                </svg>
                <span>Garantía de satisfacción</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Lado derecho - Formulario -->
        <div class="auth-form-container">
          <slot />
        </div>
      </div>
    </div>
  </body>
</html>

<style is:global>
  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  body {
    font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    background: #0a0a0a;
    color: #fff;
    min-height: 100vh;
  }

  .auth-container {
    min-height: 100vh;
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .auth-bg {
    position: fixed;
    inset: 0;
    z-index: 0;
  }

  .auth-bg::before {
    content: '';
    position: absolute;
    inset: 0;
    background: url('/assets/tamara-login.jpg') center center / cover no-repeat;
    filter: brightness(0.4) saturate(0.8);
  }

  .auth-bg::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      135deg,
      rgba(0, 0, 0, 0.7) 0%,
      rgba(0, 0, 0, 0.5) 50%,
      rgba(0, 0, 0, 0.7) 100%
    );
  }

  .auth-content {
    position: relative;
    z-index: 10;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 80px;
    width: 100%;
    max-width: 1200px;
    padding: 40px 24px;
    min-height: 100vh;
  }

  /* Branding */
  .auth-branding {
    display: none;
    flex: 1;
    max-width: 480px;
  }

  .branding-content {
    color: #fff;
  }

  .brand-logo {
    display: inline-block;
    font-size: 32px;
    font-weight: 800;
    background: linear-gradient(135deg, #eab308, #f59e0b);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    text-decoration: none;
    margin-bottom: 32px;
  }

  .branding-content h1 {
    font-size: 40px;
    font-weight: 700;
    line-height: 1.2;
    margin-bottom: 16px;
  }

  .branding-content p {
    font-size: 18px;
    color: rgba(255, 255, 255, 0.8);
    line-height: 1.6;
    margin-bottom: 40px;
  }

  .features {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .feature {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 16px;
    color: rgba(255, 255, 255, 0.9);
  }

  .feature svg {
    color: #eab308;
    flex-shrink: 0;
  }

  /* Form Container */
  .auth-form-container {
    width: 100%;
    max-width: 420px;
  }

  /* Responsive */
  @media (min-width: 1024px) {
    .auth-branding {
      display: block;
    }

    .auth-content {
      justify-content: space-between;
    }
  }

  @media (max-width: 480px) {
    .auth-content {
      padding: 20px 16px;
    }
  }
</style>
