---
// src/pages/order-success.astro
import ProductsLayout from "@/layouts/ProductsLayout.astro";
import { Formatter } from "@/utils";
import Stripe from 'stripe';
import OrderTracking from '@/components/OrderTracking.astro';
import { actions } from 'astro:actions';
import CheckoutProgress from '@/components/shared/CheckoutProgressBar.astro';

const STRIPE_SECRET_KEY = import.meta.env.STRIPE_SECRET_KEY;
const stripe = new Stripe(STRIPE_SECRET_KEY);

interface NormalizedProduct {
  id: string;
  name: string;
  price: number;
  quantity: number;
  image?: string | null;
  variantDescription?: string | null;
  variantSku?: string | null;
  variantImage?: string | null;
  weight?: number;
  engraving?: { id: string; imageUrl: string; notes: string } | null;
}

interface OrderDetails {
  orderId: string;
  date: string;
  products: NormalizedProduct[];
  shipping: { method: string; cost: number; address: string; city?: string; state?: string; postalCode?: string; };
  customer: { name: string; email: string; phone?: string; };
  subtotal: number;
  total: number;
  paymentStatus: string;
  paymentMethod: string;
  trackingNumber?: string;
  carrier?: string;
  labelUrl?: string;
}

let orderDetails: OrderDetails | null = null;
let errorMessage: string | null = null;
let trackingInfo: any = null;

// Limpiar carrito via Astro cookies (server-side safe)
Astro.cookies.set('cart', '[]', { path: '/', maxAge: 60 * 60 * 24 * 30 });

const sessionId = Astro.url.searchParams.get('session_id');
let orderIdParam = Astro.url.searchParams.get('order_id');

// ── Retorno de Mercado Pago ──
// MP regresa con external_reference, no con order_id. Se confirma el
// pedido (idempotente: si el webhook ya lo hizo, no repite nada) y se
// traduce a order_id para que el resto de la página funcione igual
// que con Stripe o PayPal.
const extRef = Astro.url.searchParams.get('external_reference');
if (extRef && !orderIdParam) {
  try {
    const mpStatus = Astro.url.searchParams.get('status');
    const paymentId = Astro.url.searchParams.get('payment_id');

    if (mpStatus === 'approved') {
      const { confirmOrderByReference } = await import('@/utils/mercadopago-orders');
      await confirmOrderByReference(extRef, paymentId ?? undefined);
    }

    const { db, eq, orders } = await import('astro:db');
    const [found] = await db
      .select({ id: orders.id })
      .from(orders)
      .where(eq(orders.externalReference, extRef));

    if (found) return Astro.redirect(`/order-success?order_id=${found.id}`);
    errorMessage = 'No encontramos tu pedido. Escríbenos por WhatsApp con tu comprobante.';
  } catch (e) {
    console.error('❌ Retorno MP:', e);
    errorMessage = 'Tu pago se procesó, pero hubo un problema al mostrar el pedido. Escríbenos por WhatsApp.';
  }
}

try {
  if (orderIdParam) {
    const response = await fetch(`${Astro.url.origin}/api/get-order?order_id=${orderIdParam}`);
    if (response.ok) {
      const orderData = await response.json();
      const shippingData = orderData.shippingAddress ? JSON.parse(orderData.shippingAddress) : {};
      let shippingInfo = null;
      if (orderData.shippingInfo) {
        try { shippingInfo = typeof orderData.shippingInfo === 'string' ? JSON.parse(orderData.shippingInfo) : orderData.shippingInfo; } catch (e) {}
      }
      
      orderDetails = {
        orderId: orderData.orderNumber,
        date: new Date(orderData.createdAt).toLocaleDateString('es-MX', { year: 'numeric', month: 'long', day: 'numeric' }),
        products: orderData.items.map((item: any) => ({
          id: item.productId, name: item.productName, price: item.price, quantity: item.quantity,
          image: item.image || item.variantImage || item.productImage || null,
          variantDescription: item.variantDescription || null, variantSku: item.variantSku || null,
          variantImage: item.variantImage || null, weight: 100,
          engraving: item.engraving || null,
        })),
        shipping: {
          method: shippingInfo ? `${shippingInfo.carrier} - ${shippingInfo.service}` : "Envío Estándar",
          cost: orderData.shippingCost || shippingInfo?.price || 0,
          address: shippingData.streetAddress || "Dirección no disponible",
          city: shippingData.city, state: shippingData.state, postalCode: shippingData.postalCode
        },
        customer: { name: orderData.customerName || shippingData.name || "Cliente", email: orderData.customerEmail, phone: shippingData.phone },
        subtotal: orderData.subtotal, total: orderData.total, paymentStatus: "Pagado",
        paymentMethod: orderData.paymentMethod || 'Tarjeta',
        trackingNumber: orderData.trackingNumber, carrier: shippingInfo?.carrier || orderData.carrier
      };
    } else { throw new Error("No se pudo cargar la orden"); }
  } else if (sessionId) {
    const session = await stripe.checkout.sessions.retrieve(sessionId, { expand: ['line_items.data.price.product'] });
    const products = session.line_items?.data.map(item => {
      const product = item.price?.product as Stripe.Product;
      return { id: product.id || "", name: item.description || product.name, price: item.price?.unit_amount ? item.price.unit_amount / 100 : 0, quantity: item.quantity || 1, image: product.images?.[0] || null, variantDescription: null, variantSku: null, variantImage: null, weight: 100 };
    }) || [];
    const total = session.amount_total ? session.amount_total / 100 : 0;
    const sa = session.customer_details?.address;
    orderDetails = {
      orderId: session.id.substring(0, 8).toUpperCase(),
      date: new Date(session.created * 1000).toLocaleDateString('es-MX', { year: 'numeric', month: 'long', day: 'numeric' }),
      products, shipping: { method: "Envío Estándar", cost: session.shipping_cost?.amount_total ? session.shipping_cost.amount_total / 100 : 0, address: sa?.line1 || "N/A", city: sa?.city || undefined, state: sa?.state || undefined, postalCode: sa?.postal_code || undefined },
      customer: { name: session.customer_details?.name || "Cliente", email: session.customer_details?.email || "N/A", phone: session.customer_details?.phone || undefined },
      subtotal: total, total, paymentStatus: session.payment_status === "paid" ? "Pagado" : "Pendiente", paymentMethod: 'Tarjeta'
    };
  } else { errorMessage = "No se encontró ID de sesión ni ID de pedido"; }

  if (orderDetails?.trackingNumber && orderDetails?.carrier) {
    try {
      const { data: tr, error: te } = await Astro.callAction(actions.trackShipment, { trackingNumber: orderDetails.trackingNumber, carrier: orderDetails.carrier });
      if (!te && tr?.success) trackingInfo = tr.tracking;
    } catch {}
  }
} catch (error: any) { errorMessage = error.message || "Error al cargar los detalles del pedido"; console.error('Error:', error); }

function getProductImage(product: NormalizedProduct): string {
  if (product.variantImage?.trim()) return product.variantImage;
  if (product.image?.trim()) return product.image;
  return 'https://placehold.co/100x100/1a1a2e/eab308?text=Sin+imagen';
}

const totalItems = orderDetails?.products.reduce((s, p) => s + p.quantity, 0) || 0;
---

<ProductsLayout title={orderDetails ? `Pedido ${orderDetails.orderId}` : 'Error'}>
  <div class="os-page">
    <div class="bg-decoration"><div class="glow glow-1"></div><div class="glow glow-2"></div><div class="grid-pattern"></div></div>

    <div class="os-container">
      <CheckoutProgress current="completado" />
      {errorMessage ? (
        <div class="error-state">
          <div class="error-icon">
            <svg width="64" height="64" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.964-.833-2.732 0L4.082 16.5c-.77.833.192 2.5 1.732 2.5z"/></svg>
          </div>
          <h1 class="error-title">Error al cargar la orden</h1>
          <p class="error-text">{errorMessage}</p>
          <a href="/" class="error-cta">Volver a la tienda</a>
        </div>
      ) : orderDetails ? (
        <>
          {/* ═══ SUCCESS HERO ═══ */}
          <div class="success-hero">
            <div class="success-checkmark">
              <svg width="48" height="48" fill="none" viewBox="0 0 24 24"><circle cx="12" cy="12" r="11" stroke="#22c55e" stroke-width="1.5"/><path stroke="#22c55e" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12.5l2.5 2.5 5-5"/></svg>
            </div>
            <div class="success-text">
              <h1 class="success-title">¡Pedido confirmado!</h1>
              <p class="success-subtitle">Gracias por tu compra. Tu pedido está siendo preparado.</p>
            </div>
            <div class="order-id-card">
              <span class="order-id-label">Pedido</span>
              <span class="order-id-value">{orderDetails.orderId}</span>
              <span class="order-id-date">{orderDetails.date}</span>
            </div>
          </div>

          {/* ═══ TRACKING BANNER ═══ */}
          {orderDetails.trackingNumber && (
            <div class="tracking-banner">
              <div class="tracking-icon-wrap">
                <svg width="28" height="28" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16V6a1 1 0 00-1-1H4a1 1 0 00-1 1v10a1 1 0 001 1h1m8-1a1 1 0 01-1 1H9m4-1V8a1 1 0 011-1h2.586a1 1 0 01.707.293l3.414 3.414a1 1 0 01.293.707V16a1 1 0 01-1 1h-1m-6-1a1 1 0 001 1h1M5 17a2 2 0 104 0m-4 0a2 2 0 114 0m6 0a2 2 0 104 0m-4 0a2 2 0 114 0"/></svg>
              </div>
              <div class="tracking-info">
                <span class="tracking-label">Número de rastreo</span>
                <code class="tracking-code">{orderDetails.trackingNumber}</code>
                <span class="tracking-carrier">{orderDetails.carrier?.toUpperCase()}</span>
              </div>
              <a href={`/account/mis-pedidos?tracking=${orderDetails.trackingNumber}`} class="tracking-btn">Ver envío</a>
            </div>
          )}

          {/* ═══ WHATSAPP CTA ═══ */}
          <div class="whatsapp-banner">
            <div class="wa-icon">
              <svg width="24" height="24" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg>
            </div>
            <div class="wa-text">
              <span class="wa-title">Envía tu comprobante por WhatsApp</span>
              <span class="wa-sub">Incluye tu pedido: <strong>{orderDetails.orderId}</strong></span>
            </div>
            <a href={`https://wa.me/528714617696?text=Hola,%20adjunto%20comprobante%20de%20pago%20para%20el%20pedido%20%23${orderDetails.orderId}`} target="_blank" rel="noopener noreferrer" class="wa-btn">
              <svg width="18" height="18" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg>
              Enviar
            </a>
          </div>

          {/* ═══ TRACKING COMPONENT ═══ */}
          {orderDetails.trackingNumber && (
            <div class="tracking-section">
              <OrderTracking trackingNumber={orderDetails.trackingNumber} orderId={orderDetails.orderId} showDetails={true} />
            </div>
          )}

          {/* ═══ MAIN GRID ═══ */}
          <div class="os-grid">
            {/* LEFT: Products + Shipping */}
            <div class="os-left">
              {/* Products Card */}
              <div class="os-card">
                <div class="card-header">
                  <div class="header-icon"><svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"/></svg></div>
                  <h2 class="card-title">Resumen del pedido</h2>
                  <span class="card-badge">{totalItems} {totalItems === 1 ? 'producto' : 'productos'}</span>
                </div>

                <div class="products-list">
                  {orderDetails.products.map((product, i) => {
                    const displayImage = getProductImage(product);
                    const hasVariant = !!product.variantDescription;
                    return (
                      <div class="product-row" style={`animation-delay: ${i * 0.08}s`}>
                        <div class="product-img-wrap">
                          <img src={displayImage} alt={product.name} class="product-img" loading="lazy" onerror="this.onerror=null;this.src='https://placehold.co/100x100/1a1a2e/eab308?text=Sin+imagen';" />
                          {product.quantity > 1 && <span class="qty-badge">{product.quantity}</span>}
                        </div>
                        <div class="product-details">
                          <span class="product-name">{product.name}</span>
                          {hasVariant && (
                            <div class="variant-tag">
                              <svg width="12" height="12" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A2 2 0 013 12V7a4 4 0 014-4z"/></svg>
                              <span>{product.variantDescription}</span>
                            </div>
                          )}
                          <span class="product-qty">Cantidad: {product.quantity}</span>
                          {product.engraving && (
                            <div class="engraving-row">
                              <img src={product.engraving.imageUrl} alt="Grabado" class="engr-thumb" />
                              <div class="engr-info">
                                <span class="engr-label">
                                  <svg width="12" height="12" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"/></svg>
                                  Grabado láser
                                </span>
                                {product.engraving.notes && <span class="engr-notes">"{product.engraving.notes}"</span>}
                              </div>
                            </div>
                          )}
                        </div>
                        <div class="product-price-col">
                          <span class="product-total">{Formatter.currency(product.price * product.quantity)}</span>
                          {product.quantity > 1 && <span class="product-unit">{Formatter.currency(product.price)} c/u</span>}
                        </div>
                      </div>
                    );
                  })}
                </div>

                <div class="totals-section">
                  <div class="total-row"><span>Subtotal</span><span>{Formatter.currency(orderDetails.subtotal)}</span></div>
                  <div class="total-row">
                    <span>Envío {orderDetails.shipping.method !== "Envío Estándar" && <span class="shipping-method">({orderDetails.shipping.method})</span>}</span>
                    <span class={orderDetails.shipping.cost === 0 ? 'free-shipping' : ''}>{orderDetails.shipping.cost > 0 ? Formatter.currency(orderDetails.shipping.cost) : 'Gratis'}</span>
                  </div>
                  <div class="total-row final">
                    <span>Total</span>
                    <span class="final-price">{Formatter.currency(orderDetails.total)}</span>
                  </div>
                </div>
              </div>

              {/* Shipping Info Card */}
              <div class="os-card">
                <div class="card-header">
                  <div class="header-icon"><svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a2 2 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg></div>
                  <h2 class="card-title">Información de envío</h2>
                </div>
                <div class="info-grid">
                  <div class="info-block">
                    <span class="info-label">Destinatario</span>
                    <span class="info-value">{orderDetails.customer.name}</span>
                    <span class="info-sub">{orderDetails.customer.email}</span>
                    {orderDetails.customer.phone && <span class="info-sub">Tel: {orderDetails.customer.phone}</span>}
                  </div>
                  <div class="info-block">
                    <span class="info-label">Dirección</span>
                    <span class="info-value">{orderDetails.shipping.address}</span>
                    {orderDetails.shipping.city && <span class="info-sub">{orderDetails.shipping.city}, {orderDetails.shipping.state} {orderDetails.shipping.postalCode}</span>}
                  </div>
                  {orderDetails.trackingNumber && (
                    <div class="info-block full">
                      <span class="info-label">Rastreo</span>
                      <div class="tracking-inline">
                        <span class="info-value">{orderDetails.carrier?.toUpperCase()}</span>
                        <code class="tracking-mono">{orderDetails.trackingNumber}</code>
                      </div>
                    </div>
                  )}
                </div>
              </div>
            </div>

            {/* RIGHT: Status + Help */}
            <div class="os-right">
              {/* Order Status */}
              <div class="os-card">
                <div class="card-header">
                  <div class="header-icon"><svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg></div>
                  <h2 class="card-title">Estado</h2>
                </div>
                <div class="status-timeline">
                  <div class="status-step done">
                    <div class="status-dot"><svg width="14" height="14" fill="none" stroke="#000" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"/></svg></div>
                    <div class="status-info"><span class="status-name">Pago confirmado</span><span class="status-desc">{orderDetails.paymentMethod === 'card' ? 'Tarjeta' : orderDetails.paymentMethod === 'paypal' ? 'PayPal' : orderDetails.paymentMethod?.startsWith('mercadopago') ? 'Mercado Pago' : 'Pagado'}</span></div>
                  </div>
                  {orderDetails.trackingNumber ? (
                    <>
                      <div class="status-step done">
                        <div class="status-dot"><svg width="14" height="14" fill="none" stroke="#000" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"/></svg></div>
                        <div class="status-info"><span class="status-name">Etiqueta generada</span><span class="status-desc">Guía lista</span></div>
                      </div>
                      <div class="status-step active">
                        <div class="status-dot pulse"></div>
                        <div class="status-info"><span class="status-name">En tránsito</span><span class="status-desc">Tu pedido va en camino</span></div>
                      </div>
                      <div class="status-step pending">
                        <div class="status-dot"></div>
                        <div class="status-info"><span class="status-name">Entregado</span></div>
                      </div>
                    </>
                  ) : (
                    <>
                      <div class="status-step active">
                        <div class="status-dot pulse"></div>
                        <div class="status-info"><span class="status-name">Preparando pedido</span><span class="status-desc">Empaquetando con cuidado</span></div>
                      </div>
                      <div class="status-step pending">
                        <div class="status-dot"></div>
                        <div class="status-info"><span class="status-name">En tránsito</span></div>
                      </div>
                      <div class="status-step pending">
                        <div class="status-dot"></div>
                        <div class="status-info"><span class="status-name">Entregado</span></div>
                      </div>
                    </>
                  )}
                </div>
              </div>

              {/* Actions Card */}
              <div class="os-card">
                <div class="card-header">
                  <div class="header-icon"><svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg></div>
                  <h2 class="card-title">Acciones</h2>
                </div>
                <div class="actions-list">
                  <button id="download-invoice" class="action-btn">
                    <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
                    <span>Descargar ticket</span>
                  </button>
                  {orderDetails.trackingNumber && (
                    <a href="/account/mis-pedidos" class="action-btn">
                      <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/></svg>
                      <span>Mis pedidos</span>
