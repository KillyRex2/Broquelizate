</style>

<script>
  import { generateAndPrintTicket } from '@/services/ticketGenerator';
  import { clearCartStore } from '@/store';

  // Clear cart store on client side too
  clearCartStore();

  async function handlePrintTicket() {
    const btn = document.getElementById('download-invoice') as HTMLButtonElement;
    const el = document.getElementById('order-details-data');
    if (!btn || !el) return;
    const od = JSON.parse(el.textContent || '{}');
    if (!od.products || !od.orderId) { alert('No se encontraron los detalles.'); return; }
    const orig = btn.innerHTML; btn.disabled = true; btn.innerHTML = '<span>Generando...</span>';
    try {
      await generateAndPrintTicket(
        od.products.map((p: any) => ({ ...p, displayName: p.variantDescription ? `${p.name} (${p.variantDescription})` : p.name })),
        od.total, od.orderId, od.paymentMethod,
        { name: "Broquelizate La Laguna", address: "Bravo 222, Colonia Centro, Gómez Palacio, Dgo.", phone: "528714617696" }
      );
    } catch (err) { console.error('Error ticket:', err); alert('Error al generar el ticket.'); }
    finally { btn.disabled = false; btn.innerHTML = orig; }
  }

  document.addEventListener('astro:page-load', () => {
    const b = document.getElementById('download-invoice');
    if (b) b.onclick = handlePrintTicket;
  });
</script>