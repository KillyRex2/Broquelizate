              </div>
            </div>
            
            {/* Columna Derecha: Seguimiento y Ayuda */}
            <div class="space-y-8">
              <div class="bg-white shadow rounded-lg">
                <div class="px-6 py-5 border-b border-gray-200">
                  <h2 class="text-xl font-semibold text-gray-900">Estado del pedido</h2>
