---
// src/pages/contact.astro
//
// El pie de página y el menú "Ayuda" ya apuntaban aquí; lo que faltaba era
// la página. Hasta ahora daba 404 en producción.
//
// El mensaje se manda con Resend a la dirección de la tienda, con el correo
// de quien escribe como responder-a: contestar desde la bandeja de entrada
// le llega directo, sin copiar nada.

import MainLayout from '@/layouts/MainLayout.astro';
import { actions } from 'astro:actions';

const WHATSAPP = '528714617696';
const CORREO_PUBLICO = 'broquelizateyu@outlook.com';
const MAPS = 'https://maps.app.goo.gl/ZEHP2N6orCeNYXURA';

// El formulario se envía al servidor y la página se vuelve a pintar con el
// resultado. Si no hay JavaScript, funciona igual: es un <form> de verdad.
const resultado = Astro.getActionResult(actions.sendContactForm);
const enviado = (resultado && !resultado.error) || Astro.url.searchParams.get('enviado') === '1';

// Marca de tiempo de apertura: la acción descarta lo que llega demasiado
// rápido para haber sido escrito por una persona.
const abiertoEn = Date.now();
---

<MainLayout
  title="Contacto · Broquelizate"
  description="Escríbenos: dudas sobre piezas, perforaciones, envíos o tu pedido. Te respondemos lo antes posible."
>
  <main class="contacto">
    <div class="contacto-fondo" aria-hidden="true">
      <span class="orbe orbe-oro"></span>
      <span class="orbe orbe-violeta"></span>
    </div>

    <div class="contacto-caja">
      <header class="contacto-encabezado">
        <span class="etiqueta">Estamos para ayudarte</span>
        <h1>Contáctanos</h1>
        <p>
          Dudas sobre una pieza, una perforación, tu envío o un pedido en camino.
          Escríbenos y te respondemos lo antes posible.
        </p>
      </header>

      <div class="contacto-cuerpo">
        <!-- Formulario -->
        <section class="tarjeta tarjeta-form">
          {enviado ? (
            <div class="exito" role="status">
              <div class="exito-icono" aria-hidden="true">
                <svg width="28" height="28" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
                </svg>
              </div>
              <h2>Mensaje enviado</h2>
              <p>
                Gracias por escribirnos. Te responderemos al correo que nos
                dejaste, normalmente el mismo día.
              </p>
              <a href="/" class="btn-oro">Volver al inicio</a>
            </div>
          ) : (
            <form method="POST" action={actions.sendContactForm} class="formulario" id="form-contacto">
              <p
                class="aviso-error"
                id="error-contacto"
                role="alert"
                hidden={!resultado?.error}
              >{resultado?.error?.message}</p>

              <div class="fila">
                <div class="campo">
                  <label for="name">Nombre <span class="req">*</span></label>
                  <input
                    type="text" id="name" name="name" required
                    maxlength="80" autocomplete="name"
                    placeholder="Cómo te llamas"
                  />
                </div>

                <div class="campo">
                  <label for="email">Correo electrónico <span class="req">*</span></label>
                  <input
                    type="email" id="email" name="email" required
                    maxlength="150" autocomplete="email"
                    placeholder="tu@correo.com"
                  />
                </div>
              </div>

              <div class="campo">
                <label for="phone">Teléfono <span class="opc">(opcional)</span></label>
                <input
                  type="tel" id="phone" name="phone"
                  maxlength="30" autocomplete="tel"
                  placeholder="Por si prefieres que te marquemos"
                />
              </div>

              <div class="campo">
                <label for="message">Mensaje <span class="req">*</span></label>
                <textarea
                  id="message" name="message" required
                  minlength="10" maxlength="3000" rows={6}
                  placeholder="Cuéntanos en qué podemos ayudarte"
                ></textarea>
              </div>

              <!-- Campo trampa: invisible para las personas, irresistible
                   para los robots que rellenan todo lo que encuentran. -->
              <div class="trampa" aria-hidden="true">
                <label for="website">No llenes este campo</label>
                <input type="text" id="website" name="website" tabindex="-1" autocomplete="off" />
              </div>
              <input type="hidden" name="ts" value={String(abiertoEn)} />

              <button type="submit" class="btn-oro btn-enviar">
                <span>Enviar mensaje</span>
                <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
                </svg>
              </button>

              <p class="nota-privacidad">
                Usamos tus datos solo para responderte. Puedes leer el
                <a href="/aviso-de-privacidad">aviso de privacidad</a>.
              </p>
            </form>
          )}
        </section>

        <!-- Otras vías -->
        <aside class="tarjeta tarjeta-vias">
          <h2>O si prefieres</h2>

          <a class="via via-whatsapp" href={`https://wa.me/${WHATSAPP}`} target="_blank" rel="noopener noreferrer">
            <span class="via-icono" aria-hidden="true">
              <svg width="20" height="20" fill="currentColor" viewBox="0 0 24 24">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.149-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51a12.8 12.8 0 00-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884a9.82 9.82 0 016.988 2.896 9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.886-9.885 9.886m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/>
              </svg>
            </span>
            <span class="via-texto">
              <strong>WhatsApp</strong>
              <small>Lo más rápido para dudas cortas</small>
            </span>
          </a>

          <a class="via" href={`mailto:${CORREO_PUBLICO}`}>
            <span class="via-icono" aria-hidden="true">
              <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
              </svg>
            </span>
            <span class="via-texto">
              <strong>Correo</strong>
              <small>{CORREO_PUBLICO}</small>
            </span>
          </a>

          <a class="via" href={MAPS} target="_blank" rel="noopener noreferrer">
            <span class="via-icono" aria-hidden="true">
              <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a2 2 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
              </svg>
            </span>
            <span class="via-texto">
              <strong>Visítanos</strong>
              <small>Gómez Palacio, Durango</small>
            </span>
          </a>

          <div class="nota-pedido">
            <strong>¿Es sobre un pedido?</strong>
            <p>Ten a la mano tu número de pedido: así lo encontramos de inmediato.</p>
          </div>
        </aside>
      </div>
    </div>
  </main>
</MainLayout>

<style>
  .contacto {
    position: relative;
    min-height: 70vh;
    padding: 64px 20px 88px;
    background: #0d0f13;
    overflow: hidden;
  }

  /* Misma luz de fondo que el resto del sitio: dos manchas muy difuminadas
     que le quitan lo plano al negro sin pedir atención. */
  .contacto-fondo { position: absolute; inset: 0; pointer-events: none; }
  .orbe { position: absolute; border-radius: 50%; filter: blur(130px); }
  .orbe-oro {
    width: 520px; height: 520px; top: -180px; right: -120px;
    background: radial-gradient(circle, rgba(234, 179, 8, 0.1) 0%, transparent 70%);
  }
  .orbe-violeta {
    width: 420px; height: 420px; bottom: -140px; left: -100px;
    background: radial-gradient(circle, rgba(168, 85, 247, 0.07) 0%, transparent 70%);
  }

  .contacto-caja { position: relative; z-index: 1; max-width: 1060px; margin: 0 auto; }

  .contacto-encabezado { text-align: center; margin-bottom: 44px; }

  .etiqueta {
    display: inline-block; padding: 6px 16px; border-radius: 999px;
    border: 1px solid rgba(234, 179, 8, 0.3); background: rgba(234, 179, 8, 0.08);
    color: #eab308; font-size: 0.72rem; font-weight: 700;
    letter-spacing: 0.08em; text-transform: uppercase;
  }

  .contacto-encabezado h1 {
    margin: 18px 0 10px; color: #fff;
    font-size: clamp(2rem, 5vw, 2.9rem); font-weight: 800; letter-spacing: -0.02em;
  }

  .contacto-encabezado p {
    margin: 0 auto; max-width: 52ch;
    color: #9aa1ab; font-size: 1rem; line-height: 1.65;
  }

  .contacto-cuerpo {
    display: grid; gap: 22px;
    grid-template-columns: minmax(0, 1.55fr) minmax(0, 1fr);
    align-items: start;
  }

  .tarjeta {
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.05) 0%, rgba(255, 255, 255, 0.018) 45%, rgba(255, 255, 255, 0.01) 100%),
      #15181d;
    border: 1px solid rgba(255, 255, 255, 0.075);
    border-radius: 20px;
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.07), 0 12px 34px -16px rgba(0, 0, 0, 0.8);
    padding: 30px;
  }

  /* ── Formulario ── */
  .formulario { display: flex; flex-direction: column; gap: 18px; }

  .fila { display: grid; gap: 18px; grid-template-columns: 1fr 1fr; }

  .campo { display: flex; flex-direction: column; gap: 7px; min-width: 0; }

  .campo label { color: #e8eaed; font-size: 0.85rem; font-weight: 600; }
  .req { color: #eab308; }
  .opc { color: #646b75; font-weight: 400; }

  .campo input,
  .campo textarea {
    width: 100%; padding: 12px 14px;
    background: #0f1216; color: #e8eaed;
    border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 12px;
    font-size: 0.95rem; font-family: inherit;
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }

  .campo textarea { resize: vertical; min-height: 140px; line-height: 1.6; }

  .campo input::placeholder,
  .campo textarea::placeholder { color: #5c636d; }

  .campo input:focus,
  .campo textarea:focus {
    outline: none;
    border-color: rgba(234, 179, 8, 0.6);
    box-shadow: 0 0 0 3px rgba(234, 179, 8, 0.12);
  }

  /* El campo trampa sale del flujo sin display:none: algunos robots se
     saltan lo que está oculto de la forma obvia. */
  .trampa {
    position: absolute; left: -9999px;
    width: 1px; height: 1px; overflow: hidden;
  }

  .btn-oro {
    display: inline-flex; align-items: center; justify-content: center; gap: 9px;
    padding: 14px 28px; border: none; border-radius: 12px;
    background: linear-gradient(135deg, #eab308, #f59e0b);
    color: #1a1403; font-size: 0.95rem; font-weight: 800;
    cursor: pointer; text-decoration: none;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }

  .btn-oro:hover { transform: translateY(-1px); box-shadow: 0 10px 24px -10px rgba(234, 179, 8, 0.7); }
  .btn-oro:active { transform: translateY(0); }
  .btn-enviar { align-self: flex-start; }

  .aviso-error {
    margin: 0; padding: 12px 15px; border-radius: 12px;
    background: rgba(239, 68, 68, 0.1); border: 1px solid rgba(239, 68, 68, 0.3);
    color: #fca5a5; font-size: 0.88rem;
  }

  .nota-privacidad { margin: 0; color: #646b75; font-size: 0.78rem; }
  .nota-privacidad a { color: #9aa1ab; text-decoration: underline; }
  .nota-privacidad a:hover { color: #eab308; }

  /* ── Confirmación ── */
  .exito { text-align: center; padding: 26px 10px; }

  .exito-icono {
    width: 62px; height: 62px; margin: 0 auto 18px;
    display: flex; align-items: center; justify-content: center;
    border-radius: 50%;
    background: rgba(52, 211, 153, 0.12); border: 1px solid rgba(52, 211, 153, 0.35);
    color: #34d399;
  }

  .exito h2 { margin: 0 0 9px; color: #fff; font-size: 1.4rem; font-weight: 700; }
  .exito p { margin: 0 auto 24px; max-width: 42ch; color: #9aa1ab; line-height: 1.6; }

  /* ── Otras vías ── */
  .tarjeta-vias h2 {
    margin: 0 0 18px; color: #fff; font-size: 1.05rem; font-weight: 700;
  }

  .via {
    display: flex; align-items: center; gap: 13px;
    padding: 13px; margin-bottom: 10px;
    border: 1px solid rgba(255, 255, 255, 0.07); border-radius: 14px;
    text-decoration: none;
    transition: border-color 0.15s ease, background 0.15s ease;
  }

  .via:hover { border-color: rgba(234, 179, 8, 0.4); background: rgba(255, 255, 255, 0.03); }

  .via-icono {
    flex-shrink: 0; width: 40px; height: 40px; border-radius: 11px;
    display: flex; align-items: center; justify-content: center;
    background: rgba(234, 179, 8, 0.1); color: #eab308;
  }

  .via-whatsapp .via-icono { background: rgba(37, 211, 102, 0.12); color: #25d366; }

  .via-texto { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
  .via-texto strong { color: #e8eaed; font-size: 0.92rem; font-weight: 600; }
  .via-texto small { color: #8a929e; font-size: 0.78rem; overflow-wrap: anywhere; }

  .nota-pedido {
    margin-top: 18px; padding: 15px;
    border-radius: 14px; background: rgba(234, 179, 8, 0.07);
    border: 1px solid rgba(234, 179, 8, 0.18);
  }

  .nota-pedido strong { display: block; color: #eab308; font-size: 0.87rem; margin-bottom: 5px; }
  .nota-pedido p { margin: 0; color: #9aa1ab; font-size: 0.82rem; line-height: 1.55; }

  @media (max-width: 880px) {
    .contacto-cuerpo { grid-template-columns: 1fr; }
  }

  @media (max-width: 560px) {
    .contacto { padding: 44px 16px 64px; }
    .tarjeta { padding: 22px; border-radius: 16px; }
    .fila { grid-template-columns: 1fr; }
    .btn-enviar { align-self: stretch; }
  }
</style>

<script>
  // Mejora progresiva. Sin JavaScript el formulario funciona igual: es un
  // <form method="POST"> de verdad y la página se vuelve a pintar con el
  // resultado. Con JavaScript, el envío va por detrás, así que un error no
  // borra lo que la persona ya escribió — que es justo cuando más molesta.
  import { actions } from 'astro:actions';

  function iniciar() {
    const form = document.getElementById('form-contacto') as HTMLFormElement | null;
    if (!form || form.dataset.listo === 'true') return;
    form.dataset.listo = 'true';

    const boton = form.querySelector('button[type="submit"]') as HTMLButtonElement | null;
    const cajaError = document.getElementById('error-contacto');
    const textoBoton = boton?.querySelector('span');
    const etiquetaOriginal = textoBoton?.textContent ?? 'Enviar mensaje';

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (boton?.disabled) return;

      if (boton) {
        boton.disabled = true;
        boton.classList.add('ocupado');
        if (textoBoton) textoBoton.textContent = 'Enviando…';
      }
      if (cajaError) cajaError.hidden = true;

      const { error } = await actions.sendContactForm(new FormData(form));

      if (error) {
        if (boton) {
          boton.disabled = false;
          boton.classList.remove('ocupado');
          if (textoBoton) textoBoton.textContent = etiquetaOriginal;
        }
        if (cajaError) {
          cajaError.textContent = error.message || 'No pudimos enviar tu mensaje. Inténtalo de nuevo.';
          cajaError.hidden = false;
          cajaError.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }
        return;
      }

      // Se recarga para que el servidor pinte la confirmación: así el
      // estado vive en un solo lugar y no en dos copias que se desfasan.
      window.location.search = '?enviado=1';
    });
  }

  document.addEventListener('astro:page-load', iniciar);
  iniciar();
</script>
