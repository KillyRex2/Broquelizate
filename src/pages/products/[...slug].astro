  .trust-title { font-size: 0.85rem; font-weight: 600; color: #fff; }
  .trust-desc { font-size: 0.75rem; color: rgba(255, 255, 255, 0.4); }
  .gallery-section { padding-top: 48px; border-top: 1px solid rgba(255, 255, 255, 0.06); }
  .gallery-header { display: flex; align-items: center; gap: 24px; margin-bottom: 32px; }
  .header-line { flex: 1; height: 1px; background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.1), transparent); }
  .gallery-title { display: flex; align-items: center; gap: 12px; font-size: 1.25rem; font-weight: 800; color: #fff; white-space: nowrap; }
  .gallery-title svg { color: #eab308; }
  .gallery-grid { display: grid; grid-template-columns: repeat(5, 1fr); gap: 16px; }
  .gallery-item { position: relative; aspect-ratio: 1; border-radius: 16px; overflow: hidden; background: rgba(255, 255, 255, 0.02); border: 1px solid rgba(255, 255, 255, 0.06); cursor: pointer; transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1); }
  .gallery-item:hover { border-color: rgba(234, 179, 8, 0.4); transform: translateY(-6px); }
  .gallery-item img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.5s ease; }
  .gallery-item:hover img { transform: scale(1.1); }
  .gallery-overlay { position: absolute; inset: 0; background: linear-gradient(to top, rgba(0, 0, 0, 0.8) 0%, transparent 60%); opacity: 0; transition: opacity 0.3s ease; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 8px; }
  .gallery-item:hover .gallery-overlay { opacity: 1; }
  .overlay-icon { width: 48px; height: 48px; display: flex; align-items: center; justify-content: center; background: rgba(255, 255, 255, 0.15); border-radius: 50%; color: #fff; }
  .overlay-text { color: #fff; font-size: 0.85rem; font-weight: 600; }
  .gallery-counter { position: absolute; top: 12px; right: 12px; padding: 6px 12px; background: rgba(0, 0, 0, 0.7); border-radius: 20px; color: #fff; font-size: 0.75rem; font-weight: 600; opacity: 0; transition: opacity 0.3s ease; }
  .gallery-item:hover .gallery-counter { opacity: 1; }
  .gallery-info { display: flex; align-items: center; justify-content: center; gap: 10px; margin-top: 28px; color: rgba(255, 255, 255, 0.5); font-size: 0.9rem; }
  .gallery-info svg { color: #eab308; }
  .gallery-info strong { color: #eab308; }
  .lightbox { position: fixed; inset: 0; z-index: 100; display: none; align-items: center; justify-content: center; }
  .lightbox.open { display: flex; }
  .lb-backdrop { position: absolute; inset: 0; background: rgba(0, 0, 0, 0.95); backdrop-filter: blur(10px); }
  .lb-container { position: relative; width: 100%; max-width: 1200px; padding: 24px; }
  .lb-close { position: absolute; top: -50px; right: 24px; width: 48px; height: 48px; display: flex; align-items: center; justify-content: center; background: rgba(255, 255, 255, 0.1); border: none; border-radius: 50%; color: #fff; cursor: pointer; transition: all 0.2s ease; z-index: 10; }
  .lb-close:hover { background: rgba(255, 255, 255, 0.2); }
  .lb-nav { position: absolute; top: 50%; transform: translateY(-50%); width: 48px; height: 48px; display: flex; align-items: center; justify-content: center; background: rgba(255, 255, 255, 0.1); border: none; border-radius: 50%; color: #fff; cursor: pointer; transition: all 0.2s ease; z-index: 10; }
  .lb-nav:hover { background: rgba(255, 255, 255, 0.2); }
  .lb-nav.prev { left: 24px; }
  .lb-nav.next { right: 24px; }
  .lb-content { position: relative; }
  .lb-content img { width: 100%; max-height: 80vh; object-fit: contain; border-radius: 16px; }
  .lb-counter { position: absolute; bottom: -40px; left: 50%; transform: translateX(-50%); padding: 8px 20px; background: rgba(255, 255, 255, 0.1); border-radius: 20px; color: #fff; font-size: 0.9rem; font-weight: 600; }
  @keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }
  @keyframes fadeInLeft { from { opacity: 0; transform: translateX(-40px); } to { opacity: 1; transform: translateX(0); } }
  @keyframes fadeInRight { from { opacity: 0; transform: translateX(40px); } to { opacity: 1; transform: translateX(0); } }
  .animate-spin { animation: spin 1s linear infinite; }
  @keyframes spin { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }
  @media (max-width: 1024px) { .product-grid { grid-template-columns: 1fr; gap: 40px; } .images-column { position: static; } .mobile-trust { display: grid; } .trust-badges { display: none; } .gallery-grid { grid-template-columns: repeat(3, 1fr); } }
  @media (max-width: 768px) { .product-detail-page { padding: 16px 0 60px; } .product-title { font-size: 1.75rem; } .price-value { font-size: 2rem; } .variant-options { grid-template-columns: 1fr; } .thumbnails-grid { grid-template-columns: repeat(4, 1fr); } .gallery-grid { grid-template-columns: repeat(2, 1fr); gap: 12px; } }
  @media (max-width: 480px) { .product-container { padding: 0 16px; } .breadcrumb { padding: 10px 14px; gap: 6px; font-size: 0.8rem; overflow-x: auto; } .breadcrumb-current { max-width: 120px; } .product-badges { gap: 8px; } .badge { padding: 6px 12px; font-size: 0.7rem; } .price-box { padding: 16px 20px; } .thumbnails-grid { grid-template-columns: repeat(3, 1fr); } .mobile-trust { gap: 8px; } .trust-mini { padding: 10px 6px; } .trust-mini span { font-size: 0.65rem; } }
</style>

<script>
  import { itemsInCart } from "@/store";
  import { navigate } from "astro:transitions/client";
  import { CartCookiesClient } from "../../utils/cart-cookies";
  import { actions } from "astro:actions";

  function setupProductPage() {
    const productIdInput = document.getElementById("product-id") as HTMLInputElement;
    if (!productIdInput) return;

    const qtyInput = document.getElementById("qty-input") as HTMLInputElement;
    const decrementBtn = document.getElementById("qty-decr") as HTMLButtonElement;
    const incrementBtn = document.getElementById("qty-incr") as HTMLButtonElement;
    const addBtn = document.getElementById("add-to-cart") as HTMLButtonElement;
    const hasVariantsInput = document.getElementById("product-has-variants") as HTMLInputElement;
    const baseStockInput = document.getElementById("base-stock") as HTMLInputElement;
    const basePriceInput = document.getElementById("base-price") as HTMLInputElement;
    const variantImageMapInput = document.getElementById("variant-image-map") as HTMLInputElement;
    const generalImagesInput = document.getElementById("general-images") as HTMLInputElement;
    
    const variantImageMap = variantImageMapInput ? JSON.parse(variantImageMapInput.value) : {};
    const generalImages = generalImagesInput ? JSON.parse(generalImagesInput.value) : [];
    
    const priceElement = document.getElementById("product-price");
    const stockBadge = document.getElementById("stock-badge");
    const variantInfo = document.getElementById("variant-info");
    const selectedCombination = document.getElementById("selected-combination");
    const combinationSku = document.getElementById("combination-sku");
    const variantMessage = document.getElementById("variant-message");

    if (!qtyInput || !addBtn) return;

    const hasVariants = hasVariantsInput?.value === 'true';
    const baseStock = parseInt(baseStockInput?.value || '0');
    const basePrice = parseFloat(basePriceInput?.value || '0');
    
    let currentCombination: any = null;
    let selectedVariants: Record<string, string> = {};

    const formatCurrency = (value: number) => new Intl.NumberFormat('es-MX', { style: 'currency', currency: 'MXN' }).format(value);

    function showMessage(message: string, type: 'info' | 'error' | 'success' = 'info') {
      if (!variantMessage) return;
      variantMessage.textContent = message;
      variantMessage.className = `msg ${type}`;
      setTimeout(() => variantMessage.classList.add('hidden'), 5000);
    }

    const updateQuantity = (newQty: number) => {
      const maxStock = hasVariants && currentCombination ? currentCombination.stock : baseStock;
      qtyInput.value = Math.max(1, Math.min(maxStock, newQty)).toString();
    };
    
    function updateProductImage(variantId: string | null) {
      const fn = (window as any).updateSliderImages;
      if (typeof fn !== 'function') return;
      if (!variantId) { fn('product-main-slider', generalImages); return; }
      const variantImage = variantImageMap[variantId];
      fn('product-main-slider', variantImage ? [variantImage] : generalImages);
    }

    async function updateCombination() {
      if (!hasVariants) return;
      const variantGroups = document.querySelectorAll('.variant-group');
      if (Object.keys(selectedVariants).length < variantGroups.length) {
        addBtn.disabled = true;
        showMessage('Por favor, selecciona una opción para cada variante.', 'info');
        return;
      }

      try {
        const { data, error } = await actions.getVariantCombination({ productId: productIdInput.value, selectedVariants });
        if (error || !data) { showMessage('Esta combinación no está disponible.', 'error'); addBtn.disabled = true; currentCombination = null; return; }

        currentCombination = data;
        if (!currentCombination.combinationName) {
          currentCombination.combinationName = Object.entries(selectedVariants).map(([variantName, variantId]) => {
            const button = document.querySelector(`[data-variant-id="${variantId}"]`) as HTMLElement;
            return button ? `${variantName}: ${button.dataset.variantValue}` : '';
          }).filter(Boolean).join(' / ');
        }
        
        if (priceElement) priceElement.textContent = formatCurrency(data.price);
        if (stockBadge) { const isInStock = data.stock > 0; stockBadge.className = `badge ${isInStock ? 'badge-stock' : 'badge-out'}`; stockBadge.textContent = isInStock ? `${data.stock} en stock` : 'Agotado'; }
        if (variantInfo && selectedCombination && combinationSku) {
          selectedCombination.textContent = Object.values(selectedVariants).map(variantId => { const button = document.querySelector(`[data-variant-id="${variantId}"]`) as HTMLElement; return button ? button.dataset.variantValue : ''; }).join(' / ');
          combinationSku.textContent = data.sku || '-';
          variantInfo.classList.remove('hidden');
        }

        const isOutOfStock = data.stock <= 0;
        addBtn.disabled = isOutOfStock;
        addBtn.innerHTML = isOutOfStock ? '<span>Sin stock disponible</span>' : `<svg width="22" height="22" fill="currentColor" viewBox="0 0 20 20"><path d="M3 1a1 1 0 000 2h1.22l.305 1.222a.997.997 0 00.01.042l1.358 5.43-.893.892C3.74 11.846 4.632 14 6.414 14H15a1 1 0 000-2H6.414l1-1H14a1 1 0 00.894-.553l3-6A1 1 0 0017 3H6.28l-.31-1.243A1 1 0 005 1H3zM16 16.5a1.5 1.5 0 11-3 0 1.5 1.5 0 013 0zM6.5 18a1.5 1.5 0 100-3 1.5 1.5 0 000 3z"/></svg><span>Añadir al carrito</span>`;
        qtyInput.max = data.stock.toString();
        if (parseInt(qtyInput.value) > data.stock) qtyInput.value = Math.max(1, data.stock).toString();
      } catch (e) { showMessage('Error al consultar el producto.', 'error'); }
    }
    
    function selectVariantOption(button: HTMLElement) {
      const variantName = button.dataset.variantName;
      const variantId = button.dataset.variantId;
      const hasImage = button.dataset.hasImage === 'true';
      const group = button.closest('.variant-group');
      if (!group || !variantName || !variantId) return;
      group.querySelectorAll('.variant-option').forEach(opt => opt.classList.remove('selected'));
      button.classList.add('selected');
      selectedVariants[variantName] = variantId;
      updateProductImage(hasImage ? variantId : null);
      updateCombination();
    }
    
    if (hasVariants) document.querySelectorAll('.variant-option').forEach(button => button.addEventListener('click', () => selectVariantOption(button as HTMLElement)));

    decrementBtn?.addEventListener("click", () => updateQuantity(parseInt(qtyInput.value) - 1));
    incrementBtn?.addEventListener("click", () => updateQuantity(parseInt(qtyInput.value) + 1));
    qtyInput?.addEventListener("change", () => updateQuantity(parseInt(qtyInput.value)));

    addBtn?.addEventListener("click", async () => {
      const quantityToAdd = parseInt(qtyInput.value) || 1;
      const productId = productIdInput.value;
      if (hasVariants && !currentCombination) { showMessage('Por favor, selecciona todas las opciones de variante.', 'error'); return; }
      addBtn.disabled = true;
      addBtn.innerHTML = `<svg class="animate-spin" width="22" height="22" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg><span>Procesando...</span>`;
      try {
        const cartItem: any = { productId, quantity: quantityToAdd, combinationId: currentCombination?.id, variantName: currentCombination?.combinationName, variantSku: currentCombination?.sku };
        if (hasVariants && currentCombination) {
          cartItem.combinationId = currentCombination.id;
          cartItem.variantName = currentCombination.combinationName || Object.entries(selectedVariants).map(([name, id]) => { const btn = document.querySelector(`[data-variant-id="${id}"]`) as HTMLElement; return btn ? `${name}: ${btn.dataset.variantValue}` : ''; }).filter(Boolean).join(' / ');
          if (currentCombination.sku) cartItem.variantSku = currentCombination.sku;
          cartItem.variantPrice = currentCombination.price;
          if (currentCombination.price && currentCombination.price !== basePrice) cartItem.variantPriceAdjustment = currentCombination.price - basePrice;
        }
        CartCookiesClient.addItem(cartItem);
        itemsInCart.set(CartCookiesClient.getTotalItems());
        showMessage('¡Producto añadido al carrito!', 'success');
        setTimeout(async () => await navigate("/cart"), 800);
      } catch (error) {
        showMessage('Error al añadir el producto', 'error');
        addBtn.disabled = false;
        addBtn.innerHTML = `<svg width="22" height="22" fill="currentColor" viewBox="0 0 20 20"><path d="M3 1a1 1 0 000 2h1.22l.305 1.222a.997.997 0 00.01.042l1.358 5.43-.893.892C3.74 11.846 4.632 14 6.414 14H15a1 1 0 000-2H6.414l1-1H14a1 1 0 00.894-.553l3-6A1 1 0 0017 3H6.28l-.31-1.243A1 1 0 005 1H3zM16 16.5a1.5 1.5 0 11-3 0 1.5 1.5 0 013 0zM6.5 18a1.5 1.5 0 100-3 1.5 1.5 0 000 3z"/></svg><span>Añadir al carrito</span>`;
      }
    });

    // Lightbox
    const lightbox = document.getElementById('lightbox');
    const lightboxImage = document.getElementById('lightbox-image') as HTMLImageElement;
    const lightboxCounter = document.getElementById('lightbox-counter');
    const galleryImages = document.querySelectorAll('[data-gallery-image]');
    let currentImageIndex = 0;
    const totalImages = galleryImages.length;

    function openLightbox(index: number) {
      currentImageIndex = index;
      const item = galleryImages[index] as HTMLElement;
      const img = item.querySelector('img') as HTMLImageElement;
      if (lightboxImage && img) { lightboxImage.src = img.src; lightboxImage.alt = img.alt; }
      if (lightboxCounter) lightboxCounter.textContent = `${index + 1} / ${totalImages}`;
      if (lightbox) { lightbox.classList.add('open'); document.body.style.overflow = 'hidden'; }
    }

    function closeLightbox() { if (lightbox) { lightbox.classList.remove('open'); document.body.style.overflow = ''; } }
    function showPrevImage() { currentImageIndex = (currentImageIndex - 1 + totalImages) % totalImages; openLightbox(currentImageIndex); }
    function showNextImage() { currentImageIndex = (currentImageIndex + 1) % totalImages; openLightbox(currentImageIndex); }

    galleryImages.forEach((item, index) => item.addEventListener('click', () => openLightbox(index)));
    document.getElementById('lightbox-close')?.addEventListener('click', closeLightbox);
    document.getElementById('lightbox-prev')?.addEventListener('click', showPrevImage);
    document.getElementById('lightbox-next')?.addEventListener('click', showNextImage);
    document.querySelector('.lb-backdrop')?.addEventListener('click', closeLightbox);
    document.addEventListener('keydown', (e) => { if (lightbox?.classList.contains('open')) { if (e.key === 'Escape') closeLightbox(); if (e.key === 'ArrowLeft') showPrevImage(); if (e.key === 'ArrowRight') showNextImage(); } });

    // Init
    if (hasVariants) document.querySelectorAll('.variant-group').forEach(group => { const firstOption = group.querySelector('.variant-option:not([disabled])') as HTMLElement; if (firstOption) selectVariantOption(firstOption); });
    else { addBtn.disabled = baseStock <= 0; if (baseStock <= 0) addBtn.innerHTML = '<span>Sin stock disponible</span>'; }
  }

  document.addEventListener("astro:page-load", () => setTimeout(() => setupProductPage(), 100));
</script>
