---
// src/pages/products/[...slug].astro
import ProductSlideshow from "@/components/products/ProductSlideshow.astro";
import ProductsLayout from "@/layouts/ProductsLayout.astro";
import { actions } from "astro:actions";
import { Formatter } from "@/utils";

const { slug } = Astro.params;
const { data, error } = await Astro.callAction(
  actions.getProductBySlug,
  slug ?? ""
);

if (error) {
  return Astro.redirect("/404");
}

const rawProduct = data.product;
const images = data.images || [];
const generalImages = data.generalImages || [];
const variantImages = data.variantImages || [];

const fullGeneralImages = (generalImages.length > 0 ? generalImages : images).map((img: any) => 
  img.image.startsWith("http") 
    ? img.image 
    : `${import.meta.env.PUBLIC_URL}/images/products/${img.image}`
);

const variantImageMap = new Map();
if (variantImages.length > 0) {
  variantImages.forEach((img: any) => {
    const fullUrl = img.image.startsWith("http") 
      ? img.image 
      : `${import.meta.env.PUBLIC_URL}/images/products/${img.image}`;
    variantImageMap.set(img.variantId, fullUrl);
  });
}

let variantsData = null;
if (rawProduct.hasVariants) {
  const { data: variants } = await Astro.callAction(actions.getGroupedProductVariants, rawProduct.id);
  variantsData = variants;
}

const image = images[0]?.image.startsWith("http")
  ? images[0].image
  : `${import.meta.env.PUBLIC_URL}/images/products/${images[0]?.image}`;

let piercing_name: string[] = [];
if (typeof rawProduct.piercing_name === 'string') {
  piercing_name = rawProduct.piercing_name.split(',').map(p => p.trim());
} else if (Array.isArray(rawProduct.piercing_name)) {
  piercing_name = rawProduct.piercing_name;
}

const product = {
  ...rawProduct,
  piercing_name
};

interface VariantOption {
  id: string;
  value: string;
  priceAdjustment: number;
  stock: number;
}

interface ProcessedVariantOption extends VariantOption {
  isOutOfStock: boolean;
  hasImage: boolean;
}

interface ProcessedVariantGroup {
  variantName: string;
  options: ProcessedVariantOption[];
}

const processVariants = (variantsData: any): ProcessedVariantGroup[] | null => {
  if (!variantsData?.hasVariants) return null;

  return Object.entries(variantsData.groupedVariants).map(([variantName, group]: [string, any]) => {
    const processedOptions = group.options.map((option: VariantOption) => {
      const isOutOfStock = option.stock <= 0;
      const hasImage = variantImageMap.has(option.id);

      return {
        ...option,
        isOutOfStock,
        hasImage
      };
    });

    return {
      variantName,
      options: processedOptions
    };
  });
};

const processedVariants = processVariants(variantsData);
---

<ProductsLayout 
  title={product.name} 
  description={product.description}
  image={image}
>
  <div class="product-detail-page">
    <!-- Background Decorations -->
    <div class="bg-decoration">
      <div class="glow glow-1"></div>
      <div class="glow glow-2"></div>
      <div class="grid-pattern"></div>
    </div>

    <div class="product-container">
      <!-- Breadcrumb -->
      <nav class="breadcrumb" aria-label="Navegación">
        <a href="/" class="breadcrumb-link">
          <svg width="16" height="16" fill="currentColor" viewBox="0 0 20 20">
            <path d="M10.707 2.293a1 1 0 00-1.414 0l-7 7a1 1 0 001.414 1.414L4 10.414V17a1 1 0 001 1h2a1 1 0 001-1v-2a1 1 0 011-1h2a1 1 0 011 1v2a1 1 0 001 1h2a1 1 0 001-1v-6.586l.293.293a1 1 0 001.414-1.414l-7-7z"/>
          </svg>
          <span>Inicio</span>
        </a>
        <svg class="breadcrumb-sep" width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
        </svg>
        <a href="/products" class="breadcrumb-link">Productos</a>
        <svg class="breadcrumb-sep" width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
        </svg>
        <span class="breadcrumb-current">{product.name}</span>
      </nav>

      <!-- Main Product Grid -->
      <div class="product-grid">
        <!-- Images Column -->
        <div class="images-column">
          <div class="main-image-wrapper">
            {product.hasVariants && variantImageMap.size > 0 && (
              <div class="variant-badge">
                <svg width="14" height="14" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                </svg>
                <span>Variantes con imagen</span>
              </div>
            )}
            <ProductSlideshow images={fullGeneralImages} sliderId="product-main-slider" />
          </div>

          {images.length > 1 && (
            <div class="thumbnails-grid">
              {images.slice(0, 5).map((imageObj, index) => {
                const imageSrc = imageObj.image.startsWith("http")
                  ? imageObj.image
                  : `${import.meta.env.PUBLIC_URL}/images/products/${imageObj.image}`;
                return (
                  <button class="thumb-btn" data-gallery-thumb data-index={index}>
                    <img src={imageSrc} alt={`${product.name} - ${index + 1}`} loading="lazy" />
                    {index === 4 && images.length > 5 && (
                      <div class="thumb-more"><span>+{images.length - 5}</span></div>
                    )}
                  </button>
                );
              })}
            </div>
          )}

          <!-- Mobile Trust Strip -->
          <div class="mobile-trust">
            <div class="trust-mini">
              <svg width="16" height="16" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M2.166 4.999A11.954 11.954 0 0010 1.944 11.954 11.954 0 0017.834 5c.11.65.166 1.32.166 2.001 0 5.225-3.34 9.67-8 11.317C5.34 16.67 2 12.225 2 7c0-.682.057-1.35.166-2.001zm11.541 3.708a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
              </svg>
              <span>Compra segura</span>
            </div>
            <div class="trust-mini">
              <svg width="16" height="16" fill="currentColor" viewBox="0 0 20 20">
                <path d="M8 16.5a1.5 1.5 0 11-3 0 1.5 1.5 0 013 0zM15 16.5a1.5 1.5 0 11-3 0 1.5 1.5 0 013 0zM3 4a1 1 0 00-1 1v10a1 1 0 001 1h1.05a2.5 2.5 0 014.9 0H10a1 1 0 001-1V5a1 1 0 00-1-1H3zM14 7a1 1 0 011-1h4.05a1 1 0 01.866.5l1.08 1.875A1 1 0 0121 9v5a1 1 0 01-1 1h-.05a2.5 2.5 0 01-4.9 0H14a1 1 0 01-1-1V8z"/>
              </svg>
              <span>Envío nacional</span>
            </div>
            <div class="trust-mini">
              <svg width="16" height="16" fill="currentColor" viewBox="0 0 20 20">
                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
              </svg>
              <span>Calidad garantizada</span>
            </div>
          </div>
        </div>

        <!-- Info Column -->
        <div class="info-column">
          <!-- Badges -->
          <div class="product-badges">
            <span class="badge badge-category">
              <svg width="12" height="12" fill="currentColor" viewBox="0 0 20 20">
                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
              </svg>
              {product.category}
            </span>
            <span class="badge badge-type">{product.type}</span>
            <span id="stock-badge" class={`badge ${product.stock > 0 ? 'badge-stock' : 'badge-out'}`}>
              {product.stock > 0 ? `${product.stock} en stock` : 'Agotado'}
            </span>
          </div>

          <!-- Title -->
          <h1 class="product-title">{product.name}</h1>

          <!-- Price -->
          <div class="price-box">
            <div class="price-main">
              <span id="product-price" class="price-value">{Formatter.currency(product.price)}</span>
              <span class="price-currency">MXN</span>
            </div>
            <p class="price-note">Precio final, impuestos incluidos</p>
          </div>

          <!-- Variants -->
          {product.hasVariants && processedVariants && (
            <div class="variants-section">
              <div class="variants-header">
                <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4"/>
                </svg>
                <h3>Personaliza tu producto</h3>
              </div>
              
              {processedVariants.map((variantGroup) => (
                <div class="variant-group" data-variant-name={variantGroup.variantName}>
                  <label class="variant-label">{variantGroup.variantName}</label>
                  <div class="variant-options">
                    {variantGroup.options.map((option, index) => (
                      <button
                        type="button"
                        data-variant-id={option.id}
                        data-variant-name={variantGroup.variantName}
                        data-variant-value={option.value}
                        data-price-adjustment={option.priceAdjustment}
                        data-stock={option.stock}
                        data-has-image={option.hasImage}
                        class={`variant-option ${option.isOutOfStock ? 'out-of-stock' : ''} ${index === 0 && !option.isOutOfStock ? 'selected' : ''}`}
                        disabled={option.isOutOfStock}
                      >
                        <div class="variant-main">
                          <span class="variant-value">
                            {option.value}
                            {option.hasImage && <span class="has-img">📷</span>}
                          </span>
                          {option.priceAdjustment !== 0 && (
                            <span class={`price-adj ${option.priceAdjustment > 0 ? 'pos' : 'neg'}`}>
                              {option.priceAdjustment > 0 ? '+' : ''}{Formatter.currency(option.priceAdjustment)}
                            </span>
                          )}
                        </div>
                        <span class="variant-stock">{option.isOutOfStock ? 'Agotado' : `${option.stock} disp.`}</span>
                        <div class="select-dot"></div>
                      </button>
                    ))}
                  </div>
                </div>
              ))}

              <div id="variant-info" class="variant-info hidden">
                <div class="info-row">
                  <div><span class="info-label">Selección:</span><span id="selected-combination" class="info-val"></span></div>
                  <div><span class="info-label">SKU:</span><span id="combination-sku" class="info-sku">-</span></div>
                </div>
              </div>
            </div>
          )}

          <!-- Piercings -->
          {product.piercing_name.length > 0 && (
            <div class="piercing-section">
              <h3 class="section-label">
                <svg width="16" height="16" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                </svg>
                Perforaciones compatibles
              </h3>
              <div class="piercing-tags">
                {product.piercing_name.map(piercing => (
                  <span class="piercing-tag">{piercing}</span>
                ))}
              </div>
            </div>
          )}

          <!-- Description -->
          <div class="desc-section">
            <h3 class="section-label">
              <svg width="16" height="16" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M4 4a2 2 0 012-2h4.586A2 2 0 0112 2.586L15.414 6A2 2 0 0116 7.414V16a2 2 0 01-2 2H6a2 2 0 01-2-2V4zm2 6a1 1 0 011-1h6a1 1 0 110 2H7a1 1 0 01-1-1zm1 3a1 1 0 100 2h6a1 1 0 100-2H7z" clip-rule="evenodd"/>
              </svg>
              Descripción
            </h3>
            <p class="product-desc">{product.description}</p>
          </div>

          <!-- Shipping -->
          <div class="shipping-card">
            <div class="shipping-icon">
              <svg width="24" height="24" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 8h14M5 8a2 2 0 110-4h14a2 2 0 110 4M5 8v10a2 2 0 002 2h10a2 2 0 002-2V8m-9 4h4"/>
              </svg>
            </div>
            <div class="shipping-text">
              <p class="shipping-title">Envío a todo México</p>
              <p class="shipping-sub">Calcula el costo en el carrito</p>
            </div>
            <div class="shipping-check">
              <svg width="20" height="20" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M2.166 4.999A11.954 11.954 0 0010 1.944 11.954 11.954 0 0017.834 5c.11.65.166 1.32.166 2.001 0 5.225-3.34 9.67-8 11.317C5.34 16.67 2 12.225 2 7c0-.682.057-1.35.166-2.001zm11.541 3.708a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
              </svg>
            </div>
          </div>

          <!-- Cart Section -->
          <div class="cart-section">
            <div class="qty-row">
              <label class="qty-label">Cantidad</label>
              <div class="qty-controls">
                <button id="qty-decr" class="qty-btn" aria-label="Disminuir">
                  <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M20 12H4"/>
                  </svg>
                </button>
                <input id="qty-input" type="number" min="1" value="1" class="qty-input" />
                <button id="qty-incr" class="qty-btn" aria-label="Aumentar">
                  <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 4v16m8-8H4"/>
                  </svg>
                </button>
              </div>
            </div>

            <button id="add-to-cart" class="add-btn">
              <svg width="22" height="22" fill="currentColor" viewBox="0 0 20 20">
                <path d="M3 1a1 1 0 000 2h1.22l.305 1.222a.997.997 0 00.01.042l1.358 5.43-.893.892C3.74 11.846 4.632 14 6.414 14H15a1 1 0 000-2H6.414l1-1H14a1 1 0 00.894-.553l3-6A1 1 0 0017 3H6.28l-.31-1.243A1 1 0 005 1H3zM16 16.5a1.5 1.5 0 11-3 0 1.5 1.5 0 013 0zM6.5 18a1.5 1.5 0 100-3 1.5 1.5 0 000 3z"/>
              </svg>
              <span>Añadir al carrito</span>
            </button>

            <div id="variant-message" class="msg hidden"></div>
          </div>

          <!-- Trust Badges Desktop -->
          <div class="trust-badges">
            <div class="trust-item">
              <div class="trust-icon">
                <svg width="20" height="20" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M2.166 4.999A11.954 11.954 0 0010 1.944 11.954 11.954 0 0017.834 5c.11.65.166 1.32.166 2.001 0 5.225-3.34 9.67-8 11.317C5.34 16.67 2 12.225 2 7c0-.682.057-1.35.166-2.001zm11.541 3.708a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                </svg>
              </div>
              <div class="trust-text"><span class="trust-title">Compra segura</span><span class="trust-desc">Pago protegido</span></div>
            </div>
            <div class="trust-item">
              <div class="trust-icon">
                <svg width="20" height="20" fill="currentColor" viewBox="0 0 20 20">
                  <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                </svg>
              </div>
              <div class="trust-text"><span class="trust-title">Calidad premium</span><span class="trust-desc">100% garantizado</span></div>
            </div>
            <div class="trust-item">
              <div class="trust-icon">
                <svg width="20" height="20" fill="currentColor" viewBox="0 0 20 20">
                  <path d="M8 16.5a1.5 1.5 0 11-3 0 1.5 1.5 0 013 0zM15 16.5a1.5 1.5 0 11-3 0 1.5 1.5 0 013 0zM3 4a1 1 0 00-1 1v10a1 1 0 001 1h1.05a2.5 2.5 0 014.9 0H10a1 1 0 001-1V5a1 1 0 00-1-1H3zM14 7a1 1 0 011-1h4.05a1 1 0 01.866.5l1.08 1.875A1 1 0 0121 9v5a1 1 0 01-1 1h-.05a2.5 2.5 0 01-4.9 0H14a1 1 0 01-1-1V8z"/>
                </svg>
              </div>
              <div class="trust-text"><span class="trust-title">Envío rápido</span><span class="trust-desc">A todo México</span></div>
            </div>
          </div>
        </div>
      </div>

      <!-- Gallery -->
      {images.length > 1 && (
        <section class="gallery-section">
          <div class="gallery-header">
            <div class="header-line"></div>
            <h2 class="gallery-title">
              <svg width="24" height="24" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
              </svg>
              Galería del producto
            </h2>
            <div class="header-line"></div>
          </div>

          <div class="gallery-grid">
            {images.map((imageObj, index) => {
              const imageSrc = imageObj.image.startsWith("http")
                ? imageObj.image
                : `${import.meta.env.PUBLIC_URL}/images/products/${imageObj.image}`;
              return (
                <div class="gallery-item" data-gallery-image data-gallery-index={index}>
                  <img src={imageSrc} alt={`${product.name} - Imagen ${index + 1}`} loading="lazy" />
                  <div class="gallery-overlay">
                    <div class="overlay-icon">
                      <svg width="24" height="24" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v3m0 0v3m0-3h3m-3 0H7"/>
                      </svg>
                    </div>
                    <span class="overlay-text">Ver imagen</span>
                  </div>
                  <span class="gallery-counter">{index + 1}/{images.length}</span>
                </div>
              );
            })}
          </div>

          <p class="gallery-info">
            <svg width="16" height="16" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M4 3a2 2 0 00-2 2v10a2 2 0 002 2h12a2 2 0 002-2V5a2 2 0 00-2-2H4zm12 12H4l4-8 3 6 2-4 3 6z" clip-rule="evenodd"/>
            </svg>
            <span>Mostrando <strong>{images.length}</strong> {images.length === 1 ? 'imagen' : 'imágenes'}</span>
          </p>
        </section>
      )}
    </div>

    <!-- Lightbox -->
    <div id="lightbox" class="lightbox">
      <div class="lb-backdrop"></div>
      <div class="lb-container">
        <button id="lightbox-close" class="lb-close" aria-label="Cerrar">
          <svg width="24" height="24" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
          </svg>
        </button>
        <button id="lightbox-prev" class="lb-nav prev" aria-label="Anterior">
          <svg width="24" height="24" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
          </svg>
        </button>
        <button id="lightbox-next" class="lb-nav next" aria-label="Siguiente">
          <svg width="24" height="24" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
          </svg>
        </button>
        <div class="lb-content">
          <img id="lightbox-image" src="" alt="" />
          <div class="lb-counter"><span id="lightbox-counter">1 / 1</span></div>
        </div>
      </div>
    </div>

    <!-- Hidden Inputs -->
    <input type="hidden" id="product-id" value={product.id} />
    <input type="hidden" id="product-has-variants" value={`${product.hasVariants}`} />
    <input type="hidden" id="base-price" value={product.price} />
    <input type="hidden" id="base-stock" value={product.stock} />
    <input type="hidden" id="variant-image-map" value={JSON.stringify(Object.fromEntries(variantImageMap))} />
    <input type="hidden" id="general-images" value={JSON.stringify(fullGeneralImages)} />
  </div>
</ProductsLayout>

<style>
  .product-detail-page { position: relative; min-height: 100vh; padding: 24px 0 80px; }
