.gallery-section { padding-top: 48px; border-top: 1px solid rgba(0,0,0,0.06); }
.gallery-header { display: flex; align-items: center; gap: 24px; margin-bottom: 32px; }
.header-line { flex: 1; height: 1px; background: linear-gradient(90deg, transparent, rgba(0,0,0,0.1), transparent); }
.gallery-title { display: flex; align-items: center; gap: 12px; font-size: 1.25rem; font-weight: 800; color: var(--txt); white-space: nowrap; }
