.gallery-overlay { position: absolute; inset: 0; z-index: 3; background: linear-gradient(to top, rgba(0,0,0,0.5) 0%, transparent 60%); opacity: 0; transition: opacity 0.3s ease; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 8px; }
.gallery-item:hover .gallery-overlay { opacity: 1; }
.overlay-icon { width: 48px; height: 48px; display: flex; align-items: center; justify-content: center; background: rgba(255,255,255,0.2); backdrop-filter: blur(6px); box-shadow: var(--lg-thickness); border-radius: 50%; color: #fff; }
.overlay-text { color: #fff; font-size: 0.85rem; font-weight: 600; }
.gallery-counter { position: absolute; top: 12px; right: 12px; z-index: 3; padding: 5px 12px; background: rgba(255,255,255,0.2); backdrop-filter: blur(8px); box-shadow: var(--lg-thickness); border-radius: 999px; color: #fff; font-size: 0.75rem; font-weight: 600; opacity: 0; transition: opacity 0.3s ease; }
.gallery-item:hover .gallery-counter { opacity: 1; }

.related-section { padding-top: 48px; margin-top: 48px; border-top: 1px solid rgba(0,0,0,0.06); }
.related-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; }
.related-card { display: block; text-decoration: none; border-radius: 24px; overflow: hidden; transition: all 0.35s cubic-bezier(0.34, 1.3, 0.64, 1); }
.related-card:hover { transform: translateY(-5px) scale(1.02); }
.related-img { aspect-ratio: 1; overflow: hidden; }
.related-img img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.4s ease; }
.related-card:hover .related-img img { transform: scale(1.06); }
.related-name { padding: 12px 16px 4px; color: var(--txt); font-size: 0.9rem; font-weight: 600; position: relative; z-index: 3; }
.related-price { padding: 0 16px 16px; color: var(--gold-deep); font-size: 0.95rem; font-weight: 800; position: relative; z-index: 3; }

/* Lightbox */
.lightbox { position: fixed; inset: 0; z-index: 100; display: none; align-items: center; justify-content: center; }
.lightbox.open { display: flex; }
.lb-backdrop { position: absolute; inset: 0; background: rgba(255,255,255,0.55); backdrop-filter: saturate(180%) blur(40px); -webkit-backdrop-filter: saturate(180%) blur(40px); }
.lb-container { position: relative; width: 100%; max-width: 1200px; padding: 24px; }
.lb-close, .lb-nav { width: 50px; height: 50px; display: flex; align-items: center; justify-content: center; background: rgba(255,255,255,0.25); backdrop-filter: blur(6px) saturate(180%) brightness(1.1); -webkit-backdrop-filter: blur(6px) saturate(180%) brightness(1.1); border: none; border-radius: 50%; box-shadow: var(--lg-thickness), var(--lg-drop); color: var(--txt); cursor: pointer; transition: all 0.2s cubic-bezier(0.34, 1.4, 0.64, 1); z-index: 10; }
.lb-close { position: absolute; top: -54px; right: 24px; }
.lb-close:hover, .lb-nav:hover { background: rgba(255,255,255,0.5); }
.lb-close:active, .lb-nav:active { transform: scale(0.92); }
.lb-nav { position: absolute; top: 50%; transform: translateY(-50%); }
.lb-nav.prev { left: 24px; }
.lb-nav.next { right: 24px; }
.lb-content { position: relative; }
.lb-content img { width: 100%; max-height: 80vh; object-fit: contain; border-radius: 24px; box-shadow: 0 30px 60px -30px rgba(0,0,0,0.4); }
.lb-counter { position: absolute; bottom: -44px; left: 50%; transform: translateX(-50%); padding: 8px 20px; background: rgba(255,255,255,0.25); backdrop-filter: blur(6px); box-shadow: var(--lg-thickness); border-radius: 999px; color: var(--txt); font-size: 0.9rem; font-weight: 600; }

/* Sin backdrop-filter: el vidrio se vuelve sólido para no perder legibilidad */
@supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
  .breadcrumb, .details-block, .mp-line, .variants-section, .cart-section,
  .info-box, .main-image-wrapper, .gallery-item, .related-card, .chip,
  .thumb-btn, .announcement-bar, .variant-option, .badge { background: rgba(255,255,255,0.93); }
