---
// src/pages/products/[...slug].astro
import ProductSlideshow from "@/components/products/ProductSlideshow.astro";
import ProductCustomization from "@/pages/products/ProductCustomization.astro";
import ProductsLayout from "@/layouts/ProductsLayout.astro";
import { actions } from "astro:actions";
import { Formatter } from "@/utils";

// ⚙️ Configuración editable
const FREE_SHIPPING_THRESHOLD = 999; // MXN — pon 0 para ocultar la banda y la fila de envío gratis
const WHATSAPP_URL = "https://wa.me/52XXXXXXXXXX"; // ← pon tu número real

// 🎨 Swatches: mapa de nombres de color → color CSS.
// Si el grupo de variantes se llama "Color" (o contiene "color") y el valor
// está en este mapa, se pinta un cuadrito de color como en la referencia.
// Si no está en el mapa, se muestra como pill de texto normal.
const COLOR_MAP: Record<string, string> = {
  dorado: '#d4af37',
  oro: '#d4af37',
  'oro rosa': '#e7b9a4',
  plateado: '#c9ccd1',
  plata: '#c9ccd1',
  negro: '#26262a',
  blanco: '#f2f2f2',
  gris: '#9ca3af',
  rosa: '#f472b6',
  rojo: '#ef4444',
  azul: '#3b82f6',
  'azul rey': '#1d4ed8',
  'azul cielo': '#7dd3fc',
  verde: '#22c55e',
  morado: '#8b5cf6',
  lila: '#c4b5fd',
  amarillo: '#facc15',
  café: '#92400e',
  cafe: '#92400e',
  tornasol: 'conic-gradient(from 0deg, #f87171, #facc15, #4ade80, #60a5fa, #c084fc, #f87171)',
  multicolor: 'conic-gradient(from 0deg, #f87171, #facc15, #4ade80, #60a5fa, #c084fc, #f87171)',
  arcoiris: 'conic-gradient(from 0deg, #f87171, #facc15, #4ade80, #60a5fa, #c084fc, #f87171)',
};
const getSwatch = (value: string): string | null =>
  COLOR_MAP[value.trim().toLowerCase()] ?? null;
const isColorGroup = (name: string): boolean =>
  name.trim().toLowerCase().includes('color');

const { slug } = Astro.params;
const { data, error } = await Astro.callAction(
  actions.getProductBySlug,
  slug ?? ""
);

if (error) {
  return Astro.redirect("/404");
}

const rawProduct = data.product;
const images = data.images || [];
const generalImages = data.generalImages || [];
const variantImages = data.variantImages || [];

// Ordenar imágenes: coverImage primero
const coverImageId = (rawProduct as any).coverImageId || '';
const sourceImages = generalImages.length > 0 ? generalImages : images;
const sortedImages = [...sourceImages].sort((a: any, b: any) => {
  if (a.id === coverImageId) return -1;
  if (b.id === coverImageId) return 1;
  return 0;
});

const fullGeneralImages = sortedImages.map((img: any) => 
  img.image.startsWith("http") 
    ? img.image 
    : `${import.meta.env.PUBLIC_URL}/images/products/${img.image}`
);

const variantImageMap = new Map();
if (variantImages.length > 0) {
  variantImages.forEach((img: any) => {
    const fullUrl = img.image.startsWith("http") 
      ? img.image 
      : `${import.meta.env.PUBLIC_URL}/images/products/${img.image}`;
    variantImageMap.set(img.variantId, fullUrl);
  });
}

let variantsData = null;
let combinationImageMap = new Map();
if (rawProduct.hasVariants) {
  const { data: variants } = await Astro.callAction(actions.getGroupedProductVariants, rawProduct.id);
  variantsData = variants;
  
  if (variantsData?.combinationImages) {
    Object.entries(variantsData.combinationImages).forEach(([comboId, imgData]: [string, any]) => {
      combinationImageMap.set(comboId, imgData.image);
    });
  }
}

const coverImg = images.find((img: any) => img.id === coverImageId) || images[0];
const image = coverImg?.image.startsWith("http")
  ? coverImg.image
  : `${import.meta.env.PUBLIC_URL}/images/products/${coverImg?.image}`;

let piercing_name: string[] = [];
if (typeof rawProduct.piercing_name === 'string') {
  piercing_name = rawProduct.piercing_name.split(',').map(p => p.trim()).filter(p => p !== '' && p !== 'Ninguno');
} else if (Array.isArray(rawProduct.piercing_name)) {
  piercing_name = (rawProduct.piercing_name as string[]).filter(p => p !== '' && p !== 'Ninguno');
}

const product = {
  ...rawProduct,
  piercing_name,
  allowsEngraving: (rawProduct as any).allowsEngraving ?? false,
};

interface VariantOption {
  id: string;
  value: string;
  priceAdjustment: number;
  stock: number;
}

interface ProcessedVariantOption extends VariantOption {
  isOutOfStock: boolean;
  hasImage: boolean;
}

interface ProcessedVariantGroup {
  variantName: string;
  options: ProcessedVariantOption[];
}

const processVariants = (variantsData: any): ProcessedVariantGroup[] | null => {
  if (!variantsData?.hasVariants) return null;

  // Con 2+ grupos el stock se administra por combinación, no por opción.
  const groupCount = Object.keys(variantsData.groupedVariants || {}).length;
  const multiGroup = groupCount >= 2;

  return Object.entries(variantsData.groupedVariants).map(([variantName, group]: [string, any]) => {
    const processedOptions = group.options.map((option: VariantOption) => ({
      ...option,
      isOutOfStock: multiGroup ? false : option.stock <= 0,
      hasImage: variantImageMap.has(option.id),
    }));

    return { variantName, options: processedOptions };
  });
};

const processedVariants = processVariants(variantsData);

const isMultiGroup = variantsData ? Object.keys(variantsData.groupedVariants || {}).length >= 2 : false;
// Disponibilidad real: si hay variantes, el stock vive en las variantes/combinaciones,
// no en el stock base. Esto evita tener que llenar el stock base.
let displayStock = product.stock;
let hasStock = product.stock > 0;

if (product.hasVariants && variantsData) {
  const combos = variantsData.combinations || [];
  if (combos.length > 0) {
    displayStock = combos.reduce((sum: number, c: any) => sum + (c.stock || 0), 0);
  } else {
    displayStock = Object.values(variantsData.groupedVariants || {})
      .flatMap((g: any) => g.options || [])
      .reduce((sum: number, o: any) => sum + (o.stock || 0), 0);
  }
  hasStock = displayStock > 0;
}

// 🔗 Productos relacionados (opcional): conecta tu action y la sección
// "También te puede interesar" se renderiza sola si hay elementos.
let relatedProducts: any[] = [];
// try {
//   const { data: rel } = await Astro.callAction(actions.getProductsByCategory, {
//     category: product.category, excludeId: product.id, limit: 4,
//   });
//   relatedProducts = rel?.products ?? [];
// } catch {}
---

<ProductsLayout 
  title={product.name} 
  description={product.description}
  image={image}
>
  <div class="product-detail-page">
    <!-- Background Decorations -->
    <div class="bg-decoration">
      <div class="glow glow-1"></div>
      <div class="glow glow-2"></div>
      <div class="grid-pattern"></div>
    </div>

    <!-- 📣 Announcement bar -->
    {FREE_SHIPPING_THRESHOLD > 0 && (
      <div class="announcement-bar">
        <svg width="16" height="16" fill="currentColor" viewBox="0 0 20 20">
          <path d="M8 16.5a1.5 1.5 0 11-3 0 1.5 1.5 0 013 0zM15 16.5a1.5 1.5 0 11-3 0 1.5 1.5 0 013 0zM3 4a1 1 0 00-1 1v10a1 1 0 001 1h1.05a2.5 2.5 0 014.9 0H10a1 1 0 001-1V5a1 1 0 00-1-1H3zM14 7a1 1 0 011-1h4.05a1 1 0 01.866.5l1.08 1.875A1 1 0 0121 9v5a1 1 0 01-1 1h-.05a2.5 2.5 0 01-4.9 0H14a1 1 0 01-1-1V8z"/>
        </svg>
        <span>Envío nacional <strong>GRATIS</strong> en compras + ${FREE_SHIPPING_THRESHOLD} MXN</span>
      </div>
    )}

    <div class="product-container">
      <!-- Breadcrumb -->
      <nav class="breadcrumb" aria-label="Navegación">
        <a href="/" class="breadcrumb-link">
          <svg width="16" height="16" fill="currentColor" viewBox="0 0 20 20">
            <path d="M10.707 2.293a1 1 0 00-1.414 0l-7 7a1 1 0 001.414 1.414L4 10.414V17a1 1 0 001 1h2a1 1 0 001-1v-2a1 1 0 011-1h2a1 1 0 011 1v2a1 1 0 001 1h2a1 1 0 001-1v-6.586l.293.293a1 1 0 001.414-1.414l-7-7z"/>
          </svg>
          <span>Inicio</span>
        </a>
        <svg class="breadcrumb-sep" width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
        </svg>
        <a href="/products" class="breadcrumb-link">Productos</a>
        <svg class="breadcrumb-sep" width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
        </svg>
        <span class="breadcrumb-current">{product.name}</span>
      </nav>

      <!-- Main Product Grid -->
      <div class="product-grid">
        <!-- Images Column -->
        <div class="images-column">
          <!-- 🖼️ Miniaturas verticales a la izquierda + imagen principal (como la referencia) -->
          <div class={`media-wrap ${images.length > 1 ? 'has-thumbs' : ''}`}>
            {images.length > 1 && (
              <div class="thumbnails-col">
                {images.slice(0, 6).map((imageObj, index) => {
                  const imageSrc = imageObj.image.startsWith("http")
                    ? imageObj.image
                    : `${import.meta.env.PUBLIC_URL}/images/products/${imageObj.image}`;
                  return (
                    <button class="thumb-btn" data-gallery-thumb data-index={index}>
                      <img src={imageSrc} alt={`${product.name} - ${index + 1}`} loading="lazy" />
                      {index === 5 && images.length > 6 && (
                        <div class="thumb-more"><span>+{images.length - 6}</span></div>
                      )}
                    </button>
                  );
                })}
              </div>
            )}
            <div class="main-image-wrapper">
              {product.hasVariants && variantImageMap.size > 0 && (
                <div class="variant-badge">
                  <svg width="14" height="14" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                  </svg>
                  <span>Variantes con imagen</span>
                </div>
              )}
              <ProductSlideshow images={fullGeneralImages} sliderId="product-main-slider" />
            </div>
          </div>

          <!-- 📄 Detalles del producto (bajo la imagen, como la referencia) -->
          <div class="details-block">
            <details class="det" open>
              <summary>
                <h2 class="det-title">Detalles del producto</h2>
                <svg class="det-chevron" width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                </svg>
              </summary>
              <div class="det-body">
                <p class="product-desc">{product.description}</p>
              </div>
            </details>

            {product.piercing_name.length > 0 && (
              <details class="det">
                <summary>
                  <h2 class="det-title">Perforaciones compatibles</h2>
                  <svg class="det-chevron" width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                  </svg>
                </summary>
                <div class="det-body">
                  <div class="piercing-tags">
                    {product.piercing_name.map(piercing => (
                      <span class="piercing-tag">{piercing}</span>
                    ))}
                  </div>
                </div>
              </details>
            )}

            <details class="det">
              <summary>
                <h2 class="det-title">Envío y entrega</h2>
                <svg class="det-chevron" width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                </svg>
              </summary>
              <div class="det-body">
                <p class="product-desc">
                  Enviamos a todo México. El costo de envío se calcula en el carrito según tu código postal.
                  {FREE_SHIPPING_THRESHOLD > 0 && ` Envío gratis en compras mayores a $${FREE_SHIPPING_THRESHOLD} MXN.`}
                </p>
              </div>
            </details>
          </div>
        </div>

        <!-- Info Column (buy box, como la referencia) -->
        <div class="info-column">
          <!-- Badges discretos -->
          <div class="product-badges">
            <span class="badge badge-category">{product.category}</span>
            <span class="badge badge-type">{product.type}</span>
          </div>

          <!-- Title (serif, como la referencia) -->
          <h1 class="product-title">{product.name}</h1>

          <!-- Price simple -->
          <div class="price-box">
            <span id="product-price" class="price-value">{Formatter.currency(product.price)}</span>
            <span class="price-currency">MXN</span>
          </div>

          <!-- ⭐ Chips de beneficios (outline pequeños, como la referencia) -->
          <ul class="benefit-chips" role="list">
            <li class="chip">
              <svg width="14" height="14" fill="currentColor" viewBox="0 0 20 20">
                <path d="M8 16.5a1.5 1.5 0 11-3 0 1.5 1.5 0 013 0zM15 16.5a1.5 1.5 0 11-3 0 1.5 1.5 0 013 0zM3 4a1 1 0 00-1 1v10a1 1 0 001 1h1.05a2.5 2.5 0 014.9 0H10a1 1 0 001-1V5a1 1 0 00-1-1H3zM14 7a1 1 0 011-1h4.05a1 1 0 01.866.5l1.08 1.875A1 1 0 0121 9v5a1 1 0 01-1 1h-.05a2.5 2.5 0 01-4.9 0H14a1 1 0 01-1-1V8z"/>
              </svg>
              <span>Envío a todo México</span>
            </li>
            <li class="chip">
              <svg width="14" height="14" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M2.166 4.999A11.954 11.954 0 0010 1.944 11.954 11.954 0 0017.834 5c.11.65.166 1.32.166 2.001 0 5.225-3.34 9.67-8 11.317C5.34 16.67 2 12.225 2 7c0-.682.057-1.35.166-2.001zm11.541 3.708a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
              </svg>
              <span>Pago seguro</span>
            </li>
            <li class="chip">
              <svg width="14" height="14" fill="currentColor" viewBox="0 0 20 20">
                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
              </svg>
              <span>Calidad garantizada</span>
            </li>
            <li class="chip">
              <svg width="14" height="14" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-12a1 1 0 10-2 0v4a1 1 0 00.293.707l2.828 2.829a1 1 0 101.415-1.415L11 9.586V6z" clip-rule="evenodd"/>
              </svg>
              <span>Garantía de satisfacción</span>
            </li>
          </ul>

          <!-- 💳 Línea Mercado Pago (expandible con "Saber más") -->
          <details class="mp-line">
            <summary>
              <span class="mp-dot" aria-hidden="true">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                  <rect x="2" y="5" width="20" height="14" rx="3"/>
                  <path d="M2 10h20"/>
                </svg>
              </span>
              <span class="mp-text">Compra ahora, <strong>paga después</strong> con Mercado Pago.</span>
              <span class="mp-more">Saber más</span>
            </summary>
            <ol class="mp-steps">
              <li><span class="mp-step-num">1</span><p>Agrega tu producto al carrito y <strong>elige pagar con Mercado Pago</strong>.</p></li>
              <li><span class="mp-step-num">2</span><p>En tu cuenta de Mercado Pago, <strong>elige la cantidad de meses</strong> y confirma.</p></li>
              <li><span class="mp-step-num">3</span><p><strong>Paga mes a mes</strong> con saldo disponible, débito u otros medios.</p></li>
            </ol>
            <p class="mp-disclaimer">Crédito sujeto a aprobación de Mercado Pago.</p>
          </details>

          <!-- 🟢 Línea de stock con subrayado (como la referencia) -->
          <div id="stock-badge" class={`stock-line ${hasStock ? 'in' : 'out'}`}>
            {hasStock ? `En stock, listo para ser enviado (${displayStock} disp.)` : 'Agotado temporalmente'}
          </div>

          <!-- Variants: swatches de color + pills -->
          {product.hasVariants && processedVariants && (
            <div class="variants-section">
              {processedVariants.map((variantGroup) => {
                const colorGroup = isColorGroup(variantGroup.variantName);
                return (
                  <div class="variant-group" data-variant-name={variantGroup.variantName}>
                    <label class="variant-label">
                      {variantGroup.variantName}:
                      <span class="variant-selected-value" data-selected-for={variantGroup.variantName}>Selecciona</span>
                    </label>
                    <div class="variant-options">
                      {variantGroup.options.map((option) => {
                        const swatch = colorGroup ? getSwatch(option.value) : null;
                        return swatch ? (
                          <button
                            type="button"
                            data-variant-id={option.id}
                            data-variant-name={variantGroup.variantName}
                            data-variant-value={option.value}
                            data-price-adjustment={option.priceAdjustment}
                            data-stock={option.stock}
                            data-has-image={option.hasImage}
                            class={`variant-option variant-swatch ${option.isOutOfStock ? 'out-of-stock' : ''}`}
                            disabled={option.isOutOfStock}
                            title={option.value}
                            aria-label={option.value}
                          >
                            <span class="swatch-color" style={`background:${swatch}`}></span>
                          </button>
                        ) : (
                          <button
                            type="button"
                            data-variant-id={option.id}
                            data-variant-name={variantGroup.variantName}
                            data-variant-value={option.value}
                            data-price-adjustment={option.priceAdjustment}
                            data-stock={option.stock}
                            data-has-image={option.hasImage}
                            class={`variant-option ${option.isOutOfStock ? 'out-of-stock' : ''}`}
                            disabled={option.isOutOfStock}
                            title={!isMultiGroup && !option.isOutOfStock ? `${option.stock} disponibles` : undefined}
                          >
                            <span class="variant-value">{option.value}</span>
                            {option.priceAdjustment !== 0 && (
                              <span class={`price-adj ${option.priceAdjustment > 0 ? 'pos' : 'neg'}`}>
                                {option.priceAdjustment > 0 ? '+' : ''}{Formatter.currency(option.priceAdjustment)}
                              </span>
                            )}
                          </button>
                        );
                      })}
                    </div>
                  </div>
                );
              })}

              <div id="variant-info" class="variant-info hidden">
                <div class="info-row">
                  <div><span class="info-label">Selección:</span><span id="selected-combination" class="info-val"></span></div>
                  <div><span class="info-label">SKU:</span><span id="combination-sku" class="info-sku">-</span></div>
                </div>
              </div>
            </div>
          )}

          <!-- ✅ GRABADO LÁSER (solo si el producto lo permite) -->
          <ProductCustomization 
            productId={product.id} 
            productName={product.name}
            customizationFieldsRaw={(rawProduct as any).customizationFields || '[]'}
          />

          <!-- Cart Section -->
          <div class="cart-section">
            <div class="qty-row">
              <label class="qty-label">Cantidad</label>
              <div class="qty-controls">
                <button id="qty-decr" class="qty-btn" aria-label="Disminuir">
                  <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M20 12H4"/>
                  </svg>
                </button>
                <input id="qty-input" type="number" min="1" value="1" class="qty-input" />
                <button id="qty-incr" class="qty-btn" aria-label="Aumentar">
                  <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 4v16m8-8H4"/>
                  </svg>
                </button>
              </div>
            </div>

            <button id="add-to-cart" class="add-btn">
              <svg width="20" height="20" fill="currentColor" viewBox="0 0 20 20">
                <path d="M3 1a1 1 0 000 2h1.22l.305 1.222a.997.997 0 00.01.042l1.358 5.43-.893.892C3.74 11.846 4.632 14 6.414 14H15a1 1 0 000-2H6.414l1-1H14a1 1 0 00.894-.553l3-6A1 1 0 0017 3H6.28l-.31-1.243A1 1 0 005 1H3zM16 16.5a1.5 1.5 0 11-3 0 1.5 1.5 0 013 0zM6.5 18a1.5 1.5 0 100-3 1.5 1.5 0 000 3z"/>
              </svg>
              <span>Añadir al carrito</span>
            </button>

            <div id="variant-message" class="msg hidden"></div>

            <p class="tax-note">
              Impuesto incluido. <a href="/cart" class="tax-link">Envío</a> calculado en el momento de la compra.
            </p>
          </div>

          <!-- 📦 Caja de info apilada con divisores (como la referencia) -->
          <div class="info-box">
            <a href={WHATSAPP_URL} target="_blank" rel="noopener noreferrer" class="info-box-row link">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
              </svg>
              <span>¿Tienes dudas? <u>Contáctanos por WhatsApp</u></span>
            </a>
            {FREE_SHIPPING_THRESHOLD > 0 && (
              <div class="info-box-row">
                <svg width="18" height="18" fill="currentColor" viewBox="0 0 20 20">
                  <path d="M8 16.5a1.5 1.5 0 11-3 0 1.5 1.5 0 013 0zM15 16.5a1.5 1.5 0 11-3 0 1.5 1.5 0 013 0zM3 4a1 1 0 00-1 1v10a1 1 0 001 1h1.05a2.5 2.5 0 014.9 0H10a1 1 0 001-1V5a1 1 0 00-1-1H3zM14 7a1 1 0 011-1h4.05a1 1 0 01.866.5l1.08 1.875A1 1 0 0121 9v5a1 1 0 01-1 1h-.05a2.5 2.5 0 01-4.9 0H14a1 1 0 01-1-1V8z"/>
                </svg>
                <span>Envío gratis en compras + ${FREE_SHIPPING_THRESHOLD} MXN</span>
              </div>
            )}
            <div class="info-box-row">
              <svg width="18" height="18" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M5 9V7a5 5 0 0110 0v2a2 2 0 012 2v5a2 2 0 01-2 2H5a2 2 0 01-2-2v-5a2 2 0 012-2zm8-2v2H7V7a3 3 0 016 0z" clip-rule="evenodd"/>
              </svg>
              <span>Pagos seguros</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Gallery -->
      {images.length > 1 && (
        <section class="gallery-section">
          <div class="gallery-header">
            <div class="header-line"></div>
            <h2 class="gallery-title">
              <svg width="24" height="24" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
              </svg>
              Galería del producto
            </h2>
            <div class="header-line"></div>
          </div>

          <div class="gallery-grid">
            {images.map((imageObj, index) => {
              const imageSrc = imageObj.image.startsWith("http")
                ? imageObj.image
                : `${import.meta.env.PUBLIC_URL}/images/products/${imageObj.image}`;
              return (
                <div class="gallery-item" data-gallery-image data-gallery-index={index}>
                  <img src={imageSrc} alt={`${product.name} - Imagen ${index + 1}`} loading="lazy" />
                  <div class="gallery-overlay">
                    <div class="overlay-icon">
                      <svg width="24" height="24" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v3m0 0v3m0-3h3m-3 0H7"/>
                      </svg>
                    </div>
                    <span class="overlay-text">Ver imagen</span>
                  </div>
                  <span class="gallery-counter">{index + 1}/{images.length}</span>
                </div>
              );
            })}
          </div>
        </section>
      )}

      <!-- 🛍️ También te puede interesar (se muestra solo si hay relacionados) -->
      {relatedProducts.length > 0 && (
        <section class="related-section">
          <div class="gallery-header">
            <div class="header-line"></div>
            <h2 class="gallery-title">También te puede interesar</h2>
            <div class="header-line"></div>
          </div>
          <div class="related-grid">
            {relatedProducts.map((rp: any) => (
              <a href={`/products/${rp.slug}`} class="related-card">
                <div class="related-img">
                  <img src={rp.image} alt={rp.name} loading="lazy" />
                </div>
                <p class="related-name">{rp.name}</p>
                <p class="related-price">{Formatter.currency(rp.price)}</p>
              </a>
            ))}
          </div>
        </section>
      )}
    </div>

    <!-- Lightbox -->
    <div id="lightbox" class="lightbox">
      <div class="lb-backdrop"></div>
      <div class="lb-container">
        <button id="lightbox-close" class="lb-close" aria-label="Cerrar">
          <svg width="24" height="24" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
          </svg>
        </button>
        <button id="lightbox-prev" class="lb-nav prev" aria-label="Anterior">
          <svg width="24" height="24" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
          </svg>
        </button>
        <button id="lightbox-next" class="lb-nav next" aria-label="Siguiente">
          <svg width="24" height="24" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
          </svg>
        </button>
        <div class="lb-content">
          <img id="lightbox-image" src="" alt="" />
          <div class="lb-counter"><span id="lightbox-counter">1 / 1</span></div>
        </div>
      </div>
    </div>

    <!-- Hidden Inputs -->
    <input type="hidden" id="product-id" value={product.id} />
    <input type="hidden" id="product-has-variants" value={`${product.hasVariants}`} />
    <input type="hidden" id="base-price" value={product.price} />
    <input type="hidden" id="base-stock" value={product.stock} />
    <input type="hidden" id="variant-image-map" value={JSON.stringify(Object.fromEntries(variantImageMap))} />
    <input type="hidden" id="general-images" value={JSON.stringify(fullGeneralImages)} />
    <input type="hidden" id="combination-image-map" value={JSON.stringify(Object.fromEntries(combinationImageMap))} />
    <input type="hidden" id="combinations-data" value={JSON.stringify(
      (variantsData?.combinations || []).map((c: any) => ({
        id: c.id, name: c.combinationName, price: c.price, stock: c.stock, sku: c.sku
      }))
    )} />
  </div>
</ProductsLayout>

<style>
  .product-detail-page { position: relative; min-height: 100vh; padding: 0 0 80px; }
  .bg-decoration { position: fixed; inset: 0; pointer-events: none; z-index: 0; }
  .glow { position: absolute; border-radius: 50%; filter: blur(150px); }
  .glow-1 { width: 600px; height: 600px; background: radial-gradient(circle, rgba(234, 179, 8, 0.06) 0%, transparent 70%); top: -100px; right: -100px; }
  .glow-2 { width: 500px; height: 500px; background: radial-gradient(circle, rgba(234, 179, 8, 0.04) 0%, transparent 70%); bottom: 200px; left: -100px; }
  .grid-pattern { position: absolute; inset: 0; background-image: linear-gradient(rgba(255, 255, 255, 0.015) 1px, transparent 1px), linear-gradient(90deg, rgba(255, 255, 255, 0.015) 1px, transparent 1px); background-size: 60px 60px; }

  /* 📣 Announcement bar */
  .announcement-bar { position: relative; z-index: 10; display: flex; align-items: center; justify-content: center; gap: 10px; padding: 10px 16px; margin-bottom: 24px; background: linear-gradient(90deg, rgba(234, 179, 8, 0.12), rgba(245, 158, 11, 0.08), rgba(234, 179, 8, 0.12)); border-bottom: 1px solid rgba(234, 179, 8, 0.2); color: rgba(255, 255, 255, 0.85); font-size: 0.85rem; text-align: center; }
  .announcement-bar svg { color: #eab308; flex-shrink: 0; }
  .announcement-bar strong { color: #eab308; }

  .product-container { position: relative; z-index: 10; max-width: 1400px; margin: 0 auto; padding: 0 24px; }
  .breadcrumb { display: flex; align-items: center; gap: 10px; margin-bottom: 32px; padding: 14px 20px; background: rgba(255, 255, 255, 0.02); border: 1px solid rgba(255, 255, 255, 0.05); border-radius: 14px; animation: fadeIn 0.4s ease-out; }
  .breadcrumb-link { display: flex; align-items: center; gap: 6px; color: rgba(255, 255, 255, 0.5); text-decoration: none; font-size: 0.9rem; font-weight: 500; transition: color 0.2s; }
  .breadcrumb-link:hover { color: #eab308; }
  .breadcrumb-sep { color: rgba(255, 255, 255, 0.2); }
  .breadcrumb-current { color: #fff; font-weight: 600; font-size: 0.9rem; max-width: 200px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .product-grid { display: grid; grid-template-columns: 1.15fr 1fr; gap: 56px; margin-bottom: 80px; }
  .images-column { animation: fadeInLeft 0.6s ease-out; }

  /* 🖼️ Media: miniaturas verticales + principal */
  .media-wrap { display: grid; grid-template-columns: 1fr; gap: 14px; }
.media-wrap.has-thumbs { grid-template-columns: 84px 1fr; }
  .thumbnails-col { display: flex; flex-direction: column; gap: 10px; max-height: 560px; overflow-y: auto; scrollbar-width: thin; }
  .main-image-wrapper { position: relative; border-radius: 20px; overflow: hidden; background: rgba(255, 255, 255, 0.02); border: 1px solid rgba(255, 255, 255, 0.06); height: fit-content; }
  .variant-badge { position: absolute; top: 16px; left: 16px; z-index: 20; display: flex; align-items: center; gap: 8px; padding: 10px 16px; background: rgba(0, 0, 0, 0.7); backdrop-filter: blur(10px); border: 1px solid rgba(234, 179, 8, 0.3); border-radius: 12px; color: #eab308; font-size: 0.8rem; font-weight: 500; }
  .thumb-btn { position: relative; aspect-ratio: 1; width: 100%; border-radius: 10px; overflow: hidden; border: 2px solid rgba(255, 255, 255, 0.1); background: rgba(255, 255, 255, 0.02); cursor: pointer; transition: all 0.25s ease; flex-shrink: 0; }
  .thumb-btn:hover { border-color: rgba(234, 179, 8, 0.6); }
  .thumb-btn img { width: 100%; height: 100%; object-fit: cover; }
  .thumb-more { position: absolute; inset: 0; background: rgba(0, 0, 0, 0.75); display: flex; align-items: center; justify-content: center; color: #fff; font-weight: 700; font-size: 0.9rem; }

  /* 📄 Detalles bajo la imagen (heading + línea, como la referencia) */
  .details-block { margin-top: 40px; display: flex; flex-direction: column; gap: 8px; }
  .det { border-bottom: 1px solid rgba(255, 255, 255, 0.08); }
  .det summary { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 18px 4px; cursor: pointer; list-style: none; user-select: none; }
  .det summary::-webkit-details-marker { display: none; }
  .det-title { font-size: 1.15rem; font-weight: 800; color: #fff; }
  .det-chevron { color: rgba(255, 255, 255, 0.4); transition: transform 0.25s ease; flex-shrink: 0; }
  .det[open] .det-chevron { transform: rotate(180deg); }
  .det-body { padding: 0 4px 22px; }
  .piercing-tags { display: flex; flex-wrap: wrap; gap: 8px; }
  .piercing-tag { display: inline-flex; padding: 8px 16px; background: rgba(59, 130, 246, 0.1); border: 1px solid rgba(59, 130, 246, 0.2); border-radius: 10px; color: #60a5fa; font-size: 0.85rem; font-weight: 500; }
  .product-desc { font-size: 0.95rem; line-height: 1.8; color: rgba(255, 255, 255, 0.65); }

  /* Info column */
  .info-column { animation: fadeInRight 0.6s ease-out; }
  .product-badges { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 14px; }
  .badge { display: inline-flex; align-items: center; gap: 6px; padding: 5px 12px; border-radius: 999px; font-size: 0.7rem; font-weight: 600; letter-spacing: 0.04em; text-transform: uppercase; }
  .badge-category { background: rgba(234, 179, 8, 0.1); border: 1px solid rgba(234, 179, 8, 0.25); color: #eab308; }
  .badge-type { background: rgba(139, 92, 246, 0.1); border: 1px solid rgba(139, 92, 246, 0.25); color: #a78bfa; }

  /* Title serif, como la referencia */
  .product-title { font-size: 2.25rem; font-weight: 900; color: #fff; line-height: 1.15; margin-bottom: 12px; letter-spacing: -0.02em; }

  /* Price simple */
  .price-box { display: flex; align-items: baseline; gap: 8px; margin-bottom: 18px; }
  .price-value { font-size: 1.6rem; font-weight: 700; color: #eab308; letter-spacing: -0.01em; }
  .price-currency { color: rgba(255, 255, 255, 0.35); font-size: 0.85rem; font-weight: 500; }

  /* ⭐ Chips de beneficios (outline compactos) */
  .benefit-chips { display: flex; flex-wrap: wrap; gap: 8px; margin: 0 0 20px; padding: 0; list-style: none; }
  .chip { display: inline-flex; align-items: center; gap: 7px; padding: 7px 13px; border: 1px solid rgba(255, 255, 255, 0.14); border-radius: 8px; font-size: 0.76rem; font-weight: 500; color: rgba(255, 255, 255, 0.75); background: rgba(255, 255, 255, 0.02); }
  .chip svg { color: #eab308; flex-shrink: 0; }

  /* 💳 Línea Mercado Pago */
  .mp-line { margin-bottom: 18px; border: 1px solid rgba(255, 255, 255, 0.08); border-radius: 12px; background: rgba(255, 255, 255, 0.02); }
  .mp-line summary { display: flex; align-items: center; gap: 10px; padding: 12px 14px; cursor: pointer; list-style: none; user-select: none; }
  .mp-line summary::-webkit-details-marker { display: none; }
  .mp-dot { display: flex; align-items: center; justify-content: center; width: 28px; height: 28px; background: rgba(234, 179, 8, 0.15); border-radius: 50%; color: #eab308; flex-shrink: 0; }
  .mp-text { flex: 1; font-size: 0.83rem; color: rgba(255, 255, 255, 0.7); }
  .mp-text strong { color: #fff; }
  .mp-more { font-size: 0.78rem; color: #eab308; text-decoration: underline; white-space: nowrap; }
  .mp-steps { margin: 0; padding: 4px 14px 8px; list-style: none; display: flex; flex-direction: column; gap: 10px; }
  .mp-steps li { display: flex; align-items: flex-start; gap: 10px; }
  .mp-step-num { display: flex; align-items: center; justify-content: center; width: 22px; height: 22px; background: rgba(234, 179, 8, 0.15); border: 1px solid rgba(234, 179, 8, 0.35); border-radius: 50%; color: #eab308; font-size: 0.7rem; font-weight: 800; flex-shrink: 0; }
  .mp-steps p { font-size: 0.82rem; color: rgba(255, 255, 255, 0.6); line-height: 1.5; }
  .mp-steps strong { color: rgba(255, 255, 255, 0.9); }
  .mp-disclaimer { padding: 4px 14px 14px; font-size: 0.7rem; color: rgba(255, 255, 255, 0.35); }

  /* 🟢 Línea de stock con subrayado */
  .stock-line { display: inline-block; margin-bottom: 20px; padding-bottom: 8px; font-size: 0.88rem; font-weight: 600; }
  .stock-line.in { color: #22c55e; border-bottom: 2px solid rgba(34, 197, 94, 0.6); }
  .stock-line.out { color: #ef4444; border-bottom: 2px solid rgba(239, 68, 68, 0.6); }

  /* Variants */
  .variants-section { margin-bottom: 24px; }
  .variant-group { margin-bottom: 18px; }
  .variant-group:last-of-type { margin-bottom: 0; }
  .variant-label { display: block; font-size: 0.88rem; font-weight: 500; color: rgba(255, 255, 255, 0.6); margin-bottom: 10px; text-transform: capitalize; }
  .variant-selected-value { color: #fff; font-weight: 700; margin-left: 6px; }
  .variant-options { display: flex; flex-wrap: wrap; gap: 10px; align-items: center; }

  /* Pills de texto */
  .variant-option { position: relative; display: inline-flex; align-items: center; gap: 8px; padding: 10px 18px; background: rgba(255, 255, 255, 0.03); border: 1.5px solid rgba(255, 255, 255, 0.14); border-radius: 10px; color: #fff; font-size: 0.88rem; font-weight: 600; cursor: pointer; transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1); }
  .variant-option:hover:not(:disabled) { border-color: rgba(234, 179, 8, 0.5); background: rgba(234, 179, 8, 0.06); }
  .variant-option.selected { background: rgba(234, 179, 8, 0.12); border-color: #eab308; color: #fbbf24; }
  .variant-option.out-of-stock { opacity: 0.35; cursor: not-allowed; text-decoration: line-through; }
  .variant-option:focus-visible { outline: 2px solid #eab308; outline-offset: 2px; }

  /* 🎨 Swatches de color (cuadritos, como la referencia) */
  .variant-swatch { padding: 4px; width: 52px; height: 52px; border-radius: 10px; justify-content: center; text-decoration: none !important; }
  .variant-swatch .swatch-color { display: block; width: 100%; height: 100%; border-radius: 7px; border: 1px solid rgba(0, 0, 0, 0.25); }
  .variant-swatch.selected { border-color: #eab308; box-shadow: 0 0 0 3px rgba(234, 179, 8, 0.25); }
  .variant-swatch.out-of-stock { opacity: 0.3; }
  .variant-swatch.out-of-stock::after { content: ''; position: absolute; inset: 6px; background: linear-gradient(to top right, transparent 46%, #ef4444 48%, #ef4444 52%, transparent 54%); border-radius: 7px; }

  .price-adj { font-size: 0.72rem; font-weight: 700; padding: 2px 8px; border-radius: 999px; }
  .price-adj.pos { background: rgba(34, 197, 94, 0.15); color: #22c55e; }
  .price-adj.neg { background: rgba(239, 68, 68, 0.15); color: #ef4444; }
  .variant-info { margin-top: 16px; padding: 14px 16px; background: rgba(234, 179, 8, 0.08); border: 1px solid rgba(234, 179, 8, 0.2); border-radius: 12px; }
  .variant-info.hidden { display: none; }
  .info-row { display: flex; justify-content: space-between; align-items: center; gap: 16px; }
  .info-row > div { display: flex; flex-direction: column; gap: 4px; }
  .info-label { font-size: 0.75rem; color: rgba(255, 255, 255, 0.5); }
  .info-val { font-weight: 700; color: #fff; }
  .info-sku { font-family: monospace; color: rgba(255, 255, 255, 0.6); font-size: 0.85rem; }

  /* Cart */
  .cart-section { padding: 22px; background: rgba(255, 255, 255, 0.02); border: 1px solid rgba(255, 255, 255, 0.06); border-radius: 16px; margin-bottom: 18px; }
  .qty-row { display: flex; justify-content: space-between; align-items: center; margin-bottom: 18px; }
  .qty-label { font-size: 0.9rem; font-weight: 600; color: rgba(255, 255, 255, 0.7); }
  .qty-controls { display: flex; align-items: center; gap: 12px; }
  .qty-btn { width: 42px; height: 42px; display: flex; align-items: center; justify-content: center; background: rgba(255, 255, 255, 0.05); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 10px; color: #fff; cursor: pointer; transition: all 0.2s ease; }
  .qty-btn:hover { background: rgba(234, 179, 8, 0.15); border-color: rgba(234, 179, 8, 0.3); color: #eab308; }
  .qty-input { width: 66px; height: 42px; text-align: center; background: rgba(255, 255, 255, 0.05); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 10px; color: #fff; font-size: 1.05rem; font-weight: 700; }
  .qty-input:focus { outline: none; border-color: #eab308; }
  /* Botón ancho, uppercase, como la referencia */
  .add-btn { width: 100%; display: flex; align-items: center; justify-content: center; gap: 10px; padding: 16px 28px; background: linear-gradient(135deg, #eab308 0%, #f59e0b 100%); border: none; border-radius: 10px; color: #000; font-size: 0.95rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.08em; cursor: pointer; transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1); box-shadow: 0 4px 20px rgba(234, 179, 8, 0.25); }
  .add-btn:hover:not(:disabled) { transform: translateY(-2px); box-shadow: 0 10px 30px rgba(234, 179, 8, 0.35); }
  .add-btn:disabled { background: rgba(255, 255, 255, 0.1); color: rgba(255, 255, 255, 0.4); cursor: not-allowed; box-shadow: none; }
  .msg { margin-top: 14px; padding: 13px 16px; border-radius: 12px; font-size: 0.88rem; font-weight: 500; }
  .msg.hidden { display: none; }
  .msg.info { background: rgba(59, 130, 246, 0.1); border: 1px solid rgba(59, 130, 246, 0.2); color: #60a5fa; }
  .msg.error { background: rgba(239, 68, 68, 0.1); border: 1px solid rgba(239, 68, 68, 0.2); color: #f87171; }
  .msg.success { background: rgba(34, 197, 94, 0.1); border: 1px solid rgba(34, 197, 94, 0.2); color: #22c55e; }
  .tax-note { margin-top: 14px; font-size: 0.8rem; color: rgba(255, 255, 255, 0.45); text-align: center; }
  .tax-link { color: rgba(255, 255, 255, 0.6); text-decoration: underline; }
  .tax-link:hover { color: #eab308; }

  /* 📦 Caja de info apilada con divisores */
  .info-box { border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 14px; overflow: hidden; background: rgba(255, 255, 255, 0.02); }
  .info-box-row { display: flex; align-items: center; gap: 12px; padding: 15px 18px; font-size: 0.85rem; color: rgba(255, 255, 255, 0.7); border-bottom: 1px solid rgba(255, 255, 255, 0.07); }
  .info-box-row:last-child { border-bottom: none; }
  .info-box-row svg { color: #eab308; flex-shrink: 0; }
  .info-box-row.link { text-decoration: none; transition: background 0.2s ease; }
  .info-box-row.link:hover { background: rgba(37, 211, 102, 0.06); }
  .info-box-row.link svg { color: #25d366; }
  .info-box-row.link u { color: rgba(255, 255, 255, 0.9); }

  /* Gallery */
  .gallery-section { padding-top: 48px; border-top: 1px solid rgba(255, 255, 255, 0.06); }
  .gallery-header { display: flex; align-items: center; gap: 24px; margin-bottom: 32px; }
  .header-line { flex: 1; height: 1px; background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.1), transparent); }
  .gallery-title { display: flex; align-items: center; gap: 12px; font-size: 1.25rem; font-weight: 800; color: #fff; white-space: nowrap; }
  .gallery-title svg { color: #eab308; }
  .gallery-grid { display: grid; grid-template-columns: repeat(5, 1fr); gap: 16px; }
  .gallery-item { position: relative; aspect-ratio: 1; border-radius: 16px; overflow: hidden; background: rgba(255, 255, 255, 0.02); border: 1px solid rgba(255, 255, 255, 0.06); cursor: pointer; transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1); }
  .gallery-item:hover { border-color: rgba(234, 179, 8, 0.4); transform: translateY(-6px); }
  .gallery-item img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.5s ease; }
  .gallery-item:hover img { transform: scale(1.1); }
  .gallery-overlay { position: absolute; inset: 0; background: linear-gradient(to top, rgba(0, 0, 0, 0.8) 0%, transparent 60%); opacity: 0; transition: opacity 0.3s ease; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 8px; }
  .gallery-item:hover .gallery-overlay { opacity: 1; }
  .overlay-icon { width: 48px; height: 48px; display: flex; align-items: center; justify-content: center; background: rgba(255, 255, 255, 0.15); border-radius: 50%; color: #fff; }
  .overlay-text { color: #fff; font-size: 0.85rem; font-weight: 600; }
  .gallery-counter { position: absolute; top: 12px; right: 12px; padding: 6px 12px; background: rgba(0, 0, 0, 0.7); border-radius: 20px; color: #fff; font-size: 0.75rem; font-weight: 600; opacity: 0; transition: opacity 0.3s ease; }
  .gallery-item:hover .gallery-counter { opacity: 1; }

  /* 🛍️ Relacionados */
  .related-section { padding-top: 48px; margin-top: 48px; border-top: 1px solid rgba(255, 255, 255, 0.06); }
  .related-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; }
  .related-card { display: block; text-decoration: none; border-radius: 16px; overflow: hidden; background: rgba(255, 255, 255, 0.02); border: 1px solid rgba(255, 255, 255, 0.06); transition: all 0.3s ease; }
  .related-card:hover { border-color: rgba(234, 179, 8, 0.4); transform: translateY(-4px); }
  .related-img { aspect-ratio: 1; overflow: hidden; }
  .related-img img { width: 100%; height: 100%; object-fit: cover; transition: transform 0.4s ease; }
  .related-card:hover .related-img img { transform: scale(1.06); }
  .related-name { padding: 12px 14px 4px; color: #fff; font-size: 0.9rem; font-weight: 600; }
  .related-price { padding: 0 14px 14px; color: #eab308; font-size: 0.95rem; font-weight: 800; }

  /* Lightbox */
  .lightbox { position: fixed; inset: 0; z-index: 100; display: none; align-items: center; justify-content: center; }
  .lightbox.open { display: flex; }
  .lb-backdrop { position: absolute; inset: 0; background: rgba(0, 0, 0, 0.95); backdrop-filter: blur(10px); }
  .lb-container { position: relative; width: 100%; max-width: 1200px; padding: 24px; }
  .lb-close { position: absolute; top: -50px; right: 24px; width: 48px; height: 48px; display: flex; align-items: center; justify-content: center; background: rgba(255, 255, 255, 0.1); border: none; border-radius: 50%; color: #fff; cursor: pointer; transition: all 0.2s ease; z-index: 10; }
  .lb-close:hover { background: rgba(255, 255, 255, 0.2); }
  .lb-nav { position: absolute; top: 50%; transform: translateY(-50%); width: 48px; height: 48px; display: flex; align-items: center; justify-content: center; background: rgba(255, 255, 255, 0.1); border: none; border-radius: 50%; color: #fff; cursor: pointer; transition: all 0.2s ease; z-index: 10; }
  .lb-nav:hover { background: rgba(255, 255, 255, 0.2); }
  .lb-nav.prev { left: 24px; }
  .lb-nav.next { right: 24px; }
  .lb-content { position: relative; }
  .lb-content img { width: 100%; max-height: 80vh; object-fit: contain; border-radius: 16px; }
  .lb-counter { position: absolute; bottom: -40px; left: 50%; transform: translateX(-50%); padding: 8px 20px; background: rgba(255, 255, 255, 0.1); border-radius: 20px; color: #fff; font-size: 0.9rem; font-weight: 600; }

  @keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }
  @keyframes fadeInLeft { from { opacity: 0; transform: translateX(-40px); } to { opacity: 1; transform: translateX(0); } }
  @keyframes fadeInRight { from { opacity: 0; transform: translateX(40px); } to { opacity: 1; transform: translateX(0); } }
  .animate-spin { animation: spin 1s linear infinite; }
  @keyframes spin { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }

  @media (prefers-reduced-motion: reduce) {
    .images-column, .info-column, .breadcrumb { animation: none; }
    .gallery-item, .related-card, .add-btn, .thumb-btn { transition: none; }
  }

  @media (max-width: 1024px) {
    .product-grid { grid-template-columns: 1fr; gap: 40px; }
    .gallery-grid { grid-template-columns: repeat(3, 1fr); }
    .related-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 768px) {
    .product-detail-page { padding-bottom: 60px; }
    .product-title { font-size: 1.9rem; }
    /* Miniaturas horizontales abajo en móvil */
    .media-wrap { grid-template-columns: 1fr; }
    .thumbnails-col { flex-direction: row; order: 2; max-height: none; overflow-x: auto; overflow-y: hidden; padding-bottom: 4px; }
    .thumb-btn { width: 72px; }
    .gallery-grid { grid-template-columns: repeat(2, 1fr); gap: 12px; }
  }
  @media (max-width: 480px) {
    .product-container { padding: 0 16px; }
    .announcement-bar { font-size: 0.75rem; padding: 8px 12px; }
    .breadcrumb { padding: 10px 14px; gap: 6px; font-size: 0.8rem; overflow-x: auto; }
    .breadcrumb-current { max-width: 120px; }
    .product-title { font-size: 1.65rem; }
    .thumb-btn { width: 62px; }
    .chip { padding: 6px 10px; font-size: 0.7rem; }
    .variant-swatch { width: 46px; height: 46px; }
    .related-grid { grid-template-columns: 1fr 1fr; gap: 12px; }
  }
</style>

<script>
  import { itemsInCart } from "@/store";
  import { navigate } from "astro:transitions/client";
  import { CartCookiesClient } from "../../utils/cart-cookies";
  import { actions } from "astro:actions";

  // =====================================================
  // PRODUCT PAGE SCRIPT - Corregido para View Transitions
  // =====================================================

  let isPageInitialized = false;

  function setupProductPage(): void {
    // Evitar inicialización múltiple
    if (isPageInitialized) return;
    
    const productIdInput = document.getElementById("product-id") as HTMLInputElement;
    if (!productIdInput) return;
    
    isPageInitialized = true;

    // Referencias a elementos del DOM
    const qtyInput = document.getElementById("qty-input") as HTMLInputElement;
    const decrementBtn = document.getElementById("qty-decr") as HTMLButtonElement;
    const incrementBtn = document.getElementById("qty-incr") as HTMLButtonElement;
    const addBtn = document.getElementById("add-to-cart") as HTMLButtonElement;
    const hasVariantsInput = document.getElementById("product-has-variants") as HTMLInputElement;
    const baseStockInput = document.getElementById("base-stock") as HTMLInputElement;
    const basePriceInput = document.getElementById("base-price") as HTMLInputElement;
    const variantImageMapInput = document.getElementById("variant-image-map") as HTMLInputElement;
    const generalImagesInput = document.getElementById("general-images") as HTMLInputElement;
    const combinationImageMapInput = document.getElementById("combination-image-map") as HTMLInputElement;
    
    const variantImageMap = variantImageMapInput ? JSON.parse(variantImageMapInput.value) : {};
    const generalImages = generalImagesInput ? JSON.parse(generalImagesInput.value) : [];
    const combinationImageMapData = combinationImageMapInput ? JSON.parse(combinationImageMapInput.value) : {};
    const combinationsDataInput = document.getElementById("combinations-data") as HTMLInputElement;
    const combinationsData = combinationsDataInput ? JSON.parse(combinationsDataInput.value) : [];
    const priceElement = document.getElementById("product-price");
    const stockLine = document.getElementById("stock-badge");
    const variantInfo = document.getElementById("variant-info");
    const selectedCombination = document.getElementById("selected-combination");
    const combinationSku = document.getElementById("combination-sku");
    const variantMessage = document.getElementById("variant-message");

    if (!qtyInput || !addBtn) return;

    const hasVariants = hasVariantsInput?.value === 'true';
    const baseStock = parseInt(baseStockInput?.value || '0');
    const basePrice = parseFloat(basePriceInput?.value || '0');
    
    let currentCombination: any = null;
    let selectedVariants: Record<string, string> = {};
    let isAddingToCart = false;

    // Utilidades
    const formatCurrency = (value: number): string => {
      return new Intl.NumberFormat('es-MX', { style: 'currency', currency: 'MXN' }).format(value);
    };

    function showMessage(message: string, type: 'info' | 'error' | 'success' = 'info'): void {
      if (!variantMessage) return;
      variantMessage.textContent = message;
      variantMessage.className = `msg ${type}`;
      
      const hideTimeout = window.setTimeout(() => {
        variantMessage.classList.add('hidden');
      }, 5000);
      
      (variantMessage as any)._hideTimeout = hideTimeout;
    }

    function updateQuantity(newQty: number): void {
      const maxStock = hasVariants && currentCombination ? currentCombination.stock : baseStock;
      qtyInput.value = Math.max(1, Math.min(maxStock, newQty)).toString();
    }
    
    function updateProductImage(variantId: string | null): void {
      const updateSliderFn = (window as any).updateSliderImages;
      if (typeof updateSliderFn !== 'function') return;
      
      if (!variantId) {
        updateSliderFn('product-main-slider', generalImages);
        return;
      }
      
      const variantImage = variantImageMap[variantId];
      updateSliderFn('product-main-slider', variantImage ? [variantImage] : generalImages);
    }

    function updateCombination(): void {
      if (!hasVariants) return;

      const variantGroups = document.querySelectorAll('.variant-group');

      if (Object.keys(selectedVariants).length < variantGroups.length) {
        addBtn.disabled = true;
        showMessage('Por favor, selecciona una opción para cada variante.', 'info');
        return;
      }

      // Botones seleccionados → construir nombre de combinación (mismo criterio que el servidor)
      const selectedButtons = Object.values(selectedVariants).map(
        (variantId) => document.querySelector(`[data-variant-id="${variantId}"]`) as HTMLElement
      );
      const combinationName = selectedButtons
        .map((b) => b?.dataset.variantValue || '')
        .sort()
        .join(' - ');

      // Buscar localmente (sin llamada al servidor)
      let combo = combinationsData.find((c: any) => c.name === combinationName);

      if (!combo) {
        // Fallback: precio = base + suma de ajustes (igual que getVariantCombination)
        const totalAdjustment = selectedButtons.reduce(
          (sum, b) => sum + (parseFloat(b?.dataset.priceAdjustment || '0') || 0), 0
        );
        const stock = Math.min(...selectedButtons.map((b) => parseInt(b?.dataset.stock || '0') || 0));
        combo = { id: 'calculated', name: combinationName, price: basePrice + totalAdjustment, stock, sku: null };
      }

      currentCombination = {
        id: combo.id,
        combinationName: combo.name,
        price: combo.price,
        stock: combo.stock,
        sku: combo.sku,
      };

      if (priceElement) priceElement.textContent = formatCurrency(combo.price);

      if (stockLine) {
        const isInStock = combo.stock > 0;
        stockLine.className = `stock-line ${isInStock ? 'in' : 'out'}`;
        stockLine.textContent = isInStock
          ? `En stock, listo para ser enviado (${combo.stock} disp.)`
          : 'Agotado temporalmente';
      }

      if (variantInfo && selectedCombination && combinationSku) {
        selectedCombination.textContent = selectedButtons
          .map((b) => b?.dataset.variantValue || '')
          .join(' / ');
        combinationSku.textContent = combo.sku || '-';
        variantInfo.classList.remove('hidden');
      }

      const isOutOfStock = combo.stock <= 0;
      addBtn.disabled = isOutOfStock;
      addBtn.innerHTML = isOutOfStock
        ? '<span>Sin stock disponible</span>'
        : `
          <svg width="20" height="20" fill="currentColor" viewBox="0 0 20 20">
            <path d="M3 1a1 1 0 000 2h1.22l.305 1.222a.997.997 0 00.01.042l1.358 5.43-.893.892C3.74 11.846 4.632 14 6.414 14H15a1 1 0 000-2H6.414l1-1H14a1 1 0 00.894-.553l3-6A1 1 0 0017 3H6.28l-.31-1.243A1 1 0 005 1H3zM16 16.5a1.5 1.5 0 11-3 0 1.5 1.5 0 013 0zM6.5 18a1.5 1.5 0 100-3 1.5 1.5 0 000 3z"/>
          </svg>
          <span>Añadir al carrito</span>`;

      qtyInput.max = combo.stock.toString();
      if (parseInt(qtyInput.value) > combo.stock) {
        qtyInput.value = Math.max(1, combo.stock).toString();
      }

      // Imagen de la combinación si existe
      const comboImage = combinationImageMapData[combo.id];
      const updateSliderFn = (window as any).updateSliderImages;
      if (typeof updateSliderFn === 'function') {
        updateSliderFn('product-main-slider', comboImage ? [comboImage] : generalImages);
      }
    }
    
    function selectVariantOption(button: HTMLElement): void {
      const variantName = button.dataset.variantName;
      const variantId = button.dataset.variantId;
      const variantValue = button.dataset.variantValue;
      const hasImage = button.dataset.hasImage === 'true';
      const group = button.closest('.variant-group');
      
      if (!group || !variantName || !variantId) return;
      
      group.querySelectorAll('.variant-option').forEach(opt => {
        opt.classList.remove('selected');
      });
      
      button.classList.add('selected');
      selectedVariants[variantName] = variantId;

      // ✅ Mostrar el valor seleccionado junto al label (estilo Shopify: "Color: Plateado")
      const selectedValueEl = group.querySelector('.variant-selected-value');
      if (selectedValueEl && variantValue) {
        selectedValueEl.textContent = variantValue;
      }
      
      // Solo actualizar imagen por variante individual si NO hay combinaciones
      // Si hay combinaciones, updateCombination se encarga de la imagen
      const variantGroups = document.querySelectorAll('.variant-group');
      if (variantGroups.length < 2) {
        updateProductImage(hasImage ? variantId : null);
      }
      updateCombination();
    }

    // =====================================================
    // EVENT LISTENERS
    // =====================================================
    
    if (hasVariants) {
      document.querySelectorAll('.variant-option').forEach(button => {
        button.addEventListener('click', () => selectVariantOption(button as HTMLElement));
      });
    }

    decrementBtn?.addEventListener("click", () => updateQuantity(parseInt(qtyInput.value) - 1));
    incrementBtn?.addEventListener("click", () => updateQuantity(parseInt(qtyInput.value) + 1));
    qtyInput?.addEventListener("change", () => updateQuantity(parseInt(qtyInput.value)));

    // Añadir al carrito
    addBtn?.addEventListener("click", async () => {
      if (isAddingToCart) return;
      
      const quantityToAdd = parseInt(qtyInput.value) || 1;
      const productId = productIdInput.value;
      
      if (hasVariants && !currentCombination) {
        showMessage('Por favor, selecciona todas las opciones de variante.', 'error');
        return;
      }
      
      isAddingToCart = true;
      addBtn.disabled = true;
      addBtn.innerHTML = `
        <svg class="animate-spin" width="20" height="20" fill="none" viewBox="0 0 24 24">
          <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
          <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
        </svg>
        <span>Procesando...</span>
      `;
      
      try {
        // Construir item del carrito
        const cartItem: any = {
          productId,
          quantity: quantityToAdd
        };
        
        if (hasVariants && currentCombination) {
          cartItem.combinationId = currentCombination.id;
          cartItem.variantName = currentCombination.combinationName || 
            Object.entries(selectedVariants)
              .map(([name, id]) => {
                const btn = document.querySelector(`[data-variant-id="${id}"]`) as HTMLElement;
                return btn ? `${name}: ${btn.dataset.variantValue}` : '';
              })
              .filter(Boolean)
              .join(' / ');
          
          if (currentCombination.sku) {
            cartItem.variantSku = currentCombination.sku;
          }
          
          cartItem.variantPrice = currentCombination.price;
          
          if (currentCombination.price && currentCombination.price !== basePrice) {
            cartItem.variantPriceAdjustment = currentCombination.price - basePrice;
          }
        }

        // ✅ Agregar datos de personalización si existen
        const custToggle = (document.getElementById('cust-toggle-check') as HTMLInputElement)?.checked;
        const custValuesJson = (document.getElementById('customization-values-json') as HTMLInputElement)?.value;
        
        if (custToggle && custValuesJson) {
          try {
            const custValues = JSON.parse(custValuesJson);
            if (Array.isArray(custValues) && custValues.length > 0) {
              cartItem.customizationValues = custValues;
              
              // Backward compat: si hay un campo de imagen, llenar engraving también
              const imageValue = custValues.find((v: any) => v.type === 'image');
              if (imageValue) {
                cartItem.engraving = {
                  id: imageValue.fieldId,
                  imageUrl: imageValue.value,
                  notes: custValues.filter((v: any) => v.type === 'text').map((v: any) => `${v.label}: ${v.value}`).join(', '),
                };
              }
            }
          } catch {}
        }
        
        // Añadir al carrito
        CartCookiesClient.addItem(cartItem);
        itemsInCart.set(CartCookiesClient.getTotalItems());
        
        showMessage('¡Producto añadido al carrito!', 'success');
        
        window.setTimeout(() => {
          navigate("/cart");
        }, 800);
        
      } catch (error) {
        console.error('Error al añadir al carrito:', error);
        showMessage('Error al añadir el producto', 'error');
        
        isAddingToCart = false;
        addBtn.disabled = false;
        addBtn.innerHTML = `
          <svg width="20" height="20" fill="currentColor" viewBox="0 0 20 20">
            <path d="M3 1a1 1 0 000 2h1.22l.305 1.222a.997.997 0 00.01.042l1.358 5.43-.893.892C3.74 11.846 4.632 14 6.414 14H15a1 1 0 000-2H6.414l1-1H14a1 1 0 00.894-.553l3-6A1 1 0 0017 3H6.28l-.31-1.243A1 1 0 005 1H3zM16 16.5a1.5 1.5 0 11-3 0 1.5 1.5 0 013 0zM6.5 18a1.5 1.5 0 100-3 1.5 1.5 0 000 3z"/>
          </svg>
          <span>Añadir al carrito</span>
        `;
      }
    });

    // =====================================================
    // LIGHTBOX
    // =====================================================
    
    const lightbox = document.getElementById('lightbox');
    const lightboxImage = document.getElementById('lightbox-image') as HTMLImageElement;
    const lightboxCounter = document.getElementById('lightbox-counter');
    const galleryImages = document.querySelectorAll('[data-gallery-image]');
    let currentImageIndex = 0;
    const totalImages = galleryImages.length;

    function openLightbox(index: number): void {
      currentImageIndex = index;
      const item = galleryImages[index] as HTMLElement;
      const img = item.querySelector('img') as HTMLImageElement;
      
      if (lightboxImage && img) {
        lightboxImage.src = img.src;
        lightboxImage.alt = img.alt;
      }
      
      if (lightboxCounter) {
        lightboxCounter.textContent = `${index + 1} / ${totalImages}`;
      }
      
      if (lightbox) {
        lightbox.classList.add('open');
        document.body.style.overflow = 'hidden';
      }
    }

    function closeLightbox(): void {
      if (lightbox) {
        lightbox.classList.remove('open');
        document.body.style.overflow = '';
      }
    }

    function showPrevImage(): void {
      currentImageIndex = (currentImageIndex - 1 + totalImages) % totalImages;
      openLightbox(currentImageIndex);
    }

    function showNextImage(): void {
      currentImageIndex = (currentImageIndex + 1) % totalImages;
      openLightbox(currentImageIndex);
    }

    galleryImages.forEach((item, index) => {
      item.addEventListener('click', () => openLightbox(index));
    });

    // Las miniaturas también abren el lightbox
    document.querySelectorAll('[data-gallery-thumb]').forEach((thumb) => {
      thumb.addEventListener('click', () => {
        const index = parseInt((thumb as HTMLElement).dataset.index || '0');
        if (totalImages > 0) openLightbox(Math.min(index, totalImages - 1));
      });
    });
    
    document.getElementById('lightbox-close')?.addEventListener('click', closeLightbox);
    document.getElementById('lightbox-prev')?.addEventListener('click', showPrevImage);
    document.getElementById('lightbox-next')?.addEventListener('click', showNextImage);
    document.querySelector('.lb-backdrop')?.addEventListener('click', closeLightbox);
    
    function handleKeydown(e: KeyboardEvent): void {
      if (!lightbox?.classList.contains('open')) return;
      
      switch (e.key) {
        case 'Escape':
          closeLightbox();
          break;
        case 'ArrowLeft':
          showPrevImage();
          break;
        case 'ArrowRight':
          showNextImage();
          break;
      }
    }
    
    document.addEventListener('keydown', handleKeydown);

    // =====================================================
    // INICIALIZACIÓN
    // =====================================================
    
    if (hasVariants) {
      // No preseleccionar ninguna combinación
      // El usuario debe elegir manualmente
      addBtn.disabled = true;
      showMessage('Selecciona las opciones para tu producto.', 'info');
    } else {
      addBtn.disabled = baseStock <= 0;
      if (baseStock <= 0) {
        addBtn.innerHTML = '<span>Sin stock disponible</span>';
      }
    }
  }

  // =====================================================
  // LIFECYCLE HOOKS
  // =====================================================

  document.addEventListener('astro:before-preparation', () => {
    isPageInitialized = false;
    document.body.style.overflow = '';
  });

  document.addEventListener("astro:page-load", setupProductPage);
</script>