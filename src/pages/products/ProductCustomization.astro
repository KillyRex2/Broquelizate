---
// =====================================================
// src/components/products/ProductCustomization.astro
// =====================================================
// Componente dinámico de personalización de producto
// Renderiza campos de texto, imagen y selección configurados por el admin

import type { CustomizationField } from '@/utils/customization';
import { parseCustomizationFields } from '@/utils/customization';

interface Props {
  productId: string;
  productName: string;
  customizationFieldsRaw: string;
}

const { productId, productName, customizationFieldsRaw } = Astro.props;
const fields: CustomizationField[] = parseCustomizationFields(customizationFieldsRaw);

// No renderizar nada si no hay campos
if (fields.length === 0) return null;

const hasImageFields = fields.some(f => f.type === 'image');
const hasTextFields = fields.some(f => f.type === 'text');
const hasSelectFields = fields.some(f => f.type === 'select');

// Catálogo de fuentes — debe coincidir con el del admin
const FONT_MAP: Record<string, { family: string; url: string }> = {
  'Elegante': { family: 'Playfair Display', url: 'https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;700&display=swap' },
  'Cursiva': { family: 'Dancing Script', url: 'https://fonts.googleapis.com/css2?family=Dancing+Script:wght@400;700&display=swap' },
  'Moderna': { family: 'Montserrat', url: 'https://fonts.googleapis.com/css2?family=Montserrat:wght@400;700&display=swap' },
  'Clásica': { family: 'Merriweather', url: 'https://fonts.googleapis.com/css2?family=Merriweather:wght@400;700&display=swap' },
  'Máquina de Escribir': { family: 'Courier Prime', url: 'https://fonts.googleapis.com/css2?family=Courier+Prime:wght@400;700&display=swap' },
  'Básica': { family: 'Open Sans', url: 'https://fonts.googleapis.com/css2?family=Open+Sans:wght@400;700&display=swap' },
  'Manuscrita': { family: 'Caveat', url: 'https://fonts.googleapis.com/css2?family=Caveat:wght@400;700&display=swap' },
  'Art Déco': { family: 'Poiret One', url: 'https://fonts.googleapis.com/css2?family=Poiret+One&display=swap' },
  'Minimalista': { family: 'Quicksand', url: 'https://fonts.googleapis.com/css2?family=Quicksand:wght@400;700&display=swap' },
  'Romántica': { family: 'Great Vibes', url: 'https://fonts.googleapis.com/css2?family=Great+Vibes&display=swap' },
  'Gótica': { family: 'UnifrakturMaguntia', url: 'https://fonts.googleapis.com/css2?family=UnifrakturMaguntia&display=swap' },
  'Delicada': { family: 'Sacramento', url: 'https://fonts.googleapis.com/css2?family=Sacramento&display=swap' },
  'Negrita': { family: 'Oswald', url: 'https://fonts.googleapis.com/css2?family=Oswald:wght@400;700&display=swap' },
  'Infantil': { family: 'Patrick Hand', url: 'https://fonts.googleapis.com/css2?family=Patrick+Hand&display=swap' },
  'Serif Fina': { family: 'Cormorant Garamond', url: 'https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;700&display=swap' },
  'Grabado': { family: 'Cinzel', url: 'https://fonts.googleapis.com/css2?family=Cinzel:wght@400;700&display=swap' },
};

// Recolectar fuentes necesarias para precargar
const fontsToLoad = new Set<string>();
fields.filter(f => f.type === 'select' && f.options).forEach(f => {
  f.options!.forEach(opt => {
    if (FONT_MAP[opt]) fontsToLoad.add(FONT_MAP[opt].url);
  });
});
---

{/* Precargar Google Fonts necesarias */}
{Array.from(fontsToLoad).map(url => (
  <link rel="stylesheet" href={url} />
))}

<div class="customization-section" id="customization-section" data-product-id={productId}>
  <!-- Header -->
  <div class="cust-header">
    <div class="cust-icon-wrap">
      <svg width="24" height="24" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"/>
      </svg>
    </div>
    <div class="cust-title-group">
      <h3 class="cust-title">Personaliza tu producto</h3>
      <p class="cust-subtitle">{fields.length} {fields.length === 1 ? 'campo disponible' : 'campos disponibles'}</p>
    </div>
    <label class="cust-toggle">
      <input type="checkbox" id="cust-toggle-check" />
      <span class="toggle-track">
        <span class="toggle-thumb"></span>
      </span>
      <span class="toggle-label">Personalizar</span>
    </label>
  </div>

  <!-- Contenido colapsable -->
  <div id="cust-content" class="cust-content collapsed">
    
    <!-- Info banner -->
    <div class="cust-info-banner">
      <svg width="18" height="18" fill="currentColor" viewBox="0 0 20 20">
        <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd"/>
      </svg>
      <div>
        <p class="info-main">Completa los campos para personalizar tu pieza.</p>
        <p class="info-sub">Los campos marcados con <span class="req-star">*</span> son obligatorios.</p>
      </div>
    </div>

    <!-- Campos dinámicos -->
    <div class="cust-fields" id="cust-fields">
      {fields.map((field, index) => (
        <div 
          class="cust-field" 
          data-field-id={field.id} 
          data-field-type={field.type}
          data-field-required={field.required ? 'true' : 'false'}
          data-field-index={index}
        >
          <label class="cust-field-label">
            {field.type === 'text' && (
              <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
              </svg>
            )}
            {field.type === 'image' && (
              <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
              </svg>
            )}
            {field.type === 'select' && (
              <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 10h16M4 14h16M4 18h16"/>
              </svg>
            )}
            <span>{field.label}</span>
            {field.required && <span class="req-star">*</span>}
          </label>

          {/* Campo de texto */}
          {field.type === 'text' && (
            <div class="text-field-wrap">
              <input 
                type="text" 
                class="cust-text-input" 
                data-field-id={field.id}
                placeholder={field.placeholder || 'Escribe aquí...'}
                maxlength={field.maxLength || 100}
              />
              <div class="text-field-meta">
                <span class="char-counter">
                  <span class="char-current" data-counter-for={field.id}>0</span>/{field.maxLength || 100}
                </span>
              </div>
            </div>
          )}

          {/* Campo de imagen */}
          {field.type === 'image' && (
            <div class="image-field-wrap" data-field-id={field.id}>
              <div class="img-drop-zone" data-drop-for={field.id}>
                <input 
                  type="file" 
                  class="img-file-input" 
                  data-field-id={field.id}
                  accept={field.accept?.join(',') || 'image/jpeg,image/png,image/webp,image/gif'}
                />
                <div class="img-empty-state" data-empty-for={field.id}>
                  <div class="img-upload-icon">
                    <svg width="36" height="36" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                    </svg>
                  </div>
                  <p class="img-upload-text">Arrastra o <button type="button" class="img-browse-btn" data-browse-for={field.id}>selecciona imagen</button></p>
                  <p class="img-upload-formats">
                    {(field.accept || ['image/jpeg','image/png','image/webp','image/gif']).map(t => t.split('/')[1]?.toUpperCase()).join(', ')} · Máx. {field.maxSize || 10}MB
                  </p>
                </div>
                <div class="img-loading-state hidden" data-loading-for={field.id}>
                  <svg class="spin-icon" width="32" height="32" fill="none" viewBox="0 0 24 24">
                    <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                    <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                  </svg>
                  <p>Subiendo imagen...</p>
                </div>
              </div>
              <div class="img-preview hidden" data-preview-for={field.id}>
                <div class="img-preview-thumb">
                  <img data-preview-img-for={field.id} src="" alt="Vista previa" />
                  <div class="img-preview-badge">
                    <svg width="12" height="12" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>
                    Lista
                  </div>
                </div>
                <div class="img-preview-info">
                  <span class="img-file-name" data-filename-for={field.id}>imagen.jpg</span>
                  <span class="img-file-size" data-filesize-for={field.id}>2.4 MB</span>
                  <div class="img-preview-actions">
                    <button type="button" class="img-change-btn" data-change-for={field.id}>
                      <svg width="14" height="14" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg>
                      Cambiar
                    </button>
                    <button type="button" class="img-remove-btn" data-remove-for={field.id}>
                      <svg width="14" height="14" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
                      Eliminar
                    </button>
                  </div>
                </div>
              </div>
            </div>
          )}

          {/* Campo de selección — con preview de fuente si aplica */}
          {field.type === 'select' && field.options && (
            <div class="select-field-wrap">
              <div class="select-options" data-select-for={field.id}>
                {field.options.map(option => {
                  const fontInfo = FONT_MAP[option];
                  const isFont = !!fontInfo;
                  return (
                    <button 
                      type="button" 
                      class={`select-option-btn ${isFont ? 'has-font-preview' : ''}`}
                      data-field-id={field.id}
                      data-option-value={option}
                      data-font-family={isFont ? fontInfo.family : ''}
                    >
                      <span class="select-dot"></span>
                      <span class="select-option-content">
                        <span class="select-option-name">{option}</span>
                        {isFont && (
                          <span 
                            class="select-font-preview" 
                            style={`font-family: '${fontInfo.family}', cursive;`}
                          >
                            Texto de ejemplo — Abc 123
                          </span>
                        )}
                      </span>
                    </button>
                  );
                })}
              </div>
            </div>
          )}

          <p class="field-error hidden" data-error-for={field.id}></p>
        </div>
      ))}
    </div>

    {/* Tips solo si hay campos de imagen */}
    {hasImageFields && (
      <div class="cust-tips">
        <h4 class="tips-title">
          <svg width="16" height="16" fill="currentColor" viewBox="0 0 20 20">
            <path d="M11 3a1 1 0 10-2 0v1a1 1 0 102 0V3zM15.657 5.757a1 1 0 00-1.414-1.414l-.707.707a1 1 0 001.414 1.414l.707-.707zM18 10a1 1 0 01-1 1h-1a1 1 0 110-2h1a1 1 0 011 1zM5.05 6.464A1 1 0 106.464 5.05l-.707-.707a1 1 0 00-1.414 1.414l.707.707zM5 10a1 1 0 01-1 1H3a1 1 0 110-2h1a1 1 0 011 1zM8 16v-1h4v1a2 2 0 11-4 0zM12 14c.015-.34.208-.646.477-.859a4 4 0 10-4.954 0c.27.213.462.519.476.859h4.002z"/>
          </svg>
          Consejos para imágenes
        </h4>
        <div class="tips-grid">
          <div class="tip-item"><div class="tip-icon good"><svg width="14" height="14" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg></div><span>Imágenes nítidas y bien iluminadas</span></div>
          <div class="tip-item"><div class="tip-icon good"><svg width="14" height="14" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg></div><span>Alto contraste entre sujeto y fondo</span></div>
          <div class="tip-item"><div class="tip-icon bad"><svg width="14" height="14" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd"/></svg></div><span>Evita imágenes borrosas o pixeladas</span></div>
          <div class="tip-item"><div class="tip-icon bad"><svg width="14" height="14" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd"/></svg></div><span>Evita fondos complejos o saturados</span></div>
        </div>
      </div>
    )}
  </div>

  <!-- Hidden inputs para el carrito -->
  <input type="hidden" id="customization-values-json" value="[]" />
  <input type="hidden" id="customization-fields-config" value={JSON.stringify(fields)} />
</div>

<style>
  /* =====================================================
     CUSTOMIZATION SECTION — Premium Dark Theme
     ===================================================== */
  .customization-section { margin-bottom: 28px; border-radius: 20px; overflow: hidden; background: rgba(255,255,255,0.02); border: 1px solid rgba(255,255,255,0.06); transition: border-color 0.4s ease; }
  .customization-section:has(#cust-toggle-check:checked) { border-color: rgba(234,179,8,0.3); background: rgba(234,179,8,0.02); }

  /* --- Header --- */
  .cust-header { display: flex; align-items: center; gap: 14px; padding: 20px 24px; }
  .cust-icon-wrap { width: 46px; height: 46px; display: flex; align-items: center; justify-content: center; background: linear-gradient(135deg, rgba(234,179,8,0.15), rgba(245,158,11,0.08)); border: 1px solid rgba(234,179,8,0.25); border-radius: 14px; color: #eab308; flex-shrink: 0; }
  .cust-title-group { flex: 1; min-width: 0; }
  .cust-title { font-size: 1.05rem; font-weight: 700; color: #fff; margin: 0; }
  .cust-subtitle { font-size: 0.8rem; color: rgba(255,255,255,0.45); margin: 2px 0 0; }

  /* --- Toggle --- */
  .cust-toggle { display: flex; align-items: center; gap: 10px; cursor: pointer; flex-shrink: 0; }
  .cust-toggle input { position: absolute; opacity: 0; width: 0; height: 0; }
  .toggle-track { position: relative; width: 48px; height: 26px; background: rgba(255,255,255,0.1); border: 1px solid rgba(255,255,255,0.15); border-radius: 13px; transition: all 0.3s cubic-bezier(0.4,0,0.2,1); }
  .toggle-thumb { position: absolute; top: 2px; left: 2px; width: 20px; height: 20px; background: rgba(255,255,255,0.6); border-radius: 50%; transition: all 0.3s cubic-bezier(0.4,0,0.2,1); }
  .cust-toggle input:checked ~ .toggle-track { background: rgba(234,179,8,0.3); border-color: rgba(234,179,8,0.5); }
  .cust-toggle input:checked ~ .toggle-track .toggle-thumb { left: 24px; background: #eab308; box-shadow: 0 0 12px rgba(234,179,8,0.5); }
  .toggle-label { font-size: 0.8rem; font-weight: 600; color: rgba(255,255,255,0.5); transition: color 0.3s; display: none; }
  .cust-toggle input:checked ~ .toggle-label { color: #eab308; }

  /* --- Collapsible --- */
  .cust-content { padding: 0 24px 24px; max-height: 3000px; opacity: 1; transition: all 0.5s cubic-bezier(0.4,0,0.2,1); overflow: hidden; }
  .cust-content.collapsed { max-height: 0; padding-top: 0; padding-bottom: 0; opacity: 0; pointer-events: none; }

  /* --- Info Banner --- */
  .cust-info-banner { display: flex; gap: 12px; padding: 14px 18px; background: rgba(234,179,8,0.06); border: 1px solid rgba(234,179,8,0.15); border-radius: 14px; margin-bottom: 20px; }
  .cust-info-banner svg { color: #eab308; flex-shrink: 0; margin-top: 1px; }
  .info-main { font-size: 0.85rem; font-weight: 600; color: rgba(255,255,255,0.8); margin: 0; }
  .info-sub { font-size: 0.78rem; color: rgba(255,255,255,0.45); margin: 4px 0 0; }
  .req-star { color: #ef4444; font-weight: 700; }

  /* --- Fields --- */
  .cust-fields { display: flex; flex-direction: column; gap: 20px; }
  .cust-field { padding: 18px 20px; background: rgba(255,255,255,0.025); border: 1px solid rgba(255,255,255,0.08); border-radius: 16px; transition: border-color 0.3s; }
  .cust-field:focus-within { border-color: rgba(234,179,8,0.3); }
  .cust-field-label { display: flex; align-items: center; gap: 8px; font-size: 0.9rem; font-weight: 600; color: rgba(255,255,255,0.75); margin-bottom: 12px; }
  .cust-field-label svg { color: #eab308; flex-shrink: 0; }

  /* --- Text Fields --- */
  .text-field-wrap { position: relative; }
  .cust-text-input { width: 100%; padding: 14px 16px; background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.12); border-radius: 12px; color: #fff; font-size: 0.95rem; font-family: inherit; transition: all 0.3s; }
  .cust-text-input::placeholder { color: rgba(255,255,255,0.25); }
  .cust-text-input:focus { outline: none; border-color: rgba(234,179,8,0.5); background: rgba(255,255,255,0.06); }
  .text-field-meta { display: flex; justify-content: flex-end; margin-top: 6px; }
  .char-counter { font-size: 0.7rem; color: rgba(255,255,255,0.25); }

  /* --- Image Fields --- */
  .image-field-wrap { position: relative; }
  .img-drop-zone { position: relative; border: 2px dashed rgba(255,255,255,0.12); border-radius: 14px; background: rgba(255,255,255,0.015); transition: all 0.3s; cursor: pointer; overflow: hidden; }
  .img-drop-zone.drag-over { border-color: #eab308; background: rgba(234,179,8,0.05); transform: scale(1.01); }
  .img-drop-zone.has-error { border-color: #ef4444; background: rgba(239,68,68,0.05); }
  .img-file-input { position: absolute; opacity: 0; width: 0; height: 0; }
  .img-empty-state { display: flex; flex-direction: column; align-items: center; padding: 32px 20px; text-align: center; }
  .img-upload-icon { width: 64px; height: 64px; display: flex; align-items: center; justify-content: center; background: linear-gradient(135deg, rgba(234,179,8,0.08), rgba(234,179,8,0.03)); border: 1px solid rgba(234,179,8,0.15); border-radius: 18px; color: #eab308; margin-bottom: 12px; transition: transform 0.3s; }
  .img-drop-zone:hover .img-upload-icon { transform: translateY(-3px); }
  .img-upload-text { font-size: 0.88rem; color: rgba(255,255,255,0.6); margin: 0 0 8px; }
  .img-browse-btn { background: none; border: none; color: #eab308; font-weight: 700; cursor: pointer; text-decoration: underline; text-underline-offset: 2px; font-size: inherit; font-family: inherit; }
  .img-browse-btn:hover { color: #fbbf24; }
  .img-upload-formats { font-size: 0.72rem; color: rgba(255,255,255,0.25); margin: 0; }
  .img-loading-state { display: flex; flex-direction: column; align-items: center; padding: 32px 20px; text-align: center; color: rgba(255,255,255,0.6); font-size: 0.85rem; }
  .img-loading-state.hidden { display: none; }
  .spin-icon { animation: cust-spin 1s linear infinite; color: #eab308; margin-bottom: 10px; }
  @keyframes cust-spin { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }

  /* --- Image Preview --- */
  .img-preview { display: flex; gap: 14px; padding: 14px; background: rgba(34,197,94,0.05); border: 1px solid rgba(34,197,94,0.2); border-radius: 14px; animation: cust-fadeIn 0.4s ease-out; }
  .img-preview.hidden { display: none; }
  @keyframes cust-fadeIn { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: translateY(0); } }
  .img-preview-thumb { position: relative; width: 80px; height: 80px; flex-shrink: 0; border-radius: 10px; overflow: hidden; border: 2px solid rgba(34,197,94,0.3); }
  .img-preview-thumb img { width: 100%; height: 100%; object-fit: cover; }
  .img-preview-badge { position: absolute; bottom: 0; left: 0; right: 0; display: flex; align-items: center; justify-content: center; gap: 3px; padding: 3px; background: rgba(34,197,94,0.9); color: #fff; font-size: 0.6rem; font-weight: 700; }
  .img-preview-info { flex: 1; display: flex; flex-direction: column; justify-content: center; gap: 4px; min-width: 0; }
  .img-file-name { font-size: 0.82rem; font-weight: 600; color: #fff; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .img-file-size { font-size: 0.7rem; color: rgba(255,255,255,0.4); }
  .img-preview-actions { display: flex; gap: 8px; margin-top: 6px; }
  .img-change-btn, .img-remove-btn { display: inline-flex; align-items: center; gap: 5px; padding: 5px 12px; border-radius: 8px; font-size: 0.72rem; font-weight: 600; cursor: pointer; transition: all 0.2s; border: 1px solid; background: none; }
  .img-change-btn { border-color: rgba(59,130,246,0.2); color: #60a5fa; }
  .img-change-btn:hover { background: rgba(59,130,246,0.15); border-color: rgba(59,130,246,0.4); }
  .img-remove-btn { border-color: rgba(239,68,68,0.2); color: #f87171; }
  .img-remove-btn:hover { background: rgba(239,68,68,0.15); border-color: rgba(239,68,68,0.4); }

  /* --- Select Fields with Font Preview --- */
  .select-options { display: flex; flex-direction: column; gap: 10px; }
  .select-option-btn { position: relative; display: flex; align-items: center; gap: 12px; padding: 14px 16px; background: rgba(255,255,255,0.03); border: 2px solid rgba(255,255,255,0.08); border-radius: 14px; color: rgba(255,255,255,0.8); font-size: 0.9rem; font-weight: 500; cursor: pointer; transition: all 0.25s cubic-bezier(0.4,0,0.2,1); text-align: left; font-family: inherit; width: 100%; }
  .select-option-btn:hover { background: rgba(255,255,255,0.05); border-color: rgba(234,179,8,0.3); transform: translateY(-1px); }
  .select-option-btn.selected { background: rgba(234,179,8,0.1); border-color: #eab308; color: #fff; }
  .select-option-btn.selected .select-font-preview { color: rgba(255,255,255,0.7); }
  .select-dot { width: 18px; height: 18px; border: 2px solid rgba(255,255,255,0.2); border-radius: 50%; flex-shrink: 0; position: relative; transition: all 0.2s; }
  .select-option-btn.selected .select-dot { border-color: #eab308; background: #eab308; }
  .select-option-btn.selected .select-dot::after { content: ''; position: absolute; top: 50%; left: 50%; transform: translate(-50%,-50%); width: 7px; height: 7px; background: #000; border-radius: 50%; }
  
  .select-option-content { display: flex; flex-direction: column; gap: 4px; flex: 1; min-width: 0; }
  .select-option-name { font-size: 0.85rem; font-weight: 600; color: rgba(255,255,255,0.85); }
  .select-font-preview { font-size: 1.15rem; color: rgba(255,255,255,0.45); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; line-height: 1.4; transition: color 0.2s; }

  /* Non-font select: grid layout */
  .select-options:not(:has(.has-font-preview)) { display: grid; grid-template-columns: repeat(2, 1fr); }
  .select-option-btn:not(.has-font-preview) .select-option-content { flex-direction: row; align-items: center; }

  /* --- Field Error --- */
  .field-error { font-size: 0.78rem; color: #f87171; margin: 8px 0 0; padding: 0 4px; }
  .field-error.hidden { display: none; }

  /* --- Tips --- */
  .cust-tips { padding: 16px 18px; background: rgba(255,255,255,0.02); border: 1px solid rgba(255,255,255,0.05); border-radius: 14px; margin-top: 20px; }
  .tips-title { display: flex; align-items: center; gap: 8px; font-size: 0.85rem; font-weight: 700; color: rgba(255,255,255,0.6); margin: 0 0 12px; }
  .tips-title svg { color: #eab308; }
  .tips-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
  .tip-item { display: flex; align-items: center; gap: 8px; }
  .tip-icon { width: 22px; height: 22px; display: flex; align-items: center; justify-content: center; border-radius: 6px; flex-shrink: 0; }
  .tip-icon.good { background: rgba(34,197,94,0.15); color: #22c55e; }
  .tip-icon.bad { background: rgba(239,68,68,0.15); color: #ef4444; }
  .tip-item span { font-size: 0.75rem; color: rgba(255,255,255,0.5); line-height: 1.3; }

  /* --- Responsive --- */
  @media (max-width: 768px) {
    .cust-header { flex-wrap: wrap; padding: 16px 18px; gap: 12px; }
    .cust-toggle { width: 100%; justify-content: space-between; padding-top: 12px; border-top: 1px solid rgba(255,255,255,0.06); }
    .toggle-label { display: block; }
    .cust-content { padding: 0 18px 18px; }
    .img-preview { flex-direction: column; align-items: center; text-align: center; }
    .img-preview-actions { justify-content: center; }
    .tips-grid { grid-template-columns: 1fr; }
    .select-font-preview { font-size: 1rem; }
    .select-options:not(:has(.has-font-preview)) { grid-template-columns: 1fr; }
  }
</style>

<script>
  import { actions } from "astro:actions";
  import type { CustomizationField, CustomizationValue } from "@/utils/customization";

  function setupCustomization(): void {
    const section = document.getElementById('customization-section');
    if (!section) return;
    if (section.hasAttribute('data-cust-init')) return;
    section.setAttribute('data-cust-init', 'true');

    const productId = section.dataset.productId || '';
    const toggleCheck = document.getElementById('cust-toggle-check') as HTMLInputElement;
    const content = document.getElementById('cust-content');
    const valuesInput = document.getElementById('customization-values-json') as HTMLInputElement;
    const configInput = document.getElementById('customization-fields-config') as HTMLInputElement;

    if (!toggleCheck || !content || !valuesInput || !configInput) return;

    let fields: CustomizationField[] = [];
    try { fields = JSON.parse(configInput.value); } catch { fields = []; }

    const values: Record<string, CustomizationValue> = {};
    const uploadedImages: Record<string, string> = {};
    let isUploading = false;

    // --- Toggle ---
    toggleCheck.addEventListener('change', () => {
      content.classList.toggle('collapsed', !toggleCheck.checked);
    });

    // --- Sync ---
    function syncValues(): void {
      const arr = Object.values(values).filter(v => v.value.trim() !== '');
      valuesInput.value = JSON.stringify(arr);
    }

    // --- TEXT FIELDS ---
    document.querySelectorAll('.cust-text-input').forEach(input => {
      const el = input as HTMLInputElement;
      const fieldId = el.dataset.fieldId!;
      const field = fields.find(f => f.id === fieldId);
      if (!field) return;

      el.addEventListener('input', () => {
        const counter = document.querySelector(`[data-counter-for="${fieldId}"]`);
        if (counter) counter.textContent = el.value.length.toString();
        values[fieldId] = { fieldId, label: field.label, type: 'text', value: el.value };
        syncValues();
      });
    });

    // --- SELECT FIELDS ---
    document.querySelectorAll('.select-option-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const el = btn as HTMLElement;
        const fieldId = el.dataset.fieldId!;
        const optionValue = el.dataset.optionValue!;
        const field = fields.find(f => f.id === fieldId);
        if (!field) return;

        const container = el.closest('.select-options');
        container?.querySelectorAll('.select-option-btn').forEach(b => b.classList.remove('selected'));
        el.classList.add('selected');

        values[fieldId] = { fieldId, label: field.label, type: 'select', value: optionValue };
        syncValues();
      });
    });

    // --- IMAGE FIELDS ---
    fields.filter(f => f.type === 'image').forEach(field => {
      const dropZone = document.querySelector(`[data-drop-for="${field.id}"]`) as HTMLElement;
      const fileInput = document.querySelector(`.img-file-input[data-field-id="${field.id}"]`) as HTMLInputElement;
      const emptyState = document.querySelector(`[data-empty-for="${field.id}"]`) as HTMLElement;
      const loadingState = document.querySelector(`[data-loading-for="${field.id}"]`) as HTMLElement;
      const preview = document.querySelector(`[data-preview-for="${field.id}"]`) as HTMLElement;
      const previewImg = document.querySelector(`[data-preview-img-for="${field.id}"]`) as HTMLImageElement;
      const fileNameEl = document.querySelector(`[data-filename-for="${field.id}"]`) as HTMLElement;
      const fileSizeEl = document.querySelector(`[data-filesize-for="${field.id}"]`) as HTMLElement;
      const browseBtn = document.querySelector(`[data-browse-for="${field.id}"]`) as HTMLElement;
      const changeBtn = document.querySelector(`[data-change-for="${field.id}"]`) as HTMLElement;
      const removeBtn = document.querySelector(`[data-remove-for="${field.id}"]`) as HTMLElement;

      if (!dropZone || !fileInput) return;

      browseBtn?.addEventListener('click', (e) => { e.preventDefault(); e.stopPropagation(); fileInput.click(); });
      changeBtn?.addEventListener('click', () => fileInput.click());

      dropZone.addEventListener('click', (e) => {
        if ((e.target as HTMLElement).closest('button')) return;
        if (isUploading) return;
        fileInput.click();
      });

      const prevent = (e: Event) => { e.preventDefault(); e.stopPropagation(); };
      ['dragenter','dragover','dragleave','drop'].forEach(ev => dropZone.addEventListener(ev, prevent));
      ['dragenter','dragover'].forEach(ev => dropZone.addEventListener(ev, () => dropZone.classList.add('drag-over')));
      ['dragleave','drop'].forEach(ev => dropZone.addEventListener(ev, () => dropZone.classList.remove('drag-over')));
      dropZone.addEventListener('drop', (e: DragEvent) => {
        const files = e.dataTransfer?.files;
        if (files && files.length > 0) handleImageFile(field, files[0]);
      });

      fileInput.addEventListener('change', () => {
        if (fileInput.files && fileInput.files.length > 0) handleImageFile(field, fileInput.files[0]);
      });

      removeBtn?.addEventListener('click', async () => {
        if (uploadedImages[field.id]) {
          try { await actions.deleteCustomizationImage({ imageUrl: uploadedImages[field.id] }); } catch {}
          delete uploadedImages[field.id];
        }
        delete values[field.id];
        syncValues();
        if (dropZone) dropZone.style.display = '';
        emptyState?.classList.remove('hidden');
        loadingState?.classList.add('hidden');
        preview?.classList.add('hidden');
        if (fileInput) fileInput.value = '';
      });

      async function handleImageFile(field: CustomizationField, file: File): Promise<void> {
        if (isUploading) return;

        const allowedTypes = field.accept || ['image/jpeg','image/png','image/webp','image/gif'];
        if (!allowedTypes.includes(file.type)) {
          showFieldError(field.id, `Formato no soportado. Usa: ${allowedTypes.map(t => t.split('/')[1]?.toUpperCase()).join(', ')}`);
          return;
        }
        const maxBytes = (field.maxSize || 10) * 1024 * 1024;
        if (file.size > maxBytes) {
          showFieldError(field.id, `La imagen no debe superar ${field.maxSize || 10}MB`);
          return;
        }

        if (uploadedImages[field.id]) {
          try { await actions.deleteCustomizationImage({ imageUrl: uploadedImages[field.id] }); } catch {}
        }

        isUploading = true;
        emptyState?.classList.add('hidden');
        loadingState?.classList.remove('hidden');

        try {
          const formData = new FormData();
          formData.append('productId', productId);
          formData.append('fieldId', field.id);
          formData.append('imageFile', file);

          const { data, error } = await actions.uploadCustomizationImage(formData);
          if (error || !data) throw new Error(error?.message || 'Error desconocido');

          uploadedImages[field.id] = data.imageUrl;
          values[field.id] = { fieldId: field.id, label: field.label, type: 'image', value: data.imageUrl };
          syncValues();

          if (dropZone) dropZone.style.display = 'none';
          loadingState?.classList.add('hidden');
          preview?.classList.remove('hidden');
          if (previewImg) previewImg.src = data.imageUrl;
          if (fileNameEl) fileNameEl.textContent = file.name;
          if (fileSizeEl) fileSizeEl.textContent = `${(file.size / 1024 / 1024).toFixed(2)} MB`;

        } catch (err: any) {
          console.error('Error uploading customization image:', err);
          showFieldError(field.id, err.message || 'Error al subir imagen');
          emptyState?.classList.remove('hidden');
          loadingState?.classList.add('hidden');
        } finally {
          isUploading = false;
          if (fileInput) fileInput.value = '';
        }
      }
    });

    function showFieldError(fieldId: string, message: string): void {
      const errorEl = document.querySelector(`[data-error-for="${fieldId}"]`) as HTMLElement;
      if (errorEl) {
        errorEl.textContent = message;
        errorEl.classList.remove('hidden');
        setTimeout(() => errorEl.classList.add('hidden'), 5000);
      }
    }
  }

  document.addEventListener('astro:page-load', setupCustomization);
  document.addEventListener('astro:before-preparation', () => {
    const section = document.getElementById('customization-section');
    section?.removeAttribute('data-cust-init');
  });
</script>
