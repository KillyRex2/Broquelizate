                </svg>
                <span>Miembro desde {memberSince}</span>
              </div>
            )}
          </div>
        </div>
      </div>
    </div>

    <!-- Estadísticas -->
    <div class="stats-grid">
      <div class="stat-card">
        <div class="stat-icon orders">
          <svg width="24" height="24" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"/>
          </svg>
        </div>
        <div class="stat-content">
          <span class="stat-value">{stats.totalOrders}</span>
          <span class="stat-label">Pedidos totales</span>
        </div>
      </div>
      
      <div class="stat-card">
        <div class="stat-icon spent">
          <svg width="24" height="24" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
          </svg>
        </div>
        <div class="stat-content">
          <span class="stat-value">${stats.totalSpent.toLocaleString('es-MX', { minimumFractionDigits: 0 })}</span>
          <span class="stat-label">Total gastado</span>
        </div>
      </div>
      
      <div class="stat-card">
        <div class="stat-icon pending">
          <svg width="24" height="24" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
          </svg>
        </div>
        <div class="stat-content">
          <span class="stat-value">{stats.pendingOrders}</span>
          <span class="stat-label">En proceso</span>
        </div>
      </div>
      
      <div class="stat-card">
        <div class="stat-icon delivered">
          <svg width="24" height="24" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
          </svg>
        </div>
        <div class="stat-content">
          <span class="stat-value">{stats.deliveredOrders}</span>
          <span class="stat-label">Entregados</span>
        </div>
      </div>
    </div>

    <!-- Contenido principal -->
    <div class="profile-content">
      <!-- Información personal -->
      <div class="profile-section">
        <div class="section-header">
          <div class="section-title">
            <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
            </svg>
            <h2>Información Personal</h2>
          </div>
          <button class="edit-btn" data-section="personal">
            <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"/>
            </svg>
            Editar
          </button>
        </div>
        
        <div class="info-grid" id="personal-info">
          <div class="info-item">
            <label>Nombre completo</label>
            <p>{userName}</p>
          </div>
          <div class="info-item">
            <label>Correo electrónico</label>
            <p>{userEmail}</p>
          </div>
          <div class="info-item">
            <label>Teléfono</label>
            <p>{userPhone || 'No registrado'}</p>
          </div>
        </div>

        <!-- Formulario de edición (oculto por defecto) -->
        <form class="edit-form hidden" id="personal-form">
          <div class="form-grid">
            <div class="form-group">
              <label for="edit-name">Nombre completo</label>
              <input type="text" id="edit-name" name="name" value={userName} required />
            </div>
            <div class="form-group">
              <label for="edit-email">Correo electrónico</label>
              <input type="email" id="edit-email" name="email" value={userEmail} disabled />
              <span class="form-hint">El correo no se puede cambiar</span>
            </div>
            <div class="form-group">
              <label for="edit-phone">Teléfono</label>
              <input type="tel" id="edit-phone" name="phone" value={userPhone || ''} placeholder="10 dígitos" />
            </div>
          </div>
          <div class="form-actions">
            <button type="button" class="btn-cancel" data-section="personal">Cancelar</button>
            <button type="submit" class="btn-save">
              <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
              </svg>
              Guardar cambios
            </button>
          </div>
        </form>
      </div>

      <!-- Dirección de envío -->
      <div class="profile-section">
        <div class="section-header">
          <div class="section-title">
            <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
            </svg>
            <h2>Dirección de Envío</h2>
          </div>
          <button class="edit-btn" data-section="address">
            <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"/>
            </svg>
