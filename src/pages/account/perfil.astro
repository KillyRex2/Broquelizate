---
// src/pages/account/perfil.astro
import MainLayout from '@/layouts/MainLayout.astro';
import { db, orders } from 'astro:db';
import { eq } from 'drizzle-orm';

// El middleware ya verificó la autenticación y trae los datos completos
const { user } = Astro.locals;

// Parsear dirección de envío si existe
let shippingAddress = null;
if (user?.shippingAddress) {
  try {
    shippingAddress = typeof user.shippingAddress === 'string' 
      ? JSON.parse(user.shippingAddress) 
      : user.shippingAddress;
  } catch (e) {
    console.warn('Error parseando dirección:', e);
  }
}

// Obtener estadísticas del usuario
let stats = {
  totalOrders: 0,
  totalSpent: 0,
  pendingOrders: 0,
  deliveredOrders: 0
};

try {
  const ordersData = await db
    .select()
    .from(orders)
    .where(eq(orders.customerEmail, user!.email))
    .all();
  
  stats.totalOrders = ordersData.length;
  stats.totalSpent = ordersData.reduce((acc, order) => acc + (order.total || 0), 0);
  stats.pendingOrders = ordersData.filter(o => 
    o.status === 'pending' || o.status === 'processing'
  ).length;
  stats.deliveredOrders = ordersData.filter(o => 
    o.status === 'delivered' || o.status === 'completed'
  ).length;
} catch (e) {
  console.error('Error obteniendo estadísticas:', e);
}

// Formatear fecha de registro
const createdAtDate = user?.createdAt;
let memberSince: string | null = null;
if (createdAtDate) {
  try {
    const date = new Date(createdAtDate);
    if (!isNaN(date.getTime())) {
      memberSince = date.toLocaleDateString('es-MX', { year: 'numeric', month: 'long' });
    }
  } catch (e) {
    console.warn('Error formateando fecha:', e);
  }
}

// Datos del usuario
const userName = user?.name || 'Usuario';
const userEmail = user?.email || '';
const userPhone = user?.phone || null;

// Función para obtener iniciales
function getInitials(name: string): string {
  if (!name) return 'U';
  return name
    .split(' ')
    .filter(word => word.length > 0)
    .map(word => word[0])
    .join('')
    .toUpperCase()
    .slice(0, 2);
}
---

<MainLayout title="Mi Perfil - Broquelizate">
  <div class="profile-container">
    <!-- Header del perfil -->
    <div class="profile-header">
      <div class="profile-header-bg"></div>
      <div class="profile-header-content">
        <div class="avatar-section">
          <div class="avatar">
            <span class="avatar-initials">{getInitials(userName)}</span>
            <button class="avatar-edit" title="Cambiar foto">
              <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24">
