                <option value="Baja California" selected={shippingAddress?.state === 'Baja California'}>Baja California</option>
                <option value="Baja California Sur" selected={shippingAddress?.state === 'Baja California Sur'}>Baja California Sur</option>
                <option value="Campeche" selected={shippingAddress?.state === 'Campeche'}>Campeche</option>
                <option value="Chiapas" selected={shippingAddress?.state === 'Chiapas'}>Chiapas</option>
                <option value="Chihuahua" selected={shippingAddress?.state === 'Chihuahua'}>Chihuahua</option>
                <option value="Ciudad de México" selected={shippingAddress?.state === 'Ciudad de México'}>Ciudad de México</option>
                <option value="Coahuila" selected={shippingAddress?.state === 'Coahuila'}>Coahuila</option>
                <option value="Colima" selected={shippingAddress?.state === 'Colima'}>Colima</option>
                <option value="Durango" selected={shippingAddress?.state === 'Durango'}>Durango</option>
                <option value="Estado de México" selected={shippingAddress?.state === 'Estado de México'}>Estado de México</option>
                <option value="Guanajuato" selected={shippingAddress?.state === 'Guanajuato'}>Guanajuato</option>
                <option value="Guerrero" selected={shippingAddress?.state === 'Guerrero'}>Guerrero</option>
                <option value="Hidalgo" selected={shippingAddress?.state === 'Hidalgo'}>Hidalgo</option>
                <option value="Jalisco" selected={shippingAddress?.state === 'Jalisco'}>Jalisco</option>
                <option value="Michoacán" selected={shippingAddress?.state === 'Michoacán'}>Michoacán</option>
                <option value="Morelos" selected={shippingAddress?.state === 'Morelos'}>Morelos</option>
                <option value="Nayarit" selected={shippingAddress?.state === 'Nayarit'}>Nayarit</option>
                <option value="Nuevo León" selected={shippingAddress?.state === 'Nuevo León'}>Nuevo León</option>
                <option value="Oaxaca" selected={shippingAddress?.state === 'Oaxaca'}>Oaxaca</option>
                <option value="Puebla" selected={shippingAddress?.state === 'Puebla'}>Puebla</option>
