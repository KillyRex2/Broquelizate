            <div class="form-group full">
              <label for="edit-street">Calle y número</label>
              <input type="text" id="edit-street" name="streetAddress" value={shippingAddress?.streetAddress || shippingAddress?.street || ''} placeholder="Ej: Av. Principal #123" required />
            </div>
            <div class="form-group">
              <label for="edit-colony">Colonia</label>
              <input type="text" id="edit-colony" name="colony" value={shippingAddress?.colony || shippingAddress?.district || ''} placeholder="Ej: Centro" required />
            </div>
            <div class="form-group">
