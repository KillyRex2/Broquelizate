---
// src/pages/admin/products/index.astro
import ProductImage from "@/components/products/ProductImage.astro";
import Pagination from "@/components/shared/Pagination.astro";
import AdminLayout from "@/layouts/AdminLayout.astro";
import { Formatter } from "@/utils";
import { actions } from "astro:actions";
import FilterBar from '@/components/admin/FilterBar.astro';

const searchParams = Astro.url.searchParams;

// Parámetros de filtros
const pageParam = Number(searchParams.get('page') ?? 1);
const searchParam = searchParams.get('search') ?? '';
const categoryParam = searchParams.get('category') ?? 'all';
const stockFilterParam = searchParams.get('stockFilter') ?? 'all';
const sortByParam = searchParams.get('sortBy') ?? 'name';
const sortOrderParam = searchParams.get('sortOrder') ?? 'asc';
const minPriceParam = Number(searchParams.get('minPrice') ?? 0);
const maxPriceParam = Number(searchParams.get('maxPrice') ?? 99999);

// Petición para los productos de la página actual
const { data: pageData, error: pageError } = await Astro.callAction(
  actions.getProductsByPage,
  { 
    page: pageParam,
    search: searchParam,
    category: categoryParam,
    stockFilter: stockFilterParam,
    sortBy: sortByParam,
    sortOrder: sortOrderParam,
    minPrice: minPriceParam,
    maxPrice: maxPriceParam,
  }
);

// Petición para las estadísticas del inventario
const { data: stats, error: statsError } = await Astro.callAction(actions.getInventoryStats, {});

// Obtener todas las categorías para pasarlas al filtro
const { data: allProductsForCategories = [] } = await Astro.callAction(actions.getAllProductsWithImages, undefined);
const allCategories = Array.from(new Set(allProductsForCategories.map(p => p.category).filter(Boolean)));

// Si alguna de las peticiones falla, redirige
if (pageError || statsError) {
  return Astro.redirect('/');
}

const { products, totalPages, totalItems } = pageData;

// Función para generar URL de ordenamiento
function getSortUrl(column: string) {
  const url = new URL(Astro.url);
  const currentSort = sortByParam;
  const currentOrder = sortOrderParam;
  
  if (currentSort === column) {
    url.searchParams.set('sortOrder', currentOrder === 'asc' ? 'desc' : 'asc');
  } else {
    url.searchParams.set('sortBy', column);
    url.searchParams.set('sortOrder', 'asc');
  }
  url.searchParams.set('page', '1');
  return url.toString();
}

// Obtener icono de ordenamiento
function getSortIcon(column: string) {
  if (sortByParam !== column) return 'neutral';
  return sortOrderParam === 'asc' ? 'asc' : 'desc';
}
---
<AdminLayout title="Inventario de Joyas">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 py-8 space-y-8">

    <!-- Header -->
    <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
      <div>
        <h1 class="text-3xl font-bold text-white flex items-center gap-3">
          <span class="p-2 bg-gradient-to-br from-yellow-400 to-orange-500 rounded-xl shadow-lg">
            <svg class="w-7 h-7 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/>
            </svg>
          </span>
          Inventario de Joyas
        </h1>
        <p class="text-gray-400 mt-2">Controla y gestiona tu catálogo de productos</p>
      </div>
      <a 
        href="/admin/products/new" 
        class="group inline-flex items-center justify-center w-full sm:w-auto bg-gradient-to-r from-yellow-400 to-yellow-500 text-black px-6 py-3.5 rounded-xl font-bold shadow-lg hover:shadow-xl hover:from-yellow-500 hover:to-orange-500 transition-all duration-300 active:scale-95"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2 group-hover:rotate-90 transition-transform duration-300" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M10 5a1 1 0 011 1v3h3a1 1 0 110 2h-3v3a1 1 0 11-2 0v-3H6a1 1 0 110-2h3V6a1 1 0 011-1z" clip-rule="evenodd" />
        </svg>
        <span>Agregar Joya</span>
      </a>
    </div>

    <!-- Estadísticas -->
    {stats && (
      <div>
        <h2 class="text-lg font-semibold text-gray-300 mb-4 flex items-center gap-2">
          <svg class="w-5 h-5 text-yellow-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/>
          </svg>
          Resumen del Inventario
        </h2>
        <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-4">
          <div class="stat-card group">
            <div class="stat-icon bg-gradient-to-br from-emerald-400 to-emerald-600">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
              </svg>
            </div>
            <div>
              <p class="stat-label">Valor en stock</p>
              <p class="stat-value text-emerald-400">{Formatter.currency(stats.totalValue)}</p>
            </div>
          </div>
          
          <div class="stat-card group">
            <div class="stat-icon bg-gradient-to-br from-blue-400 to-blue-600">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z"/>
              </svg>
            </div>
            <div>
              <p class="stat-label">Costo de stock</p>
              <p class="stat-value text-blue-400">{Formatter.currency(stats.totalCost)}</p>
            </div>
          </div>
          
          <div class="stat-card group">
            <div class="stat-icon bg-gradient-to-br from-green-400 to-green-600">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"/>
              </svg>
            </div>
            <div>
              <p class="stat-label">Ganancia estimada</p>
              <p class="stat-value text-green-400">{Formatter.currency(stats.estimatedProfit)}</p>
            </div>
          </div>
          
          <div class="stat-card group">
            <div class="stat-icon bg-gradient-to-br from-orange-400 to-orange-600">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/>
              </svg>
            </div>
            <div>
              <p class="stat-label">Stock bajo</p>
              <p class="stat-value text-orange-400">{stats.lowStockCount} <span class="text-sm font-normal text-gray-500">productos</span></p>
            </div>
          </div>
          
          <div class="stat-card group">
            <div class="stat-icon bg-gradient-to-br from-red-400 to-red-600">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728A9 9 0 015.636 5.636m12.728 12.728L5.636 5.636"/>
              </svg>
            </div>
            <div>
              <p class="stat-label">Sin stock</p>
              <p class="stat-value text-red-400">{stats.outOfStockCount} <span class="text-sm font-normal text-gray-500">productos</span></p>
            </div>
          </div>
        </div>
      </div>
    )}

    <!-- Tabla de productos -->
    <div class="bg-white rounded-2xl shadow-xl overflow-hidden border border-gray-100">
      <!-- Filtros -->
      <div class="p-5 border-b border-gray-100 bg-gray-50/50">
        <FilterBar 
          categories={allCategories}
          initialSearch={searchParam}
          initialCategory={categoryParam}
          initialStockFilter={stockFilterParam}
          initialSortBy={sortByParam}
          initialSortOrder={sortOrderParam}
          initialMinPrice={minPriceParam}
          initialMaxPrice={maxPriceParam}
          totalResults={totalItems || 0}
        />
      </div>
      
      <!-- Tabla -->
      <div class="overflow-x-auto">
        <table class="min-w-full">
          <thead class="bg-gradient-to-r from-yellow-50 to-orange-50 border-b border-yellow-100">
            <tr>
              <th class="text-left text-xs font-semibold text-yellow-800 uppercase tracking-wider px-6 py-4">
                Imagen
              </th>
              <th class="text-left text-xs font-semibold text-yellow-800 uppercase tracking-wider px-6 py-4">
                <a href={getSortUrl('name')} class="sort-header group">
                  <span>Producto</span>
                  <span class="sort-icon" data-sort={getSortIcon('name')}>
                    {getSortIcon('name') === 'asc' && (
                      <svg class="w-4 h-4 text-yellow-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 15l7-7 7 7"/>
                      </svg>
                    )}
                    {getSortIcon('name') === 'desc' && (
                      <svg class="w-4 h-4 text-yellow-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                      </svg>
                    )}
                    {getSortIcon('name') === 'neutral' && (
                      <svg class="w-4 h-4 text-gray-400 opacity-0 group-hover:opacity-100 transition-opacity" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16V4m0 0L3 8m4-4l4 4m6 0v12m0 0l4-4m-4 4l-4-4"/>
                      </svg>
                    )}
                  </span>
                </a>
              </th>
              <th class="text-left text-xs font-semibold text-yellow-800 uppercase tracking-wider px-6 py-4">
                <a href={getSortUrl('category')} class="sort-header group">
                  <span>Categoría</span>
                  <span class="sort-icon" data-sort={getSortIcon('category')}>
                    {getSortIcon('category') === 'asc' && (
                      <svg class="w-4 h-4 text-yellow-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 15l7-7 7 7"/>
                      </svg>
                    )}
                    {getSortIcon('category') === 'desc' && (
                      <svg class="w-4 h-4 text-yellow-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                      </svg>
                    )}
                    {getSortIcon('category') === 'neutral' && (
                      <svg class="w-4 h-4 text-gray-400 opacity-0 group-hover:opacity-100 transition-opacity" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16V4m0 0L3 8m4-4l4 4m6 0v12m0 0l4-4m-4 4l-4-4"/>
                      </svg>
                    )}
                  </span>
                </a>
              </th>
              <th class="text-left text-xs font-semibold text-yellow-800 uppercase tracking-wider px-6 py-4">
                <a href={getSortUrl('stock')} class="sort-header group">
                  <span>Stock</span>
                  <span class="sort-icon" data-sort={getSortIcon('stock')}>
                    {getSortIcon('stock') === 'asc' && (
                      <svg class="w-4 h-4 text-yellow-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 15l7-7 7 7"/>
                      </svg>
                    )}
                    {getSortIcon('stock') === 'desc' && (
                      <svg class="w-4 h-4 text-yellow-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                      </svg>
                    )}
                    {getSortIcon('stock') === 'neutral' && (
                      <svg class="w-4 h-4 text-gray-400 opacity-0 group-hover:opacity-100 transition-opacity" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16V4m0 0L3 8m4-4l4 4m6 0v12m0 0l4-4m-4 4l-4-4"/>
                      </svg>
                    )}
                  </span>
                </a>
              </th>
              <th class="text-left text-xs font-semibold text-yellow-800 uppercase tracking-wider px-6 py-4">
                <a href={getSortUrl('price')} class="sort-header group">
                  <span>Precio</span>
                  <span class="sort-icon" data-sort={getSortIcon('price')}>
                    {getSortIcon('price') === 'asc' && (
                      <svg class="w-4 h-4 text-yellow-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 15l7-7 7 7"/>
                      </svg>
                    )}
                    {getSortIcon('price') === 'desc' && (
                      <svg class="w-4 h-4 text-yellow-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
                      </svg>
                    )}
                    {getSortIcon('price') === 'neutral' && (
                      <svg class="w-4 h-4 text-gray-400 opacity-0 group-hover:opacity-100 transition-opacity" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 16V4m0 0L3 8m4-4l4 4m6 0v12m0 0l4-4m-4 4l-4-4"/>
                      </svg>
                    )}
                  </span>
                </a>
              </th>
              <th class="text-left text-xs font-semibold text-yellow-800 uppercase tracking-wider px-6 py-4">
                Acciones
              </th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100">
            {products.length === 0 ? (
              <tr>
                <td colspan="6" class="px-6 py-16 text-center">
                  <div class="flex flex-col items-center justify-center">
                    <div class="w-20 h-20 bg-gray-100 rounded-full flex items-center justify-center mb-4">
                      <svg class="w-10 h-10 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 13V6a2 2 0 00-2-2H6a2 2 0 00-2 2v7m16 0v5a2 2 0 01-2 2H6a2 2 0 01-2-2v-5m16 0h-2.586a1 1 0 00-.707.293l-2.414 2.414a1 1 0 01-.707.293h-3.172a1 1 0 01-.707-.293l-2.414-2.414A1 1 0 006.586 13H4"/>
                      </svg>
                    </div>
                    <h3 class="text-lg font-semibold text-gray-700 mb-1">No se encontraron productos</h3>
                    <p class="text-gray-500 mb-4">Intenta con otros filtros o agrega nuevos productos</p>
                    <a href="/admin/products/new" class="px-4 py-2 bg-yellow-500 text-black font-medium rounded-lg hover:bg-yellow-600 transition-colors">
                      Agregar producto
                    </a>
                  </div>
                </td>
              </tr>
            ) : (
              products.map((product, index) => (
                <tr 
                  id={`product-row-${product.id}`} 
                  class="group hover:bg-yellow-50/50 transition-colors duration-200"
                  style={`animation: fadeIn 0.3s ease ${index * 0.05}s both;`}
                >
                  <td class="px-6 py-4">
                    {product.images && product.images.length > 0 && product.images[0] !== 'no-image.png' ? (
                      <div class="relative">
                        <ProductImage 
                          src={product.images[0]} 
                          alt={product.name} 
                          className="h-16 w-16 object-contain rounded-xl shadow-sm border border-gray-100 bg-white p-1 group-hover:shadow-md transition-shadow" 
                        />
                        {product.images.length > 1 && (
                          <span class="absolute -bottom-1 -right-1 w-5 h-5 bg-gray-700 text-white text-[10px] font-bold rounded-full flex items-center justify-center">
                            +{product.images.length - 1}
                          </span>
                        )}
                      </div>
                    ) : (
                      <div class="flex items-center justify-center h-16 w-16 bg-gray-100 rounded-xl border-2 border-dashed border-gray-200">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-gray-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-6-6h.01" />
                        </svg>
                      </div>
                    )}
                  </td>
                  <td class="px-6 py-4">
                    <a 
                      href={`/admin/products/${product.slug}`} 
                      class="text-gray-800 font-semibold hover:text-yellow-600 transition-colors line-clamp-2"
                    >
                      {product.name}
                    </a>
                    {product.description && (
                      <p class="text-xs text-gray-500 mt-1 line-clamp-1">{product.description}</p>
                    )}
                  </td>
                  <td class="px-6 py-4">
                    <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold bg-gradient-to-r from-yellow-100 to-orange-100 text-yellow-800 border border-yellow-200">
                      {product.category || 'Sin categoría'}
                    </span>
                  </td>
                  <td class="px-6 py-4">
                    {product.stock === 0 && (
                      <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full text-xs font-bold bg-red-100 text-red-700 border border-red-200">
                        <span class="w-2 h-2 bg-red-500 rounded-full animate-pulse"></span>
                        Agotado
                      </span>
                    )}
                    {product.stock > 0 && product.stock <= 5 && (
                      <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full text-xs font-bold bg-orange-100 text-orange-700 border border-orange-200">
                        <span class="w-2 h-2 bg-orange-500 rounded-full"></span>
                        {product.stock} ud
                      </span>
                    )}
                    {product.stock > 5 && product.stock <= 20 && (
                      <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full text-xs font-bold bg-green-100 text-green-700 border border-green-200">
                        <span class="w-2 h-2 bg-green-500 rounded-full"></span>
                        {product.stock} ud
                      </span>
                    )}
                    {product.stock > 20 && (
                      <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full text-xs font-bold bg-blue-100 text-blue-700 border border-blue-200">
                        <span class="w-2 h-2 bg-blue-500 rounded-full"></span>
                        {product.stock} ud
                      </span>
                    )}
                  </td>
                  <td class="px-6 py-4">
                    <span class="text-lg font-bold text-gray-900">
                      {Formatter.currency(product.price)}
                    </span>
                    {product.cost && product.cost > 0 && (
                      <p class="text-xs text-gray-500 mt-0.5">
                        Costo: {Formatter.currency(product.cost)}
                      </p>
                    )}
                  </td>
                  <td class="px-6 py-4">
                    <div class="flex items-center gap-1">
                      <a 
                        href={`/admin/products/${product.slug}`} 
                        class="action-btn bg-yellow-100 text-yellow-700 hover:bg-yellow-200" 
                        title="Editar"
                      >
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="currentColor" viewBox="0 0 20 20">
                          <path d="M13.586 3.586a2 2 0 112.828 2.828l-.793.793-2.828-2.828.793-.793zM11.38 5.793L3 14.172V17h2.828l8.38-8.379-2.828-2.828z" />
                        </svg>
                      </a>
                      <a 
                        href={`/products/${product.slug}`} 
                        target="_blank"
                        class="action-btn bg-blue-100 text-blue-700 hover:bg-blue-200" 
                        title="Ver en tienda"
                      >
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
                        </svg>
                      </a>
                      <button 
                        type="button"
                        class="action-btn bg-red-100 text-red-600 hover:bg-red-200 delete-btn"
                        title="Eliminar"
                        data-product-id={product.id}
                        data-product-name={product.name}
                      >
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="currentColor" viewBox="0 0 20 20">
                          <path fill-rule="evenodd" d="M9 2a1 1 0 00-.894.553L7.382 4H4a1 1 0 000 2v10a2 2 0 002 2h8a2 2 0 002-2V6a1 1 0 100-2h-3.382l-.724-1.447A1 1 0 0011 2H9zM7 8a1 1 0 012 0v6a1 1 0 11-2 0V8zm5-1a1 1 0 00-1 1v6a1 1 0 102 0V8a1 1 0 00-1-1z" clip-rule="evenodd" />
                        </svg>
                      </button>
                    </div>
                  </td>
                </tr>
              ))
            )}
          </tbody>
        </table>
      </div>
      
      <!-- Paginación -->
      {totalPages > 1 && (
        <div class="px-6 py-4 bg-gray-50 border-t border-gray-100">
          <Pagination 
            totalPages={totalPages} 
            currentPage={pageParam} 
            queryParams={{ 
              search: searchParam, 
              category: categoryParam,
              stockFilter: stockFilterParam,
              sortBy: sortByParam,
              sortOrder: sortOrderParam,
              minPrice: String(minPriceParam),
              maxPrice: String(maxPriceParam),
            }} 
          />
        </div>
      )}
    </div>
  </div>

  <!-- ✅ SCRIPT 1: Solo guardar filtros (is:inline - SIN imports) -->
  <script is:inline>
    (function() {
      var FILTERS_STORAGE_KEY = 'admin_products_filters';
      
      function saveCurrentFilters() {
        var url = new URL(window.location.href);
        var filters = {
          search: url.searchParams.get('search') || '',
          category: url.searchParams.get('category') || 'all',
          stockFilter: url.searchParams.get('stockFilter') || 'all',
          sortBy: url.searchParams.get('sortBy') || 'name',
          sortOrder: url.searchParams.get('sortOrder') || 'asc',
          minPrice: url.searchParams.get('minPrice') || '0',
          maxPrice: url.searchParams.get('maxPrice') || '99999',
          page: url.searchParams.get('page') || '1'
        };
        
        console.log('📦 GUARDANDO filtros:', filters);
        sessionStorage.setItem(FILTERS_STORAGE_KEY, JSON.stringify(filters));
      }
      
      // Ejecutar inmediatamente
      saveCurrentFilters();
      
      // También ejecutar en navegación con View Transitions
      document.addEventListener('astro:page-load', function() {
        if (window.location.pathname === '/admin/products') {
          saveCurrentFilters();
        }
      });
    })();
  </script>

  <!-- ✅ SCRIPT 2: Funcionalidad de eliminar (CON imports) -->
  <script>
    import { Confirm, Alert, Toast } from '@/utils/alerts';
    import { actions } from 'astro:actions';

    function initDeleteButtons() {
      const deleteButtons = document.querySelectorAll('.delete-btn');

      deleteButtons.forEach(btn => {
        // Evitar múltiples listeners
        if (btn.hasAttribute('data-listener-attached')) return;
        btn.setAttribute('data-listener-attached', 'true');
        
        btn.addEventListener('click', async (e) => {
          const button = e.currentTarget as HTMLButtonElement;
          const id = button.dataset.productId;
          const name = button.dataset.productName;

          if (!id || !name) return;

          const confirmed = await Confirm.show({
            title: '¿Eliminar producto?',
            message: `¿Seguro que quieres eliminar "${name}"? Esta acción no se puede deshacer.`,
            confirmText: 'Sí, eliminar',
            cancelText: 'Cancelar',
            type: 'danger'
          });

          if (!confirmed) return;

          const loadingId = Toast.loading('Eliminando producto...');

          const { data, error } = await actions.deleteProduct({ id });

          Toast.dismiss(loadingId);

          if (error) {
            await Alert.error('Error', error.message || 'No se pudo eliminar el producto.');
            return;
          }

          if (data?.success) {
            const row = document.getElementById(`product-row-${id}`);
            if (row) {
              row.style.transition = 'all 0.4s ease';
              row.style.opacity = '0';
              row.style.transform = 'translateX(20px)';
              setTimeout(() => row.remove(), 400);
            }
            
            Toast.success('¡Eliminado!', `${name} fue eliminado correctamente.`);
          }
        });
      });
    }

    // Inicializar
    document.addEventListener('astro:page-load', initDeleteButtons);
    if (document.readyState === 'complete' || document.readyState === 'interactive') {
      initDeleteButtons();
    }
  </script>

