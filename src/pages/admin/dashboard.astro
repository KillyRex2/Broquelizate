---
// src/pages/admin/index.astro
import AdminLayout from '@/layouts/AdminLayout.astro';
import StatsGrid from '@/components/admin/StatsGrid.astro';
import RevenueChart from '@/components/admin/RevenueChart.astro';
import RecentOrders from '@/components/admin/RecentOrders.astro';
import TopProducts from '@/components/admin/TopProducts.astro';
import ActivityFeed from '@/components/admin/ActivityFeed.astro';
import SalesByCategory from '@/components/admin/SalesByPaymentMethod.astro';

const pageTitle = "Panel de Administración";

// Fecha formateada
const now = new Date();
const dateOptions: Intl.DateTimeFormatOptions = { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' };
const formattedDate = now.toLocaleDateString('es-MX', dateOptions);
// Capitalizar primera letra
const displayDate = formattedDate.charAt(0).toUpperCase() + formattedDate.slice(1);
---

<AdminLayout title={pageTitle}>
  <div class="dashboard-wrapper">
    <!-- Ambient background -->
    <div class="dashboard-bg">
      <div class="bg-orb bg-orb-1"></div>
      <div class="bg-orb bg-orb-2"></div>
      <div class="bg-grid"></div>
    </div>

    <div class="relative z-10 p-4 sm:p-6 lg:p-8 space-y-8 max-w-[1600px] mx-auto">
      
      <!-- HEADER -->
      <header class="dashboard-header">
        <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center gap-5">
          <div>
            <div class="flex items-center gap-3">
              <div class="header-icon">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 5a1 1 0 011-1h14a1 1 0 011 1v2a1 1 0 01-1 1H5a1 1 0 01-1-1V5zM4 13a1 1 0 011-1h6a1 1 0 011 1v6a1 1 0 01-1 1H5a1 1 0 01-1-1v-6zM16 13a1 1 0 011-1h2a1 1 0 011 1v6a1 1 0 01-1 1h-2a1 1 0 01-1-1v-6z"/>
                </svg>
              </div>
              <div>
                <h1 class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight">Dashboard</h1>
                <p class="text-sm text-gray-400 mt-0.5 flex items-center gap-2">
                  <svg class="w-4 h-4 text-yellow-500/70" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M6 2a1 1 0 00-1 1v1H4a2 2 0 00-2 2v10a2 2 0 002 2h12a2 2 0 002-2V6a2 2 0 00-2-2h-1V3a1 1 0 10-2 0v1H7V3a1 1 0 00-1-1zm0 5a1 1 0 000 2h8a1 1 0 100-2H6z" clip-rule="evenodd"/>
                  </svg>
                  {displayDate}
                </p>
              </div>
            </div>
          </div>
          
          <div class="flex items-center gap-3 w-full sm:w-auto">
            <a href="/admin/products/new" class="btn-gold w-full sm:w-auto">
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
                <path d="M10 5a1 1 0 011 1v3h3a1 1 0 110 2h-3v3a1 1 0 11-2 0v-3H6a1 1 0 110-2h3V6a1 1 0 011-1z"/>
              </svg>
              <span>Nuevo Producto</span>
            </a>
            <a href="/admin/sale" class="btn-ghost">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z"/>
              </svg>
              <span class="hidden sm:inline">POS</span>
            </a>
          </div>
        </div>
      </header>

      <!-- STATS GRID -->
      <section class="animate-section" style="animation-delay: 0.1s;">
        <StatsGrid />
      </section>
      
      <!-- MAIN CONTENT GRID -->
      <div class="grid grid-cols-1 xl:grid-cols-3 gap-6 lg:gap-8">
        
        <!-- Columna Principal -->
        <div class="xl:col-span-2 space-y-6 lg:space-y-8">
          
          <!-- Revenue Chart -->
          <section class="dashboard-card animate-section" style="animation-delay: 0.2s;">
            <div class="card-header">
              <div class="flex items-center gap-3">
                <div class="card-icon bg-emerald-500/10 text-emerald-400">
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"/>
                  </svg>
                </div>
                <div>
                  <h2 class="card-title">Ingresos</h2>
                  <p class="text-xs text-gray-500 mt-0.5">Rendimiento de ventas</p>
                </div>
              </div>
              <div class="period-tabs">
                <button class="period-tab active" data-period="week">Semana</button>
                <button class="period-tab" data-period="month">Mes</button>
                <button class="period-tab" data-period="year">Año</button>
              </div>
            </div>
            <div class="card-body">
              <RevenueChart />
            </div>
          </section>
          
          <!-- Recent Orders -->
          <section class="dashboard-card animate-section" style="animation-delay: 0.3s;">
            <div class="card-header">
              <div class="flex items-center gap-3">
                <div class="card-icon bg-blue-500/10 text-blue-400">
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01"/>
                  </svg>
                </div>
                <div>
                  <h2 class="card-title">Órdenes Recientes</h2>
                  <p class="text-xs text-gray-500 mt-0.5">Últimas transacciones</p>
                </div>
              </div>
              <a href="/admin/orders" class="view-all-link">
                <span>Ver todas</span>
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                </svg>
              </a>
            </div>
            <div class="card-body">
              <RecentOrders />
            </div>
          </section>
        </div>
        
        <!-- Columna Lateral -->
        <div class="space-y-6 lg:space-y-8">
          
          <!-- Sales by Category -->
          <section class="dashboard-card animate-section" style="animation-delay: 0.25s;">
            <div class="card-header">
              <div class="flex items-center gap-3">
                <div class="card-icon bg-amber-500/10 text-amber-400">
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 3.055A9.001 9.001 0 1020.945 13H11V3.055z"/>
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.488 9H15V3.512A9.025 9.025 0 0120.488 9z"/>
                  </svg>
                </div>
                <div>
                  <h2 class="card-title">Ventas por Categoría</h2>
                  <p class="text-xs text-gray-500 mt-0.5">Distribución de materiales</p>
                </div>
              </div>
            </div>
            <div class="card-body">
              <SalesByCategory />
            </div>
          </section>
          <!-- Activity Feed -->
          <section class="dashboard-card animate-section" style="animation-delay: 0.3s;">
            <div class="card-header">
              <div class="flex items-center gap-3">
                <div class="card-icon bg-pink-500/10 text-pink-400">
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                      d="M13 10V3L4 14h7v7l9-11h-7z"/>
                  </svg>
                </div>
                <div>
                  <h2 class="card-title">Actividad Reciente</h2>
                  <p class="text-xs text-gray-500 mt-0.5">Últimos pedidos</p>
                </div>
              </div>
            </div>
            <div class="card-body">
              <ActivityFeed />
            </div>
          </section>
          
          <!-- Top Products -->
          <section class="dashboard-card animate-section" style="animation-delay: 0.35s;">
            <div class="card-header">
              <div class="flex items-center gap-3">
                <div class="card-icon bg-yellow-500/10 text-yellow-400">
                  <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 20 20">
                    <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                  </svg>
                </div>
                <div>
                  <h2 class="card-title">Más Vendidos</h2>
                  <p class="text-xs text-gray-500 mt-0.5">Productos estrella</p>
                </div>
              </div>
              <a href="/admin/products" class="view-all-link">
                <span>Inventario</span>
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                </svg>
              </a>
            </div>
            <div class="card-body">
              <TopProducts />
            </div>
          </section>

          <!-- Quick Actions -->
          <section class="dashboard-card animate-section" style="animation-delay: 0.4s;">
            <div class="card-header">
              <div class="flex items-center gap-3">
                <div class="card-icon bg-purple-500/10 text-purple-400">
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/>
                  </svg>
                </div>
                <div>
                  <h2 class="card-title">Accesos Rápidos</h2>
                </div>
              </div>
            </div>
            <div class="card-body">
              <div class="grid grid-cols-2 gap-3">
                <a href="/admin/products" class="quick-action">
                  <div class="qa-icon bg-yellow-500/10">
                    <svg class="w-5 h-5 text-yellow-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/>
                    </svg>
                  </div>
                  <span class="qa-label">Inventario</span>
                </a>
                <a href="/admin/orders" class="quick-action">
                  <div class="qa-icon bg-blue-500/10">
                    <svg class="w-5 h-5 text-blue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"/>
                    </svg>
                  </div>
                  <span class="qa-label">Órdenes</span>
                </a>
                <a href="/admin/sale" class="quick-action">
                  <div class="qa-icon bg-emerald-500/10">
                    <svg class="w-5 h-5 text-emerald-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z"/>
                    </svg>
                  </div>
                  <span class="qa-label">Punto de Venta</span>
                </a>
                <a href="/admin/products/new" class="quick-action">
                  <div class="qa-icon bg-purple-500/10">
                    <svg class="w-5 h-5 text-purple-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
                    </svg>
                  </div>
                  <span class="qa-label">Nuevo Producto</span>
                </a>
              </div>
            </div>
          </section>
        </div>
      </div>
    </div>
  </div>

  <!-- ✅ FIX: Guard para View Transitions — evita error de canvas en otras páginas -->
  <script is:inline>
  (function() {
    // Envolver cualquier función que use canvas con un guard
    var originalRenderForPeriod = window.renderForPeriod;
    if (typeof originalRenderForPeriod === 'function') {
      window.renderForPeriod = function() {
        var canvas = document.querySelector('canvas');
        if (!canvas) return;
        return originalRenderForPeriod.apply(this, arguments);
      };
    }

    // Guard genérico para astro:page-load en dashboard
    function isDashboardPage() {
      return window.location.pathname === '/admin' || window.location.pathname === '/admin/';
    }

    // Interceptar eventos que puedan ejecutar código de gráficas
    document.addEventListener('astro:page-load', function() {
      if (!isDashboardPage()) return;
      
      // Period tabs
      var tabs = document.querySelectorAll('.period-tab');
      tabs.forEach(function(tab) {
        if (tab.hasAttribute('data-tab-listener')) return;
        tab.setAttribute('data-tab-listener', 'true');
        
        tab.addEventListener('click', function() {
          tabs.forEach(function(t) { t.classList.remove('active'); });
          tab.classList.add('active');
          var period = tab.getAttribute('data-period');
          if (typeof window.renderForPeriod === 'function') {
            window.renderForPeriod(period);
          }
        });
      });
    });
  })();
  </script>

  <style>
    /* === DASHBOARD LAYOUT === */
    .dashboard-wrapper {
      position: relative;
      min-height: 100vh;
    }

    .dashboard-bg {
      position: fixed;
      inset: 0;
      pointer-events: none;
      z-index: 0;
      overflow: hidden;
    }

    .bg-orb {
      position: absolute;
      border-radius: 50%;
      filter: blur(120px);
      opacity: 0.5;
    }

    .bg-orb-1 {
      width: 500px;
      height: 500px;
      background: radial-gradient(circle, rgba(234, 179, 8, 0.06) 0%, transparent 70%);
      top: -150px;
      right: -100px;
    }

    .bg-orb-2 {
      width: 400px;
      height: 400px;
      background: radial-gradient(circle, rgba(168, 85, 247, 0.04) 0%, transparent 70%);
      bottom: 100px;
      left: -80px;
    }

    .bg-grid {
      position: absolute;
      inset: 0;
      background-image: 
        linear-gradient(rgba(255, 255, 255, 0.012) 1px, transparent 1px),
        linear-gradient(90deg, rgba(255, 255, 255, 0.012) 1px, transparent 1px);
      background-size: 48px 48px;
    }

    /* === ANIMATIONS === */
    @keyframes slideUp {
      from {
        opacity: 0;
        transform: translateY(20px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    .animate-section {
      animation: slideUp 0.5s ease-out both;
    }

    /* === HEADER === */
    .dashboard-header {
      padding: 20px 24px;
      background: rgba(255, 255, 255, 0.02);
      border: 1px solid rgba(255, 255, 255, 0.05);
      border-radius: 20px;
      backdrop-filter: blur(10px);
    }

    .header-icon {
      width: 48px;
      height: 48px;
      display: flex;
      align-items: center;
      justify-content: center;
      background: linear-gradient(135deg, rgba(234, 179, 8, 0.15), rgba(245, 158, 11, 0.08));
      border: 1px solid rgba(234, 179, 8, 0.2);
      border-radius: 14px;
      color: #eab308;
      flex-shrink: 0;
    }

    /* === BUTTONS === */
    .btn-gold {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      padding: 10px 20px;
      background: linear-gradient(135deg, #eab308, #f59e0b);
      color: #000;
      font-weight: 700;
      font-size: 0.875rem;
      border-radius: 12px;
      border: none;
      cursor: pointer;
      transition: all 0.25s ease;
      box-shadow: 0 4px 16px rgba(234, 179, 8, 0.25);
      text-decoration: none;
    }

    .btn-gold:hover {
      transform: translateY(-2px);
      box-shadow: 0 8px 24px rgba(234, 179, 8, 0.35);
    }

    .btn-ghost {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      padding: 10px 16px;
      background: rgba(255, 255, 255, 0.04);
      border: 1px solid rgba(255, 255, 255, 0.1);
      color: rgba(255, 255, 255, 0.7);
      font-weight: 600;
      font-size: 0.875rem;
      border-radius: 12px;
      cursor: pointer;
      transition: all 0.2s ease;
      text-decoration: none;
    }

    .btn-ghost:hover {
      background: rgba(255, 255, 255, 0.08);
      border-color: rgba(255, 255, 255, 0.15);
      color: #fff;
    }

    /* === CARDS === */
    .dashboard-card {
      background: rgba(255, 255, 255, 0.02);
      border: 1px solid rgba(255, 255, 255, 0.06);
      border-radius: 20px;
      overflow: hidden;
      transition: border-color 0.3s ease;
    }

    .dashboard-card:hover {
      border-color: rgba(255, 255, 255, 0.1);
    }

    .card-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 20px 24px 0;
      flex-wrap: wrap;
      gap: 12px;
    }

    .card-body {
      padding: 20px 24px 24px;
    }

    .card-icon {
      width: 40px;
      height: 40px;
      display: flex;
      align-items: center;
      justify-content: center;
      border-radius: 12px;
      flex-shrink: 0;
    }

    .card-title {
      font-size: 1rem;
      font-weight: 700;
      color: #fff;
      letter-spacing: -0.01em;
    }

    /* === PERIOD TABS === */
    .period-tabs {
      display: flex;
      gap: 4px;
      padding: 4px;
      background: rgba(255, 255, 255, 0.04);
      border-radius: 10px;
      border: 1px solid rgba(255, 255, 255, 0.06);
    }

    .period-tab {
      padding: 6px 14px;
      font-size: 0.8rem;
      font-weight: 600;
      color: rgba(255, 255, 255, 0.4);
      border-radius: 8px;
      cursor: pointer;
      transition: all 0.2s ease;
      border: none;
      background: transparent;
    }

    .period-tab:hover {
      color: rgba(255, 255, 255, 0.7);
    }

    .period-tab.active {
      background: rgba(234, 179, 8, 0.15);
      color: #eab308;
      border: 1px solid rgba(234, 179, 8, 0.2);
    }

    /* === VIEW ALL LINK === */
    .view-all-link {
      display: inline-flex;
      align-items: center;
      gap: 4px;
      font-size: 0.8rem;
      font-weight: 600;
      color: rgba(234, 179, 8, 0.7);
      text-decoration: none;
      transition: all 0.2s ease;
      padding: 6px 12px;
      border-radius: 8px;
    }

    .view-all-link:hover {
      color: #eab308;
      background: rgba(234, 179, 8, 0.08);
    }

    .view-all-link svg {
      transition: transform 0.2s ease;
    }

    .view-all-link:hover svg {
      transform: translateX(3px);
    }

    /* === QUICK ACTIONS === */
    .quick-action {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 10px;
      padding: 20px 12px;
      background: rgba(255, 255, 255, 0.02);
      border: 1px solid rgba(255, 255, 255, 0.06);
      border-radius: 16px;
      text-decoration: none;
      transition: all 0.25s ease;
      cursor: pointer;
    }

    .quick-action:hover {
      background: rgba(255, 255, 255, 0.05);
      border-color: rgba(234, 179, 8, 0.2);
      transform: translateY(-3px);
    }

    .qa-icon {
      width: 44px;
      height: 44px;
      display: flex;
      align-items: center;
      justify-content: center;
      border-radius: 14px;
    }

    .qa-label {
      font-size: 0.8rem;
      font-weight: 600;
      color: rgba(255, 255, 255, 0.6);
      text-align: center;
    }

    .quick-action:hover .qa-label {
      color: #fff;
    }

    /* === RESPONSIVE === */
    @media (max-width: 640px) {
      .dashboard-header {
        padding: 16px;
        border-radius: 16px;
      }

      .card-header {
        padding: 16px 16px 0;
      }

      .card-body {
        padding: 16px;
      }

      .period-tabs {
        width: 100%;
        justify-content: center;
      }

      .header-icon {
        width: 40px;
        height: 40px;
        border-radius: 12px;
      }
    }
  </style>
</AdminLayout>