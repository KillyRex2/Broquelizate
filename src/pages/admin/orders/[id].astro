---
// src/pages/admin/orders/[id].astro
import AdminLayout from '@/layouts/AdminLayout.astro';
import { db, orders, order_items } from 'astro:db';
import { eq } from 'drizzle-orm';
import { actions } from 'astro:actions';
import { normalizeExtras } from '@/utils/pos-extra';
import { packageForItems } from '@/utils/shipping';
import { parseCustomizationData } from '@/utils/customization';
import { formatDateTime } from '@/utils/datetime';

interface ShippingAddress {
  streetAddress: string;
  city: string;
  state: string;
  zip: string;
  country: string;
}

const { id } = Astro.params;
if (!id) return Astro.redirect('/admin/orders');

const order = await db.select().from(orders).where(eq(orders.id, id)).get();
if (!order) return Astro.redirect('/404');

const rawItems = await db.select().from(order_items).where(eq(order_items.orderId, order.id)).all();

const items = rawItems.map(item => {
  let engravingData = null;
  if ((item as any).engraving) {
    try {
      engravingData = typeof (item as any).engraving === 'string'
        ? JSON.parse((item as any).engraving)
        : (item as any).engraving;
    } catch (e) { console.warn('Error parseando engraving:', e); }
  }
  // Personalización que eligió el cliente (texto, tipografía, número de piezas...)
  const customization = parseCustomizationData((item as any).customizationData)
    .filter(cv => cv && String(cv.value ?? '').trim() !== '')
    // la imagen del grabado ya se muestra en su propio bloque
    .filter(cv => !(cv.type === 'image' && engravingData?.imageUrl === cv.value));
  return { ...item, engraving: engravingData, customization };
});

const engravingItems = items.filter(i => i.engraving);

let clientName = 'Cliente de Mostrador';
if (order.clientId) {
  try {
    const { data: client } = await Astro.callAction(actions.getClientById, order.clientId.toString());
    if (client) {
      clientName = client.nombre;
    } else {
      clientName = `Cliente no encontrado (ID: ${order.clientId})`;
    }
  } catch (error) {
    console.error('Error al obtener el cliente:', error);
    clientName = `Error al buscar (ID: ${order.clientId})`;
  }
}

// El paquete con el que se le cotizó al cliente en el checkout.
// Antes el formulario de abajo traía 0.5 kg y 20x15x10 quemados en el HTML,
// pero priceCheckout usa packageForItems(itemsCount), que arranca en 1 kg y
// crece con las piezas. Cotizar la guía con medio kilo menos daba precios
// que no correspondían a lo cobrado, y el ajuste por repeso lo acaba
// pagando la tienda. Los campos siguen siendo editables si el paquete real
// es distinto.
const itemsCount = rawItems.reduce((n, i) => n + (Number(i.quantity) || 1), 0);
const pkg = packageForItems(itemsCount);

const formatCurrency = (value: number | null) => value == null ? 'N/A' : new Intl.NumberFormat('es-MX', { style: 'currency', currency: 'MXN' }).format(value);
const formatDate = (date: Date | null) =>
  date ? formatDateTime(date, { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric', hour: '2-digit', minute: '2-digit' }) : 'N/A';

let shippingAddress: ShippingAddress = {
  streetAddress: 'N/A', city: 'N/A', state: 'N/A', zip: 'N/A', country: 'N/A'
};

let rawAddress: Record<string, any> = {};
if (order.shippingAddress) {
  try {
    rawAddress = JSON.parse(order.shippingAddress) || {};
    shippingAddress = { ...shippingAddress, ...rawAddress };
    // El checkout guarda `postalCode`; esta página usa `zip`. Sin esto el CP salía "N/A"
    // y "Cotizar Envío" pedía editar la dirección en cada pedido web.
    if (!rawAddress.zip && rawAddress.postalCode) shippingAddress.zip = String(rawAddress.postalCode);
  } catch (error) {
    console.error('Error parsing shipping address:', error);
  }
}

// Recoger en tienda
const isPickup = (order as any).deliveryMethod === 'pickup';
const pickupName: string = rawAddress.pickupName || rawAddress.name || '';
const pickupPhone: string = rawAddress.phone || '';

// Montos adicionales de ventas del POS (se guardan en shippingAddress).
// extraCharges = lista [{ amount, description }]; additionalChargeDescription = formato de un solo monto.
const extraChargesDetail = normalizeExtras(rawAddress.extraCharges ?? []);
const legacyChargeDescription: string = rawAddress.additionalChargeDescription || '';

// shippingCost = lo que pagó el cliente · labelCost = lo que costó la guía en Envia
const labelCost = (order as any).labelCost as number | null | undefined;
const chargedShippingText = order.shippingCost == null ? null : order.shippingCost > 0 ? formatCurrency(order.shippingCost) : 'Gratis';

const ORIGIN_ADDRESS = {
  name: "Broquelizate",
  street: "Calle Escobedo esquina con Bravo",
  number: "222",
  district: "Colonia Centro",
  city: "Gómez Palacio",
  state: "Durango",
  postalCode: "35000",
  phone: "8714617696",
  email: "contacto@broquelizate.com"
};

const netAdjustment = (order.total ?? 0) - (order.subtotal ?? 0) - (order.tax ?? 0);
const additionalCharges = netAdjustment > 0 ? netAdjustment : 0;
const discount = netAdjustment < 0 ? Math.abs(netAdjustment) : 0;

const hasShippingLabel = !!(order.trackingNumber && order.labelUrl);
const hasTrackingOnly = !!(order.trackingNumber && !order.labelUrl);

const statusLabels: Record<string, string> = {
  pending: 'Pendiente', processing: 'Procesando', shipped: 'Enviado', completed: 'Completado', cancelled: 'Cancelado'
};
---

<AdminLayout title={`Orden #${order.orderNumber || order.id.slice(0,8)}`}>

  {/* --- Datos ocultos para el script de impresión --- */}
  <div id="products-data" style="display:none;">
    {JSON.stringify(items.map(i => ({ name: i.productName, price: i.price, quantity: i.quantity || 1 })))}
  </div>
  <div id="total-data" style="display:none;">{order.total ?? 0}</div>
  <div id="order-number-data" style="display:none;">{order.orderNumber || order.id.slice(0,8)}</div>
  <div id="payment-method-data" style="display:none;">{order.paymentMethod || 'Desconocido'}</div>
  <div id="discount-data" style="display:none;">{discount}</div>
  <div id="additional-charges-data" style="display:none;">{additionalCharges}</div>
  <div id="additional-charge-desc-data" style="display:none;">{extraChargesDetail.length ? JSON.stringify(extraChargesDetail) : legacyChargeDescription}</div>

  {/* Datos para gestión de envíos */}
  <div id="order-data" style="display:none;"
    data-order-id={order.id}
    data-status={order.status}
    data-tracking-number={order.trackingNumber}
    data-carrier={order.carrier}
    data-label-url={order.labelUrl}
    data-destination-zip={shippingAddress.zip}
    data-customer-email={order.customerEmail}
    data-customer-phone={order.customerPhone}
    data-customer-name={order.customerName}
    data-shipping-address={JSON.stringify(shippingAddress)}
    data-paid-service={order.shippingService || ''}
    data-paid-cost={order.shippingCost ?? ''}
  ></div>

  <div class="order-page">
    {/* Header */}
    <header class="order-header">
      <div class="oh-left">
        <p class="eyebrow">Detalle de venta</p>
        <h1>Orden <span class="ord-num">#{order.orderNumber || order.id.slice(0,8)}</span></h1>
        {isPickup && <span class="count-badge pickup-badge">🏬 Recoger en tienda</span>}
      </div>
      <div class="oh-actions">
        <button id="print-ticket-btn" class="btn btn-gold">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z"/></svg>
          Imprimir Ticket
        </button>
        <a href="/admin/orders" class="btn btn-ghost">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18"/></svg>
          Volver
        </a>
      </div>
    </header>

    <div class="order-grid">
      {/* Columna principal */}
      <div class="col-main">
        {/* Artículos */}
        <section class="panel">
          <div class="panel-head">
            <h2>Artículos del pedido</h2>
            <span class="count-badge">{items.length}</span>
          </div>
          <ul class="items-list">
            {items.map(item => (
              <li class="item-row">
                <div class="item-top">
                  <div class="item-info">
                    <p class="item-name">{item.productName}</p>
                    <p class="item-qty">Cantidad: {item.quantity}</p>
                  </div>
                  <div class="item-prices">
                    <p class="item-total">{formatCurrency(item.price * (item.quantity ?? 1))}</p>
                    <p class="item-unit">{formatCurrency(item.price)} c/u</p>
                  </div>
                </div>
                {item.engraving && (
                  <div class="engrave-chip">
                    <img src={item.engraving.imageUrl} alt="Grabado láser" class="engrave-thumb" />
                    <div class="engrave-info">
                      <div class="engrave-title">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"/></svg>
                        <span>Grabado láser personalizado</span>
                      </div>
                      {item.engraving.notes && <p class="engrave-notes">"{item.engraving.notes}"</p>}
                    </div>
                    <a href={item.engraving.imageUrl} target="_blank" class="engrave-link">Ver imagen</a>
                  </div>
                )}
                {item.customization.length > 0 && (
                  <ul class="cust-list">
                    {item.customization.map(cv => (
                      <li class="cust-row">
                        <span class="cust-label">{cv.label}:</span>
                        {cv.type === 'image'
                          ? <a href={cv.value} target="_blank" rel="noopener" class="cust-link">Ver imagen</a>
                          : <span class="cust-value">{cv.type === 'pieces' ? `${cv.value} ${cv.value === '1' ? 'pieza' : 'piezas'}` : cv.value}</span>}
                      </li>
                    ))}
                  </ul>
                )}
              </li>
            ))}
          </ul>
        </section>

        {/* Totales */}
        <section class="panel">
          <div class="totals">
            <div class="t-row">
              <span>Subtotal</span>
              <span class="t-val">{formatCurrency(order.subtotal)}</span>
            </div>
            {additionalCharges > 0 && (
              <div class="t-row">
                <span>
                  {extraChargesDetail.length > 1 ? 'Montos adicionales' : 'Monto adicional'}
                  {extraChargesDetail.length > 0
                    ? extraChargesDetail.map(x => (
                        <small style="display:block;font-size:0.75rem;opacity:0.7;">
                          {x.description || 'Sin descripción'}{extraChargesDetail.length > 1 && ` · ${formatCurrency(x.amount)}`}
                        </small>
                      ))
                    : legacyChargeDescription && <small style="display:block;font-size:0.75rem;opacity:0.7;">{legacyChargeDescription}</small>}
                </span>
                <span class="t-val">{formatCurrency(additionalCharges)}</span>
              </div>
            )}
            {discount > 0 && (
              <div class="t-row">
                <span>Descuento</span>
                <span class="t-val t-discount">-{formatCurrency(discount)}</span>
              </div>
            )}
            <div class="t-row t-grand">
              <span>Total</span>
              <span class="t-grand-val">{formatCurrency(order.total)}</span>
            </div>
          </div>
        </section>

        {/* GRABADO LÁSER PARA PRODUCCIÓN */}
        {engravingItems.length > 0 && (
          <section class="panel panel-accent">
            <div class="corner-badge corner-gold">🔥 GRABADO LÁSER</div>
            <div class="panel-head">
              <div class="head-icon head-icon-gold">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"/></svg>
              </div>
              <h2>Archivos de grabado para producción</h2>
            </div>
            <p class="panel-sub">
              {engravingItems.length === 1 ? 'Este pedido incluye 1 producto con grabado láser personalizado.' : `Este pedido incluye ${engravingItems.length} productos con grabado láser personalizado.`}
              Descarga las imágenes en alta resolución para producción.
            </p>
            <div class="engrave-prod-list">
              {engravingItems.map((item, idx) => (
                <div class="engrave-prod">
                  <div class="engrave-prod-img">
                    <img src={item.engraving.imageUrl} alt={`Grabado para ${item.productName}`} />
                  </div>
                  <div class="engrave-prod-body">
                    <div class="engrave-prod-head">
                      <div>
                        <p class="engrave-prod-name">{item.productName}</p>
                        <p class="engrave-prod-qty">Cantidad a grabar: {item.quantity}</p>
                        {item.engraving.notes && (
                          <div class="engrave-prod-note">
                            <p class="note-label">Notas del cliente:</p>
                            <p class="note-text">"{item.engraving.notes}"</p>
                          </div>
                        )}
                      </div>
                      <span class="prod-num">#{idx + 1}</span>
                    </div>
                    <div class="engrave-prod-actions">
                      <a href={item.engraving.imageUrl} target="_blank" class="btn btn-blue btn-sm">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>
                        Ver Original
                      </a>
                      <a href={item.engraving.imageUrl} download={`grabado-${item.productName?.replace(/\s+/g, '-').toLowerCase()}-${idx + 1}.png`} class="btn btn-green btn-sm">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
                        Descargar HD
                      </a>
                    </div>
                  </div>
                </div>
              ))}
            </div>
            <div class="info-note">
              <svg viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd"/></svg>
              Las imágenes están almacenadas en Cloudinary. Formatos: JPG, PNG, WEBP, GIF. Máximo 10MB.
            </div>
          </section>
        )}

        {/* ETIQUETA DE ENVÍO GENERADA */}
        {hasShippingLabel && (
          <section class="panel panel-accent">
            <div class="corner-badge corner-green">✓ GUÍA GENERADA</div>
            <div class="panel-head">
              <div class="head-icon head-icon-green">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
              </div>
              <h2>Etiqueta de Envío</h2>
            </div>

            <div class="ship-grid">
              <div class="mini-card">
                <p class="mini-label">Paquetería</p>
                <p class="mini-value-lg">{order.carrier}</p>
              </div>
              <div class="mini-card">
                <p class="mini-label">Servicio</p>
                <p class="mini-value">{order.shippingService || 'Estándar'}</p>
              </div>
            </div>

            <div class="track-box">
              <p class="mini-label">Número de Rastreo</p>
              <div class="track-row">
                <p class="track-number">{order.trackingNumber}</p>
                <button id="copy-tracking-btn" class="btn btn-soft btn-sm">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2m0 0h2a2 2 0 012 2v3m2 4H10m0 0l3-3m-3 3l3 3"/></svg>
                  Copiar
                </button>
              </div>
            </div>

            {labelCost != null && (
              <div class="cost-box">
                <span>Costo de la guía</span>
                <span class="cost-val">{formatCurrency(labelCost)}</span>
              </div>
            )}
            {chargedShippingText && (
              <div class="cost-box" style="margin-top:8px;">
                <span>Cobrado al cliente</span>
                <span class="cost-val">{chargedShippingText}</span>
              </div>
            )}

            {order.shippedAt && (
              <p class="ship-date">📅 Enviado el: <strong>{formatDate(order.shippedAt)}</strong></p>
            )}

            <div class="ship-actions">
              <a href={order.labelUrl} target="_blank" class="btn btn-blue btn-lg">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
                Descargar PDF
              </a>
              <button id="print-label-btn" class="btn btn-green btn-lg">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z"/></svg>
                Imprimir Etiqueta
              </button>
            </div>

            <button id="track-shipment-btn" class="btn btn-dark btn-block">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
              Ver Rastreo en Tiempo Real
            </button>
          </section>
        )}

        {/* Tracking sin label */}
        {hasTrackingOnly && (
          <section class="panel">
            <div class="panel-head"><h2>📦 Información de Envío</h2></div>
            <div class="track-box">
              <p class="mini-label">Número de Rastreo</p>
              <div class="track-row">
                <p class="track-number">{order.trackingNumber}</p>
                <button id="copy-tracking-btn" class="btn btn-soft btn-sm">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2"/></svg>
                  Copiar
                </button>
              </div>
            </div>
            <div class="ship-grid" style="margin-top:14px;">
              <div class="mini-card">
                <p class="mini-label">Paquetería</p>
                <p class="mini-value">{order.carrier}</p>
              </div>
              {order.shippingService && (
                <div class="mini-card">
                  <p class="mini-label">Servicio</p>
                  <p class="mini-value">{order.shippingService}</p>
                </div>
              )}
            </div>
            {labelCost != null && (
              <div class="cost-box" style="margin-top:14px;">
                <span>Costo de la guía</span>
                <span class="cost-val">{formatCurrency(labelCost)}</span>
              </div>
            )}
            {chargedShippingText && (
              <div class="cost-box" style="margin-top:8px;">
                <span>Cobrado al cliente</span>
                <span class="cost-val">{chargedShippingText}</span>
              </div>
            )}
            <button id="track-shipment-btn" class="btn btn-dark btn-block" style="margin-top:14px;">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
              Ver Rastreo
            </button>
          </section>
        )}
      </div>

      {/* Columna lateral */}
      <div class="col-side">
        {/* Detalles */}
        <section class="panel">
          <div class="panel-head"><h2>Detalles de la orden</h2></div>
          <div class="detail-list">
            <div class="detail-row"><span class="detail-key">Fecha</span><span class="detail-val">{formatDate(order.createdAt)}</span></div>
            <div class="detail-row"><span class="detail-key">Cliente</span><span class="detail-val">{clientName}</span></div>
            <div class="detail-row">
              <span class="detail-key">Estado</span>
              <span class={`status-pill status-${order.status}`}>{statusLabels[order.status] || order.status}</span>
            </div>
            <div class="detail-row"><span class="detail-key">Método de pago</span><span class="detail-val">{order.paymentMethod || 'No especificado'}</span></div>
          </div>
        </section>

        {/* Cambiar estado */}
        <section class="panel">
          <div class="panel-head"><h2>⚙️ Cambiar estado</h2></div>
          <div class="status-control">
            <select id="status-select" class="dark-select">
              <option value="pending" selected={order.status === 'pending'}>Pendiente</option>
              <option value="processing" selected={order.status === 'processing'}>Procesando</option>
              <option value="shipped" selected={order.status === 'shipped'}>Enviado</option>
              <option value="completed" selected={order.status === 'completed'}>Completado</option>
              <option value="cancelled" selected={order.status === 'cancelled'}>Cancelado</option>
            </select>
            <button id="update-status-btn" class="btn btn-gold btn-block">Actualizar Estado</button>
            {order.status !== 'cancelled' && (
              <button id="cancel-order-btn" class="btn btn-danger btn-block">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
                Cancelar Orden
              </button>
            )}
          </div>
        </section>

        {/* Cliente */}
        <section class="panel">
          <div class="panel-head between">
            <h2>👤 Información del cliente</h2>
            {!isPickup && <button id="edit-shipping-btn" class="link-edit">✏️ Editar</button>}
          </div>
          <div class="detail-list">
            {order.customerName && (
              <div class="kv"><p class="kv-key">Nombre</p><p class="kv-val">{order.customerName}</p></div>
            )}
            <div class="kv">
              <p class="kv-key">Email</p>
              <a href={`mailto:${order.customerEmail}`} class="kv-link">{order.customerEmail}</a>
            </div>
            {order.customerPhone && (
              <div class="kv"><p class="kv-key">Teléfono</p><p class="kv-val">{order.customerPhone}</p></div>
            )}
            {isPickup ? (
              <div class="addr-block">
                <h3>🏬 Recoger en tienda</h3>
                <div class="addr-lines">
                  <p>Recoge: <strong>{pickupName || 'Sin nombre'}</strong></p>
                  {pickupPhone && <p>Tel: {pickupPhone}</p>}
                  <p>Pide identificación y el número de pedido al entregar.</p>
                </div>
              </div>
            ) : (
              <div class="addr-block">
                <h3>📍 Dirección de envío</h3>
                <div class="addr-lines">
                  <p>{shippingAddress.streetAddress}</p>
                  {rawAddress.neighborhood && <p>Col. {rawAddress.neighborhood}</p>}
                  <p>{shippingAddress.city}, {shippingAddress.state}</p>
                  <p>CP: {shippingAddress.zip}</p>
                  <p>{shippingAddress.country}</p>
                  {rawAddress.deliveryNotes && <p>Notas: {rawAddress.deliveryNotes}</p>}
                </div>
              </div>
            )}
          </div>
        </section>

        {/* Pedido para recoger en tienda: no lleva guía */}
        {isPickup && order.status !== 'cancelled' && (
          <section class="panel panel-accent">
            <div class="panel-head">
              <div class="head-icon head-icon-gold">🏬</div>
              <h2>Recoger en tienda</h2>
            </div>
            <p class="panel-sub">
              Este pedido no se envía por paquetería. Prepáralo, avisa al cliente que está listo y,
              cuando lo recoja, cambia el estado a <strong>Completado</strong>.
            </p>
          </section>
        )}

        {/* Gestionar envío */}
        {!isPickup && !order.trackingNumber && order.status !== 'cancelled' && (
          <section class="panel panel-accent">
            <div class="panel-head">
              <div class="head-icon head-icon-blue">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 8h14M5 8a2 2 0 110-4h14a2 2 0 110 4M5 8v10a2 2 0 002 2h10a2 2 0 002-2V8m-9 4h4"/></svg>
              </div>
              <h2>Gestionar envío</h2>
            </div>

            {order.carrier && (
              <p class="panel-sub">
                El cliente eligió <strong>{order.carrier} · {order.shippingService || 'Estándar'}</strong>
                {order.shippingCost != null && <> — pagó {order.shippingCost > 0 ? formatCurrency(order.shippingCost) : 'envío gratis'}</>}
              </p>
            )}

            <div class="ship-form">
              <div class="field">
                <label>Peso (kg)</label>
                <input type="number" id="weight" step="0.1" value={pkg.weight} class="dark-input" />
              </div>
              <div class="field-grid">
                <div class="field"><label>Largo (cm)</label><input type="number" id="length" value={pkg.length} class="dark-input" /></div>
                <div class="field"><label>Ancho (cm)</label><input type="number" id="width" value={pkg.width} class="dark-input" /></div>
                <div class="field"><label>Alto (cm)</label><input type="number" id="height" value={pkg.height} class="dark-input" /></div>
              </div>
              <p class="ship-hint">
                Medidas con las que se le cotizó al cliente ({itemsCount} {itemsCount === 1 ? 'pieza' : 'piezas'}).
                Ajústalas si el paquete real es distinto.
              </p>
            </div>

            <button id="quote-shipping-btn" class="btn btn-blue btn-block">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z"/></svg>
              Cotizar Envío
            </button>

            <div id="shipping-rates" class="hidden rates-wrap">
              <h3 class="rates-title">Opciones disponibles:</h3>
              <div id="rates-container" class="rates-container"></div>
            </div>

            <div id="loading-rates" class="hidden loading-block">
              <div class="spinner-blue"></div>
              <p>Buscando las mejores opciones de envío...</p>
            </div>

            <div id="error-rates" class="hidden error-block">
              <p><span id="error-message"></span></p>
            </div>
          </section>
        )}

        {/* Resumen de envío con etiqueta */}
        {hasShippingLabel && (
          <section class="panel">
            <div class="panel-head"><h2>📊 Resumen de envío</h2></div>
            <div class="detail-list">
              <div class="detail-row"><span class="detail-key">Paquetería</span><span class="detail-val">{order.carrier}</span></div>
              <div class="detail-row"><span class="detail-key">Servicio</span><span class="detail-val">{order.shippingService || 'Estándar'}</span></div>
              {labelCost != null && (
                <div class="detail-row"><span class="detail-key">Costo de la guía</span><span class="detail-val t-gold">{formatCurrency(labelCost)}</span></div>
              )}
              {chargedShippingText && (
                <div class="detail-row"><span class="detail-key">Cobrado al cliente</span><span class="detail-val">{chargedShippingText}</span></div>
              )}
              <div class="detail-row"><span class="detail-key">Estado</span><span class="status-pill status-completed">Etiqueta generada</span></div>
            </div>
          </section>
        )}
      </div>
    </div>
  </div>

  {/* Modal de Tracking */}
  <div id="tracking-modal" class="hidden modal-overlay">
    <div class="modal-card">
      <div class="modal-head">
        <h2>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7"/></svg>
          Rastreo de Envío
        </h2>
        <button id="close-modal" class="modal-close">×</button>
      </div>
      <div id="tracking-content" class="modal-body"></div>
    </div>
  </div>

  <style is:global>
    .order-page {
      --bg: #0b0b0d; --panel: #141417; --panel-2: #1b1b1f;
      --line: rgba(255,255,255,0.07); --line-strong: rgba(255,255,255,0.12);
      --gold: #eab308; --gold-soft: #fbbf24; --txt: #f5f5f4;
      --txt-dim: rgba(245,245,244,0.55); --txt-faint: rgba(245,245,244,0.35);
      --green: #34d399; --blue: #60a5fa; --red: #f87171;
      position: relative; min-height: 100vh; width: 100%; max-width: 100%; overflow-x: hidden;
      box-sizing: border-box; padding: 28px 28px 60px; border-radius: 20px;
      background: radial-gradient(900px 500px at 85% -10%, rgba(234,179,8,0.07), transparent 70%), var(--bg);
      color: var(--txt); font-family: 'Inter', system-ui, -apple-system, sans-serif;
    }
    .order-page * { box-sizing: border-box; }

    .order-header { display: flex; align-items: flex-end; justify-content: space-between; gap: 16px; margin-bottom: 24px; flex-wrap: wrap; }
    .order-header .eyebrow { font-size: 0.72rem; letter-spacing: 0.22em; text-transform: uppercase; color: var(--gold); font-weight: 600; margin: 0 0 6px; }
    .order-header h1 { font-size: 2rem; font-weight: 800; letter-spacing: -0.02em; line-height: 1; margin: 0; }
    .order-header .ord-num { background: linear-gradient(135deg, var(--gold), var(--gold-soft)); -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent; font-family: ui-monospace, monospace; }
    .oh-actions { display: flex; gap: 10px; flex-wrap: wrap; }

    /* Botones */
    .btn { display: inline-flex; align-items: center; justify-content: center; gap: 8px; padding: 10px 18px; border-radius: 12px; font-size: 0.85rem; font-weight: 700; cursor: pointer; border: 1px solid transparent; transition: all 0.18s; text-decoration: none; }
    .btn svg { width: 18px; height: 18px; }
    .btn-sm { padding: 7px 13px; font-size: 0.78rem; }
    .btn-sm svg { width: 15px; height: 15px; }
    .btn-lg { padding: 14px 20px; font-size: 0.9rem; }
    .btn-block { width: 100%; }
    .btn-gold { background: linear-gradient(135deg, var(--gold), var(--gold-soft)); color: #1a1205; }
    .btn-gold:hover { filter: brightness(1.08); transform: translateY(-1px); }
    .btn-ghost { background: var(--panel); color: var(--txt); border-color: var(--line); }
    .btn-ghost:hover { border-color: var(--line-strong); }
    .btn-blue { background: var(--blue); color: #07203f; }
    .btn-blue:hover { filter: brightness(1.08); }
    .btn-green { background: var(--green); color: #053826; }
    .btn-green:hover { filter: brightness(1.08); }
    .btn-dark { background: var(--panel-2); color: var(--txt); border-color: var(--line); }
    .btn-dark:hover { border-color: var(--line-strong); }
    .btn-soft { background: var(--panel-2); color: var(--txt-dim); border-color: var(--line); }
    .btn-soft:hover { color: var(--txt); }
    .btn-danger { background: rgba(248,113,113,0.12); color: var(--red); border-color: rgba(248,113,113,0.3); }
    .btn-danger:hover { background: rgba(248,113,113,0.2); }

    /* Grid */
    .order-grid { display: grid; grid-template-columns: 1fr 360px; gap: 18px; align-items: start; }
    .col-main, .col-side { display: flex; flex-direction: column; gap: 18px; min-width: 0; }

    /* Panel */
    .panel { position: relative; background: var(--panel); border: 1px solid var(--line); border-radius: 18px; padding: 22px; overflow: hidden; }
    .panel-accent { background: linear-gradient(160deg, var(--panel) 0%, var(--panel-2) 100%); }
    .panel-head { display: flex; align-items: center; gap: 12px; margin-bottom: 18px; }
    .panel-head.between { justify-content: space-between; }
    .panel-head h2 { font-size: 1.05rem; font-weight: 700; margin: 0; }
    .panel-sub { font-size: 0.85rem; color: var(--txt-dim); margin: 0 0 16px; line-height: 1.5; }
    .pickup-badge { display: inline-block; margin: 8px 0 0; }
    .count-badge { margin-left: auto; background: var(--panel-2); color: var(--gold-soft); font-size: 0.8rem; font-weight: 700; padding: 3px 12px; border-radius: 999px; border: 1px solid var(--line); }
    .head-icon { width: 42px; height: 42px; border-radius: 12px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
    .head-icon svg { width: 22px; height: 22px; }
    .head-icon-gold { background: linear-gradient(135deg, var(--gold), var(--gold-soft)); color: #1a1205; }
    .head-icon-green { background: var(--green); color: #053826; }
    .head-icon-blue { background: var(--blue); color: #07203f; }

    .corner-badge { position: absolute; top: 0; right: 0; padding: 5px 14px; border-bottom-left-radius: 12px; font-size: 0.72rem; font-weight: 800; letter-spacing: 0.05em; }
    .corner-gold { background: linear-gradient(135deg, var(--gold), var(--gold-soft)); color: #1a1205; }
    .corner-green { background: var(--green); color: #053826; }

    /* Items */
    .items-list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 4px; }
    .item-row { padding: 14px; border-radius: 12px; transition: background 0.15s; }
    .item-row:hover { background: var(--panel-2); }
    .item-top { display: flex; align-items: flex-start; justify-content: space-between; gap: 14px; }
    .item-name { font-weight: 600; color: var(--txt); margin: 0; }
    .item-qty { font-size: 0.8rem; color: var(--txt-faint); margin: 4px 0 0; }
    .item-prices { text-align: right; flex-shrink: 0; }
    .item-total { font-weight: 700; color: var(--txt); margin: 0; }
    .item-unit { font-size: 0.8rem; color: var(--txt-faint); margin: 2px 0 0; }

    .cust-list { list-style: none; margin: 10px 0 0; padding: 10px 12px; border-radius: 12px; background: rgba(234,179,8,0.06); border: 1px solid rgba(234,179,8,0.18); display: flex; flex-direction: column; gap: 4px; }
    .cust-row { display: flex; gap: 6px; font-size: 0.82rem; line-height: 1.35; }
    .cust-label { color: var(--txt-faint); flex-shrink: 0; }
    .cust-value { color: var(--txt); font-weight: 600; overflow-wrap: anywhere; }
    .cust-link { color: var(--gold-soft); font-weight: 700; }
    .engrave-chip { display: flex; align-items: center; gap: 12px; margin-top: 12px; padding: 12px; border-radius: 12px; background: rgba(234,179,8,0.06); border: 1px solid rgba(234,179,8,0.18); }
    .engrave-thumb { width: 52px; height: 52px; object-fit: cover; border-radius: 10px; border: 1px solid rgba(234,179,8,0.3); flex-shrink: 0; }
    .engrave-info { flex: 1; min-width: 0; }
    .engrave-title { display: flex; align-items: center; gap: 6px; color: var(--gold-soft); font-size: 0.85rem; font-weight: 700; }
    .engrave-title svg { width: 15px; height: 15px; flex-shrink: 0; }
    .engrave-notes { font-size: 0.78rem; color: var(--txt-dim); font-style: italic; margin: 4px 0 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .engrave-link { flex-shrink: 0; padding: 7px 13px; background: linear-gradient(135deg, var(--gold), var(--gold-soft)); color: #1a1205; font-size: 0.76rem; font-weight: 700; border-radius: 9px; text-decoration: none; }

    /* Totales */
    .totals { display: flex; flex-direction: column; gap: 12px; }
    .t-row { display: flex; justify-content: space-between; align-items: center; font-size: 0.95rem; color: var(--txt-dim); }
    .t-val { font-weight: 600; color: var(--txt); }
    .t-discount { color: var(--red); }
    .t-grand { border-top: 1px solid var(--line); padding-top: 14px; margin-top: 4px; }
    .t-grand span:first-child { font-size: 1.1rem; font-weight: 700; color: var(--txt); }
    .t-grand-val { font-size: 1.5rem; font-weight: 800; background: linear-gradient(135deg, var(--gold), var(--gold-soft)); -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent; }
    .t-gold { color: var(--gold-soft); }

    /* Grabado producción */
    .engrave-prod-list { display: flex; flex-direction: column; gap: 14px; }
    .engrave-prod { display: flex; background: var(--bg); border: 1px solid var(--line); border-radius: 14px; overflow: hidden; }
    .engrave-prod-img { width: 130px; flex-shrink: 0; background: var(--panel-2); display: flex; align-items: center; justify-content: center; padding: 8px; }
    .engrave-prod-img img { width: 100%; height: 100%; object-fit: contain; min-height: 110px; }
    .engrave-prod-body { flex: 1; padding: 16px; min-width: 0; }
    .engrave-prod-head { display: flex; justify-content: space-between; gap: 12px; }
    .engrave-prod-name { font-weight: 700; font-size: 1.05rem; color: var(--txt); margin: 0; }
    .engrave-prod-qty { font-size: 0.8rem; color: var(--txt-faint); margin: 4px 0 0; }
    .engrave-prod-note { margin-top: 10px; padding: 8px 12px; background: rgba(234,179,8,0.06); border-left: 3px solid var(--gold); border-radius: 0 8px 8px 0; }
    .note-label { font-size: 0.72rem; color: var(--txt-faint); font-weight: 700; margin: 0; }
    .note-text { font-size: 0.85rem; color: var(--txt); margin: 2px 0 0; }
    .prod-num { background: rgba(234,179,8,0.15); color: var(--gold-soft); font-size: 0.75rem; font-weight: 800; padding: 3px 10px; border-radius: 999px; height: fit-content; flex-shrink: 0; }
    .engrave-prod-actions { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 16px; }

    .info-note { display: flex; align-items: center; gap: 8px; margin-top: 16px; padding: 12px; background: var(--bg); border: 1px solid var(--line); border-radius: 10px; font-size: 0.76rem; color: var(--txt-faint); }
    .info-note svg { width: 16px; height: 16px; flex-shrink: 0; }

    /* Envío */
    .ship-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-bottom: 16px; }
    .mini-card { background: var(--bg); border: 1px solid var(--line); border-radius: 12px; padding: 14px; }
    .mini-label { font-size: 0.68rem; text-transform: uppercase; letter-spacing: 0.1em; color: var(--txt-faint); margin: 0 0 6px; font-weight: 600; }
    .mini-value { font-size: 1rem; font-weight: 600; color: var(--txt); margin: 0; }
    .mini-value-lg { font-size: 1.4rem; font-weight: 800; color: var(--txt); margin: 0; text-transform: uppercase; }
    .track-box { background: var(--bg); border: 1px solid var(--line); border-radius: 12px; padding: 16px; margin-bottom: 16px; }
    .track-row { display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap; margin-top: 8px; }
    .track-number { font-family: ui-monospace, monospace; font-size: 1.3rem; font-weight: 700; color: var(--blue); letter-spacing: 0.05em; margin: 0; word-break: break-all; }
    .cost-box { display: flex; justify-content: space-between; align-items: center; padding: 14px 16px; background: rgba(234,179,8,0.06); border: 1px solid rgba(234,179,8,0.18); border-radius: 12px; margin-bottom: 16px; color: var(--txt-dim); font-weight: 600; }
    .cost-val { font-size: 1.3rem; font-weight: 800; color: var(--gold-soft); }
    .ship-date { font-size: 0.85rem; color: var(--txt-dim); margin: 0 0 16px; }
    .ship-actions { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-bottom: 12px; }

    /* Detalles laterales */
    .detail-list { display: flex; flex-direction: column; gap: 14px; }
    .detail-row { display: flex; justify-content: space-between; align-items: center; gap: 12px; }
    .detail-key { font-size: 0.85rem; color: var(--txt-dim); flex-shrink: 0; }
    .detail-val { font-size: 0.88rem; font-weight: 600; color: var(--txt); text-align: right; }
    .kv-key { font-size: 0.72rem; color: var(--txt-faint); margin: 0 0 3px; }
    .kv-val { font-weight: 600; color: var(--txt); margin: 0; }
    .kv-link { color: var(--gold-soft); font-weight: 600; text-decoration: none; word-break: break-all; }
    .kv-link:hover { text-decoration: underline; }
    .addr-block { border-top: 1px solid var(--line); padding-top: 14px; }
    .addr-block h3 { font-size: 0.9rem; font-weight: 700; color: var(--txt); margin: 0 0 8px; }
    .addr-lines { font-size: 0.82rem; color: var(--txt-dim); line-height: 1.6; }
    .addr-lines p { margin: 0; }
    .link-edit { background: none; border: none; color: var(--gold-soft); font-size: 0.82rem; font-weight: 600; cursor: pointer; }

    /* Status pill */
    .status-pill { padding: 4px 12px; border-radius: 999px; font-size: 0.72rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.04em; }
    .status-completed { background: rgba(52,211,153,0.15); color: var(--green); }
    .status-pending { background: rgba(234,179,8,0.15); color: var(--gold-soft); }
    .status-shipped { background: rgba(96,165,250,0.15); color: var(--blue); }
    .status-cancelled { background: rgba(248,113,113,0.15); color: var(--red); }
    .status-processing { background: rgba(167,139,250,0.15); color: #a78bfa; }

    /* Controles */
    .status-control { display: flex; flex-direction: column; gap: 12px; }
    .dark-select, .dark-input { width: 100%; background: var(--bg); border: 1px solid var(--line); border-radius: 12px; color: var(--txt); padding: 12px 14px; font-size: 0.9rem; font-family: inherit; color-scheme: dark; transition: border-color 0.18s; }
    .dark-select:focus, .dark-input:focus { outline: none; border-color: var(--gold); }
    .ship-form { margin-bottom: 10px; display: flex; flex-direction: column; gap: 12px; }
    .ship-hint { font-size: 0.74rem; color: var(--txt-dim); margin: 0 0 16px; line-height: 1.45; }
    .field label { display: block; font-size: 0.78rem; color: var(--txt-dim); margin-bottom: 6px; font-weight: 600; }
    .field-grid { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 8px; }

    /* Rates */
    .rates-wrap { margin-top: 16px; }
    .rates-title { font-size: 0.9rem; font-weight: 700; color: var(--txt); margin: 0 0 12px; }
    .rates-container { display: flex; flex-direction: column; gap: 8px; max-height: 320px; overflow-y: auto; }
    .loading-block { margin-top: 16px; text-align: center; padding: 24px; }
    .loading-block p { font-size: 0.85rem; color: var(--txt-dim); margin: 12px 0 0; }
    .spinner-blue { width: 38px; height: 38px; border: 3px solid var(--line-strong); border-top-color: var(--blue); border-radius: 50%; animation: ospin 0.7s linear infinite; display: inline-block; }
    @keyframes ospin { to { transform: rotate(360deg); } }
    .error-block { margin-top: 16px; padding: 14px; background: rgba(248,113,113,0.1); border: 1px solid rgba(248,113,113,0.3); border-radius: 12px; color: var(--red); font-size: 0.85rem; }

    /* Modal */
    .modal-overlay { position: fixed; inset: 0; background: rgba(0,0,0,0.7); backdrop-filter: blur(3px); z-index: 50; display: flex; align-items: center; justify-content: center; padding: 16px; }
    .modal-card { background: var(--panel); border: 1px solid var(--line); border-radius: 20px; max-width: 720px; width: 100%; max-height: 90vh; overflow-y: auto; }
    .modal-head { position: sticky; top: 0; background: linear-gradient(135deg, #1b1b1f, #141417); border-bottom: 1px solid var(--line); padding: 20px 24px; display: flex; align-items: center; justify-content: space-between; }
    .modal-head h2 { display: flex; align-items: center; gap: 12px; font-size: 1.2rem; font-weight: 700; color: var(--txt); margin: 0; }
    .modal-head svg { width: 24px; height: 24px; color: var(--gold-soft); }
    .modal-close { background: none; border: none; color: var(--txt-dim); font-size: 1.8rem; line-height: 1; cursor: pointer; transition: all 0.2s; }
    .modal-close:hover { color: var(--txt); transform: rotate(90deg); }
    .modal-body { padding: 24px; }

    .hidden { display: none !important; }

    @media (max-width: 1024px) {
      .order-grid { grid-template-columns: 1fr; }
    }
    @media (max-width: 640px) {
      .order-page { padding: 18px 14px 44px; }
      .order-header h1 { font-size: 1.6rem; }
      .ship-grid, .ship-actions, .field-grid { grid-template-columns: 1fr; }
      .engrave-prod { flex-direction: column; }
      .engrave-prod-img { width: 100%; }
    }
  </style>

  <script>
    import { generateAndPrintTicket } from '@/services/ticketGenerator';
    import { actions } from 'astro:actions';
    // Diálogos propios: SweetAlert2 pierde su CSS con View Transitions y
    // termina saliendo sin estilos en una esquina.
    import { Alert, Confirm, Toast, Prompt } from '@/utils/alerts';

    interface ShippingAddress {
      streetAddress: string;
      city: string;
      state: string;
      zip: string;
      country: string;
    }

    function initializeOrderPage() {
      // 1. IMPRESIÓN DE TICKETS
      const productsDataEl = document.getElementById('products-data');
      const totalDataEl = document.getElementById('total-data');
      const orderNumberDataEl = document.getElementById('order-number-data');
      const paymentMethodDataEl = document.getElementById('payment-method-data');
      const discountDataEl = document.getElementById('discount-data');
      const additionalChargesDataEl = document.getElementById('additional-charges-data');

      const products = productsDataEl ? JSON.parse(productsDataEl.textContent || '[]') : [];
      const total = totalDataEl ? parseFloat(totalDataEl.textContent || '0') : 0;
      const orderNumber = orderNumberDataEl ? orderNumberDataEl.textContent || '' : 'N/A';
      const paymentMethod = paymentMethodDataEl ? paymentMethodDataEl.textContent || 'Desconocido' : 'Desconocido';
      const discountValue = discountDataEl ? parseFloat(discountDataEl.textContent || '0') : 0;
      const additionalChargesValue = additionalChargesDataEl ? parseFloat(additionalChargesDataEl.textContent || '0') : 0;
      // Lista de montos (JSON) o, en pedidos del formato anterior, solo la descripción
      const rawChargeDetail = (document.getElementById('additional-charge-desc-data')?.textContent || '').trim();
      let additionalChargeDetail: string | { amount: number; description: string }[] | undefined = rawChargeDetail || undefined;
      if (rawChargeDetail.startsWith('[')) {
        try { additionalChargeDetail = JSON.parse(rawChargeDetail); } catch {}
      }

      const printBtn = document.getElementById('print-ticket-btn');
      printBtn?.addEventListener('click', () => {
        const storeInfo = {
          name: 'Broquelizate',
          address: 'Calle Escobedo esquina con Calle Bravo (segundo piso), Colonia Centro, Gómez Palacio, Durango.',
          phone: '528 714 617696',
        };

        generateAndPrintTicket(
          products,
          total,
          orderNumber,
          paymentMethod,
          storeInfo,
          discountValue,
          additionalChargesValue,
          undefined,
          undefined,
          undefined,
          additionalChargeDetail
        );
      });

      // 2. GESTIÓN DE ENVÍOS
      const orderDataEl = document.getElementById('order-data');
      if (!orderDataEl) return;

      const orderId = orderDataEl.dataset.orderId;
      const trackingNumber = orderDataEl.dataset.trackingNumber;
      const carrier = orderDataEl.dataset.carrier;
      const labelUrl = orderDataEl.dataset.labelUrl;
      const customerEmail = orderDataEl.dataset.customerEmail;
      const customerPhone = orderDataEl.dataset.customerPhone;
      const customerName = orderDataEl.dataset.customerName;

      // Lo que el cliente eligió y pagó en el checkout. Sirve para marcar esa
      // misma opción al re-cotizar: comprar una guía más lenta que la pagada
      // es un problema para el cliente, y una más cara, para la tienda.
      const paidCarrier = (orderDataEl.dataset.carrier || '').toLowerCase();
      const paidService = (orderDataEl.dataset.paidService || '').toLowerCase();
      const paidCost = parseFloat(orderDataEl.dataset.paidCost || '');

      let shippingAddress: ShippingAddress;
      try {
        shippingAddress = JSON.parse(orderDataEl.dataset.shippingAddress || '{}') as ShippingAddress;
      } catch {
        shippingAddress = { streetAddress: 'N/A', city: 'N/A', state: 'N/A', zip: 'N/A', country: 'N/A' };
      }

      const ORIGIN_ADDRESS = {
        name: "Broquelizate",
        street: "Calle Escobedo esquina con Bravo",
        number: "222",
        district: "Colonia Centro",
        city: "Gómez Palacio",
        state: "Durango",
        postalCode: "35000",
        phone: "8714617696",
        email: "contacto@broquelizate.com"
      };

      // 3. COPIAR TRACKING
      const copyTrackingBtn = document.getElementById('copy-tracking-btn');
      copyTrackingBtn?.addEventListener('click', async () => {
        if (!trackingNumber) return;
        try {
          await navigator.clipboard.writeText(trackingNumber);
          const originalHTML = copyTrackingBtn.innerHTML;
          copyTrackingBtn.innerHTML = '✓ ¡Copiado!';
          setTimeout(() => { copyTrackingBtn.innerHTML = originalHTML; }, 2000);
        } catch (err) {
          console.error('Error al copiar:', err);
        }
      });

      // 4. IMPRIMIR ETIQUETA
      const printLabelBtn = document.getElementById('print-label-btn');
      printLabelBtn?.addEventListener('click', () => {
        if (!labelUrl) return;
        const printWindow = window.open(labelUrl, '_blank');
        if (printWindow) {
          printWindow.addEventListener('load', () => {
            setTimeout(() => { printWindow.print(); }, 500);
          });
        }
      });

      // 5. CARGAR DIRECCIÓN DEL USUARIO
      async function loadUserShippingAddress() {
        if (!customerEmail) return null;
        try {
          const { data, error } = await actions.getUserProfileByEmail({ email: customerEmail });
          if (error || !data || !data.user) return null;
          return data.user.shippingAddress;
        } catch (error) {
          console.error('Error loading user shipping address:', error);
          return null;
        }
      }

      // 6. EDITAR DIRECCIÓN
      const editShippingBtn = document.getElementById('edit-shipping-btn');
      editShippingBtn?.addEventListener('click', async () => {
        const cargando = Toast.loading('Cargando información…');

        const userAddress = await loadUserShippingAddress();
        const addressToUse = userAddress && userAddress.streetAddress ? userAddress : shippingAddress;
        const vieneDelPerfil = !!(userAddress && userAddress.streetAddress);

        Toast.dismiss(cargando);

        const formValues = await Prompt.show({
          title: 'Editar dirección de envío',
          message: vieneDelPerfil
            ? 'Cargada desde el perfil del cliente.'
            : 'El cliente no tiene dirección guardada: se usan los datos de la orden.',
          confirmText: 'Guardar',
          fields: [
            { id: 'streetAddress', label: 'Dirección',      placeholder: 'Calle y número', value: addressToUse.streetAddress },
            { id: 'city',          label: 'Ciudad',         placeholder: 'Ciudad',         value: addressToUse.city },
            { id: 'state',         label: 'Estado',         placeholder: 'Estado',         value: addressToUse.state },
            { id: 'zip',           label: 'Código postal',  placeholder: '5 dígitos',      value: addressToUse.zip },
            { id: 'country',       label: 'País',           placeholder: 'País',           value: addressToUse.country },
          ],
          validate: (v) => {
            if (!v.streetAddress?.trim()) return 'La dirección es obligatoria.';
            if (!v.city?.trim())          return 'La ciudad es obligatoria.';
            if (!v.state?.trim())         return 'El estado es obligatorio.';
            if (!/^\d{5}$/.test(v.zip?.trim() ?? '')) return 'El código postal debe tener exactamente 5 dígitos.';
            if (!v.country?.trim())       return 'El país es obligatorio.';
            return null;
          },
        });

        if (formValues) {
          const guardando = Toast.loading('Guardando dirección…');
          try {
            const direccion = {
              streetAddress: formValues.streetAddress.trim(),
              city: formValues.city.trim(),
              state: formValues.state.trim(),
              zip: formValues.zip.trim(),
              country: formValues.country.trim(),
            };
            const { error } = await actions.updateOrderShippingAddress({ orderId: orderId!, shippingAddress: direccion });
            Toast.dismiss(guardando);
            if (error) { await Alert.error('No se pudo guardar', error); return; }
            shippingAddress = direccion;
            Toast.success('Dirección actualizada');
            window.location.reload();
          } catch (error) {
            Toast.dismiss(guardando);
            console.error('Error:', error);
            await Alert.error('Error inesperado', 'Ocurrió un error al guardar la dirección.');
          }
        }
      });

      // 7. ACTUALIZAR ESTADO
      const updateStatusBtn = document.getElementById('update-status-btn');
      const statusSelect = document.getElementById('status-select') as HTMLSelectElement;

      // Lo que el admin necesita saber después de mover el estado: si las
      // piezas volvieron al almacén y, sobre todo, cuáles NO se pudieron
      // devolver solas. Ese aviso es el que evita que dé por cuadrado un
      // inventario que no lo está.
      async function avisarDelStock(data: any) {
        if (!data) return;

        if (data.stockError) {
          await Alert.warning(
            'Revisa el inventario',
            'El estado se guardó, pero las piezas no se pudieron devolver al inventario. Ajústalo a mano.',
          );
          return;
        }

        const pendientes = data.sinResolver ?? [];
        if (pendientes.length > 0) {
          const lista = pendientes
            .map((r: any) => `· ${r.cantidad} × ${r.producto}${r.detalle ? ` (${r.detalle})` : ''} — ${r.motivo}`)
            .join('\n');
          await Alert.warning(
            'Hay piezas que ajustar a mano',
            `Se devolvió lo que se pudo, pero estas no:\n\n${lista}`,
          );
          return;
        }

        if (data.stockDevuelto && data.renglonesAjustados > 0) {
          Toast.success('Piezas devueltas al inventario');
        } else if (data.stockTomado && data.renglonesAjustados > 0) {
          Toast.success('Piezas descontadas de nuevo');
        }
      }

      updateStatusBtn?.addEventListener('click', async () => {
        const newStatus = statusSelect?.value;
        if (!newStatus) return;

        const estadoActual = (document.getElementById('order-data') as HTMLElement | null)?.dataset.status || '';
        const tomaStock = (e: string) => ['paid', 'completed', 'processing', 'shipped'].includes(e);
        const devolvera = estadoActual !== 'cancelled' && newStatus === 'cancelled' && tomaStock(estadoActual);
        const retomara = estadoActual === 'cancelled' && tomaStock(newStatus);

        const confirmado = await Confirm.show({
          title: '¿Cambiar el estado?',
          message: `La orden pasará a "${newStatus}".`
            + (devolvera ? ' Las piezas vuelven al inventario.' : '')
            + (retomara ? ' Las piezas se vuelven a descontar del inventario.' : ''),
          confirmText: 'Sí, cambiar',
          type: 'info',
        });
        if (!confirmado) return;

        const actualizando = Toast.loading('Actualizando estado…');

        try {
          const { data, error } = await actions.updateOrderStatus({ orderId: orderId!, status: newStatus as any });
          Toast.dismiss(actualizando);
          if (error) { await Alert.error('No se pudo actualizar', error); return; }
          Toast.success('Estado actualizado');
          await avisarDelStock(data);
          window.location.reload();
        } catch (error) {
          Toast.dismiss(actualizando);
          console.error('Error:', error);
          await Alert.error('Error inesperado', 'Ocurrió un error al actualizar el estado.');
        }
      });

      // 7b. CANCELAR ORDEN (botón directo)
      const cancelOrderBtn = document.getElementById('cancel-order-btn');
      cancelOrderBtn?.addEventListener('click', async () => {
        const confirmado = await Confirm.show({
          title: '¿Cancelar esta orden?',
          message: 'Quedará marcada como cancelada, saldrá de las estadísticas de venta y las piezas vuelven al inventario.',
          confirmText: 'Sí, cancelar orden',
          cancelText: 'No, mantener',
          type: 'danger',
        });
        if (!confirmado) return;

        const cancelando = Toast.loading('Cancelando orden…');

        try {
          const { data, error } = await actions.updateOrderStatus({ orderId: orderId!, status: 'cancelled' as any });
          Toast.dismiss(cancelando);
          if (error) { await Alert.error('No se pudo cancelar', error); return; }
          Toast.success('Orden cancelada');
          await avisarDelStock(data);
          window.location.reload();
        } catch (error) {
          Toast.dismiss(cancelando);
          console.error('Error:', error);
          await Alert.error('Error inesperado', 'Ocurrió un error al cancelar la orden.');
        }
      });

      // 8. COTIZAR ENVÍO
      const quoteBtn = document.getElementById('quote-shipping-btn');
      const loadingRates = document.getElementById('loading-rates');
      const shippingRates = document.getElementById('shipping-rates');
      const ratesContainer = document.getElementById('rates-container');
      const errorRates = document.getElementById('error-rates');
      const errorMessage = document.getElementById('error-message');

      quoteBtn?.addEventListener('click', async () => {
        const weight = parseFloat((document.getElementById('weight') as HTMLInputElement)?.value || '0.5');
        const length = parseFloat((document.getElementById('length') as HTMLInputElement)?.value || '20');
        const width = parseFloat((document.getElementById('width') as HTMLInputElement)?.value || '15');
        const height = parseFloat((document.getElementById('height') as HTMLInputElement)?.value || '10');

        const currentZip = shippingAddress.zip;
        if (!currentZip || currentZip === 'N/A' || !/^\d{5}$/.test(currentZip)) {
          await Alert.warning(
            'Código postal inválido',
            'Edita la dirección de envío y asegúrate de que el código postal tenga 5 dígitos.'
          );
          return;
        }

        loadingRates?.classList.remove('hidden');
        shippingRates?.classList.add('hidden');
        errorRates?.classList.add('hidden');
        quoteBtn.disabled = true;

        try {
          const { data, error } = await actions.getShippingRates({
            originPostalCode: ORIGIN_ADDRESS.postalCode,
            destinationPostalCode: currentZip,
            destinationCity: shippingAddress.city,
            destinationState: shippingAddress.state,
            weight, length, width, height
          });

          loadingRates?.classList.add('hidden');

          if (error || !data?.success) {
            errorRates?.classList.remove('hidden');
            if (errorMessage) errorMessage.textContent = data?.error || error || 'Error al cotizar';
            return;
          }

          if (data.rates && data.rates.length > 0) {
            if (ratesContainer) {
              ratesContainer.innerHTML = data.rates.map((rate: any) => {
                const esLaPagada =
                  paidCarrier && rate.carrier?.toLowerCase() === paidCarrier &&
                  (!paidService || rate.service?.toLowerCase() === paidService);
                const borde = esLaPagada ? '#eab308' : 'rgba(255,255,255,0.07)';
                const diferencia = esLaPagada && !Number.isNaN(paidCost)
                  ? rate.totalPrice - paidCost
                  : null;

                return `
                <button class="rate-option" style="width:100%;padding:14px;border:1px solid ${borde};border-radius:12px;background:#0b0b0d;color:#f5f5f4;text-align:left;cursor:pointer;transition:all .18s;"
                  data-carrier="${rate.carrier}" data-service="${rate.service}" data-price="${rate.totalPrice}"
                  data-weight="${weight}" data-length="${length}" data-width="${width}" data-height="${height}"
                  onmouseover="this.style.borderColor='#60a5fa'" onmouseout="this.style.borderColor='${borde}'">
                  <div style="display:flex;justify-content:space-between;align-items:center;">
                    <div>
                      <p style="font-weight:700;font-size:1rem;text-transform:uppercase;margin:0;">${rate.carrier}</p>
                      <p style="font-size:0.8rem;color:rgba(245,245,244,0.55);margin:2px 0 0;">${rate.service}</p>
                      <p style="font-size:0.72rem;color:rgba(245,245,244,0.35);margin:4px 0 0;">${rate.deliveryDays} días estimados</p>
                      ${esLaPagada ? `<p style="font-size:0.7rem;color:#eab308;font-weight:600;margin:6px 0 0;">Es la que pagó el cliente</p>` : ''}
                    </div>
                    <div style="text-align:right;">
                      <p style="font-weight:800;font-size:1.4rem;color:#60a5fa;margin:0;">$${rate.totalPrice.toFixed(2)}</p>
                      <p style="font-size:0.7rem;color:rgba(245,245,244,0.35);margin:0;">${rate.currency}</p>
                      ${diferencia != null && Math.abs(diferencia) >= 1
                        ? `<p style="font-size:0.7rem;font-weight:600;margin:4px 0 0;color:${diferencia > 0 ? '#f87171' : '#34d399'};">
                             ${diferencia > 0 ? 'te cuesta' : 'te ahorras'} $${Math.abs(diferencia).toFixed(2)}
                           </p>`
                        : ''}
                    </div>
                  </div>
                </button>
              `;
              }).join('');

              document.querySelectorAll('.rate-option').forEach(btn => {
                btn.addEventListener('click', async (e) => {
                  const target = e.currentTarget as HTMLElement;
                  await createLabel(
                    target.dataset.carrier!,
                    target.dataset.service!,
                    parseFloat(target.dataset.weight!),
                    parseFloat(target.dataset.length!),
                    parseFloat(target.dataset.width!),
                    parseFloat(target.dataset.height!)
                  );
                });
              });
            }
            shippingRates?.classList.remove('hidden');
          } else {
            errorRates?.classList.remove('hidden');
            if (errorMessage) errorMessage.textContent = 'No se encontraron opciones de envío para este destino';
          }
        } catch (error) {
          console.error('Error:', error);
          loadingRates?.classList.add('hidden');
          errorRates?.classList.remove('hidden');
          if (errorMessage) errorMessage.textContent = 'Error de conexión al cotizar';
        } finally {
          quoteBtn.disabled = false;
        }
      });

      // 9. CREAR ETIQUETA
      async function createLabel(carrier: string, service: string, weight: number, length: number, width: number, height: number) {
        // Esta confirmación gasta saldo real de Envia: el resumen tiene que
        // dejar claro a dónde va y con qué peso antes de comprar.
        const confirmado = await Confirm.show({
          title: '¿Generar la guía?',
          message:
            `${carrier.toUpperCase()} ${service} a ${shippingAddress.city}, ${shippingAddress.state} ` +
            `(CP ${shippingAddress.zip}), ${weight} kg. ` +
            'Se cobra el saldo de Envia y el pedido pasa a "Enviado".',
          confirmText: 'Sí, generar',
          type: 'info',
        });
        if (!confirmado) return;

        const generando = Toast.loading(`Generando guía con ${carrier.toUpperCase()}…`);

        try {
          const { data, error } = await actions.createShippingLabel({
            orderId: orderId!,
            carrier, service,
            origin: ORIGIN_ADDRESS,
            destination: {
              name: customerName || customerEmail?.split('@')[0] || 'Cliente',
              street: shippingAddress.streetAddress || "Dirección del cliente",
              number: "S/N",
              district: shippingAddress.city || "Colonia",
              city: shippingAddress.city || "Ciudad",
              state: shippingAddress.state || "Estado",
              postalCode: shippingAddress.zip || "00000",
              phone: customerPhone || "0000000000",
              email: customerEmail || "cliente@email.com"
            },
            package: { weight, length, width, height }
          });

          Toast.dismiss(generando);

          if (error || !data?.success) {
            await Alert.error(
              'No se pudo generar la guía',
              `${data?.error || error || 'Error desconocido'}. Revisa que la dirección sea correcta y que el servicio esté disponible.`
            );
            return;
          }

          if (data.label) {
            await Alert.success(
              'Guía generada',
              `Número de rastreo: ${data.label.trackingNumber}. La etiqueta ya está lista para imprimir.`
            );
            window.location.reload();
          }
        } catch (error) {
          Toast.dismiss(generando);
          console.error('Error:', error);
          await Alert.error('Error inesperado', 'Ocurrió un error al crear la etiqueta de envío.');
        }
      }

      // 10. RASTREAR ENVÍO
      const trackBtn = document.getElementById('track-shipment-btn');
      const trackingModal = document.getElementById('tracking-modal');
      const trackingContent = document.getElementById('tracking-content');
      const closeModal = document.getElementById('close-modal');

      trackBtn?.addEventListener('click', async () => {
        if (!trackingNumber) return;

        trackingContent!.innerHTML = `<div style="text-align:center;padding:48px;"><div class="spinner-blue"></div><p style="color:rgba(245,245,244,0.55);margin-top:14px;">Obteniendo información de rastreo...</p></div>`;
        trackingModal?.classList.remove('hidden');

        try {
          const { data, error } = await actions.trackShipment({ trackingNumber, carrier });

          if (error || !data || !data.tracking) {
            trackingContent!.innerHTML = `<div style="text-align:center;padding:48px;color:#f87171;"><p style="font-size:1.1rem;font-weight:700;">Error al obtener tracking</p><p style="color:rgba(245,245,244,0.35);margin-top:8px;">${error || 'No se pudo obtener información'}</p></div>`;
            return;
          }

          const tracking = data.tracking;

          trackingContent!.innerHTML = `
            <div style="display:flex;flex-direction:column;gap:24px;">
              <div style="background:linear-gradient(135deg,#1d4ed8,#4338ca);color:#fff;padding:24px;border-radius:16px;">
                <div style="display:flex;align-items:center;gap:16px;margin-bottom:12px;">
                  <div style="width:56px;height:56px;background:rgba(255,255,255,0.15);border-radius:50%;display:flex;align-items:center;justify-content:center;">
                    <svg style="width:32px;height:32px;" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 8h14M5 8a2 2 0 110-4h14a2 2 0 110 4M5 8v10a2 2 0 002 2h10a2 2 0 002-2V8m-9 4h4"/></svg>
                  </div>
                  <div>
                    <p style="font-size:1.5rem;font-weight:800;margin:0;">${tracking.status}</p>
                    <p style="color:#c7d2fe;margin:0;">${tracking.currentLocation}</p>
                  </div>
                </div>
                ${tracking.estimatedDelivery ? `<div style="background:rgba(255,255,255,0.1);border-radius:10px;padding:12px;margin-top:14px;"><p style="font-size:0.85rem;color:#c7d2fe;margin:0;">📅 Entrega estimada: <strong style="color:#fff;">${tracking.estimatedDelivery}</strong></p></div>` : ''}
              </div>
              <div>
                <h3 style="font-weight:700;font-size:1.05rem;color:#f5f5f4;margin:0 0 16px;">Historial de Movimientos</h3>
                <div style="position:relative;">
                  ${tracking.events && tracking.events.length > 0 ? tracking.events.map((event: any, idx: number) => `
                    <div style="display:flex;gap:16px;padding-bottom:24px;${idx !== tracking.events.length - 1 ? 'border-left:2px solid rgba(96,165,250,0.3);margin-left:8px;' : 'margin-left:8px;'}">
                      <div style="position:absolute;left:0;width:18px;height:18px;border-radius:50%;${idx === 0 ? 'background:#60a5fa;box-shadow:0 0 0 4px rgba(96,165,250,0.2);' : 'background:rgba(96,165,250,0.5);'}transform:translateX(-8px);"></div>
                      <div style="margin-left:24px;background:#1b1b1f;padding:14px;border-radius:12px;flex:1;">
                        <p style="font-weight:600;color:#f5f5f4;margin:0;">${event.description}</p>
                        <p style="font-size:0.85rem;color:rgba(245,245,244,0.55);margin:4px 0 0;">📍 ${event.location}</p>
                        <p style="font-size:0.78rem;color:rgba(245,245,244,0.35);margin:6px 0 0;">🕐 ${event.date} ${event.time}</p>
                      </div>
                    </div>
                  `).join('') : '<p style="color:rgba(245,245,244,0.35);text-align:center;padding:16px;">No hay eventos de seguimiento disponibles</p>'}
                </div>
              </div>
              <div style="background:#1b1b1f;padding:16px;border-radius:12px;font-size:0.85rem;display:flex;flex-direction:column;gap:8px;">
                <p style="margin:0;"><span style="color:rgba(245,245,244,0.55);">📦 Tracking:</span> <span style="font-family:monospace;font-weight:600;">${trackingNumber}</span></p>
                <p style="margin:0;"><span style="color:rgba(245,245,244,0.55);">🚚 Paquetería:</span> <span style="font-weight:600;text-transform:uppercase;">${carrier || 'N/A'}</span></p>
              </div>
            </div>
          `;
        } catch (error) {
          console.error('Error:', error);
          trackingContent!.innerHTML = `<div style="text-align:center;padding:48px;color:#f87171;"><p style="font-size:1.1rem;font-weight:700;">❌ Error al obtener información de tracking</p></div>`;
        }
      });

      closeModal?.addEventListener('click', () => trackingModal?.classList.add('hidden'));
      trackingModal?.addEventListener('click', (e) => {
        if (e.target === trackingModal) trackingModal.classList.add('hidden');
      });
    }

    document.addEventListener('astro:page-load', initializeOrderPage);
  </script>
