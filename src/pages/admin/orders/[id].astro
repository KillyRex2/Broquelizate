---
// src/pages/admin/orders/[id].astro
import AdminLayout from '@/layouts/AdminLayout.astro';
import { db, orders, order_items } from 'astro:db';
import { eq } from 'drizzle-orm';
import { actions } from 'astro:actions';

// Definir el tipo para la dirección de envío
interface ShippingAddress {
  streetAddress: string;
  city: string;
  state: string;
  zip: string;
  country: string;
}

const { id } = Astro.params;
if (!id) return Astro.redirect('/admin/orders');

const order = await db.select().from(orders).where(eq(orders.id, id)).get();
if (!order) return Astro.redirect('/404');

const items = await db.select().from(order_items).where(eq(order_items.orderId, order.id)).all();

let clientName = 'Cliente de Mostrador';
if (order.clientId) {
  try {
    const { data: client } = await Astro.callAction(actions.getClientById, order.clientId.toString());
    if (client) {
      clientName = client.nombre; 
    } else {
      clientName = `Cliente no encontrado (ID: ${order.clientId})`;
    }
  } catch (error) {
    console.error('Error al obtener el cliente:', error);
    clientName = `Error al buscar (ID: ${order.clientId})`;
  }
}

const formatCurrency = (value: number | null) => value == null ? 'N/A' : new Intl.NumberFormat('es-MX', { style: 'currency', currency: 'MXN' }).format(value);
const formatDate = (date: Date | null) => date ? new Date(date).toLocaleDateString('es-MX', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric', hour: '2-digit', minute: '2-digit' }) : 'N/A';

// Tipar correctamente shippingAddress
let shippingAddress: ShippingAddress = { 
  streetAddress: 'N/A', 
  city: 'N/A', 
  state: 'N/A', 
  zip: 'N/A', 
  country: 'N/A' 
};

if (order.shippingAddress) {
  try { 
    shippingAddress = { ...shippingAddress, ...JSON.parse(order.shippingAddress) } 
  } catch (error) {
    console.error('Error parsing shipping address:', error);
  } 
}

// Configuración de origen para envíos
const ORIGIN_ADDRESS = {
  name: "Broquelizate",
  street: "Calle Escobedo esquina con Bravo",
  number: "222",
  district: "Colonia Centro",
  city: "Gómez Palacio",
  state: "Durango",
  postalCode: "35000",
  phone: "8714617696",
  email: "contacto@broquelizate.com"
};

// --- Lógica para Descuentos y Cargos Adicionales ---
const netAdjustment = (order.total ?? 0) - (order.subtotal ?? 0) - (order.tax ?? 0);
const additionalCharges = netAdjustment > 0 ? netAdjustment : 0;
const discount = netAdjustment < 0 ? Math.abs(netAdjustment) : 0;

// Verificar si tiene etiqueta generada
const hasShippingLabel = !!(order.trackingNumber && order.labelUrl);
const hasTrackingOnly = !!(order.trackingNumber && !order.labelUrl);
---

<AdminLayout title={`Orden #${order.orderNumber || order.id.slice(0,8)}`}>
  
  {/* --- Datos ocultos para el script de impresión --- */}
  <div id="products-data" style="display:none;">
    {JSON.stringify(items.map(i => ({ name: i.productName, price: i.price, quantity: i.quantity || 1 })))}
  </div>
  <div id="total-data" style="display:none;">{order.total ?? 0}</div>
  <div id="order-number-data" style="display:none;">{order.orderNumber || order.id.slice(0,8)}</div>
  <div id="payment-method-data" style="display:none;">{order.paymentMethod || 'Desconocido'}</div>
  <div id="discount-data" style="display:none;">{discount}</div>
  <div id="additional-charges-data" style="display:none;">{additionalCharges}</div>

  {/* Datos para gestión de envíos */}
  <div id="order-data" style="display:none;" 
    data-order-id={order.id}
    data-tracking-number={order.trackingNumber}
    data-carrier={order.carrier}
    data-label-url={order.labelUrl}
    data-destination-zip={shippingAddress.zip}
    data-customer-email={order.customerEmail}
    data-customer-phone={order.customerPhone}
    data-customer-name={order.customerName}
    data-shipping-address={JSON.stringify(shippingAddress)}
  ></div>

  <div class="bg-white rounded-2xl shadow-lg overflow-hidden">
    <div class="bg-gradient-to-r from-amber-500 to-yellow-400 p-6 flex justify-between items-center flex-wrap gap-4">
      <h1 class="text-2xl md:text-3xl font-semibold text-white">
        Orden <span class="font-mono text-white">#{order.orderNumber || order.id.slice(0,8)}</span>
      </h1>
      <div class="flex items-center gap-3">
        <button
          id="print-ticket-btn"
          class="bg-yellow-600 hover:bg-yellow-700 text-white font-bold px-4 py-2 rounded-lg shadow transition-transform hover:scale-105"
        >
          📄 Imprimir Ticket
        </button>
        <a href="/admin/orders" class="flex items-center text-white hover:opacity-80 transition-opacity">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
          </svg>
          Volver
        </a>
      </div>
    </div>

    <div class="p-6 lg:p-8 grid grid-cols-1 lg:grid-cols-3 gap-8">
      {/* Columna Principal */}
      <div class="lg:col-span-2 space-y-8">
        {/* Items del Pedido */}
        <div class="bg-white p-6 rounded-2xl shadow-lg border border-gray-100">
          <h2 class="text-xl font-semibold text-gray-800 border-b pb-4 mb-4">
            Artículos del Pedido ({items.length})
          </h2>
          <ul class="divide-y divide-gray-200">
            {items.map(item => (
              <li class="py-4 flex items-center justify-between hover:bg-amber-50 transition-colors">
                <div>
                  <p class="font-semibold text-gray-900">{item.productName}</p>
                  <p class="text-sm text-gray-500">Cantidad: {item.quantity}</p>
                </div>
                <div class="text-right">
                  <p class="font-medium text-gray-800">{formatCurrency(item.price * (item.quantity ?? 1))}</p>
                  <p class="text-sm text-gray-500">{formatCurrency(item.price)} c/u</p>
                </div>
              </li>
            ))}
          </ul>
        </div>

        {/* Totales */}
        <div class="bg-white p-6 rounded-2xl shadow-lg border border-gray-100">
          <div class="space-y-3 text-lg">
            <div class="flex justify-between">
              <span class="text-gray-600">Subtotal:</span>
              <span class="font-medium">{formatCurrency(order.subtotal)}</span>
            </div>
    
            {additionalCharges > 0 && (
              <div class="flex justify-between">
                <span class="text-gray-600">Monto adicional:</span>
                <span class="font-medium">{formatCurrency(additionalCharges)}</span>
              </div>
            )}
    
            {discount > 0 && (
              <div class="flex justify-between">
                <span class="text-gray-600">Descuento:</span>
                <span class="font-medium text-red-600">-{formatCurrency(discount)}</span>
              </div>
            )}
    
            <div class="border-t pt-3 mt-3 flex justify-between text-2xl font-bold">
              <span class="text-gray-900">Total:</span>
              <span class="text-amber-600">{formatCurrency(order.total)}</span>
            </div>
          </div>
        </div>

        {/* ============================================ */}
        {/* SECCIÓN DE ETIQUETA DE ENVÍO GENERADA */}
        {/* ============================================ */}
        {hasShippingLabel && (
          <div class="bg-gradient-to-br from-emerald-50 to-green-50 p-6 rounded-2xl shadow-lg border-2 border-emerald-200 relative overflow-hidden">
            {/* Badge de éxito */}
            <div class="absolute top-0 right-0 bg-emerald-500 text-white px-4 py-1 rounded-bl-xl text-sm font-bold">
              ✓ GUÍA GENERADA
            </div>
            
            <h2 class="text-xl font-semibold text-emerald-900 mb-6 flex items-center gap-3">
              <div class="w-12 h-12 bg-emerald-500 rounded-full flex items-center justify-center">
                <svg class="w-7 h-7 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                </svg>
              </div>
              Etiqueta de Envío
            </h2>
            
            {/* Info de la etiqueta */}
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-6">
              <div class="bg-white p-4 rounded-xl shadow-sm">
                <p class="text-xs text-gray-500 uppercase tracking-wide mb-1">Paquetería</p>
                <p class="text-2xl font-black text-gray-900 uppercase">{order.carrier}</p>
              </div>
              <div class="bg-white p-4 rounded-xl shadow-sm">
                <p class="text-xs text-gray-500 uppercase tracking-wide mb-1">Servicio</p>
                <p class="text-lg font-semibold text-gray-800">{order.shippingService || 'Estándar'}</p>
              </div>
            </div>

            {/* Número de Tracking */}
            <div class="bg-white p-5 rounded-xl shadow-sm mb-6">
              <p class="text-xs text-gray-500 uppercase tracking-wide mb-2">Número de Rastreo</p>
              <div class="flex items-center justify-between gap-4 flex-wrap">
                <p class="font-mono text-2xl font-bold text-blue-600 tracking-wider">{order.trackingNumber}</p>
                <button 
                  id="copy-tracking-btn"
                  class="px-4 py-2 bg-gray-100 hover:bg-gray-200 rounded-lg text-gray-700 font-medium transition-colors flex items-center gap-2"
                >
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2m0 0h2a2 2 0 012 2v3m2 4H10m0 0l3-3m-3 3l3 3"></path>
                  </svg>
                  Copiar
                </button>
              </div>
            </div>

            {/* Costo de envío si existe */}
            {order.shippingCost && (
              <div class="bg-amber-50 border border-amber-200 p-4 rounded-xl mb-6">
                <div class="flex justify-between items-center">
                  <span class="text-amber-800 font-medium">Costo del Envío:</span>
                  <span class="text-2xl font-bold text-amber-600">{formatCurrency(order.shippingCost)}</span>
                </div>
              </div>
            )}

            {/* Fecha de envío */}
            {order.shippedAt && (
              <p class="text-sm text-gray-600 mb-6">
                📅 Enviado el: <span class="font-medium">{formatDate(order.shippedAt)}</span>
              </p>
            )}

            {/* Botones de acción */}
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
              <a 
                href={order.labelUrl} 
                target="_blank"
                class="flex items-center justify-center gap-3 px-6 py-4 bg-blue-600 text-white rounded-xl hover:bg-blue-700 font-bold transition-all hover:scale-[1.02] shadow-lg hover:shadow-xl"
              >
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                </svg>
                Descargar PDF
              </a>
              <button 
                id="print-label-btn"
                class="flex items-center justify-center gap-3 px-6 py-4 bg-emerald-600 text-white rounded-xl hover:bg-emerald-700 font-bold transition-all hover:scale-[1.02] shadow-lg hover:shadow-xl"
              >
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z"></path>
                </svg>
                Imprimir Etiqueta
              </button>
            </div>

            {/* Botón de rastreo */}
            <button 
              id="track-shipment-btn"
              class="w-full mt-4 px-6 py-3 bg-gray-800 text-white rounded-xl hover:bg-gray-900 font-semibold transition-colors flex items-center justify-center gap-2"
            >
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
              </svg>
              Ver Rastreo en Tiempo Real
            </button>
          </div>
        )}

        {/* Información de Envío (solo tracking sin label) */}
        {hasTrackingOnly && (
          <div class="bg-blue-50 p-6 rounded-2xl shadow-lg border border-blue-200">
            <h2 class="text-xl font-semibold text-blue-900 mb-4">📦 Información de Envío</h2>
            <div class="space-y-3">
              <div class="bg-white p-4 rounded-lg">
                <p class="text-sm text-gray-600">Número de Rastreo</p>
                <div class="flex items-center justify-between flex-wrap gap-2">
                  <p class="font-mono font-bold text-lg text-blue-600">{order.trackingNumber}</p>
                  <button 
                    id="copy-tracking-btn"
                    class="px-3 py-1 bg-gray-100 hover:bg-gray-200 rounded text-sm text-gray-700 flex items-center gap-1"
                  >
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2"></path>
                    </svg>
                    Copiar
                  </button>
                </div>
              </div>
              <div class="grid grid-cols-2 gap-4">
                <div class="bg-white p-4 rounded-lg">
                  <p class="text-sm text-gray-600">Paquetería</p>
                  <p class="font-semibold text-gray-900 uppercase">{order.carrier}</p>
                </div>
                {order.shippingService && (
                  <div class="bg-white p-4 rounded-lg">
                    <p class="text-sm text-gray-600">Servicio</p>
                    <p class="font-semibold text-gray-900">{order.shippingService}</p>
                  </div>
                )}
              </div>
              {order.shippingCost && (
                <div class="bg-white p-4 rounded-lg">
                  <p class="text-sm text-gray-600">Costo de Envío</p>
                  <p class="font-bold text-lg text-amber-600">{formatCurrency(order.shippingCost)}</p>
                </div>
              )}
              <button 
                id="track-shipment-btn"
                class="w-full px-4 py-3 bg-gray-800 text-white rounded-lg hover:bg-gray-900 font-semibold transition-colors flex items-center justify-center gap-2"
              >
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                </svg>
                Ver Rastreo
              </button>
            </div>
          </div>
        )}
      </div>

      {/* Columna Lateral - Información y Acciones */}
      <div class="space-y-8">
        {/* Detalles de la Orden */}
        <div class="bg-white p-6 rounded-2xl shadow-lg border border-gray-100">
          <h2 class="text-xl font-semibold text-gray-800 mb-4">Detalles de la Orden</h2>
          <div class="space-y-3 text-gray-700">
            <p><strong>Fecha:</strong> {formatDate(order.createdAt)}</p>
            <p><strong>Cliente:</strong> {clientName}</p>
            <p>
              <strong>Estado:</strong> 
              <span class={`ml-2 px-3 py-1 rounded-full uppercase text-xs font-bold
                ${order.status === 'completed' ? 'bg-green-100 text-green-800' : ''}
                ${order.status === 'pending' ? 'bg-yellow-100 text-yellow-800' : ''}
                ${order.status === 'shipped' ? 'bg-blue-100 text-blue-800' : ''}
                ${order.status === 'cancelled' ? 'bg-red-100 text-red-800' : ''}
                ${order.status === 'processing' ? 'bg-purple-100 text-purple-800' : ''}
              `}>
                {order.status}
              </span>
            </p>
            <p><strong>Método de pago:</strong> <span class="font-semibold">{order.paymentMethod || 'No especificado'}</span></p>
          </div>
        </div>

        {/* Cambiar Estado */}
        <div class="bg-white p-6 rounded-2xl shadow-lg border border-gray-100">
          <h2 class="text-xl font-semibold text-gray-800 mb-4">⚙️ Cambiar Estado</h2>
          <div class="space-y-3">
            <select 
              id="status-select" 
              class="w-full px-4 py-3 border-2 border-gray-300 rounded-lg focus:ring-2 focus:ring-amber-500 focus:border-amber-500 transition-all"
            >
              <option value="pending" selected={order.status === 'pending'}>Pendiente</option>
              <option value="processing" selected={order.status === 'processing'}>Procesando</option>
              <option value="shipped" selected={order.status === 'shipped'}>Enviado</option>
              <option value="completed" selected={order.status === 'completed'}>Completado</option>
              <option value="cancelled" selected={order.status === 'cancelled'}>Cancelado</option>
            </select>
            
            <button 
              id="update-status-btn"
              class="w-full px-4 py-3 bg-amber-500 text-white rounded-lg hover:bg-amber-600 font-semibold transition-colors shadow-md hover:shadow-lg"
            >
              Actualizar Estado
            </button>
          </div>
        </div>

        {/* Información del Cliente */}
        <div class="bg-white p-6 rounded-2xl shadow-lg border border-gray-100">
          <div class="flex justify-between items-center mb-4">
            <h2 class="text-xl font-semibold text-gray-800">👤 Información del Cliente</h2>
            <button 
              id="edit-shipping-btn"
              class="text-amber-600 hover:text-amber-700 font-medium text-sm"
            >
              ✏️ Editar
            </button>
          </div>
          <div class="space-y-3 text-gray-700">
            {order.customerName && (
              <div>
                <p class="text-sm text-gray-500">Nombre</p>
                <p class="font-medium">{order.customerName}</p>
              </div>
            )}
            <div>
              <p class="text-sm text-gray-500">Email</p>
              <a href={`mailto:${order.customerEmail}`} class="text-amber-600 hover:underline font-medium">
                {order.customerEmail}
              </a>
            </div>
            {order.customerPhone && (
              <div>
                <p class="text-sm text-gray-500">Teléfono</p>
                <p class="font-medium">{order.customerPhone}</p>
              </div>
            )}
            <div class="border-t pt-3 mt-3">
              <h3 class="font-semibold text-gray-800 mb-2">📍 Dirección de Envío</h3>
              <div class="text-sm space-y-1">
                <p>{shippingAddress.streetAddress}</p>
                <p>{shippingAddress.city}, {shippingAddress.state}</p>
                <p>CP: {shippingAddress.zip}</p>
                <p>{shippingAddress.country}</p>
              </div>
            </div>
          </div>
        </div>

        {/* ============================================ */}
        {/* GESTIONAR ENVÍO (si no tiene tracking) */}
        {/* ============================================ */}
        {!order.trackingNumber && order.status !== 'cancelled' && (
          <div class="bg-gradient-to-br from-blue-50 to-indigo-50 p-6 rounded-2xl shadow-lg border-2 border-blue-200">
            <h2 class="text-xl font-semibold text-blue-900 mb-4 flex items-center gap-2">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 8h14M5 8a2 2 0 110-4h14a2 2 0 110 4M5 8v10a2 2 0 002 2h10a2 2 0 002-2V8m-9 4h4"></path>
              </svg>
              Gestionar Envío
            </h2>
            
            {/* Dimensiones del Paquete */}
            <div class="space-y-3 mb-4">
              <div>
                <label class="block text-sm font-medium text-gray-700 mb-1">Peso (kg)</label>
                <input 
                  type="number" 
                  id="weight" 
                  step="0.1"
                  value="0.5"
                  class="w-full px-3 py-2 border-2 border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500"
                />
              </div>
              <div class="grid grid-cols-3 gap-2">
                <div>
                  <label class="block text-sm font-medium text-gray-700 mb-1">Largo (cm)</label>
                  <input type="number" id="length" value="20" class="w-full px-3 py-2 border-2 border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500" />
                </div>
                <div>
                  <label class="block text-sm font-medium text-gray-700 mb-1">Ancho (cm)</label>
                  <input type="number" id="width" value="15" class="w-full px-3 py-2 border-2 border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500" />
                </div>
                <div>
                  <label class="block text-sm font-medium text-gray-700 mb-1">Alto (cm)</label>
                  <input type="number" id="height" value="10" class="w-full px-3 py-2 border-2 border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500" />
                </div>
              </div>
            </div>

            <button 
              id="quote-shipping-btn"
              class="w-full px-4 py-3 bg-blue-600 text-white rounded-lg hover:bg-blue-700 font-semibold transition-all shadow-md hover:shadow-lg flex items-center justify-center gap-2"
            >
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z"></path>
              </svg>
              Cotizar Envío
            </button>

            {/* Resultados de Cotización */}
            <div id="shipping-rates" class="hidden mt-4">
              <h3 class="font-semibold text-gray-800 mb-3 flex items-center gap-2">
                <svg class="w-5 h-5 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
                Opciones Disponibles:
              </h3>
              <div id="rates-container" class="space-y-2 max-h-80 overflow-y-auto"></div>
            </div>

            {/* Loading State */}
            <div id="loading-rates" class="hidden mt-4 text-center py-6">
              <div class="inline-block animate-spin rounded-full h-10 w-10 border-4 border-blue-200 border-t-blue-600"></div>
              <p class="text-sm text-gray-600 mt-3">Buscando las mejores opciones de envío...</p>
            </div>

            {/* Error State */}
            <div id="error-rates" class="hidden mt-4 p-4 bg-red-50 border border-red-200 rounded-lg">
              <p class="text-red-700 font-medium flex items-center gap-2">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
                <span id="error-message"></span>
              </p>
            </div>
          </div>
        )}

        {/* Resumen de envío cuando ya tiene etiqueta */}
        {hasShippingLabel && (
          <div class="bg-white p-6 rounded-2xl shadow-lg border border-gray-100">
            <h2 class="text-xl font-semibold text-gray-800 mb-4">📊 Resumen de Envío</h2>
            <div class="space-y-3 text-sm">
              <div class="flex justify-between py-2 border-b">
                <span class="text-gray-600">Paquetería</span>
                <span class="font-semibold uppercase">{order.carrier}</span>
              </div>
              <div class="flex justify-between py-2 border-b">
                <span class="text-gray-600">Servicio</span>
                <span class="font-semibold">{order.shippingService || 'Estándar'}</span>
              </div>
              {order.shippingCost && (
                <div class="flex justify-between py-2 border-b">
                  <span class="text-gray-600">Costo</span>
                  <span class="font-bold text-amber-600">{formatCurrency(order.shippingCost)}</span>
                </div>
              )}
              <div class="flex justify-between py-2">
                <span class="text-gray-600">Estado</span>
                <span class="px-2 py-1 bg-green-100 text-green-800 rounded-full text-xs font-bold">
                  ETIQUETA GENERADA
                </span>
              </div>
            </div>
          </div>
        )}
      </div>
    </div>
  </div>

  {/* Modal de Tracking */}
  <div id="tracking-modal" class="hidden fixed inset-0 bg-black bg-opacity-50 z-50 flex items-center justify-center p-4">
    <div class="bg-white rounded-2xl max-w-3xl w-full max-h-[90vh] overflow-y-auto shadow-2xl">
      <div class="sticky top-0 bg-gradient-to-r from-blue-600 to-indigo-600 p-6 flex justify-between items-center">
        <h2 class="text-2xl font-bold text-white flex items-center gap-3">
          <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 20l-5.447-2.724A1 1 0 013 16.382V5.618a1 1 0 011.447-.894L9 7m0 13l6-3m-6 3V7m6 10l4.553 2.276A1 1 0 0021 18.382V7.618a1 1 0 00-.553-.894L15 4m0 13V4m0 0L9 7"></path>
          </svg>
          Rastreo de Envío
        </h2>
        <button id="close-modal" class="text-white hover:text-gray-200 text-3xl font-bold leading-none hover:rotate-90 transition-transform">×</button>
      </div>
      <div id="tracking-content" class="p-6"></div>
    </div>
  </div>
</AdminLayout>

<script>
  import { generateAndPrintTicket } from '@/services/ticketGenerator';
  import { actions } from 'astro:actions';
  import Swal from 'sweetalert2';

  interface ShippingAddress {
    streetAddress: string;
    city: string;
    state: string;
    zip: string;
    country: string;
  }

  function initializeOrderPage() {
    // ============================================
    // 1. IMPRESIÓN DE TICKETS
    // ============================================
    const productsDataEl = document.getElementById('products-data');
    const totalDataEl = document.getElementById('total-data');
    const orderNumberDataEl = document.getElementById('order-number-data');
    const paymentMethodDataEl = document.getElementById('payment-method-data');
    const discountDataEl = document.getElementById('discount-data');
    const additionalChargesDataEl = document.getElementById('additional-charges-data');

    const products = productsDataEl ? JSON.parse(productsDataEl.textContent || '[]') : [];
    const total = totalDataEl ? parseFloat(totalDataEl.textContent || '0') : 0;
    const orderNumber = orderNumberDataEl ? orderNumberDataEl.textContent || '' : 'N/A';
    const paymentMethod = paymentMethodDataEl ? paymentMethodDataEl.textContent || 'Desconocido' : 'Desconocido';
    const discountValue = discountDataEl ? parseFloat(discountDataEl.textContent || '0') : 0;
    const additionalChargesValue = additionalChargesDataEl ? parseFloat(additionalChargesDataEl.textContent || '0') : 0;

    const printBtn = document.getElementById('print-ticket-btn');
    printBtn?.addEventListener('click', () => {
      const storeInfo = {
        name: 'Broquelizate',
        address: 'esquina con, Calle Escobedo, Bravo 222, Colonia Centro, 35000 Gómez Palacio, Dgo.',
        phone: '+528714617696',
      };

      generateAndPrintTicket(
        products, 
        total, 
        orderNumber, 
        paymentMethod, 
        storeInfo,
        discountValue,
        additionalChargesValue
      );
    });

    // ============================================
    // 2. GESTIÓN DE ENVÍOS
    // ============================================
    const orderDataEl = document.getElementById('order-data');
    if (!orderDataEl) return;

    const orderId = orderDataEl.dataset.orderId;
    const trackingNumber = orderDataEl.dataset.trackingNumber;
    const carrier = orderDataEl.dataset.carrier;
    const labelUrl = orderDataEl.dataset.labelUrl;
    const customerEmail = orderDataEl.dataset.customerEmail;
    const customerPhone = orderDataEl.dataset.customerPhone;
    const customerName = orderDataEl.dataset.customerName;
    let shippingAddress: ShippingAddress;
    try {
      shippingAddress = JSON.parse(orderDataEl.dataset.shippingAddress || '{}') as ShippingAddress;
    } catch {
      shippingAddress = {
        streetAddress: 'N/A',
        city: 'N/A',
        state: 'N/A',
        zip: 'N/A',
        country: 'N/A'
      };
    }

    const ORIGIN_ADDRESS = {
      name: "Broquelizate",
      street: "Calle Escobedo esquina con Bravo",
      number: "222",
      district: "Colonia Centro",
      city: "Gómez Palacio",
      state: "Durango",
      postalCode: "35000",
      phone: "8714617696",
      email: "contacto@broquelizate.com"
    };

    // ============================================
    // 3. COPIAR NÚMERO DE TRACKING
    // ============================================
    const copyTrackingBtn = document.getElementById('copy-tracking-btn');
    copyTrackingBtn?.addEventListener('click', async () => {
      if (!trackingNumber) return;
      
      try {
        await navigator.clipboard.writeText(trackingNumber);
        
        // Feedback visual
        const originalHTML = copyTrackingBtn.innerHTML;
        copyTrackingBtn.innerHTML = `
          <svg class="w-5 h-5 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
          </svg>
          ¡Copiado!
        `;
        copyTrackingBtn.classList.add('bg-green-100');
        
        setTimeout(() => {
          copyTrackingBtn.innerHTML = originalHTML;
          copyTrackingBtn.classList.remove('bg-green-100');
        }, 2000);
      } catch (err) {
        console.error('Error al copiar:', err);
      }
    });

    // ============================================
    // 4. IMPRIMIR ETIQUETA
    // ============================================
    const printLabelBtn = document.getElementById('print-label-btn');
    printLabelBtn?.addEventListener('click', () => {
      if (!labelUrl) return;
      
      // Abrir PDF en nueva ventana e imprimir
      const printWindow = window.open(labelUrl, '_blank');
      if (printWindow) {
        printWindow.addEventListener('load', () => {
          setTimeout(() => {
            printWindow.print();
          }, 500);
        });
      }
    });

    // ============================================
    // 5. CARGAR DIRECCIÓN DEL USUARIO AUTOMÁTICAMENTE
    // ============================================
    async function loadUserShippingAddress() {
      if (!customerEmail) {
        console.log('No customer email available');
        return null;
      }

      try {
        const { data, error } = await actions.getUserProfileByEmail({ email: customerEmail });
        
        if (error || !data || !data.user) {
          console.log('User not found or no shipping address');
          return null;
        }

        return data.user.shippingAddress;
      } catch (error) {
        console.error('Error loading user shipping address:', error);
        return null;
      }
    }

    // ============================================
    // 6. EDITAR DIRECCIÓN DE ENVÍO
    // ============================================
    const editShippingBtn = document.getElementById('edit-shipping-btn');
    editShippingBtn?.addEventListener('click', async () => {
      Swal.fire({
        title: 'Cargando información...',
        allowOutsideClick: false,
        allowEscapeKey: false,
        didOpen: () => {
          Swal.showLoading();
        }
      });

      const userAddress = await loadUserShippingAddress();
      const addressToUse = userAddress && userAddress.streetAddress ? userAddress : shippingAddress;

      Swal.close();

      const { value: formValues } = await Swal.fire({
        title: '📍 Editar Dirección de Envío',
        html: `
          <div class="space-y-4 text-left p-4">
            ${userAddress && userAddress.streetAddress ? 
              '<div class="bg-green-50 border border-green-200 rounded-lg p-3 mb-4"><p class="text-sm text-green-800">✅ Dirección cargada desde el perfil del usuario</p></div>' : 
              '<div class="bg-yellow-50 border border-yellow-200 rounded-lg p-3 mb-4"><p class="text-sm text-yellow-800">⚠️ Usuario sin dirección guardada, usando datos de la orden</p></div>'
            }
            <div>
              <label class="block text-sm font-semibold text-gray-700 mb-1">Dirección *</label>
              <input id="swal-street" type="text" class="w-full px-3 py-2 border-2 border-gray-300 rounded-lg focus:ring-2 focus:ring-amber-500 focus:border-amber-500" placeholder="Calle y número" value="${addressToUse.streetAddress}">
            </div>
            <div class="grid grid-cols-2 gap-3">
              <div>
                <label class="block text-sm font-semibold text-gray-700 mb-1">Ciudad *</label>
                <input id="swal-city" type="text" class="w-full px-3 py-2 border-2 border-gray-300 rounded-lg focus:ring-2 focus:ring-amber-500 focus:border-amber-500" placeholder="Ciudad" value="${addressToUse.city}">
              </div>
              <div>
                <label class="block text-sm font-semibold text-gray-700 mb-1">Estado *</label>
                <input id="swal-state" type="text" class="w-full px-3 py-2 border-2 border-gray-300 rounded-lg focus:ring-2 focus:ring-amber-500 focus:border-amber-500" placeholder="Estado" value="${addressToUse.state}">
              </div>
            </div>
            <div class="grid grid-cols-2 gap-3">
              <div>
                <label class="block text-sm font-semibold text-gray-700 mb-1">Código Postal *</label>
                <input id="swal-zip" type="text" maxlength="5" class="w-full px-3 py-2 border-2 border-gray-300 rounded-lg focus:ring-2 focus:ring-amber-500 focus:border-amber-500" placeholder="CP (5 dígitos)" value="${addressToUse.zip}">
              </div>
              <div>
                <label class="block text-sm font-semibold text-gray-700 mb-1">País *</label>
                <input id="swal-country" type="text" class="w-full px-3 py-2 border-2 border-gray-300 rounded-lg focus:ring-2 focus:ring-amber-500 focus:border-amber-500" placeholder="País" value="${addressToUse.country}">
              </div>
            </div>
          </div>
        `,
        width: '600px',
        focusConfirm: false,
        showCancelButton: true,
        confirmButtonText: '💾 Guardar',
        cancelButtonText: '❌ Cancelar',
        confirmButtonColor: '#f59e0b',
        cancelButtonColor: '#6b7280',
        customClass: {
          popup: 'rounded-2xl',
          confirmButton: 'px-6 py-3 rounded-lg font-semibold',
          cancelButton: 'px-6 py-3 rounded-lg font-semibold'
        },
        preConfirm: () => {
          const street = (document.getElementById('swal-street') as HTMLInputElement).value.trim();
          const city = (document.getElementById('swal-city') as HTMLInputElement).value.trim();
          const state = (document.getElementById('swal-state') as HTMLInputElement).value.trim();
          const zip = (document.getElementById('swal-zip') as HTMLInputElement).value.trim();
          const country = (document.getElementById('swal-country') as HTMLInputElement).value.trim();

          if (!street) { Swal.showValidationMessage('La dirección es requerida'); return false; }
          if (!city) { Swal.showValidationMessage('La ciudad es requerida'); return false; }
          if (!state) { Swal.showValidationMessage('El estado es requerido'); return false; }
          if (!zip || !/^\d{5}$/.test(zip)) { Swal.showValidationMessage('El código postal debe contener exactamente 5 dígitos'); return false; }
          if (!country) { Swal.showValidationMessage('El país es requerido'); return false; }

          return { streetAddress: street, city, state, zip, country };
        }
      });

      if (formValues) {
        Swal.fire({
          title: 'Guardando dirección...',
          allowOutsideClick: false,
          allowEscapeKey: false,
          didOpen: () => { Swal.showLoading(); }
        });

        try {
          const { data, error } = await actions.updateOrderShippingAddress({
            orderId: orderId!,
            shippingAddress: formValues
          });

          if (error) {
            await Swal.fire({ icon: 'error', title: 'Error al guardar', text: error, confirmButtonColor: '#f59e0b' });
            return;
          }

          shippingAddress = formValues;
          
          await Swal.fire({
            icon: 'success',
            title: '¡Dirección actualizada!',
            confirmButtonColor: '#f59e0b',
            timer: 1500,
            timerProgressBar: true
          });
          
          window.location.reload();
        } catch (error) {
          console.error('Error:', error);
          await Swal.fire({ icon: 'error', title: 'Error inesperado', text: 'Ocurrió un error al guardar la dirección', confirmButtonColor: '#f59e0b' });
        }
      }
    });

    // ============================================
    // 7. ACTUALIZAR ESTADO
    // ============================================
    const updateStatusBtn = document.getElementById('update-status-btn');
    const statusSelect = document.getElementById('status-select') as HTMLSelectElement;
    
    updateStatusBtn?.addEventListener('click', async () => {
      const newStatus = statusSelect?.value;
      if (!newStatus) return;

      const result = await Swal.fire({
        title: '¿Cambiar estado de la orden?',
        html: `<p class="text-gray-700">El estado cambiará a <strong class="text-amber-600">"${newStatus}"</strong></p>`,
        icon: 'question',
        showCancelButton: true,
        confirmButtonText: '✅ Sí, cambiar',
        cancelButtonText: '❌ Cancelar',
        confirmButtonColor: '#f59e0b',
        cancelButtonColor: '#6b7280'
      });

      if (!result.isConfirmed) return;

      Swal.fire({ title: 'Actualizando estado...', allowOutsideClick: false, didOpen: () => { Swal.showLoading(); } });

      try {
        const { data, error } = await actions.updateOrderStatus({ orderId: orderId!, status: newStatus as any });

        if (error) {
          await Swal.fire({ icon: 'error', title: 'Error', text: error, confirmButtonColor: '#f59e0b' });
          return;
        }

        await Swal.fire({ icon: 'success', title: '¡Estado actualizado!', confirmButtonColor: '#f59e0b', timer: 1500, timerProgressBar: true });
        window.location.reload();
      } catch (error) {
        console.error('Error:', error);
        await Swal.fire({ icon: 'error', title: 'Error', text: 'Ocurrió un error al actualizar el estado', confirmButtonColor: '#f59e0b' });
      }
    });

    // ============================================
    // 8. COTIZAR ENVÍO
    // ============================================
    const quoteBtn = document.getElementById('quote-shipping-btn');
    const loadingRates = document.getElementById('loading-rates');
    const shippingRates = document.getElementById('shipping-rates');
    const ratesContainer = document.getElementById('rates-container');
    const errorRates = document.getElementById('error-rates');
    const errorMessage = document.getElementById('error-message');

    quoteBtn?.addEventListener('click', async () => {
      const weight = parseFloat((document.getElementById('weight') as HTMLInputElement)?.value || '0.5');
      const length = parseFloat((document.getElementById('length') as HTMLInputElement)?.value || '20');
      const width = parseFloat((document.getElementById('width') as HTMLInputElement)?.value || '15');
      const height = parseFloat((document.getElementById('height') as HTMLInputElement)?.value || '10');

      const currentZip = shippingAddress.zip;
      if (!currentZip || currentZip === 'N/A' || !/^\d{5}$/.test(currentZip)) {
        await Swal.fire({
          icon: 'warning',
          title: 'Código postal inválido',
          html: `<p class="text-gray-700">Por favor, edita la dirección de envío y asegúrate de incluir un código postal de 5 dígitos.</p>`,
          confirmButtonColor: '#f59e0b'
        });
        return;
      }

      // Mostrar loading
      loadingRates?.classList.remove('hidden');
      shippingRates?.classList.add('hidden');
      errorRates?.classList.add('hidden');
      quoteBtn.disabled = true;
      quoteBtn.innerHTML = '<span class="inline-block animate-spin mr-2">⏳</span> Cotizando...';

      try {
        const { data, error } = await actions.getShippingRates({
          originPostalCode: ORIGIN_ADDRESS.postalCode,
          destinationPostalCode: currentZip,
          destinationCity: shippingAddress.city,
          destinationState: shippingAddress.state,
          weight,
          length,
          width,
          height
        });

        loadingRates?.classList.add('hidden');

        if (error || !data?.success) {
          errorRates?.classList.remove('hidden');
          if (errorMessage) errorMessage.textContent = data?.error || error || 'Error al cotizar';
          return;
        }

        if (data.rates && data.rates.length > 0) {
          if (ratesContainer) {
            ratesContainer.innerHTML = data.rates.map((rate: any) => `
              <button 
                class="rate-option w-full p-4 border-2 border-gray-200 rounded-xl hover:border-blue-500 hover:bg-blue-50 text-left transition-all transform hover:scale-[1.01] hover:shadow-md"
                data-carrier="${rate.carrier}"
                data-service="${rate.service}"
                data-price="${rate.totalPrice}"
                data-weight="${weight}"
                data-length="${length}"
                data-width="${width}"
                data-height="${height}"
              >
                <div class="flex justify-between items-center">
                  <div>
                    <p class="font-bold text-gray-900 text-lg uppercase">${rate.carrier}</p>
                    <p class="text-sm text-gray-600">${rate.service}</p>
                    <p class="text-xs text-gray-500 mt-1 flex items-center gap-1">
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                      </svg>
                      ${rate.deliveryDays} días estimados
                    </p>
                  </div>
                  <div class="text-right">
                    <p class="font-bold text-2xl text-blue-600">$${rate.totalPrice.toFixed(2)}</p>
                    <p class="text-xs text-gray-500">${rate.currency}</p>
                  </div>
                </div>
              </button>
            `).join('');

            document.querySelectorAll('.rate-option').forEach(btn => {
              btn.addEventListener('click', async (e) => {
                const target = e.currentTarget as HTMLElement;
                await createLabel(
                  target.dataset.carrier!,
                  target.dataset.service!,
                  parseFloat(target.dataset.weight!),
                  parseFloat(target.dataset.length!),
                  parseFloat(target.dataset.width!),
                  parseFloat(target.dataset.height!)
                );
              });
            });
          }
          
          shippingRates?.classList.remove('hidden');
        } else {
          errorRates?.classList.remove('hidden');
          if (errorMessage) errorMessage.textContent = 'No se encontraron opciones de envío para este destino';
        }
      } catch (error) {
        console.error('Error:', error);
        loadingRates?.classList.add('hidden');
        errorRates?.classList.remove('hidden');
        if (errorMessage) errorMessage.textContent = 'Error de conexión al cotizar';
      } finally {
        quoteBtn.disabled = false;
        quoteBtn.innerHTML = `
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z"></path>
          </svg>
          Cotizar Envío
        `;
      }
    });

    // ============================================
    // 9. CREAR ETIQUETA DE ENVÍO
    // ============================================
    async function createLabel(carrier: string, service: string, weight: number, length: number, width: number, height: number) {
      const result = await Swal.fire({
        title: '¿Generar guía de envío?',
        html: `
          <div class="text-left bg-gradient-to-r from-blue-50 to-indigo-50 p-5 rounded-xl">
            <div class="flex items-center gap-3 mb-4">
              <div class="w-12 h-12 bg-blue-600 rounded-full flex items-center justify-center">
                <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 8h14M5 8a2 2 0 110-4h14a2 2 0 110 4M5 8v10a2 2 0 002 2h10a2 2 0 002-2V8m-9 4h4"></path>
                </svg>
              </div>
              <div>
                <p class="font-bold text-xl text-gray-900 uppercase">${carrier}</p>
                <p class="text-gray-600">${service}</p>
              </div>
            </div>
            <div class="space-y-2 text-sm">
              <p class="flex justify-between"><span class="text-gray-600">📍 Destino:</span> <span class="font-medium">${shippingAddress.city}, ${shippingAddress.state}</span></p>
              <p class="flex justify-between"><span class="text-gray-600">📮 C.P.:</span> <span class="font-medium">${shippingAddress.zip}</span></p>
              <p class="flex justify-between"><span class="text-gray-600">📦 Peso:</span> <span class="font-medium">${weight} kg</span></p>
            </div>
            <div class="mt-4 pt-4 border-t border-blue-200">
              <p class="text-xs text-blue-700">Se generará la guía y el estado cambiará a "Enviado"</p>
            </div>
          </div>
        `,
        icon: 'question',
        showCancelButton: true,
        confirmButtonText: '✅ Generar Guía',
        cancelButtonText: '❌ Cancelar',
        confirmButtonColor: '#3b82f6',
        cancelButtonColor: '#6b7280'
      });

      if (!result.isConfirmed) return;

      Swal.fire({
        title: 'Generando guía de envío...',
        html: `
          <div class="py-4">
            <div class="inline-block animate-spin rounded-full h-12 w-12 border-4 border-blue-200 border-t-blue-600 mb-4"></div>
            <p class="text-gray-600">Conectando con ${carrier.toUpperCase()}...</p>
          </div>
        `,
        allowOutsideClick: false,
        showConfirmButton: false
      });

      try {
        const { data, error } = await actions.createShippingLabel({
          orderId: orderId!,
          carrier,
          service,
          origin: ORIGIN_ADDRESS,
          destination: {
            name: customerName || customerEmail?.split('@')[0] || 'Cliente',
            street: shippingAddress.streetAddress || "Dirección del cliente",
            number: "S/N",
            district: shippingAddress.city || "Colonia",
            city: shippingAddress.city || "Ciudad",
            state: shippingAddress.state || "Estado",
            postalCode: shippingAddress.zip || "00000",
            phone: customerPhone || "0000000000",
            email: customerEmail || "cliente@email.com"
          },
          package: { weight, length, width, height }
        });

        if (error || !data?.success) {
          await Swal.fire({
            icon: 'error',
            title: 'Error al generar guía',
            html: `
              <div class="text-left">
                <p class="text-gray-700 mb-3">${data?.error || error || 'Error desconocido'}</p>
                <p class="text-sm text-gray-500">Verifica que la dirección de envío sea correcta y que el servicio esté disponible.</p>
              </div>
            `,
            confirmButtonColor: '#f59e0b'
          });
          return;
        }

        if (data.label) {
          await Swal.fire({
            icon: 'success',
            title: '¡Guía generada exitosamente!',
            html: `
              <div class="text-left">
                <div class="bg-green-50 border border-green-200 p-4 rounded-xl mb-4">
                  <p class="text-sm text-gray-600 mb-1">Número de rastreo:</p>
                  <p class="font-mono font-bold text-2xl text-blue-600">${data.label.trackingNumber}</p>
                </div>
                <p class="text-sm text-gray-600">La etiqueta está lista para imprimir.</p>
              </div>
            `,
            confirmButtonText: '🖨️ Ver Etiqueta',
            confirmButtonColor: '#10b981'
          });
          
          window.location.reload();
        }
      } catch (error) {
        console.error('Error:', error);
        await Swal.fire({
          icon: 'error',
          title: 'Error',
          text: 'Ocurrió un error al crear la etiqueta de envío',
          confirmButtonColor: '#f59e0b'
        });
      }
    }

    // ============================================
    // 10. RASTREAR ENVÍO
    // ============================================
    const trackBtn = document.getElementById('track-shipment-btn');
    const trackingModal = document.getElementById('tracking-modal');
    const trackingContent = document.getElementById('tracking-content');
    const closeModal = document.getElementById('close-modal');

    trackBtn?.addEventListener('click', async () => {
      if (!trackingNumber) return;

      trackingContent!.innerHTML = `
        <div class="text-center py-12">
          <div class="inline-block animate-spin rounded-full h-12 w-12 border-4 border-blue-200 border-t-blue-600 mb-4"></div>
          <p class="text-gray-600">Obteniendo información de rastreo...</p>
        </div>
      `;
      trackingModal?.classList.remove('hidden');

      try {
        const { data, error } = await actions.trackShipment({ trackingNumber, carrier });

        if (error || !data || !data.tracking) {
          trackingContent!.innerHTML = `
            <div class="text-center py-12">
              <div class="w-16 h-16 bg-red-100 rounded-full flex items-center justify-center mx-auto mb-4">
                <svg class="w-8 h-8 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                </svg>
              </div>
              <p class="text-red-600 text-lg font-semibold">Error al obtener tracking</p>
              <p class="text-gray-500 mt-2">${error || 'No se pudo obtener información'}</p>
            </div>
          `;
          return;
        }

        const tracking = data.tracking;
        
        trackingContent!.innerHTML = `
          <div class="space-y-6">
            <div class="bg-gradient-to-r from-blue-500 to-indigo-600 text-white p-6 rounded-2xl shadow-lg">
              <div class="flex items-center gap-4 mb-3">
                <div class="w-14 h-14 bg-white/20 rounded-full flex items-center justify-center">
                  <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 8h14M5 8a2 2 0 110-4h14a2 2 0 110 4M5 8v10a2 2 0 002 2h10a2 2 0 002-2V8m-9 4h4"></path>
                  </svg>
                </div>
                <div>
                  <p class="text-2xl font-bold">${tracking.status}</p>
                  <p class="text-blue-100">${tracking.currentLocation}</p>
                </div>
              </div>
              ${tracking.estimatedDelivery ? `
                <div class="bg-white/10 rounded-lg p-3 mt-4">
                  <p class="text-sm text-blue-100">📅 Entrega estimada: <span class="font-semibold text-white">${tracking.estimatedDelivery}</span></p>
                </div>
              ` : ''}
            </div>
            
            <div>
              <h3 class="font-bold text-lg text-gray-800 mb-4 flex items-center gap-2">
                <svg class="w-5 h-5 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
                Historial de Movimientos
              </h3>
              <div class="relative">
                ${tracking.events && tracking.events.length > 0 ? tracking.events.map((event: any, idx: number) => `
                  <div class="flex gap-4 pb-6 ${idx !== tracking.events.length - 1 ? 'border-l-2 border-blue-200 ml-2' : 'ml-2'}">
                    <div class="absolute left-0 w-5 h-5 rounded-full ${idx === 0 ? 'bg-blue-600 ring-4 ring-blue-100' : 'bg-blue-300'} -translate-x-[6px]"></div>
                    <div class="ml-6 bg-gray-50 p-4 rounded-xl flex-1 hover:bg-gray-100 transition-colors">
                      <p class="font-semibold text-gray-900">${event.description}</p>
                      <p class="text-sm text-gray-600 mt-1">📍 ${event.location}</p>
                      <p class="text-xs text-gray-500 mt-2">🕐 ${event.date} ${event.time}</p>
                    </div>
                  </div>
                `).join('') : '<p class="text-gray-500 text-center py-4">No hay eventos de seguimiento disponibles</p>'}
              </div>
            </div>

            <div class="bg-gray-100 p-4 rounded-xl text-sm space-y-2">
              <p class="flex items-center gap-2">
                <span class="text-gray-600">📦 Tracking:</span>
                <span class="font-mono font-semibold">${trackingNumber}</span>
              </p>
              <p class="flex items-center gap-2">
                <span class="text-gray-600">🚚 Paquetería:</span>
                <span class="font-semibold uppercase">${carrier || 'N/A'}</span>
              </p>
            </div>
          </div>
        `;
      } catch (error) {
        console.error('Error:', error);
        trackingContent!.innerHTML = `
          <div class="text-center py-12 text-red-600">
            <p class="text-lg font-semibold">❌ Error al obtener información de tracking</p>
          </div>
        `;
      }
    });

    closeModal?.addEventListener('click', () => trackingModal?.classList.add('hidden'));
    trackingModal?.addEventListener('click', (e) => {
      if (e.target === trackingModal) trackingModal.classList.add('hidden');
    });
  }

  document.addEventListener('astro:page-load', initializeOrderPage);
</script>
