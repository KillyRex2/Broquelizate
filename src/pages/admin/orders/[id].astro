---
// src/pages/admin/orders/[id].astro
import AdminLayout from '@/layouts/AdminLayout.astro';
import { db, orders, order_items } from 'astro:db';
import { eq } from 'drizzle-orm';
import { actions } from 'astro:actions';

interface ShippingAddress {
  streetAddress: string;
  city: string;
  state: string;
  zip: string;
  country: string;
}

const { id } = Astro.params;
if (!id) return Astro.redirect('/admin/orders');

const order = await db.select().from(orders).where(eq(orders.id, id)).get();
if (!order) return Astro.redirect('/404');

const rawItems = await db.select().from(order_items).where(eq(order_items.orderId, order.id)).all();

const items = rawItems.map(item => {
  let engravingData = null;
  if ((item as any).engraving) {
    try {
      engravingData = typeof (item as any).engraving === 'string'
        ? JSON.parse((item as any).engraving)
        : (item as any).engraving;
    } catch (e) { console.warn('Error parseando engraving:', e); }
  }
  return { ...item, engraving: engravingData };
});

const engravingItems = items.filter(i => i.engraving);

let clientName = 'Cliente de Mostrador';
if (order.clientId) {
  try {
    const { data: client } = await Astro.callAction(actions.getClientById, order.clientId.toString());
    if (client) {
      clientName = client.nombre;
    } else {
      clientName = `Cliente no encontrado (ID: ${order.clientId})`;
    }
  } catch (error) {
    console.error('Error al obtener el cliente:', error);
    clientName = `Error al buscar (ID: ${order.clientId})`;
  }
}

const formatCurrency = (value: number | null) => value == null ? 'N/A' : new Intl.NumberFormat('es-MX', { style: 'currency', currency: 'MXN' }).format(value);
const formatDate = (date: Date | null) => date ? new Date(date).toLocaleDateString('es-MX', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric', hour: '2-digit', minute: '2-digit' }) : 'N/A';

let shippingAddress: ShippingAddress = {
  streetAddress: 'N/A', city: 'N/A', state: 'N/A', zip: 'N/A', country: 'N/A'
};

if (order.shippingAddress) {
  try {
    shippingAddress = { ...shippingAddress, ...JSON.parse(order.shippingAddress) }
  } catch (error) {
    console.error('Error parsing shipping address:', error);
  }
}

const ORIGIN_ADDRESS = {
  name: "Broquelizate",
  street: "Calle Escobedo esquina con Bravo",
  number: "222",
  district: "Colonia Centro",
  city: "Gómez Palacio",
  state: "Durango",
  postalCode: "35000",
  phone: "8714617696",
  email: "contacto@broquelizate.com"
};

const netAdjustment = (order.total ?? 0) - (order.subtotal ?? 0) - (order.tax ?? 0);
const additionalCharges = netAdjustment > 0 ? netAdjustment : 0;
const discount = netAdjustment < 0 ? Math.abs(netAdjustment) : 0;

const hasShippingLabel = !!(order.trackingNumber && order.labelUrl);
const hasTrackingOnly = !!(order.trackingNumber && !order.labelUrl);

const statusLabels: Record<string, string> = {
  pending: 'Pendiente', processing: 'Procesando', shipped: 'Enviado', completed: 'Completado', cancelled: 'Cancelado'
};
---

<AdminLayout title={`Orden #${order.orderNumber || order.id.slice(0,8)}`}>

  {/* --- Datos ocultos para el script de impresión --- */}
  <div id="products-data" style="display:none;">
    {JSON.stringify(items.map(i => ({ name: i.productName, price: i.price, quantity: i.quantity || 1 })))}
  </div>
  <div id="total-data" style="display:none;">{order.total ?? 0}</div>
  <div id="order-number-data" style="display:none;">{order.orderNumber || order.id.slice(0,8)}</div>
  <div id="payment-method-data" style="display:none;">{order.paymentMethod || 'Desconocido'}</div>
  <div id="discount-data" style="display:none;">{discount}</div>
  <div id="additional-charges-data" style="display:none;">{additionalCharges}</div>

  {/* Datos para gestión de envíos */}
  <div id="order-data" style="display:none;"
    data-order-id={order.id}
    data-tracking-number={order.trackingNumber}
    data-carrier={order.carrier}
    data-label-url={order.labelUrl}
    data-destination-zip={shippingAddress.zip}
    data-customer-email={order.customerEmail}
    data-customer-phone={order.customerPhone}
    data-customer-name={order.customerName}
    data-shipping-address={JSON.stringify(shippingAddress)}
  ></div>

  <div class="order-page">
    {/* Header */}
    <header class="order-header">
      <div class="oh-left">
        <p class="eyebrow">Detalle de venta</p>
        <h1>Orden <span class="ord-num">#{order.orderNumber || order.id.slice(0,8)}</span></h1>
      </div>
      <div class="oh-actions">
        <button id="print-ticket-btn" class="btn btn-gold">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z"/></svg>
          Imprimir Ticket
        </button>
        <a href="/admin/orders" class="btn btn-ghost">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18"/></svg>
          Volver
        </a>
      </div>
    </header>

    <div class="order-grid">
      {/* Columna principal */}
      <div class="col-main">
        {/* Artículos */}
        <section class="panel">
          <div class="panel-head">
            <h2>Artículos del pedido</h2>
            <span class="count-badge">{items.length}</span>
          </div>
          <ul class="items-list">
            {items.map(item => (
              <li class="item-row">
                <div class="item-top">
                  <div class="item-info">
                    <p class="item-name">{item.productName}</p>
                    <p class="item-qty">Cantidad: {item.quantity}</p>
                  </div>
                  <div class="item-prices">
                    <p class="item-total">{formatCurrency(item.price * (item.quantity ?? 1))}</p>
                    <p class="item-unit">{formatCurrency(item.price)} c/u</p>
                  </div>
                </div>
                {item.engraving && (
                  <div class="engrave-chip">
                    <img src={item.engraving.imageUrl} alt="Grabado láser" class="engrave-thumb" />
                    <div class="engrave-info">
                      <div class="engrave-title">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"/></svg>
                        <span>Grabado láser personalizado</span>
                      </div>
                      {item.engraving.notes && <p class="engrave-notes">"{item.engraving.notes}"</p>}
                    </div>
                    <a href={item.engraving.imageUrl} target="_blank" class="engrave-link">Ver imagen</a>
                  </div>
                )}
              </li>
            ))}
          </ul>
        </section>

        {/* Totales */}
        <section class="panel">
          <div class="totals">
            <div class="t-row">
              <span>Subtotal</span>
              <span class="t-val">{formatCurrency(order.subtotal)}</span>
            </div>
            {additionalCharges > 0 && (
              <div class="t-row">
                <span>Monto adicional</span>
                <span class="t-val">{formatCurrency(additionalCharges)}</span>
              </div>
            )}
            {discount > 0 && (
              <div class="t-row">
                <span>Descuento</span>
                <span class="t-val t-discount">-{formatCurrency(discount)}</span>
              </div>
            )}
            <div class="t-row t-grand">
              <span>Total</span>
              <span class="t-grand-val">{formatCurrency(order.total)}</span>
            </div>
          </div>
        </section>

        {/* GRABADO LÁSER PARA PRODUCCIÓN */}
        {engravingItems.length > 0 && (
          <section class="panel panel-accent">
            <div class="corner-badge corner-gold">🔥 GRABADO LÁSER</div>
            <div class="panel-head">
              <div class="head-icon head-icon-gold">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"/></svg>
              </div>
              <h2>Archivos de grabado para producción</h2>
            </div>
            <p class="panel-sub">
              {engravingItems.length === 1 ? 'Este pedido incluye 1 producto con grabado láser personalizado.' : `Este pedido incluye ${engravingItems.length} productos con grabado láser personalizado.`}
              Descarga las imágenes en alta resolución para producción.
            </p>
            <div class="engrave-prod-list">
              {engravingItems.map((item, idx) => (
                <div class="engrave-prod">
                  <div class="engrave-prod-img">
                    <img src={item.engraving.imageUrl} alt={`Grabado para ${item.productName}`} />
                  </div>
                  <div class="engrave-prod-body">
                    <div class="engrave-prod-head">
                      <div>
                        <p class="engrave-prod-name">{item.productName}</p>
                        <p class="engrave-prod-qty">Cantidad a grabar: {item.quantity}</p>
                        {item.engraving.notes && (
                          <div class="engrave-prod-note">
                            <p class="note-label">Notas del cliente:</p>
                            <p class="note-text">"{item.engraving.notes}"</p>
                          </div>
                        )}
                      </div>
                      <span class="prod-num">#{idx + 1}</span>
                    </div>
                    <div class="engrave-prod-actions">
                      <a href={item.engraving.imageUrl} target="_blank" class="btn btn-blue btn-sm">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>
                        Ver Original
                      </a>
                      <a href={item.engraving.imageUrl} download={`grabado-${item.productName?.replace(/\s+/g, '-').toLowerCase()}-${idx + 1}.png`} class="btn btn-green btn-sm">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
                        Descargar HD
                      </a>
                    </div>
                  </div>
                </div>
              ))}
            </div>
            <div class="info-note">
              <svg viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd"/></svg>
              Las imágenes están almacenadas en Cloudinary. Formatos: JPG, PNG, WEBP, GIF. Máximo 10MB.
            </div>
          </section>
        )}

        {/* ETIQUETA DE ENVÍO GENERADA */}
        {hasShippingLabel && (
          <section class="panel panel-accent">
            <div class="corner-badge corner-green">✓ GUÍA GENERADA</div>
            <div class="panel-head">
              <div class="head-icon head-icon-green">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
              </div>
              <h2>Etiqueta de Envío</h2>
            </div>

            <div class="ship-grid">
              <div class="mini-card">
                <p class="mini-label">Paquetería</p>
                <p class="mini-value-lg">{order.carrier}</p>
              </div>
              <div class="mini-card">
                <p class="mini-label">Servicio</p>
                <p class="mini-value">{order.shippingService || 'Estándar'}</p>
              </div>
            </div>

            <div class="track-box">
              <p class="mini-label">Número de Rastreo</p>
              <div class="track-row">
                <p class="track-number">{order.trackingNumber}</p>
                <button id="copy-tracking-btn" class="btn btn-soft btn-sm">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2m0 0h2a2 2 0 012 2v3m2 4H10m0 0l3-3m-3 3l3 3"/></svg>
                  Copiar
                </button>
              </div>
            </div>

            {order.shippingCost && (
              <div class="cost-box">
                <span>Costo del Envío</span>
                <span class="cost-val">{formatCurrency(order.shippingCost)}</span>
              </div>
            )}

            {order.shippedAt && (
              <p class="ship-date">📅 Enviado el: <strong>{formatDate(order.shippedAt)}</strong></p>
            )}

            <div class="ship-actions">
              <a href={order.labelUrl} target="_blank" class="btn btn-blue btn-lg">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
                Descargar PDF
              </a>
              <button id="print-label-btn" class="btn btn-green btn-lg">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z"/></svg>
                Imprimir Etiqueta
              </button>
            </div>

            <button id="track-shipment-btn" class="btn btn-dark btn-block">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
              Ver Rastreo en Tiempo Real
            </button>
          </section>
        )}

        {/* Tracking sin label */}
        {hasTrackingOnly && (
          <section class="panel">
            <div class="panel-head"><h2>📦 Información de Envío</h2></div>
            <div class="track-box">
              <p class="mini-label">Número de Rastreo</p>
              <div class="track-row">
                <p class="track-number">{order.trackingNumber}</p>
                <button id="copy-tracking-btn" class="btn btn-soft btn-sm">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2"/></svg>
                  Copiar
                </button>
              </div>
            </div>
            <div class="ship-grid" style="margin-top:14px;">
              <div class="mini-card">
                <p class="mini-label">Paquetería</p>
                <p class="mini-value">{order.carrier}</p>
              </div>
              {order.shippingService && (
                <div class="mini-card">
                  <p class="mini-label">Servicio</p>
                  <p class="mini-value">{order.shippingService}</p>
                </div>
              )}
            </div>
            {order.shippingCost && (
              <div class="cost-box" style="margin-top:14px;">
                <span>Costo de Envío</span>
                <span class="cost-val">{formatCurrency(order.shippingCost)}</span>
              </div>
            )}
            <button id="track-shipment-btn" class="btn btn-dark btn-block" style="margin-top:14px;">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
              Ver Rastreo
            </button>
          </section>
        )}
      </div>

      {/* Columna lateral */}
      <div class="col-side">
        {/* Detalles */}
        <section class="panel">
          <div class="panel-head"><h2>Detalles de la orden</h2></div>
          <div class="detail-list">
            <div class="detail-row"><span class="detail-key">Fecha</span><span class="detail-val">{formatDate(order.createdAt)}</span></div>
            <div class="detail-row"><span class="detail-key">Cliente</span><span class="detail-val">{clientName}</span></div>
            <div class="detail-row">
              <span class="detail-key">Estado</span>
              <span class={`status-pill status-${order.status}`}>{statusLabels[order.status] || order.status}</span>
            </div>
            <div class="detail-row"><span class="detail-key">Método de pago</span><span class="detail-val">{order.paymentMethod || 'No especificado'}</span></div>
          </div>
        </section>

        {/* Cambiar estado */}
        <section class="panel">
          <div class="panel-head"><h2>⚙️ Cambiar estado</h2></div>
          <div class="status-control">
            <select id="status-select" class="dark-select">
              <option value="pending" selected={order.status === 'pending'}>Pendiente</option>
              <option value="processing" selected={order.status === 'processing'}>Procesando</option>
              <option value="shipped" selected={order.status === 'shipped'}>Enviado</option>
              <option value="completed" selected={order.status === 'completed'}>Completado</option>
              <option value="cancelled" selected={order.status === 'cancelled'}>Cancelado</option>
            </select>
            <button id="update-status-btn" class="btn btn-gold btn-block">Actualizar Estado</button>
            {order.status !== 'cancelled' && (
              <button id="cancel-order-btn" class="btn btn-danger btn-block">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/></svg>
                Cancelar Orden
              </button>
            )}
          </div>
        </section>

        {/* Cliente */}
        <section class="panel">
          <div class="panel-head between">
            <h2>👤 Información del cliente</h2>
            <button id="edit-shipping-btn" class="link-edit">✏️ Editar</button>
          </div>
          <div class="detail-list">
            {order.customerName && (
              <div class="kv"><p class="kv-key">Nombre</p><p class="kv-val">{order.customerName}</p></div>
            )}
            <div class="kv">
              <p class="kv-key">Email</p>
              <a href={`mailto:${order.customerEmail}`} class="kv-link">{order.customerEmail}</a>
            </div>
            {order.customerPhone && (
              <div class="kv"><p class="kv-key">Teléfono</p><p class="kv-val">{order.customerPhone}</p></div>
            )}
            <div class="addr-block">
              <h3>📍 Dirección de envío</h3>
              <div class="addr-lines">
                <p>{shippingAddress.streetAddress}</p>
                <p>{shippingAddress.city}, {shippingAddress.state}</p>
                <p>CP: {shippingAddress.zip}</p>
                <p>{shippingAddress.country}</p>
              </div>
            </div>
          </div>
        </section>

        {/* Gestionar envío */}
        {!order.trackingNumber && order.status !== 'cancelled' && (
          <section class="panel panel-accent">
            <div class="panel-head">
              <div class="head-icon head-icon-blue">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 8h14M5 8a2 2 0 110-4h14a2 2 0 110 4M5 8v10a2 2 0 002 2h10a2 2 0 002-2V8m-9 4h4"/></svg>
              </div>
              <h2>Gestionar envío</h2>
            </div>

            <div class="ship-form">
              <div class="field">
                <label>Peso (kg)</label>
                <input type="number" id="weight" step="0.1" value="0.5" class="dark-input" />
              </div>
              <div class="field-grid">
                <div class="field"><label>Largo (cm)</label><input type="number" id="length" value="20" class="dark-input" /></div>
                <div class="field"><label>Ancho (cm)</label><input type="number" id="width" value="15" class="dark-input" /></div>
                <div class="field"><label>Alto (cm)</label><input type="number" id="height" value="10" class="dark-input" /></div>
              </div>
            </div>

            <button id="quote-shipping-btn" class="btn btn-blue btn-block">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z"/></svg>
              Cotizar Envío
            </button>

            <div id="shipping-rates" class="hidden rates-wrap">
              <h3 class="rates-title">Opciones disponibles:</h3>
              <div id="rates-container" class="rates-container"></div>
            </div>

            <div id="loading-rates" class="hidden loading-block">
              <div class="spinner-blue"></div>
              <p>Buscando las mejores opciones de envío...</p>
            </div>

            <div id="error-rates" class="hidden error-block">
              <p><span id="error-message"></span></p>
            </div>
          </section>
        )}

        {/* Resumen de envío con etiqueta */}
        {hasShippingLabel && (
          <section class="panel">
            <div class="panel-head"><h2>📊 Resumen de envío</h2></div>
            <div class="detail-list">
              <div class="detail-row"><span class="detail-key">Paquetería</span><span class="detail-val">{order.carrier}</span></div>
              <div class="detail-row"><span class="detail-key">Servicio</span><span class="detail-val">{order.shippingService || 'Estándar'}</span></div>
              {order.shippingCost && (
                <div class="detail-row"><span class="detail-key">Costo</span><span class="detail-val t-gold">{formatCurrency(order.shippingCost)}</span></div>
              )}
              <div class="detail-row"><span class="detail-key">Estado</span><span class="status-pill status-completed">Etiqueta generada</span></div>
            </div>
          </section>
        )}
      </div>
    </div>
  </div>

  {/* Modal de Tracking */}
