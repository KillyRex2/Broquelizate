  <script>
    import { generateAndPrintTicket } from '@/services/ticketGenerator';
    import { actions } from 'astro:actions';
    import Swal from 'sweetalert2';

    interface ShippingAddress {
      streetAddress: string;
      city: string;
      state: string;
      zip: string;
      country: string;
    }

    function initializeOrderPage() {
      // 1. IMPRESIÓN DE TICKETS
      const productsDataEl = document.getElementById('products-data');
      const totalDataEl = document.getElementById('total-data');
      const orderNumberDataEl = document.getElementById('order-number-data');
      const paymentMethodDataEl = document.getElementById('payment-method-data');
      const discountDataEl = document.getElementById('discount-data');
      const additionalChargesDataEl = document.getElementById('additional-charges-data');

      const products = productsDataEl ? JSON.parse(productsDataEl.textContent || '[]') : [];
      const total = totalDataEl ? parseFloat(totalDataEl.textContent || '0') : 0;
      const orderNumber = orderNumberDataEl ? orderNumberDataEl.textContent || '' : 'N/A';
      const paymentMethod = paymentMethodDataEl ? paymentMethodDataEl.textContent || 'Desconocido' : 'Desconocido';
      const discountValue = discountDataEl ? parseFloat(discountDataEl.textContent || '0') : 0;
      const additionalChargesValue = additionalChargesDataEl ? parseFloat(additionalChargesDataEl.textContent || '0') : 0;

      const printBtn = document.getElementById('print-ticket-btn');
      printBtn?.addEventListener('click', () => {
        const storeInfo = {
          name: 'Broquelizate',
          address: 'Calle Escobedo esquina con Calle Bravo (segundo piso), Colonia Centro, Gómez Palacio, Durango.',
          phone: '528 714 617696',
        };

        generateAndPrintTicket(
          products,
          total,
          orderNumber,
          paymentMethod,
          storeInfo,
          discountValue,
          additionalChargesValue
        );
      });

      // 2. GESTIÓN DE ENVÍOS
      const orderDataEl = document.getElementById('order-data');
      if (!orderDataEl) return;

      const orderId = orderDataEl.dataset.orderId;
      const trackingNumber = orderDataEl.dataset.trackingNumber;
      const carrier = orderDataEl.dataset.carrier;
      const labelUrl = orderDataEl.dataset.labelUrl;
      const customerEmail = orderDataEl.dataset.customerEmail;
      const customerPhone = orderDataEl.dataset.customerPhone;
      const customerName = orderDataEl.dataset.customerName;
      let shippingAddress: ShippingAddress;
      try {
        shippingAddress = JSON.parse(orderDataEl.dataset.shippingAddress || '{}') as ShippingAddress;
      } catch {
        shippingAddress = { streetAddress: 'N/A', city: 'N/A', state: 'N/A', zip: 'N/A', country: 'N/A' };
      }

      const ORIGIN_ADDRESS = {
        name: "Broquelizate",
        street: "Calle Escobedo esquina con Bravo",
        number: "222",
        district: "Colonia Centro",
        city: "Gómez Palacio",
        state: "Durango",
        postalCode: "35000",
        phone: "8714617696",
        email: "contacto@broquelizate.com"
      };

      // 3. COPIAR TRACKING
      const copyTrackingBtn = document.getElementById('copy-tracking-btn');
      copyTrackingBtn?.addEventListener('click', async () => {
        if (!trackingNumber) return;
        try {
          await navigator.clipboard.writeText(trackingNumber);
          const originalHTML = copyTrackingBtn.innerHTML;
          copyTrackingBtn.innerHTML = '✓ ¡Copiado!';
          setTimeout(() => { copyTrackingBtn.innerHTML = originalHTML; }, 2000);
        } catch (err) {
          console.error('Error al copiar:', err);
        }
      });

      // 4. IMPRIMIR ETIQUETA
      const printLabelBtn = document.getElementById('print-label-btn');
      printLabelBtn?.addEventListener('click', () => {
        if (!labelUrl) return;
        const printWindow = window.open(labelUrl, '_blank');
        if (printWindow) {
          printWindow.addEventListener('load', () => {
            setTimeout(() => { printWindow.print(); }, 500);
          });
        }
      });

      // 5. CARGAR DIRECCIÓN DEL USUARIO
      async function loadUserShippingAddress() {
        if (!customerEmail) return null;
        try {
          const { data, error } = await actions.getUserProfileByEmail({ email: customerEmail });
          if (error || !data || !data.user) return null;
          return data.user.shippingAddress;
        } catch (error) {
          console.error('Error loading user shipping address:', error);
          return null;
        }
      }

      // 6. EDITAR DIRECCIÓN
      const editShippingBtn = document.getElementById('edit-shipping-btn');
      editShippingBtn?.addEventListener('click', async () => {
        Swal.fire({ title: 'Cargando información...', allowOutsideClick: false, allowEscapeKey: false, didOpen: () => { Swal.showLoading(); } });

        const userAddress = await loadUserShippingAddress();
        const addressToUse = userAddress && userAddress.streetAddress ? userAddress : shippingAddress;

        Swal.close();

        const { value: formValues } = await Swal.fire({
          title: '📍 Editar Dirección de Envío',
          html: `
            <div class="space-y-4 text-left p-4">
              ${userAddress && userAddress.streetAddress ?
                '<div class="bg-green-50 border border-green-200 rounded-lg p-3 mb-4"><p class="text-sm text-green-800">✅ Dirección cargada desde el perfil del usuario</p></div>' :
                '<div class="bg-yellow-50 border border-yellow-200 rounded-lg p-3 mb-4"><p class="text-sm text-yellow-800">⚠️ Usuario sin dirección guardada, usando datos de la orden</p></div>'
              }
              <div>
                <label class="block text-sm font-semibold text-gray-700 mb-1">Dirección *</label>
                <input id="swal-street" type="text" class="w-full px-3 py-2 border-2 border-gray-300 rounded-lg focus:ring-2 focus:ring-amber-500 focus:border-amber-500" placeholder="Calle y número" value="${addressToUse.streetAddress}">
              </div>
              <div class="grid grid-cols-2 gap-3">
                <div>
                  <label class="block text-sm font-semibold text-gray-700 mb-1">Ciudad *</label>
                  <input id="swal-city" type="text" class="w-full px-3 py-2 border-2 border-gray-300 rounded-lg focus:ring-2 focus:ring-amber-500 focus:border-amber-500" placeholder="Ciudad" value="${addressToUse.city}">
                </div>
                <div>
                  <label class="block text-sm font-semibold text-gray-700 mb-1">Estado *</label>
                  <input id="swal-state" type="text" class="w-full px-3 py-2 border-2 border-gray-300 rounded-lg focus:ring-2 focus:ring-amber-500 focus:border-amber-500" placeholder="Estado" value="${addressToUse.state}">
                </div>
              </div>
              <div class="grid grid-cols-2 gap-3">
                <div>
                  <label class="block text-sm font-semibold text-gray-700 mb-1">Código Postal *</label>
                  <input id="swal-zip" type="text" maxlength="5" class="w-full px-3 py-2 border-2 border-gray-300 rounded-lg focus:ring-2 focus:ring-amber-500 focus:border-amber-500" placeholder="CP (5 dígitos)" value="${addressToUse.zip}">
                </div>
                <div>
                  <label class="block text-sm font-semibold text-gray-700 mb-1">País *</label>
                  <input id="swal-country" type="text" class="w-full px-3 py-2 border-2 border-gray-300 rounded-lg focus:ring-2 focus:ring-amber-500 focus:border-amber-500" placeholder="País" value="${addressToUse.country}">
                </div>
              </div>
            </div>
          `,
          width: '600px',
          focusConfirm: false,
          showCancelButton: true,
          confirmButtonText: '💾 Guardar',
          cancelButtonText: '❌ Cancelar',
          confirmButtonColor: '#f59e0b',
          cancelButtonColor: '#6b7280',
          customClass: { popup: 'rounded-2xl', confirmButton: 'px-6 py-3 rounded-lg font-semibold', cancelButton: 'px-6 py-3 rounded-lg font-semibold' },
          preConfirm: () => {
            const street = (document.getElementById('swal-street') as HTMLInputElement).value.trim();
            const city = (document.getElementById('swal-city') as HTMLInputElement).value.trim();
            const state = (document.getElementById('swal-state') as HTMLInputElement).value.trim();
            const zip = (document.getElementById('swal-zip') as HTMLInputElement).value.trim();
            const country = (document.getElementById('swal-country') as HTMLInputElement).value.trim();
            if (!street) { Swal.showValidationMessage('La dirección es requerida'); return false; }
            if (!city) { Swal.showValidationMessage('La ciudad es requerida'); return false; }
            if (!state) { Swal.showValidationMessage('El estado es requerido'); return false; }
            if (!zip || !/^\d{5}$/.test(zip)) { Swal.showValidationMessage('El código postal debe contener exactamente 5 dígitos'); return false; }
            if (!country) { Swal.showValidationMessage('El país es requerido'); return false; }
            return { streetAddress: street, city, state, zip, country };
          }
        });

        if (formValues) {
          Swal.fire({ title: 'Guardando dirección...', allowOutsideClick: false, allowEscapeKey: false, didOpen: () => { Swal.showLoading(); } });
          try {
            const { data, error } = await actions.updateOrderShippingAddress({ orderId: orderId!, shippingAddress: formValues });
            if (error) { await Swal.fire({ icon: 'error', title: 'Error al guardar', text: error, confirmButtonColor: '#f59e0b' }); return; }
            shippingAddress = formValues;
            await Swal.fire({ icon: 'success', title: '¡Dirección actualizada!', confirmButtonColor: '#f59e0b', timer: 1500, timerProgressBar: true });
            window.location.reload();
          } catch (error) {
            console.error('Error:', error);
            await Swal.fire({ icon: 'error', title: 'Error inesperado', text: 'Ocurrió un error al guardar la dirección', confirmButtonColor: '#f59e0b' });
          }
        }
      });

      // 7. ACTUALIZAR ESTADO
      const updateStatusBtn = document.getElementById('update-status-btn');
      const statusSelect = document.getElementById('status-select') as HTMLSelectElement;

      updateStatusBtn?.addEventListener('click', async () => {
        const newStatus = statusSelect?.value;
        if (!newStatus) return;

        const result = await Swal.fire({
          title: '¿Cambiar estado de la orden?',
          html: `<p class="text-gray-700">El estado cambiará a <strong class="text-amber-600">"${newStatus}"</strong></p>`,
          icon: 'question',
          showCancelButton: true,
          confirmButtonText: '✅ Sí, cambiar',
          cancelButtonText: '❌ Cancelar',
          confirmButtonColor: '#f59e0b',
          cancelButtonColor: '#6b7280'
        });

        if (!result.isConfirmed) return;

        Swal.fire({ title: 'Actualizando estado...', allowOutsideClick: false, didOpen: () => { Swal.showLoading(); } });

        try {
          const { data, error } = await actions.updateOrderStatus({ orderId: orderId!, status: newStatus as any });
          if (error) { await Swal.fire({ icon: 'error', title: 'Error', text: error, confirmButtonColor: '#f59e0b' }); return; }
          await Swal.fire({ icon: 'success', title: '¡Estado actualizado!', confirmButtonColor: '#f59e0b', timer: 1500, timerProgressBar: true });
          window.location.reload();
        } catch (error) {
          console.error('Error:', error);
          await Swal.fire({ icon: 'error', title: 'Error', text: 'Ocurrió un error al actualizar el estado', confirmButtonColor: '#f59e0b' });
        }
      });

      // 7b. CANCELAR ORDEN (botón directo)
      const cancelOrderBtn = document.getElementById('cancel-order-btn');
      cancelOrderBtn?.addEventListener('click', async () => {
        const result = await Swal.fire({
          title: '¿Cancelar esta orden?',
          html: '<p class="text-gray-700">La orden quedará marcada como <strong class="text-red-600">cancelada</strong> y se excluirá de las estadísticas de venta.</p>',
          icon: 'warning',
          showCancelButton: true,
          confirmButtonText: 'Sí, cancelar orden',
          cancelButtonText: 'No, mantener',
          confirmButtonColor: '#dc2626',
          cancelButtonColor: '#6b7280'
        });

        if (!result.isConfirmed) return;

        Swal.fire({ title: 'Cancelando orden...', allowOutsideClick: false, didOpen: () => { Swal.showLoading(); } });

        try {
          const { data, error } = await actions.updateOrderStatus({ orderId: orderId!, status: 'cancelled' as any });
          if (error) { await Swal.fire({ icon: 'error', title: 'Error', text: error, confirmButtonColor: '#f59e0b' }); return; }
          await Swal.fire({ icon: 'success', title: 'Orden cancelada', confirmButtonColor: '#f59e0b', timer: 1500, timerProgressBar: true });
          window.location.reload();
        } catch (error) {
          console.error('Error:', error);
          await Swal.fire({ icon: 'error', title: 'Error', text: 'Ocurrió un error al cancelar la orden', confirmButtonColor: '#f59e0b' });
        }
      });

      // 8. COTIZAR ENVÍO
      const quoteBtn = document.getElementById('quote-shipping-btn');
      const loadingRates = document.getElementById('loading-rates');
      const shippingRates = document.getElementById('shipping-rates');
      const ratesContainer = document.getElementById('rates-container');
      const errorRates = document.getElementById('error-rates');
      const errorMessage = document.getElementById('error-message');

      quoteBtn?.addEventListener('click', async () => {
        const weight = parseFloat((document.getElementById('weight') as HTMLInputElement)?.value || '0.5');
        const length = parseFloat((document.getElementById('length') as HTMLInputElement)?.value || '20');
        const width = parseFloat((document.getElementById('width') as HTMLInputElement)?.value || '15');
        const height = parseFloat((document.getElementById('height') as HTMLInputElement)?.value || '10');

        const currentZip = shippingAddress.zip;
        if (!currentZip || currentZip === 'N/A' || !/^\d{5}$/.test(currentZip)) {
          await Swal.fire({ icon: 'warning', title: 'Código postal inválido', html: `<p class="text-gray-700">Por favor, edita la dirección de envío y asegúrate de incluir un código postal de 5 dígitos.</p>`, confirmButtonColor: '#f59e0b' });
          return;
        }

        loadingRates?.classList.remove('hidden');
        shippingRates?.classList.add('hidden');
        errorRates?.classList.add('hidden');
        quoteBtn.disabled = true;

        try {
          const { data, error } = await actions.getShippingRates({
            originPostalCode: ORIGIN_ADDRESS.postalCode,
            destinationPostalCode: currentZip,
            destinationCity: shippingAddress.city,
            destinationState: shippingAddress.state,
            weight, length, width, height
          });

          loadingRates?.classList.add('hidden');

          if (error || !data?.success) {
            errorRates?.classList.remove('hidden');
            if (errorMessage) errorMessage.textContent = data?.error || error || 'Error al cotizar';
            return;
          }

          if (data.rates && data.rates.length > 0) {
            if (ratesContainer) {
              ratesContainer.innerHTML = data.rates.map((rate: any) => `
                <button class="rate-option" style="width:100%;padding:14px;border:1px solid rgba(255,255,255,0.07);border-radius:12px;background:#0b0b0d;color:#f5f5f4;text-align:left;cursor:pointer;transition:all .18s;"
                  data-carrier="${rate.carrier}" data-service="${rate.service}" data-price="${rate.totalPrice}"
                  data-weight="${weight}" data-length="${length}" data-width="${width}" data-height="${height}"
                  onmouseover="this.style.borderColor='#60a5fa'" onmouseout="this.style.borderColor='rgba(255,255,255,0.07)'">
                  <div style="display:flex;justify-content:space-between;align-items:center;">
                    <div>
                      <p style="font-weight:700;font-size:1rem;text-transform:uppercase;margin:0;">${rate.carrier}</p>
                      <p style="font-size:0.8rem;color:rgba(245,245,244,0.55);margin:2px 0 0;">${rate.service}</p>
                      <p style="font-size:0.72rem;color:rgba(245,245,244,0.35);margin:4px 0 0;">${rate.deliveryDays} días estimados</p>
                    </div>
                    <div style="text-align:right;">
                      <p style="font-weight:800;font-size:1.4rem;color:#60a5fa;margin:0;">$${rate.totalPrice.toFixed(2)}</p>
                      <p style="font-size:0.7rem;color:rgba(245,245,244,0.35);margin:0;">${rate.currency}</p>
                    </div>
                  </div>
                </button>
              `).join('');

              document.querySelectorAll('.rate-option').forEach(btn => {
                btn.addEventListener('click', async (e) => {
                  const target = e.currentTarget as HTMLElement;
                  await createLabel(
                    target.dataset.carrier!,
                    target.dataset.service!,
                    parseFloat(target.dataset.weight!),
                    parseFloat(target.dataset.length!),
                    parseFloat(target.dataset.width!),
                    parseFloat(target.dataset.height!)
                  );
                });
              });
            }
            shippingRates?.classList.remove('hidden');
          } else {
            errorRates?.classList.remove('hidden');
            if (errorMessage) errorMessage.textContent = 'No se encontraron opciones de envío para este destino';
          }
        } catch (error) {
          console.error('Error:', error);
          loadingRates?.classList.add('hidden');
          errorRates?.classList.remove('hidden');
          if (errorMessage) errorMessage.textContent = 'Error de conexión al cotizar';
        } finally {
          quoteBtn.disabled = false;
        }
      });

      // 9. CREAR ETIQUETA
      async function createLabel(carrier: string, service: string, weight: number, length: number, width: number, height: number) {
        const result = await Swal.fire({
          title: '¿Generar guía de envío?',
          html: `
            <div class="text-left bg-gradient-to-r from-blue-50 to-indigo-50 p-5 rounded-xl">
              <div class="flex items-center gap-3 mb-4">
                <div class="w-12 h-12 bg-blue-600 rounded-full flex items-center justify-center">
                  <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 8h14M5 8a2 2 0 110-4h14a2 2 0 110 4M5 8v10a2 2 0 002 2h10a2 2 0 002-2V8m-9 4h4"></path></svg>
                </div>
                <div>
                  <p class="font-bold text-xl text-gray-900 uppercase">${carrier}</p>
                  <p class="text-gray-600">${service}</p>
                </div>
              </div>
              <div class="space-y-2 text-sm">
                <p class="flex justify-between"><span class="text-gray-600">📍 Destino:</span> <span class="font-medium">${shippingAddress.city}, ${shippingAddress.state}</span></p>
                <p class="flex justify-between"><span class="text-gray-600">📮 C.P.:</span> <span class="font-medium">${shippingAddress.zip}</span></p>
                <p class="flex justify-between"><span class="text-gray-600">📦 Peso:</span> <span class="font-medium">${weight} kg</span></p>
              </div>
              <div class="mt-4 pt-4 border-t border-blue-200">
                <p class="text-xs text-blue-700">Se generará la guía y el estado cambiará a "Enviado"</p>
              </div>
            </div>
          `,
          icon: 'question',
          showCancelButton: true,
          confirmButtonText: '✅ Generar Guía',
          cancelButtonText: '❌ Cancelar',
          confirmButtonColor: '#3b82f6',
          cancelButtonColor: '#6b7280'
        });

        if (!result.isConfirmed) return;

        Swal.fire({ title: 'Generando guía de envío...', html: `<div class="py-4"><div class="inline-block animate-spin rounded-full h-12 w-12 border-4 border-blue-200 border-t-blue-600 mb-4"></div><p class="text-gray-600">Conectando con ${carrier.toUpperCase()}...</p></div>`, allowOutsideClick: false, showConfirmButton: false });

        try {
          const { data, error } = await actions.createShippingLabel({
            orderId: orderId!,
            carrier, service,
            origin: ORIGIN_ADDRESS,
            destination: {
              name: customerName || customerEmail?.split('@')[0] || 'Cliente',
              street: shippingAddress.streetAddress || "Dirección del cliente",
              number: "S/N",
              district: shippingAddress.city || "Colonia",
              city: shippingAddress.city || "Ciudad",
              state: shippingAddress.state || "Estado",
              postalCode: shippingAddress.zip || "00000",
              phone: customerPhone || "0000000000",
              email: customerEmail || "cliente@email.com"
            },
            package: { weight, length, width, height }
          });

          if (error || !data?.success) {
            await Swal.fire({ icon: 'error', title: 'Error al generar guía', html: `<div class="text-left"><p class="text-gray-700 mb-3">${data?.error || error || 'Error desconocido'}</p><p class="text-sm text-gray-500">Verifica que la dirección de envío sea correcta y que el servicio esté disponible.</p></div>`, confirmButtonColor: '#f59e0b' });
            return;
          }

          if (data.label) {
            await Swal.fire({ icon: 'success', title: '¡Guía generada exitosamente!', html: `<div class="text-left"><div class="bg-green-50 border border-green-200 p-4 rounded-xl mb-4"><p class="text-sm text-gray-600 mb-1">Número de rastreo:</p><p class="font-mono font-bold text-2xl text-blue-600">${data.label.trackingNumber}</p></div><p class="text-sm text-gray-600">La etiqueta está lista para imprimir.</p></div>`, confirmButtonText: '🖨️ Ver Etiqueta', confirmButtonColor: '#10b981' });
            window.location.reload();
          }
        } catch (error) {
          console.error('Error:', error);
          await Swal.fire({ icon: 'error', title: 'Error', text: 'Ocurrió un error al crear la etiqueta de envío', confirmButtonColor: '#f59e0b' });
        }
      }

      // 10. RASTREAR ENVÍO
      const trackBtn = document.getElementById('track-shipment-btn');
      const trackingModal = document.getElementById('tracking-modal');
      const trackingContent = document.getElementById('tracking-content');
      const closeModal = document.getElementById('close-modal');

      trackBtn?.addEventListener('click', async () => {
        if (!trackingNumber) return;

        trackingContent!.innerHTML = `<div style="text-align:center;padding:48px;"><div class="spinner-blue"></div><p style="color:rgba(245,245,244,0.55);margin-top:14px;">Obteniendo información de rastreo...</p></div>`;
        trackingModal?.classList.remove('hidden');

        try {
          const { data, error } = await actions.trackShipment({ trackingNumber, carrier });

          if (error || !data || !data.tracking) {
            trackingContent!.innerHTML = `<div style="text-align:center;padding:48px;color:#f87171;"><p style="font-size:1.1rem;font-weight:700;">Error al obtener tracking</p><p style="color:rgba(245,245,244,0.35);margin-top:8px;">${error || 'No se pudo obtener información'}</p></div>`;
            return;
          }

          const tracking = data.tracking;

          trackingContent!.innerHTML = `
            <div style="display:flex;flex-direction:column;gap:24px;">
              <div style="background:linear-gradient(135deg,#1d4ed8,#4338ca);color:#fff;padding:24px;border-radius:16px;">
                <div style="display:flex;align-items:center;gap:16px;margin-bottom:12px;">
                  <div style="width:56px;height:56px;background:rgba(255,255,255,0.15);border-radius:50%;display:flex;align-items:center;justify-content:center;">
                    <svg style="width:32px;height:32px;" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 8h14M5 8a2 2 0 110-4h14a2 2 0 110 4M5 8v10a2 2 0 002 2h10a2 2 0 002-2V8m-9 4h4"/></svg>
                  </div>
                  <div>
                    <p style="font-size:1.5rem;font-weight:800;margin:0;">${tracking.status}</p>
                    <p style="color:#c7d2fe;margin:0;">${tracking.currentLocation}</p>
                  </div>
                </div>
                ${tracking.estimatedDelivery ? `<div style="background:rgba(255,255,255,0.1);border-radius:10px;padding:12px;margin-top:14px;"><p style="font-size:0.85rem;color:#c7d2fe;margin:0;">📅 Entrega estimada: <strong style="color:#fff;">${tracking.estimatedDelivery}</strong></p></div>` : ''}
              </div>
              <div>
                <h3 style="font-weight:700;font-size:1.05rem;color:#f5f5f4;margin:0 0 16px;">Historial de Movimientos</h3>
                <div style="position:relative;">
                  ${tracking.events && tracking.events.length > 0 ? tracking.events.map((event: any, idx: number) => `
                    <div style="display:flex;gap:16px;padding-bottom:24px;${idx !== tracking.events.length - 1 ? 'border-left:2px solid rgba(96,165,250,0.3);margin-left:8px;' : 'margin-left:8px;'}">
                      <div style="position:absolute;left:0;width:18px;height:18px;border-radius:50%;${idx === 0 ? 'background:#60a5fa;box-shadow:0 0 0 4px rgba(96,165,250,0.2);' : 'background:rgba(96,165,250,0.5);'}transform:translateX(-8px);"></div>
                      <div style="margin-left:24px;background:#1b1b1f;padding:14px;border-radius:12px;flex:1;">
                        <p style="font-weight:600;color:#f5f5f4;margin:0;">${event.description}</p>
                        <p style="font-size:0.85rem;color:rgba(245,245,244,0.55);margin:4px 0 0;">📍 ${event.location}</p>
                        <p style="font-size:0.78rem;color:rgba(245,245,244,0.35);margin:6px 0 0;">🕐 ${event.date} ${event.time}</p>
                      </div>
                    </div>
                  `).join('') : '<p style="color:rgba(245,245,244,0.35);text-align:center;padding:16px;">No hay eventos de seguimiento disponibles</p>'}
                </div>
              </div>
              <div style="background:#1b1b1f;padding:16px;border-radius:12px;font-size:0.85rem;display:flex;flex-direction:column;gap:8px;">
                <p style="margin:0;"><span style="color:rgba(245,245,244,0.55);">📦 Tracking:</span> <span style="font-family:monospace;font-weight:600;">${trackingNumber}</span></p>
                <p style="margin:0;"><span style="color:rgba(245,245,244,0.55);">🚚 Paquetería:</span> <span style="font-weight:600;text-transform:uppercase;">${carrier || 'N/A'}</span></p>
              </div>
            </div>
          `;
        } catch (error) {
          console.error('Error:', error);
          trackingContent!.innerHTML = `<div style="text-align:center;padding:48px;color:#f87171;"><p style="font-size:1.1rem;font-weight:700;">❌ Error al obtener información de tracking</p></div>`;
        }
      });

      closeModal?.addEventListener('click', () => trackingModal?.classList.add('hidden'));
      trackingModal?.addEventListener('click', (e) => {
        if (e.target === trackingModal) trackingModal.classList.add('hidden');
      });
    }

    document.addEventListener('astro:page-load', initializeOrderPage);
  </script>
</AdminLayout>