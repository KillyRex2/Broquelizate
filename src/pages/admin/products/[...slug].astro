---
import ProductSlideshow from '@/components/products/ProductSlideshow.astro';
import AdminLayout from '@/layouts/AdminLayout.astro';
import { actions } from 'astro:actions';

// Definir tipos para las imágenes y el producto
interface ProductImage {
  id: string;
  image: string;
  productId?: string;
  variantId?: string | null;
}

interface ProductData {
  id: string;
  name: string;
  slug: string;
  description: string;
  price: number;
  cost: number | null;
  stock: number;
  category: string;
  type: string;
  piercing_name: string[] | string;
  hasVariants: boolean;
  user?: string;
}

// Determinar si es creación o edición
const slugs = Astro.params.slug?.split('/') || [];
const isCreate = slugs[0] === 'new';
const productSlug = !isCreate ? slugs.join('/') : '';

let product: ProductData | null = null;
let initialImages: ProductImage[] = [];
let variantData = null;

if (!isCreate) {
  const { data: productData, error } = await Astro.callAction(actions.getProductBySlug, productSlug);
  
  if (error) {
    return Astro.redirect('/404');
  }
  
  product = {
    ...productData.product,
    hasVariants: productData.product.hasVariants ?? false,
    cost: productData.product.cost ?? 0,
    piercing_name: Array.isArray(productData.product.piercing_name)
      ? productData.product.piercing_name
      : productData.product.piercing_name
        ? productData.product.piercing_name.split(',').map((p: string) => p.trim())
        : []
  } as ProductData;
  
  initialImages = productData.images || [];
  
  if (product.hasVariants) {
    const { data: variants } = await Astro.callAction(actions.getGroupedProductVariants, product.id);
    variantData = variants;
  }
} else {
  product = {
    id: '',
    name: 'Broquel Perron',
    slug: 'nuevo-producto',
    description: 'Elegante [inserte nombre] que realza tu estilo con sofisticación y calidad excepcional.',
    price: 0,
    cost: 0,
    stock: 0,
    category: 'Titanio',
    type: 'Broqueles',
    piercing_name: [],
    hasVariants: false
  };
}

const pageTitle = isCreate ? 'Crear Nuevo Producto' : `Editando: ${product.name}`;

// Preparar el valor inicial para el campo hidden de piercings
const initialPiercingValue = Array.isArray(product.piercing_name) 
  ? product.piercing_name.join(',') 
  : product.piercing_name || '';
---

<AdminLayout title={pageTitle}>
  <section class="p-2 md:p-4 lg:p-8 text-gray-800">
    <header class="mb-4 md:mb-8">
      <h1 class="text-2xl md:text-4xl font-extrabold tracking-tight text-yellow-600">
        {isCreate ? 'Crear Producto' : product.name}
      </h1>
      <a href="/admin/products" class="inline-block mt-2 md:mt-4 text-sm md:text-base text-yellow-600 hover:underline font-medium">
        ← Volver
      </a>
    </header>

    <form id="product-form" class="grid grid-cols-1 lg:grid-cols-3 gap-4 md:gap-8 pb-20 md:pb-24" enctype="multipart/form-data">
      {!isCreate && <input type="hidden" name="id" value={product.id} />}
      
      <!-- ✅ CAMPO HIDDEN PARA TIPOS DE PERFORACIÓN - Este es el que se envía al servidor -->
      <input type="hidden" name="piercing_name" id="piercing_name_hidden" value={initialPiercingValue} />

      <div class="lg:col-span-2 space-y-4 md:space-y-8">
        <!-- Datos Generales -->
        <div class="card">
          <h2 class="card-title">Datos Generales</h2>
          <div class="space-y-4 md:space-y-6">
            <div>
              <label for="name" class="form-label">Nombre</label>
              <input id="name" name="name" type="text" value={product.name} required class="form-input" />
            </div>
            <div>
              <label for="slug" class="form-label">Slug</label>
              <input id="slug" name="slug" type="text" value={product.slug} required class="form-input" />
            </div>
            <div>
              <label for="description" class="form-label">Descripción</label>
              <textarea id="description" name="description" rows="4" required class="form-input">{product.description}</textarea>
            </div>
          </div>
        </div>

        <!-- Precio y Categorización -->
        <div class="card">
          <h2 class="card-title">Precio y Categorización</h2>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 md:gap-x-6 md:gap-y-8">
            <div>
              <label for="price" class="form-label">Precio</label>
              <input id="price" name="price" type="number" step="0.01" value={product.price} required class="form-input" />
            </div>
            <div>
              <label for="cost" class="form-label">Costo</label>
              <input id="cost" name="cost" type="number" step="0.01" value={product.cost || 0} required class="form-input" />
            </div>
            <div class="sm:col-span-2">
              <label for="stock" class="form-label">Inventario Base</label>
              <input id="stock" name="stock" type="number" value={product.stock} required class="form-input" />
              <span class="text-xs text-slate-500 mt-1 block">Stock general del producto sin variantes</span>
            </div>
            <div>
              <label for="category" class="form-label">Material</label>
              <select id="category" name="category" required class="form-input">
                {['Titanio','Acero Quirúrgico','Oro 10k','Oro 14k','Oro 18k','Chapa de Oro 14K','Chapa de Oro 18K','Acero Inoxidable','Plástico','Plata','Rodio'].map(c => (
                  <option value={c} selected={c === product.category}>{c}</option>
                ))}
              </select>
            </div>
            <div>
              <label for="type" class="form-label">Tipo de Joya</label>
              <select id="type" name="type" required class="form-input">
                {['Anillos','Broqueles','Pulseras','Cadenas'].map(t => (
                  <option value={t} selected={t === product.type}>{t}</option>
                ))}
              </select>
            </div>
          </div>
        </div>

        <!-- Imágenes (movidas aquí para móvil) -->
        <div class="card lg:hidden">
          <h2 class="card-title">Imágenes</h2>
          
          {!isCreate && initialImages.length > 0 && (
            <div id="slideshow-container-mobile" class="mb-4">
              <ProductSlideshow images={initialImages.map(i => i.image)} />
            </div>
          )}

          <div class="mt-4">
            <label for="file-upload-mobile" class="form-label">
              {isCreate ? 'Agregar imágenes' : 'Añadir nuevas'}
            </label>
            <div id="drop-zone-mobile" class="flex flex-col items-center justify-center w-full h-32 border-2 border-dashed border-slate-300 rounded-lg cursor-pointer bg-white hover:bg-slate-50 hover:border-yellow-600 transition-colors">
              <svg class="w-8 h-8 text-slate-400 mb-2" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 16.5V9.75m0 0l3 3m-3-3l-3 3M6.75 19.5a4.5 4.5 0 01-1.41-8.775 5.25 5.25 0 0110.233-2.33 3 3 0 013.758 3.848A3.752 3.752 0 0118 19.5H6.75z" />
              </svg>
              <p class="text-xs text-slate-500">Click para subir</p>
              <input id="file-upload-mobile" type="file" accept="image/*" multiple class="hidden" />
            </div>
          </div>
          <div id="new-images-preview-mobile" class="mt-3 grid grid-cols-3 gap-2"></div>

          {!isCreate && initialImages.length > 0 && (
            <>
              <h3 class="form-label mt-4 mb-2">Imágenes Actuales</h3>
              <ul id="image-list-container-mobile" class="space-y-2">
                {initialImages.map(i => (
                  <li data-id={i.id} class="flex items-center justify-between bg-slate-50 p-2 rounded">
                    <img src={i.image} alt="imagen actual" class="h-12 w-12 object-cover rounded" />
                    <button type="button" data-id={i.id} class="text-red-600 hover:underline text-sm delete-existing">Eliminar</button>
                  </li>
                ))}
              </ul>
            </>
          )}
        </div>

        <!-- Configuración de Variantes -->
        <div class="card">
          <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between mb-4 md:mb-6 gap-3">
            <h2 class="card-title mb-0">Variantes</h2>
            <label class="flex items-center space-x-2 cursor-pointer">
              <input 
                type="checkbox" 
                id="hasVariants" 
                name="hasVariants" 
                checked={product.hasVariants}
                class="h-5 w-5 rounded border-slate-400 text-yellow-600 focus:ring-yellow-600"
              />
              <span class="font-medium text-slate-700 text-sm md:text-base">Habilitar variantes</span>
            </label>
          </div>
          
          <div id="variants-container" class={product.hasVariants ? '' : 'hidden'}>
            <div class="space-y-4">
              <div class="bg-amber-50 border border-amber-200 rounded-lg p-3 md:p-4">
                <p class="text-xs md:text-sm text-amber-800">
                  Las variantes permiten ofrecer diferentes versiones del producto (ej: colores, tamaños).
                </p>
              </div>

              {!isCreate && (
                <div class="flex flex-col sm:flex-row gap-2 md:gap-3">
                  <button type="button" id="add-variant-btn" class="btn-secondary text-sm md:text-base">
                    + Agregar Variante
                  </button>
                  <button type="button" id="generate-combinations-btn" class="btn-secondary text-sm md:text-base">
                    ⚡ Generar Combinaciones
                  </button>
                </div>
              )}

              <div id="variants-list" class="space-y-3">
                {variantData?.groupedVariants && Object.entries(variantData.groupedVariants).map(([variantName, group]: [string, any]) => (
                  <div class="border border-slate-200 rounded-lg p-3 md:p-4 bg-slate-50 variant-group" data-variant-name={variantName}>
                    <div class="flex items-center justify-between mb-3">
                      <h4 class="font-semibold text-slate-800 text-sm md:text-base">{variantName}</h4>
                      <button 
                        type="button" 
                        class="delete-variant-group text-red-600 hover:text-red-800 text-xs md:text-sm font-medium"
                        data-variant-name={variantName}
                      >
                        Eliminar
                      </button>
                    </div>
                    <div class="grid grid-cols-1 gap-2">
                      {group.options.map((option: any) => {
                        const variantImage = initialImages.find(img => img.variantId === option.id);
                        
                        return (
                          <div class="flex items-center gap-3 bg-white rounded px-2 md:px-3 py-2 border border-slate-200 variant-item" data-variant-id={option.id}>
                            
                            <div class="flex-shrink-0">
                              {variantImage ? ( 
                                <div class="relative group">
                                  <img 
                                    src={variantImage.image} 
                                    alt={option.value}
                                    class="w-12 h-12 md:w-16 md:h-16 object-cover rounded border-2 border-yellow-500"
                                  />
                                  <button
                                    type="button"
                                    class="delete-variant-image absolute -top-1 -right-1 bg-red-600 text-white rounded-full w-5 h-5 flex items-center justify-center text-xs opacity-0 group-hover:opacity-100 transition-opacity"
                                    data-variant-id={option.id}
                                  >
                                    ×
                                  </button>
                                </div>
                              ) : (
                                <div class="w-12 h-12 md:w-16 md:h-16 bg-slate-100 rounded border-2 border-dashed border-slate-300 flex items-center justify-center">
                                  <svg class="w-6 h-6 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                                  </svg>
                                </div>
                              )}
                            </div>

                            <div class="flex-1 min-w-0">
                              <span class="text-xs md:text-sm font-medium truncate block">{option.value}</span>
                              <div class="flex items-center gap-2 mt-1 text-xs text-slate-600 flex-wrap">
                                {option.priceAdjustment !== 0 && (
                                  <span class={option.priceAdjustment > 0 ? 'text-green-600' : 'text-red-600'}>
                                    {option.priceAdjustment > 0 ? '+' : ''}${option.priceAdjustment}
                                  </span>
                                )}
                                <span>Stock: {option.stock}</span>
                                {option.sku && <span class="truncate">SKU: {option.sku}</span>}
                              </div>
                            </div>

                            <div class="flex items-center gap-1 md:gap-2 flex-shrink-0">
                              <label class="cursor-pointer">
                                <input 
                                  type="file" 
                                  accept="image/*" 
                                  class="hidden variant-image-input"
                                  data-variant-id={option.id}
                                  data-product-id={product.id}
                                />
                                <div class="upload-variant-image p-1 text-purple-600 hover:text-purple-800" title="Subir imagen">
                                  <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                                  </svg>
                                </div>
                              </label>

                              <button 
                                type="button" 
                                class="edit-variant text-blue-600 hover:text-blue-800 p-1"
                                data-variant-id={option.id}
                                data-variant-name={variantName}
                                data-variant-value={option.value}
                                data-price-adjustment={option.priceAdjustment}
                                data-stock={option.stock}
                                data-sku={option.sku || ''}
                              >
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                                </svg>
                              </button>

                              <button 
                                type="button" 
                                class="delete-variant text-red-600 hover:text-red-800 p-1"
                                data-variant-id={option.id}
                              >
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                                </svg>
                              </button>
                            </div>
                          </div>
                        );
                      })}
                    </div>
                  </div>
                ))}
              </div>

              {variantData?.combinations && variantData.combinations.length > 0 && (
                <div class="mt-6">
                  <h3 class="font-semibold text-slate-800 mb-3 text-sm md:text-base">Combinaciones Activas</h3>
                  <div class="overflow-x-auto -mx-3 px-3 md:mx-0 md:px-0">
                    <table class="min-w-full divide-y divide-slate-200 text-xs md:text-sm">
                      <thead class="bg-slate-50">
                        <tr>
                          <th class="px-2 md:px-4 py-2 text-left text-xs font-medium text-slate-500 uppercase">Combinación</th>
                          <th class="px-2 md:px-4 py-2 text-left text-xs font-medium text-slate-500 uppercase">Precio</th>
                          <th class="px-2 md:px-4 py-2 text-left text-xs font-medium text-slate-500 uppercase">Stock</th>
                          <th class="px-2 md:px-4 py-2 text-left text-xs font-medium text-slate-500 uppercase">SKU</th>
                        </tr>
                      </thead>
                      <tbody class="bg-white divide-y divide-slate-200">
                        {variantData.combinations.map((combo: any) => (
                          <tr>
                            <td class="px-2 md:px-4 py-2">{combo.combinationName}</td>
                            <td class="px-2 md:px-4 py-2">${combo.price}</td>
                            <td class="px-2 md:px-4 py-2">
                              <input 
                                type="number" 
                                value={combo.stock} 
                                data-combination-id={combo.id}
                                class="w-16 md:w-20 px-1 md:px-2 py-1 border rounded combination-stock-input text-xs md:text-sm"
                              />
                            </td>
                            <td class="px-2 md:px-4 py-2 truncate max-w-[80px]">{combo.sku || '-'}</td>
                          </tr>
                        ))}
                      </tbody>
                    </table>
                  </div>
                </div>
              )}
            </div>
          </div>
        </div>

        <!-- Tipos de Perforación -->
        <div class="card">
          <h2 class="card-title">Tipos de Perforación</h2>
          <div class="grid grid-cols-2 md:grid-cols-3 gap-3 md:gap-4">
            {['Lóbulo','Lóbulo Superior','Hélix','Antihelix','Tragus','Antitragus','Rook','Conch','Daith','Industrial','Séptum','Nóstril','Navel','Flat','Ninguno'].map(p => {
              const piercingArray = Array.isArray(product.piercing_name) ? product.piercing_name : [];
              const isChecked = piercingArray.includes(p);
              return (
                <label class="flex items-center space-x-2 cursor-pointer">
                  {/* ✅ CAMBIO: Los checkboxes ya NO tienen name, solo se usan para la UI */}
                  <input 
                    type="checkbox" 
                    value={p} 
                    checked={isChecked} 
                    class="piercing-checkbox h-4 w-4 md:h-5 md:w-5 rounded border-slate-400 text-yellow-600 focus:ring-yellow-600" 
                  />
                  <span class="font-medium text-slate-700 text-sm md:text-base">{p}</span>
                </label>
              );
            })}
          </div>
        </div>
      </div>

      <!-- Columna lateral derecha para imágenes (solo desktop) -->
      <div class="hidden lg:block lg:col-span-1 space-y-8">
        <div class="card">
          <h2 class="card-title">Imágenes</h2>
          
          {!isCreate && initialImages.length > 0 && (
            <div id="slideshow-container" class="mb-6">
              <ProductSlideshow images={initialImages.map(i => i.image)} />
            </div>
          )}

          <div class="mt-6">
            <label for="file-upload" class="form-label">
              {isCreate ? 'Agregar imágenes' : 'Añadir nuevas'}
            </label>
            <div id="drop-zone" class="flex flex-col items-center justify-center w-full h-40 border-2 border-dashed border-slate-300 rounded-lg cursor-pointer bg-white hover:bg-slate-50 hover:border-yellow-600 transition-colors">
              <svg class="w-10 h-10 text-slate-400 mb-2" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 16.5V9.75m0 0l3 3m-3-3l-3 3M6.75 19.5a4.5 4.5 0 01-1.41-8.775 5.25 5.25 0 0110.233-2.33 3 3 0 013.758 3.848A3.752 3.752 0 0118 19.5H6.75z" />
              </svg>
              <p class="text-sm text-slate-500">Click o arrastra</p>
              <input id="file-upload" type="file" accept="image/*" multiple class="hidden" />
            </div>
          </div>
          <div id="new-images-preview" class="mt-4 grid grid-cols-3 gap-2"></div>

          {!isCreate && initialImages.length > 0 && (
            <>
              <h3 class="form-label mt-6 mb-2">Imágenes Actuales</h3>
              <ul id="image-list-container" class="space-y-2">
                {initialImages.map(i => (
                  <li data-id={i.id} class="flex items-center justify-between">
                    <img src={i.image} alt="imagen actual" class="h-16 w-16 object-cover rounded" />
                    <button type="button" data-id={i.id} class="text-red-600 hover:underline delete-existing">Eliminar</button>
                  </li>
                ))}
              </ul>
            </>
          )}
        </div>
      </div>
    </form>

    <!-- Botón fijo responsive -->
    <div class="fixed bottom-0 left-0 right-0 bg-white/95 backdrop-blur-sm border-t border-slate-200 p-3 md:p-4 z-50 lg:left-64">
      <div class="max-w-6xl mx-auto flex justify-end">
        <button type="submit" form="product-form" id="save-button" class="bg-yellow-600 hover:bg-yellow-700 text-white font-bold px-6 py-2 md:px-8 md:py-3 rounded-lg shadow-lg transition-transform hover:scale-105 text-sm md:text-base w-full sm:w-auto">
          {isCreate ? 'Crear Producto' : 'Guardar'}
        </button>
      </div>
    </div>
  </section>

  <!-- Modal para agregar variantes -->
  <div id="variant-modal" class="hidden fixed inset-0 bg-black bg-opacity-50 z-50 flex items-center justify-center p-3 md:p-4">
    <div class="bg-white rounded-lg max-w-2xl w-full max-h-[90vh] overflow-y-auto">
      <div class="p-4 md:p-6">
        <h3 class="text-lg md:text-xl font-bold text-slate-800 mb-4">Agregar Nueva Variante</h3>
        
        <form id="variant-form" class="space-y-4">
          <div>
            <label class="form-label">Tipo (Color, Tamaño)</label>
            <input type="text" id="variant-name" class="form-input" placeholder="Color" required />
          </div>
          
          <div id="variant-options" class="space-y-3">
            <label class="form-label">Opciones</label>
            <div class="variant-option-row space-y-2">
              <input type="text" placeholder="Valor (ej: Dorado)" class="w-full px-3 py-2 bg-slate-50 text-slate-900 border border-slate-200 rounded-lg variant-value" required />
              <div class="grid grid-cols-3 gap-2">
                <input type="number" placeholder="Precio" step="0.01" class="px-3 py-2 bg-slate-50 text-slate-900 border border-slate-200 rounded-lg variant-price" />
                <input type="number" placeholder="Stock" class="px-3 py-2 bg-slate-50 text-slate-900 border border-slate-200 rounded-lg variant-stock" required />
                <input type="text" placeholder="SKU" class="px-3 py-2 bg-slate-50 text-slate-900 border border-slate-200 rounded-lg variant-sku" />
              </div>
              <button type="button" class="w-full text-red-600 hover:text-red-800 text-sm font-bold remove-option">× Eliminar</button>
            </div>
          </div>
          
          <button type="button" id="add-option-btn" class="btn-secondary w-full text-sm md:text-base">
            + Agregar opción
          </button>
          
          <div class="flex flex-col sm:flex-row gap-3 mt-6">
            <button type="button" id="cancel-variant-btn" class="flex-1 px-4 py-2 border border-slate-300 rounded-lg hover:bg-slate-50 text-sm md:text-base">
              Cancelar
            </button>
            <button type="submit" class="flex-1 px-4 py-2 bg-yellow-600 text-white rounded-lg hover:bg-yellow-700 text-sm md:text-base">
              Guardar
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>

  <!-- Modal para editar variante -->
  <div id="edit-variant-modal" class="hidden fixed inset-0 bg-black bg-opacity-50 z-50 flex items-center justify-center p-3 md:p-4">
    <div class="bg-white rounded-lg max-w-md w-full">
      <div class="p-4 md:p-6">
        <h3 class="text-lg md:text-xl font-bold text-slate-800 mb-4">Editar Variante</h3>
        
        <form id="edit-variant-form" class="space-y-4">
          <input type="hidden" id="edit-variant-id" />
          
          <div>
            <label class="form-label">Tipo</label>
            <input type="text" id="edit-variant-name" class="form-input bg-slate-100 text-sm md:text-base" readonly />
          </div>
          
          <div>
            <label class="form-label">Valor</label>
            <input type="text" id="edit-variant-value" class="form-input text-sm md:text-base" required />
          </div>
          
          <div>
            <label class="form-label">Ajuste de Precio</label>
            <input type="number" id="edit-price-adjustment" step="0.01" class="form-input text-sm md:text-base" />
          </div>
          
          <div>
            <label class="form-label">Stock</label>
            <input type="number" id="edit-stock" class="form-input text-sm md:text-base" required />
          </div>
          
          <div>
            <label class="form-label">SKU (opcional)</label>
            <input type="text" id="edit-sku" class="form-input text-sm md:text-base" />
          </div>
          
          <div class="flex flex-col sm:flex-row gap-3 mt-6">
            <button type="button" id="cancel-edit-variant" class="flex-1 px-4 py-2 border border-slate-300 rounded-lg hover:bg-slate-50 text-sm md:text-base">
              Cancelar
            </button>
            <button type="submit" class="flex-1 px-4 py-2 bg-yellow-600 text-white rounded-lg hover:bg-yellow-700 text-sm md:text-base">
              Guardar
            </button>
          </div>
        </form>
      </div>
    </div>
  </div>

<script>
  import { actions } from "astro:actions";
  import Swal from 'sweetalert2';
  import { navigate } from 'astro:transitions/client';

  let isInitialized = false;

  document.addEventListener('astro:page-load', () => {
    if (isInitialized) return;
    isInitialized = true;

    const form = document.getElementById('product-form') as HTMLFormElement;
    if (!form) return;

    const dropZones = [document.getElementById('drop-zone'), document.getElementById('drop-zone-mobile')].filter(Boolean);
    const fileInputs = [
      document.getElementById('file-upload') as HTMLInputElement,
      document.getElementById('file-upload-mobile') as HTMLInputElement
    ].filter(Boolean);
    const previewContainers = [
      document.getElementById('new-images-preview'),
      document.getElementById('new-images-preview-mobile')
    ].filter(Boolean);
    const imageListContainers = [
      document.getElementById('image-list-container'),
      document.getElementById('image-list-container-mobile')
    ].filter(Boolean);
    const hasVariantsCheckbox = document.getElementById('hasVariants') as HTMLInputElement;
    const variantsContainer = document.getElementById('variants-container');
    const isCreate = !form.querySelector('input[name="id"]');
    
    // ✅ REFERENCIA AL CAMPO HIDDEN DE PIERCINGS
    const piercingHiddenInput = document.getElementById('piercing_name_hidden') as HTMLInputElement;
    
    let newFiles: File[] = [];
    let isProcessing = false;

    const Toast = Swal.mixin({
      toast: true,
      position: 'top-end',
      showConfirmButton: false,
      timer: 3000,
      timerProgressBar: true,
      customClass: { popup: 'text-sm md:text-base' }
    });

    // =====================================================
    // ✅ FUNCIÓN PARA ACTUALIZAR CAMPO HIDDEN DE PIERCINGS
    // =====================================================
    function updatePiercingHiddenField() {
      const checkboxes = document.querySelectorAll('.piercing-checkbox:checked') as NodeListOf<HTMLInputElement>;
      const selectedValues = Array.from(checkboxes).map(cb => cb.value);
      
      if (piercingHiddenInput) {
        piercingHiddenInput.value = selectedValues.join(',');
        console.log('✅ piercing_name actualizado:', piercingHiddenInput.value);
      }
    }

    // ✅ AGREGAR LISTENER A TODOS LOS CHECKBOXES DE PIERCING
    document.querySelectorAll('.piercing-checkbox').forEach(checkbox => {
      checkbox.addEventListener('change', updatePiercingHiddenField);
    });

    // Manejo de archivos
    const handleNewFiles = (incomingFiles: FileList) => {
      const uniqueFiles = Array.from(incomingFiles).filter(
        file => file.type.startsWith('image/') && !newFiles.some(f => f.name === file.name && f.size === f.size)
      );
      if (uniqueFiles.length === 0) return;
      newFiles = [...newFiles, ...uniqueFiles];
      renderNewPreviews();
      updateFileInput();
    };

    const renderNewPreviews = () => {
      previewContainers.forEach(container => {
        if (!container) return;
        container.innerHTML = '';
        newFiles.forEach((file, index) => {
          const reader = new FileReader();
          reader.onload = e => {
            if (!e.target?.result) return;
            const wrapper = document.createElement('div');
            wrapper.className = 'relative group';
            wrapper.innerHTML = `
              <img src="${e.target.result as string}" alt="${file.name}" class="h-20 md:h-24 w-full object-cover rounded-lg shadow-md" />
              <button type="button" data-index="${index}" class="remove-new-btn absolute top-1 right-1 bg-red-600 text-white rounded-full h-5 w-5 md:h-6 md:w-6 flex items-center justify-center text-xs font-bold opacity-0 group-hover:opacity-100 transition-opacity">×</button>
            `;
            container.appendChild(wrapper);
          };
          reader.readAsDataURL(file);
        });
      });
    };

    const updateFileInput = () => {
      const dataTransfer = new DataTransfer();
      newFiles.forEach(file => dataTransfer.items.add(file));
      fileInputs.forEach(input => {
        if (input) input.files = dataTransfer.files;
      });
    };

    // Event listeners para drag & drop
    dropZones.forEach((dropZone, idx) => {
      const fileInput = fileInputs[idx];
      if (!dropZone || !fileInput) return;

      dropZone.addEventListener('click', () => fileInput.click());

      let changeTimeout: NodeJS.Timeout;
      fileInput.addEventListener('change', () => {
        clearTimeout(changeTimeout);
        changeTimeout = setTimeout(() => {
          if (fileInput.files && fileInput.files.length > 0) {
            handleNewFiles(fileInput.files);
          }
        }, 100);
      });

      const preventDefaults = (e: Event) => { e.preventDefault(); e.stopPropagation(); };
      ['dragenter', 'dragover', 'dragleave', 'drop'].forEach(eventName => {
        dropZone.addEventListener(eventName, preventDefaults);
      });

      ['dragenter', 'dragover'].forEach(eventName => {
        dropZone.addEventListener(eventName, () => {
          dropZone.classList.add('border-yellow-600', 'bg-yellow-50');
        });
      });

      ['dragleave', 'drop'].forEach(eventName => {
        dropZone.addEventListener(eventName, () => {
          dropZone.classList.remove('border-yellow-600', 'bg-yellow-50');
        });
      });
      
      dropZone.addEventListener('drop', (e: DragEvent) => {
        if (e.dataTransfer?.files) handleNewFiles(e.dataTransfer.files);
      });
    });

    // Subir imagen de variante
    document.addEventListener('change', async (e) => {
      const target = e.target as HTMLInputElement;
      
      if (target.classList.contains('variant-image-input') && target.files && target.files[0]) {
        const file = target.files[0];
        const variantId = target.dataset.variantId;
        const productId = target.dataset.productId;
        
        if (!variantId || !productId) return;
        
        if (!file.type.startsWith('image/')) {
          Toast.fire({ icon: 'error', title: 'Debe ser una imagen' });
          target.value = '';
          return;
        }
        
        if (file.size > 5 * 1024 * 1024) {
          Toast.fire({ icon: 'error', title: 'Imagen muy grande (máx 5MB)' });
          target.value = '';
          return;
        }
        
        Swal.fire({
          title: 'Subiendo imagen...',
          text: 'Por favor espera',
          allowOutsideClick: false,
          didOpen: () => { Swal.showLoading(); }
        });
        
        try {
          const formData = new FormData();
          formData.append('variantId', variantId);
          formData.append('productId', productId);
          formData.append('imageFile', file);
          
          const { data, error } = await actions.uploadVariantImage(formData);
          if (error) throw new Error(error.message);
          
          Swal.close();
          Toast.fire({ icon: 'success', title: '¡Imagen subida!' });
          setTimeout(() => window.location.reload(), 1000);
        } catch (err: any) {
          Swal.fire({ icon: 'error', title: 'Error', text: err.message });
        }
        
        target.value = '';
      }
    });

    // Toggle de variantes
    if (hasVariantsCheckbox && variantsContainer) {
      hasVariantsCheckbox.addEventListener('change', () => {
        variantsContainer.classList.toggle('hidden', !hasVariantsCheckbox.checked);
      });
    }

    // Modales
    const variantModal = document.getElementById('variant-modal');
    const editVariantModal = document.getElementById('edit-variant-modal');
    const addVariantBtn = document.getElementById('add-variant-btn');
    const cancelVariantBtn = document.getElementById('cancel-variant-btn');
    const variantForm = document.getElementById('variant-form') as HTMLFormElement;
    const editVariantForm = document.getElementById('edit-variant-form') as HTMLFormElement;
    const addOptionBtn = document.getElementById('add-option-btn');
    const variantOptions = document.getElementById('variant-options');

    if (addVariantBtn && variantModal) {
      addVariantBtn.addEventListener('click', () => {
        variantModal.classList.remove('hidden');
        document.body.style.overflow = 'hidden';
      });
    }

    if (cancelVariantBtn && variantModal) {
      cancelVariantBtn.addEventListener('click', () => {
        variantModal.classList.add('hidden');
        document.body.style.overflow = '';
        if (variantForm) variantForm.reset();
      });
    }

    if (addOptionBtn && variantOptions) {
      addOptionBtn.addEventListener('click', () => {
        const newRow = document.createElement('div');
        newRow.className = 'variant-option-row space-y-2 border-t border-slate-200 pt-3 mt-3';
        newRow.innerHTML = `
          <input type="text" placeholder="Valor (ej: Dorado)" class="w-full px-3 py-2 bg-slate-50 text-slate-900 border border-slate-200 rounded-lg variant-value" required />
          <div class="grid grid-cols-3 gap-2">
            <input type="number" placeholder="Precio" step="0.01" class="px-3 py-2 bg-slate-50 text-slate-900 border border-slate-200 rounded-lg variant-price" />
            <input type="number" placeholder="Stock" class="px-3 py-2 bg-slate-50 text-slate-900 border border-slate-200 rounded-lg variant-stock" required />
            <input type="text" placeholder="SKU" class="px-3 py-2 bg-slate-50 text-slate-900 border border-slate-200 rounded-lg variant-sku" />
          </div>
          <button type="button" class="w-full text-red-600 hover:text-red-800 text-sm font-bold remove-option">× Eliminar</button>
        `;
        variantOptions.appendChild(newRow);
      });
    }

    // Click handlers para variantes
    document.addEventListener('click', async (e) => {
      if (isProcessing) return;
      
      const target = e.target as HTMLElement;
      const productId = form.querySelector('input[name="id"]')?.getAttribute('value');
      
      // Eliminar imagen de variante
      if (target.closest('.delete-variant-image')) {
        e.stopPropagation();
        e.preventDefault();
        
        const button = target.closest('.delete-variant-image') as HTMLElement;
        const variantId = button.dataset.variantId;
        if (!variantId) return;
        
        const result = await Swal.fire({
          title: '¿Eliminar imagen?',
          icon: 'warning',
          showCancelButton: true,
          confirmButtonColor: '#dc2626',
          confirmButtonText: 'Sí',
          cancelButtonText: 'No'
        });
        
        if (result.isConfirmed) {
          isProcessing = true;
          try {
            const { error } = await actions.deleteVariantImage(variantId);
            if (error) throw new Error(error.message);
            Toast.fire({ icon: 'success', title: 'Imagen eliminada' });
            setTimeout(() => window.location.reload(), 1000);
          } catch (err: any) {
            Swal.fire({ icon: 'error', title: 'Error', text: err.message });
          } finally {
            isProcessing = false;
          }
        }
        return;
      }
      
      // Editar variante
      if (target.closest('.edit-variant')) {
        const button = target.closest('.edit-variant') as HTMLElement;
        if (editVariantModal) {
          (document.getElementById('edit-variant-id') as HTMLInputElement).value = button.dataset.variantId || '';
          (document.getElementById('edit-variant-name') as HTMLInputElement).value = button.dataset.variantName || '';
          (document.getElementById('edit-variant-value') as HTMLInputElement).value = button.dataset.variantValue || '';
          (document.getElementById('edit-price-adjustment') as HTMLInputElement).value = button.dataset.priceAdjustment || '0';
          (document.getElementById('edit-stock') as HTMLInputElement).value = button.dataset.stock || '0';
          (document.getElementById('edit-sku') as HTMLInputElement).value = button.dataset.sku || '';
          editVariantModal.classList.remove('hidden');
          document.body.style.overflow = 'hidden';
        }
      }

      // Eliminar variante
      if (target.closest('.delete-variant')) {
        const button = target.closest('.delete-variant') as HTMLElement;
        const variantId = button.dataset.variantId;
        
        const result = await Swal.fire({
          title: '¿Eliminar variante?',
          icon: 'warning',
          showCancelButton: true,
          confirmButtonColor: '#dc2626',
          confirmButtonText: 'Sí',
          cancelButtonText: 'No'
        });

        if (result.isConfirmed) {
          isProcessing = true;
          try {
            const { data, error } = await actions.deleteVariant(variantId!);
            if (error) throw new Error(error.message);
            
            button.closest('.variant-item')?.remove();
            
            if (data?.shouldRegenerateCombinations && productId) {
              const regen = await Swal.fire({
                title: '¿Regenerar combinaciones?',
                icon: 'question',
                showCancelButton: true,
                confirmButtonText: 'Sí',
                cancelButtonText: 'No'
              });
              if (regen.isConfirmed) {
                await actions.generateVariantCombinations(productId);
                setTimeout(() => window.location.reload(), 1000);
              }
            }
            
            const variantGroup = button.closest('.variant-group');
            if (variantGroup && variantGroup.querySelectorAll('.variant-item').length === 0) {
              variantGroup.remove();
            }
            
            Toast.fire({ icon: 'success', title: 'Eliminada' });
          } catch (err: any) {
            Swal.fire({ icon: 'error', title: 'Error', text: err.message });
          } finally {
            isProcessing = false;
          }
        }
      }

      // Eliminar grupo de variantes
      if (target.closest('.delete-variant-group')) {
        const button = target.closest('.delete-variant-group') as HTMLElement;
        const variantName = button.dataset.variantName;
        
        const result = await Swal.fire({
          title: `¿Eliminar "${variantName}"?`,
          icon: 'warning',
          showCancelButton: true,
          confirmButtonColor: '#dc2626',
          confirmButtonText: 'Sí',
          cancelButtonText: 'No'
        });

        if (result.isConfirmed) {
          isProcessing = true;
          try {
            if (!productId) throw new Error('ID de producto no encontrado');
            const { error } = await actions.deleteVariantGroup({ productId, variantName: variantName! });
            if (error) throw new Error(error.message);
            
            button.closest('.variant-group')?.remove();
            
            if (document.querySelectorAll('.variant-group').length === 0 && hasVariantsCheckbox) {
              hasVariantsCheckbox.checked = false;
              variantsContainer?.classList.add('hidden');
            }
            
            Toast.fire({ icon: 'success', title: 'Grupo eliminado' });
          } catch (err: any) {
            Swal.fire({ icon: 'error', title: 'Error', text: err.message });
          } finally {
            isProcessing = false;
          }
        }
      }

      // Remover opción del modal
      if (target.classList.contains('remove-option')) {
        const allRows = document.querySelectorAll('.variant-option-row');
        if (allRows.length > 1) {
          target.closest('.variant-option-row')?.remove();
        } else {
          Toast.fire({ icon: 'warning', title: 'Debe haber al menos una opción' });
        }
      }
    });

    // Cancelar edición
    document.getElementById('cancel-edit-variant')?.addEventListener('click', () => {
      editVariantModal?.classList.add('hidden');
      document.body.style.overflow = '';
      editVariantForm?.reset();
    });

    // Submit edición de variante
    editVariantForm?.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (isProcessing) return;
      
      isProcessing = true;
      try {
        const { error } = await actions.updateVariant({
          variantId: (document.getElementById('edit-variant-id') as HTMLInputElement).value,
          variantValue: (document.getElementById('edit-variant-value') as HTMLInputElement).value,
          priceAdjustment: parseFloat((document.getElementById('edit-price-adjustment') as HTMLInputElement).value) || 0,
          stock: parseInt((document.getElementById('edit-stock') as HTMLInputElement).value) || 0,
          sku: (document.getElementById('edit-sku') as HTMLInputElement).value || null
        });
        
        if (error) throw new Error(error.message);
        
        editVariantModal?.classList.add('hidden');
        document.body.style.overflow = '';
        Toast.fire({ icon: 'success', title: 'Actualizada' });
        setTimeout(() => window.location.reload(), 1000);
      } catch (err: any) {
        Swal.fire({ icon: 'error', title: 'Error', text: err.message });
      } finally {
        isProcessing = false;
      }
    });

    // Submit nueva variante
    variantForm?.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (isProcessing) return;
      
      const productId = form.querySelector('input[name="id"]')?.getAttribute('value');
      if (!productId) {
        Swal.fire({ icon: 'warning', title: 'Primero guarda el producto' });
        return;
      }

      const variantName = (document.getElementById('variant-name') as HTMLInputElement).value;
      const rows = document.querySelectorAll('.variant-option-row');
      const variants = Array.from(rows).map(row => ({
        variantName,
        variantValue: (row.querySelector('.variant-value') as HTMLInputElement).value,
        priceAdjustment: parseFloat((row.querySelector('.variant-price') as HTMLInputElement).value) || 0,
        stock: parseInt((row.querySelector('.variant-stock') as HTMLInputElement).value) || 0,
        sku: (row.querySelector('.variant-sku') as HTMLInputElement).value || undefined
      }));

      isProcessing = true;
      try {
        const { error } = await actions.createBatchVariants({ productId, variants });
        if (error) throw new Error(error.message);
        
        variantModal?.classList.add('hidden');
        document.body.style.overflow = '';
        Toast.fire({ icon: 'success', title: 'Creadas' });
        setTimeout(() => window.location.reload(), 1000);
      } catch (err: any) {
        Swal.fire({ icon: 'error', title: 'Error', text: err.message });
      } finally {
        isProcessing = false;
      }
    });

    // Generar combinaciones
    document.getElementById('generate-combinations-btn')?.addEventListener('click', async () => {
      if (isProcessing) return;
      
      const productId = form.querySelector('input[name="id"]')?.getAttribute('value');
      if (!productId) return;

      const result = await Swal.fire({
        title: '¿Generar combinaciones?',
        icon: 'question',
        showCancelButton: true,
        confirmButtonText: 'Sí',
        cancelButtonText: 'No'
      });

      if (result.isConfirmed) {
        isProcessing = true;
        try {
          const { error } = await actions.generateVariantCombinations(productId);
          if (error) throw new Error(error.message);
          Toast.fire({ icon: 'success', title: 'Generadas' });
          setTimeout(() => window.location.reload(), 1000);
        } catch (err: any) {
          Swal.fire({ icon: 'error', title: 'Error', text: err.message });
        } finally {
          isProcessing = false;
        }
      }
    });

    // Stock de combinaciones
    document.querySelectorAll('.combination-stock-input').forEach(input => {
      let timeout: NodeJS.Timeout;
      input.addEventListener('change', async (e) => {
        clearTimeout(timeout);
        const target = e.target as HTMLInputElement;
        const combinationId = target.dataset.combinationId;
        if (!combinationId) return;

        timeout = setTimeout(async () => {
          try {
            const { error } = await actions.updateCombinationStock({
              combinationId,
              newStock: parseInt(target.value)
            });
            if (error) throw new Error(error.message);
            target.classList.add('border-green-500');
            setTimeout(() => target.classList.remove('border-green-500'), 1000);
          } catch (err: any) {
            target.classList.add('border-red-500');
            setTimeout(() => target.classList.remove('border-red-500'), 1000);
          }
        }, 500);
      });
    });

    // Eliminar imágenes existentes
    imageListContainers.forEach(container => {
      container?.addEventListener('click', async (e) => {
        if (isProcessing) return;
        const target = e.target as HTMLButtonElement;
        if (!target.classList.contains('delete-existing')) return;
        
        const id = target.dataset.id;
        if (!id) return;
        
        const result = await Swal.fire({
          title: '¿Eliminar imagen?',
          icon: 'warning',
          showCancelButton: true,
          confirmButtonColor: '#dc2626',
          confirmButtonText: 'Sí',
          cancelButtonText: 'No'
        });

        if (result.isConfirmed) {
          isProcessing = true;
          try {
            const { error } = await actions.deleteProductImage(id);
            if (error) throw new Error(error.message);
            imageListContainers.forEach(c => c?.querySelector(`[data-id="${id}"]`)?.remove());
            Toast.fire({ icon: 'success', title: 'Eliminada' });
          } catch (err: any) {
            Swal.fire({ icon: 'error', title: 'Error', text: err.message });
          } finally {
            isProcessing = false;
          }
        }
      });
    });

    // Remover nuevas imágenes
    previewContainers.forEach(container => {
      container?.addEventListener('click', e => {
        const target = e.target as HTMLElement;
        if (target.classList.contains('remove-new-btn')) {
          const index = parseInt(target.dataset.index || '-1');
          if (index > -1) {
            newFiles.splice(index, 1);
            renderNewPreviews();
            updateFileInput();
          }
        }
      });
    });

    // Auto-generar slug
    const nameInput = document.getElementById('name') as HTMLInputElement;
    const slugInput = document.getElementById('slug') as HTMLInputElement;
    if (nameInput && slugInput && isCreate) {
      nameInput.addEventListener('input', () => {
        slugInput.value = nameInput.value
          .toLowerCase()
          .normalize("NFD")
          .replace(/[\u0300-\u036f]/g, "")
          .replace(/[^a-z0-9]+/g, '-')
          .replace(/^-+|-+$/g, '');
      });
    }

    // =====================================================
    // ✅ SUBMIT DEL FORMULARIO PRINCIPAL
    // =====================================================
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (isProcessing) return;
      
      const saveButton = document.getElementById('save-button') as HTMLButtonElement;
      if (!saveButton) return;
      
      isProcessing = true;
      saveButton.disabled = true;
      saveButton.textContent = isCreate ? 'Creando...' : 'Guardando...';
      
      try {
        // ✅ ACTUALIZAR EL CAMPO HIDDEN ANTES DE ENVIAR
        updatePiercingHiddenField();
        
        const formData = new FormData(form);
        
        // Debug
        console.log('✅ piercing_name a enviar:', formData.get('piercing_name'));
        
        // Manejo de imágenes
        formData.delete('imageFiles');
        newFiles.forEach(file => formData.append('imageFiles', file));
        
        const { data, error } = await actions.crateUpdateProduct(formData);
        if (error) throw new Error(error.message);
        
        await Swal.fire({
          icon: 'success',
          title: isCreate ? '¡Creado!' : '¡Guardado!',
          timer: 1500,
          showConfirmButton: false
        });
        
        navigate('/admin/products');
      } catch (err: any) {
        Swal.fire({ icon: 'error', title: 'Error', text: err.message });
      } finally {
        isProcessing = false;
        saveButton.disabled = false;
        saveButton.textContent = isCreate ? 'Crear Producto' : 'Guardar';
      }
    });
  });

  document.addEventListener('astro:before-preparation', () => {
    isInitialized = false;
    document.body.style.overflow = '';
  });
</script>

  <style>
    .card { @apply bg-white p-4 md:p-6 rounded-xl md:rounded-2xl shadow-lg ring-1 ring-slate-100; }
    .card-title { @apply text-base md:text-lg font-bold text-slate-800 mb-4 md:mb-6 border-b border-slate-200 pb-3 md:pb-4; }
    .form-label { @apply block text-xs md:text-sm font-bold text-slate-600 mb-2; }
    .form-input { @apply w-full px-3 md:px-4 py-2 md:py-3 bg-slate-50 text-slate-900 border border-slate-200 rounded-lg shadow-sm focus:outline-none focus:ring-2 focus:ring-yellow-500 focus:border-yellow-500 transition-colors text-sm md:text-base; }
    .btn-secondary { @apply px-3 md:px-4 py-2 border border-slate-300 text-slate-700 rounded-lg hover:bg-slate-50 transition-colors font-medium; }
    @media (max-width: 640px) { .swal2-popup { width: 90% !important; padding: 1rem !important; } }
  </style>
</AdminLayout>
