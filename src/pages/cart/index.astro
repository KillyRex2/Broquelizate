  .shipping-options::-webkit-scrollbar-track { background: rgba(255, 255, 255, 0.05); border-radius: 3px; }
  .shipping-options::-webkit-scrollbar-thumb { background: rgba(234, 179, 8, 0.4); border-radius: 3px; }
  .shipping-info { display: flex; align-items: center; gap: 8px; font-size: 0.8rem; color: rgba(255, 255, 255, 0.4); }
  .shipping-info svg { color: #22c55e; flex-shrink: 0; }
  .summary-row { display: flex; justify-content: space-between; align-items: center; }
  .row-label { display: flex; align-items: center; gap: 8px; color: rgba(255, 255, 255, 0.6); font-size: 0.95rem; }
  .row-value { font-weight: 600; color: #fff; font-size: 0.95rem; }
  .row-value.muted { color: rgba(255, 255, 255, 0.4); }
  .summary-row.savings .row-label, .summary-row.savings .row-value { color: #22c55e; }
  .summary-row.adjustment .row-label, .summary-row.adjustment .row-value { color: #fbbf24; }
  .summary-row.total .row-label { font-size: 1.1rem; font-weight: 700; color: #fff; }
  .summary-row.total .row-value { font-size: 1.75rem; font-weight: 900; background: linear-gradient(135deg, #eab308, #fbbf24); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; }
  .summary-divider { height: 1px; background: rgba(255, 255, 255, 0.08); margin: 8px 0; }
  .selected-shipping { padding: 14px; background: rgba(234, 179, 8, 0.08); border: 1px solid rgba(234, 179, 8, 0.2); border-radius: 12px; }
  .selected-shipping.hidden { display: none; }
  .shipping-selected-content { display: flex; align-items: center; gap: 12px; }
  .shipping-selected-content svg { color: #eab308; flex-shrink: 0; }
  .shipping-selected-info { flex: 1; display: flex; flex-direction: column; gap: 2px; }
  .carrier-name { font-size: 0.9rem; font-weight: 600; color: #fff; }
  .delivery-days { font-size: 0.8rem; color: rgba(255, 255, 255, 0.5); }
  .shipping-price { font-size: 1.1rem; font-weight: 800; color: #eab308; }
  .checkout-btn { width: 100%; display: flex; align-items: center; justify-content: center; gap: 12px; padding: 18px 32px; background: linear-gradient(135deg, #eab308 0%, #f59e0b 100%); border: none; border-radius: 16px; color: #000; font-size: 1.1rem; font-weight: 800; cursor: pointer; transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1); box-shadow: 0 4px 20px rgba(234, 179, 8, 0.3); margin-top: 8px; }
  .checkout-btn:hover:not(:disabled) { transform: translateY(-3px); box-shadow: 0 12px 35px rgba(234, 179, 8, 0.4); }
  .checkout-btn:disabled { background: rgba(255, 255, 255, 0.1); color: rgba(255, 255, 255, 0.4); cursor: not-allowed; box-shadow: none; }
  .payment-methods { padding-top: 20px; border-top: 1px solid rgba(255, 255, 255, 0.06); text-align: center; }
  .payment-title { font-size: 0.8rem; color: rgba(255, 255, 255, 0.4); margin-bottom: 14px; }
  .payment-icons { display: flex; justify-content: center; gap: 20px; }
  .payment-icon { display: flex; flex-direction: column; align-items: center; gap: 6px; color: rgba(255, 255, 255, 0.4); }
  .payment-icon svg { width: 28px; height: 28px; }
  .payment-icon span { font-size: 0.7rem; }
  .trust-badges { display: grid; grid-template-columns: repeat(2, 1fr); gap: 12px; }
  .trust-item { display: flex; align-items: center; gap: 12px; padding: 14px 16px; background: rgba(255, 255, 255, 0.02); border: 1px solid rgba(255, 255, 255, 0.05); border-radius: 14px; }
  .trust-icon { width: 40px; height: 40px; display: flex; align-items: center; justify-content: center; background: rgba(234, 179, 8, 0.1); border-radius: 10px; color: #eab308; flex-shrink: 0; }
  .trust-text { display: flex; flex-direction: column; gap: 2px; }
  .trust-title { font-size: 0.85rem; font-weight: 600; color: #fff; }
  .trust-desc { font-size: 0.75rem; color: rgba(255, 255, 255, 0.4); }
  @keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }
  @keyframes fadeInUp { from { opacity: 0; transform: translateY(20px); } to { opacity: 1; transform: translateY(0); } }
  @keyframes fadeInRight { from { opacity: 0; transform: translateX(30px); } to { opacity: 1; transform: translateX(0); } }
  @keyframes spin { from { transform: rotate(0deg); } to { transform: rotate(360deg); } }
  @media (max-width: 1024px) { .cart-content { grid-template-columns: 1fr; } .summary-column { position: static; } }
  @media (max-width: 768px) { .cart-page { padding: 16px 0 60px; } .cart-container { padding: 0 16px; } .cart-header { flex-direction: column; align-items: flex-start; } .header-title { font-size: 1.5rem; } .product-card { flex-direction: column; gap: 16px; padding: 16px; } .product-image-wrapper { width: 100%; height: 180px; } .product-actions { flex-wrap: wrap; gap: 12px; } .price-wrapper { margin-left: 0; flex: 1; } .trust-badges { grid-template-columns: 1fr; } }
  @media (max-width: 480px) { .breadcrumb { padding: 10px 14px; gap: 6px; font-size: 0.8rem; } .header-icon { width: 48px; height: 48px; } .card-body { padding: 16px; } .input-row { flex-direction: column; } .calculate-btn { width: 100%; justify-content: center; } .empty-features { flex-direction: column; gap: 16px; } }
  :global(.swal2-container) { z-index: 99999 !important; }
  :global(.swal2-popup) { background: #111 !important; color: #f3f4f6 !important; border: 1px solid rgba(255,255,255,0.1); }
  :global(.swal2-title) { color: #f3f4f6 !important; }
  :global(.swal2-html-container) { color: #9ca3af !important; }
</style>

<script>
  import { CartCookiesClient } from '../../utils/cart-cookies';
  import { navigate } from 'astro:transitions/client';
  import { itemsInCart } from '@/store';
  import { actions } from 'astro:actions';
  import Swal from 'sweetalert2';

  interface ShippingRate { carrier: string; service: string; deliveryDays: number; totalPrice: number; currency: string; }
  interface SelectedShipping { carrier: string; service: string; price: number; deliveryDays: number; postalCode: string; }

  function initializeCart() {
    const shippingPostalCodeInput = document.getElementById('shipping-postal-code') as HTMLInputElement;
    const calculateShippingBtn = document.getElementById('calculate-shipping-btn') as HTMLButtonElement;
    const shippingBtnText = document.getElementById('shipping-btn-text') as HTMLElement;
    const shippingBtnSpinner = document.getElementById('shipping-btn-spinner') as HTMLElement;
    const postalCodeValidation = document.getElementById('postal-code-validation') as HTMLElement;
    const shippingError = document.getElementById('shipping-error') as HTMLElement;
    const shippingErrorText = document.getElementById('shipping-error-text') as HTMLElement;
    const shippingResults = document.getElementById('shipping-results') as HTMLElement;
    const shippingOptions = document.getElementById('shipping-options') as HTMLElement;
    const clearShippingBtn = document.getElementById('clear-shipping') as HTMLElement;
    const shippingCostDisplay = document.getElementById('shipping-cost-display') as HTMLElement;
    const selectedShippingInfo = document.getElementById('selected-shipping-info') as HTMLElement;
    const selectedCarrierName = document.getElementById('selected-carrier-name') as HTMLElement;
    const selectedDeliveryDays = document.getElementById('selected-delivery-days') as HTMLElement;
    const selectedShippingPrice = document.getElementById('selected-shipping-price') as HTMLElement;
    const totalPriceElement = document.getElementById('total-price') as HTMLElement;
    const checkoutBtn = document.getElementById('checkout-btn') as HTMLButtonElement;
    const originPostalCode = (document.getElementById('origin-postal-code') as HTMLInputElement)?.value || '35000';
    const subtotal = parseFloat((document.getElementById('subtotal-value') as HTMLInputElement)?.value || '0');
    const estimatedWeight = parseFloat((document.getElementById('estimated-weight') as HTMLInputElement)?.value || '0.5');
    const totalItems = parseInt((document.getElementById('total-items') as HTMLInputElement)?.value || '0');

    let selectedShipping: SelectedShipping | null = null;
    let shippingRates: ShippingRate[] = [];

    const formatCurrency = (value: number) => new Intl.NumberFormat('es-MX', { style: 'currency', currency: 'MXN' }).format(value);
    const validatePostalCode = (cp: string) => /^\d{5}$/.test(cp);

    function setShippingLoading(loading: boolean) {
      if (calculateShippingBtn) calculateShippingBtn.disabled = loading;
      if (shippingBtnText) shippingBtnText.textContent = loading ? 'Cotizando...' : 'Cotizar';
      if (shippingBtnSpinner) shippingBtnSpinner.classList.toggle('hidden', !loading);
    }

    function showShippingError(msg: string) { if (shippingError && shippingErrorText) { shippingErrorText.textContent = msg; shippingError.classList.remove('hidden'); } if (shippingResults) shippingResults.classList.add('hidden'); }
    function hideShippingError() { if (shippingError) shippingError.classList.add('hidden'); }

    function updateTotal() {
      const shippingPrice = selectedShipping?.price || 0;
      if (totalPriceElement) totalPriceElement.textContent = formatCurrency(subtotal + shippingPrice);
      if (shippingCostDisplay) { shippingCostDisplay.textContent = selectedShipping ? formatCurrency(shippingPrice) : 'Por calcular'; shippingCostDisplay.className = selectedShipping ? 'row-value' : 'row-value muted'; }
    }

    function getCarrierEmoji(c: string): string { const e: Record<string, string> = { 'fedex': '🚚', 'dhl': '📦', 'estafeta': '📫', 'redpack': '🔴', 'ups': '🟤', 'paquetexpress': '📬', '99minutos': '⚡', 'sendex': '✉️' }; return e[c.toLowerCase()] || '📦'; }

    function renderShippingOptions(rates: ShippingRate[]) {
      if (!shippingOptions) return;
      const sorted = [...rates].sort((a, b) => a.totalPrice - b.totalPrice);
      shippingOptions.innerHTML = sorted.map((r, i) => {
        const best = i === 0, fast = r.deliveryDays === Math.min(...sorted.map(x => x.deliveryDays)) && !best;
        return `<label style="display:flex;gap:12px;padding:14px;border-radius:12px;cursor:pointer;transition:all 0.2s;border:2px solid ${best ? '#eab308' : 'rgba(255,255,255,0.1)'};background:${best ? 'rgba(234,179,8,0.1)' : 'rgba(255,255,255,0.02)'};">
          <input type="radio" name="shipping-rate" value="${i}" ${best ? 'checked' : ''} style="display:none;" />
          <span style="font-size:1.5rem;">${getCarrierEmoji(r.carrier)}</span>
          <div style="flex:1;"><div style="display:flex;align-items:center;gap:8px;flex-wrap:wrap;"><span style="font-weight:700;color:#fff;font-size:0.9rem;">${r.carrier}</span>${best ? '<span style="font-size:0.65rem;background:#eab308;color:#000;padding:2px 6px;border-radius:4px;font-weight:700;">MEJOR PRECIO</span>' : ''}${fast ? '<span style="font-size:0.65rem;background:#22c55e;color:#fff;padding:2px 6px;border-radius:4px;font-weight:700;">MÁS RÁPIDO</span>' : ''}</div><p style="font-size:0.8rem;color:rgba(255,255,255,0.5);margin-top:2px;">${r.service}</p><p style="font-size:0.75rem;color:rgba(255,255,255,0.4);margin-top:4px;">${r.deliveryDays} día${r.deliveryDays !== 1 ? 's' : ''} hábil${r.deliveryDays !== 1 ? 'es' : ''}</p></div>
          <span style="font-size:1.1rem;font-weight:800;color:${best ? '#eab308' : '#fff'};">${formatCurrency(r.totalPrice)}</span>
        </label>`;
      }).join('');
      shippingOptions.querySelectorAll('input[name="shipping-rate"]').forEach(inp => { inp.addEventListener('change', (e) => { const idx = parseInt((e.target as HTMLInputElement).value); selectShippingRate(sorted[idx]); shippingOptions.querySelectorAll('label').forEach((l, i) => { (l as HTMLElement).style.borderColor = i === idx ? '#eab308' : 'rgba(255,255,255,0.1)'; (l as HTMLElement).style.background = i === idx ? 'rgba(234,179,8,0.1)' : 'rgba(255,255,255,0.02)'; }); }); });
      if (sorted.length > 0) selectShippingRate(sorted[0]);
    }

    function selectShippingRate(r: ShippingRate) {
      const cp = shippingPostalCodeInput?.value || '';
      selectedShipping = { carrier: r.carrier, service: r.service, price: r.totalPrice, deliveryDays: r.deliveryDays, postalCode: cp };
      if (selectedShippingInfo) { selectedShippingInfo.classList.remove('hidden'); if (selectedCarrierName) selectedCarrierName.textContent = `${r.carrier} - ${r.service}`; if (selectedDeliveryDays) selectedDeliveryDays.textContent = `Entrega en ${r.deliveryDays} día${r.deliveryDays !== 1 ? 's' : ''} hábil${r.deliveryDays !== 1 ? 'es' : ''}`; if (selectedShippingPrice) selectedShippingPrice.textContent = formatCurrency(r.totalPrice); }
      localStorage.setItem('selectedShipping', JSON.stringify(selectedShipping));
      updateTotal();
    }

    async function calculateShippingRates() {
      const cp = shippingPostalCodeInput?.value?.trim() || '';
      if (!validatePostalCode(cp)) { showShippingError('Ingresa un código postal válido de 5 dígitos'); return; }
      hideShippingError(); setShippingLoading(true);
      try {
        const result = await actions.getShippingRates({ originPostalCode, destinationPostalCode: cp, weight: Math.max(1, estimatedWeight), length: Math.min(15 + (totalItems * 2), 50), width: 15, height: 10 });
        if (result.error) { showShippingError('No pudimos obtener las tarifas. Intenta de nuevo.'); return; }
        const data = result.data;
        if (!data?.success || !data?.rates || data.rates.length === 0) { showShippingError(data?.error || 'No hay opciones de envío disponibles para ese código postal.'); return; }
        shippingRates = data.rates;
        if (postalCodeValidation) postalCodeValidation.classList.remove('hidden');
        if (shippingResults) shippingResults.classList.remove('hidden');
        renderShippingOptions(shippingRates);
      } catch { showShippingError('Error de conexión. Verifica tu internet e intenta de nuevo.'); } finally { setShippingLoading(false); }
    }

    function clearShipping() { selectedShipping = null; shippingRates = []; if (shippingPostalCodeInput) shippingPostalCodeInput.value = ''; if (postalCodeValidation) postalCodeValidation.classList.add('hidden'); if (shippingResults) shippingResults.classList.add('hidden'); if (selectedShippingInfo) selectedShippingInfo.classList.add('hidden'); localStorage.removeItem('selectedShipping'); updateTotal(); }

    shippingPostalCodeInput?.addEventListener('input', (e) => { const t = e.target as HTMLInputElement; t.value = t.value.replace(/\D/g, '').slice(0, 5); if (postalCodeValidation) postalCodeValidation.classList.add('hidden'); hideShippingError(); });
    shippingPostalCodeInput?.addEventListener('keypress', (e) => { if (e.key === 'Enter') { e.preventDefault(); calculateShippingRates(); } });
    calculateShippingBtn?.addEventListener('click', calculateShippingRates);
    clearShippingBtn?.addEventListener('click', clearShipping);

    document.querySelectorAll('.remove-item').forEach(btn => { btn.addEventListener('click', async (e) => { const t = e.currentTarget as HTMLButtonElement; const productId = t.dataset.id || '', variantId = t.dataset.variantId || undefined, combinationId = t.dataset.combinationId || undefined; const result = await Swal.fire({ title: '¿Eliminar producto?', text: 'Se eliminará este producto del carrito', icon: 'question', showCancelButton: true, confirmButtonColor: '#eab308', cancelButtonColor: '#6b7280', confirmButtonText: 'Sí, eliminar', cancelButtonText: 'Cancelar' }); if (result.isConfirmed) { const cart = CartCookiesClient.removeItem(productId, variantId, combinationId); itemsInCart.set(cart.reduce((s, i) => s + i.quantity, 0)); navigate('/cart'); } }); });
    document.querySelectorAll('.qty-selector').forEach(sel => { sel.addEventListener('change', (e) => { const t = e.currentTarget as HTMLSelectElement; const productId = t.dataset.productId || '', variantId = t.dataset.variantId || undefined, combinationId = t.dataset.combinationId || undefined, qty = parseInt(t.value); if (productId && qty > 0) { const cart = CartCookiesClient.updateItemQuantity(productId, qty, variantId, combinationId); itemsInCart.set(cart.reduce((s, i) => s + i.quantity, 0)); navigate('/cart'); } }); });
    document.getElementById('clear-cart-btn')?.addEventListener('click', async () => { const result = await Swal.fire({ title: '¿Vaciar el carrito?', text: 'Se eliminarán todos los productos', icon: 'warning', showCancelButton: true, confirmButtonColor: '#ef4444', cancelButtonColor: '#6b7280', confirmButtonText: 'Sí, vaciar', cancelButtonText: 'Cancelar' }); if (result.isConfirmed) { CartCookiesClient.clearCart(); itemsInCart.set(0); localStorage.removeItem('selectedShipping'); await Swal.fire({ title: '¡Carrito vaciado!', icon: 'success', timer: 1500, showConfirmButton: false }); navigate('/cart'); } });
    checkoutBtn?.addEventListener('click', () => { if (!selectedShipping) { Swal.fire({ title: 'Selecciona un método de envío', text: 'Por favor calcula el costo de envío antes de continuar', icon: 'info', confirmButtonColor: '#eab308', confirmButtonText: 'Entendido' }); shippingPostalCodeInput?.focus(); return; } navigate('/checkout'); });

    const saved = localStorage.getItem('selectedShipping');
    if (saved && shippingPostalCodeInput) { try { const s = JSON.parse(saved); if (s.postalCode) { shippingPostalCodeInput.value = s.postalCode; setTimeout(() => calculateShippingRates(), 300); } } catch {} }
  }

  document.addEventListener('astro:page-load', () => setTimeout(() => initializeCart(), 100));
</script>
