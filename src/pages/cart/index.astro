  .change-cp-btn { background: none; border: none; color: #eab308; font-size: 0.8rem; font-weight: 500; cursor: pointer; transition: color 0.2s; }
  .change-cp-btn:hover { color: #fbbf24; }
  .shipping-options { display: flex; flex-direction: column; gap: 10px; max-height: 250px; overflow-y: auto; padding-right: 8px; }
