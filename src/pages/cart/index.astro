.product-image-wrapper { position: relative; z-index: 3; isolation: isolate; width: 88px; height: 88px; flex-shrink: 0; border-radius: 16px; overflow: hidden; background: #fff; box-shadow: 0 0 0 1px rgba(0,0,0,0.06); corner-shape: normal; }
