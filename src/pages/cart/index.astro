---
// src/pages/cart/index.astro
// ✅ ACTUALIZADO: Sin shipping calculator (movido a checkout)
// ✅ Sistema de alertas compatible con View Transitions

import { actions } from 'astro:actions';
import ProductsLayout from '@/layouts/ProductsLayout.astro';
import { Formatter } from '@/utils';

// ✅ Leer cookies del servidor (funciona en Netlify SSR)
const cartCookie = Astro.cookies.get('cart');
let cartItems: Array<{ productId: string; quantity: number; variantId?: string; combinationId?: string; customizationValues?: Array<{ fieldId: string; label: string; type: string; value: string }>; engraving?: { id: string; imageUrl: string; notes: string } }> = [];

try {
  if (cartCookie?.value) {
    cartItems = JSON.parse(cartCookie.value);
  }
} catch (e) {
  cartItems = [];
}

let products: any[] = [];

if (cartItems.length > 0) {
  const { data, error } = await Astro.callAction(actions.loadProductsFromCart, cartItems);
  if (!error && data) {
    // Merge engraving data from cart cookies into loaded products
    products = data.map((product: any) => {
      const cartItem = cartItems.find(ci => 
        ci.productId === product.productId && 
        ci.variantId === product.variantId && 
        ci.combinationId === product.combinationId
      );
      return {
        ...product,
        customizationValues: cartItem?.customizationValues || [],
        engraving: cartItem?.engraving || null,
      };
    });
  }
}

const subtotal = products.reduce((sum, p) => {
  const price = p.variantPrice ?? p.price;
  return sum + price * p.quantity;
}, 0);

const totalItems = products.reduce((sum, p) => sum + p.quantity, 0);
---

<ProductsLayout title="Tu Carrito - Broquelizate">
  <div class="cart-page">
    <div class="bg-decoration">
      <div class="glow glow-1"></div>
      <div class="glow glow-2"></div>
      <div class="grid-pattern"></div>
    </div>

    <div class="cart-container">
      <nav class="breadcrumb">
        <a href="/" class="breadcrumb-link">
          <svg width="16" height="16" fill="currentColor" viewBox="0 0 20 20">
            <path d="M10.707 2.293a1 1 0 00-1.414 0l-7 7a1 1 0 001.414 1.414L4 10.414V17a1 1 0 001 1h2a1 1 0 001-1v-2a1 1 0 011-1h2a1 1 0 011 1v2a1 1 0 001 1h2a1 1 0 001-1v-6.586l.293.293a1 1 0 001.414-1.414l-7-7z"/>
          </svg>
          <span>Inicio</span>
        </a>
        <svg class="breadcrumb-sep" width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
        </svg>
        <span class="breadcrumb-current">Carrito de compras</span>
      </nav>

      <div class="cart-header">
        <div class="header-content">
          <div class="header-icon">
            <svg width="28" height="28" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z"/>
            </svg>
          </div>
          <div>
            <h1 class="header-title">Tu Carrito</h1>
            <p class="header-subtitle">
              {totalItems === 0 ? 'Sin productos' : `${totalItems} ${totalItems === 1 ? 'producto' : 'productos'} seleccionados`}
            </p>
          </div>
        </div>
        
        {products.length > 0 && (
          <button id="clear-cart-btn" class="clear-btn">
            <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
            </svg>
            <span>Vaciar carrito</span>
          </button>
        )}
      </div>

      {products.length === 0 ? (
        <div class="empty-state">
          <div class="empty-icon">
            <svg width="80" height="80" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"/>
            </svg>
          </div>
          <h2 class="empty-title">Tu carrito está vacío</h2>
          <p class="empty-text">Descubre nuestra colección de joyería premium y encuentra las piezas perfectas para ti.</p>
          <a href="/products" class="empty-cta">
            <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/>
            </svg>
            <span>Explorar Catálogo</span>
          </a>
          <div class="empty-features">
            <div class="feature-item">
              <svg width="20" height="20" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M5 9V7a5 5 0 0110 0v2a2 2 0 012 2v5a2 2 0 01-2 2H5a2 2 0 01-2-2v-5a2 2 0 012-2zm8-2v2H7V7a3 3 0 016 0z" clip-rule="evenodd"/></svg>
              <span>Pago 100% seguro</span>
            </div>
            <div class="feature-item">
              <svg width="20" height="20" fill="currentColor" viewBox="0 0 20 20"><path d="M8 16.5a1.5 1.5 0 11-3 0 1.5 1.5 0 013 0zM15 16.5a1.5 1.5 0 11-3 0 1.5 1.5 0 013 0z"/><path d="M3 4a1 1 0 00-1 1v10a1 1 0 001 1h1.05a2.5 2.5 0 014.9 0H10a1 1 0 001-1V5a1 1 0 00-1-1H3z"/></svg>
              <span>Envío a todo México</span>
            </div>
            <div class="feature-item">
              <svg width="20" height="20" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
              <span>Calidad garantizada</span>
            </div>
          </div>
        </div>
      ) : (
        <div class="cart-content">
          <div class="products-column">
            <div class="products-list">
              {products.map((product, index) => {
                const displayPrice = product.variantPrice ?? product.price;
                const hasVariant = product.variantCombination || product.variantId;
                const productImage = product.variantImage || product.image;
                const isVariantImage = !!product.variantImage;
                
                return (
                  <div class="product-card" style={`animation-delay: ${index * 0.1}s`}>
                    <div class="product-image-wrapper">
                      <a href={`/products/${product.slug}`} class="product-image-link">
                        <img src={productImage} alt={product.name} class="product-image" loading="lazy" />
                      </a>
                      {isVariantImage && (
                        <div class="variant-image-badge">
                          <svg width="12" height="12" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M4 3a2 2 0 00-2 2v10a2 2 0 002 2h12a2 2 0 002-2V5a2 2 0 00-2-2H4zm12 12H4l4-8 3 6 2-4 3 6z" clip-rule="evenodd"/></svg>
                        </div>
                      )}
                    </div>
                    <div class="product-info">
                      <div class="product-details">
                        <a href={`/products/${product.slug}`} class="product-name">{product.name}</a>
                        <span class="product-category">{product.category}</span>
                        {hasVariant && product.variantCombination && (
                          <div class="variant-badge">
                            <svg width="14" height="14" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z"/></svg>
                            <span>{product.variantCombination}</span>
                          </div>
                        )}
                        {product.customizationValues && product.customizationValues.length > 0 && (
                          <div class="customization-badge">
                            <div class="customization-badge-header">
                              <svg width="14" height="14" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"/>
                              </svg>
                              <span>Personalización ({product.customizationValues.length})</span>
                            </div>
                            <div class="customization-badge-items">
                              {product.customizationValues.map((cv: any) => (
                                <div class="customization-badge-item">
                                  {cv.type === 'image' ? (
                                    <div class="cust-item-image-row">
                                      <img src={cv.value} alt={cv.label} class="cust-item-thumb" />
                                      <span class="cust-item-label">{cv.label}</span>
                                    </div>
                                  ) : (
                                    <div class="cust-item-text-row">
                                      <span class="cust-item-label">{cv.label}:</span>
                                      <span class="cust-item-value">{cv.value}</span>
                                    </div>
                                  )}
                                </div>
                              ))}
                            </div>
                          </div>
                        )}
                        {/* Backward compat: mostrar engraving viejo si no hay customizationValues */}
                        {(!product.customizationValues || product.customizationValues.length === 0) && product.engraving && (
                          <div class="customization-badge">
                            <div class="customization-badge-header">
                              <svg width="14" height="14" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"/>
                              </svg>
                              <span>Grabado láser</span>
                            </div>
                            <div class="customization-badge-items">
                              <div class="customization-badge-item">
                                <div class="cust-item-image-row">
                                  <img src={product.engraving.imageUrl} alt="Grabado" class="cust-item-thumb" />
                                  <span class="cust-item-label">Imagen para grabado</span>
                                </div>
                              </div>
                              {product.engraving.notes && (
                                <div class="customization-badge-item">
                                  <div class="cust-item-text-row">
                                    <span class="cust-item-label">Notas:</span>
                                    <span class="cust-item-value">{product.engraving.notes}</span>
                                  </div>
                                </div>
                              )}
                            </div>
                          </div>
                        )}
                      </div>
                      
                      <div class="product-actions">
                        <div class="quantity-wrapper">
                          <label class="quantity-label">Cantidad</label>
                          <select data-product-id={product.productId} data-variant-id={product.variantId || ''} data-combination-id={product.combinationId || ''} class="quantity-select qty-selector">
                            {Array.from({ length: Math.min(product.stock || 1, 99) }, (_, i) => i + 1).map((n) => (
                              <option value={n} selected={n === product.quantity}>{n}</option>
                            ))}
                          </select>
                        </div>
                        <div class="price-wrapper">
                          <span class="price-total">{Formatter.currency(displayPrice * product.quantity)}</span>
                          {product.quantity > 1 && <span class="price-unit">{Formatter.currency(displayPrice)} c/u</span>}
                        </div>
                        <button data-id={product.productId} data-variant-id={product.variantId || ''} data-combination-id={product.combinationId || ''} class="remove-btn remove-item" aria-label="Eliminar producto">
                          <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
                        </button>
                      </div>
                    </div>
                  </div>
                );
              })}
            </div>
            <a href="/products" class="continue-shopping">
              <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/></svg>
              <span>Seguir comprando</span>
            </a>
          </div>

          <div class="summary-column">
            <div class="summary-card order-summary">
              <div class="card-header">
                <h3 class="card-title">Resumen de compra</h3>
              </div>
              <div class="card-body">
                <div class="summary-row">
                  <span class="row-label">Subtotal ({totalItems} {totalItems === 1 ? 'producto' : 'productos'})</span>
                  <span class="row-value">{Formatter.currency(subtotal)}</span>
                </div>
                {(() => {
                  const baseTotal = products.reduce((sum, p) => sum + p.price * p.quantity, 0);
                  const savings = baseTotal - subtotal;
                  if (savings > 0) {
                    return (
                      <div class="summary-row savings">
                        <span class="row-label"><svg width="16" height="16" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg>Ahorro</span>
                        <span class="row-value">-{Formatter.currency(savings)}</span>
                      </div>
                    );
                  } else if (savings < 0) {
                    return (
                      <div class="summary-row adjustment">
                        <span class="row-label">Ajuste variantes</span>
                        <span class="row-value">+{Formatter.currency(Math.abs(savings))}</span>
                      </div>
                    );
                  }
                  return null;
                })()}
                <div class="summary-row">
                  <span class="row-label">Envío</span>
                  <span class="row-value muted">Se calcula en checkout</span>
                </div>

                <div class="summary-divider"></div>
                <div class="summary-row total">
                  <span class="row-label">Total</span>
                  <span class="row-value">{Formatter.currency(subtotal)}</span>
                </div>
                <p class="shipping-note">Cotiza tu envío en el siguiente paso</p>
                <button id="checkout-btn" class="checkout-btn">
                  <span>Proceder al pago</span>
                  <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
                </button>
                <div class="payment-methods">
                  <p class="payment-title">Métodos de pago aceptados</p>
                  <div class="payment-icons">
                    <div class="payment-icon"><svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d="M20 4H4c-1.11 0-1.99.89-1.99 2L2 18c0 1.11.89 2 2 2h16c1.11 0 2-.89 2-2V6c0-1.11-.89-2-2-2zm0 14H4v-6h16v6zm0-10H4V6h16v2z"/></svg><span>Tarjeta</span></div>
                    <div class="payment-icon"><svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d="M19 14V6c0-1.1-.9-2-2-2H3c-1.1 0-2 .9-2 2v8c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2zm-9-1c-1.66 0-3-1.34-3-3s1.34-3 3-3 3 1.34 3 3-1.34 3-3 3zm13-6v11c0 1.1-.9 2-2 2H4v-2h17V7h2z"/></svg><span>Efectivo</span></div>
                    <div class="payment-icon"><svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d="M4 10v7h3v-7H4zm6 0v7h3v-7h-3zM2 22h19v-3H2v3zm14-12v7h3v-7h-3zm-4.5-9L2 6v2h19V6l-9.5-5z"/></svg><span>SPEI</span></div>
                  </div>
                </div>
              </div>
            </div>

            <div class="trust-badges">
              <div class="trust-item">
                <div class="trust-icon"><svg width="20" height="20" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M2.166 4.999A11.954 11.954 0 0010 1.944 11.954 11.954 0 0017.834 5c.11.65.166 1.32.166 2.001 0 5.225-3.34 9.67-8 11.317C5.34 16.67 2 12.225 2 7c0-.682.057-1.35.166-2.001zm11.541 3.708a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg></div>
                <div class="trust-text"><span class="trust-title">Compra segura</span><span class="trust-desc">SSL 256-bit</span></div>
              </div>
              <div class="trust-item">
                <div class="trust-icon"><svg width="20" height="20" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-12a1 1 0 10-2 0v4a1 1 0 00.293.707l2.828 2.829a1 1 0 101.415-1.415L11 9.586V6z" clip-rule="evenodd"/></svg></div>
                <div class="trust-text"><span class="trust-title">Entrega rápida</span><span class="trust-desc">2-5 días hábiles</span></div>
              </div>
            </div>
          </div>
        </div>
      )}
    </div>
  </div>
</ProductsLayout>

<style>
  .cart-page { position: relative; min-height: 100vh; padding: 24px 0 80px; }
  .bg-decoration { position: fixed; inset: 0; pointer-events: none; z-index: 0; }
  .glow { position: absolute; border-radius: 50%; filter: blur(150px); }
  .glow-1 { width: 600px; height: 600px; background: radial-gradient(circle, rgba(234, 179, 8, 0.06) 0%, transparent 70%); top: -100px; right: -100px; }
  .glow-2 { width: 500px; height: 500px; background: radial-gradient(circle, rgba(234, 179, 8, 0.04) 0%, transparent 70%); bottom: 200px; left: -100px; }
  .grid-pattern { position: absolute; inset: 0; background-image: linear-gradient(rgba(255, 255, 255, 0.015) 1px, transparent 1px), linear-gradient(90deg, rgba(255, 255, 255, 0.015) 1px, transparent 1px); background-size: 60px 60px; }
  .cart-container { position: relative; z-index: 10; max-width: 1400px; margin: 0 auto; padding: 0 24px; }
  .breadcrumb { display: flex; align-items: center; gap: 10px; margin-bottom: 32px; padding: 14px 20px; background: rgba(255, 255, 255, 0.02); border: 1px solid rgba(255, 255, 255, 0.05); border-radius: 14px; animation: fadeIn 0.4s ease-out; }
  .breadcrumb-link { display: flex; align-items: center; gap: 6px; color: rgba(255, 255, 255, 0.5); text-decoration: none; font-size: 0.9rem; font-weight: 500; transition: color 0.2s; }
  .breadcrumb-link:hover { color: #eab308; }
  .breadcrumb-sep { color: rgba(255, 255, 255, 0.2); }
  .breadcrumb-current { color: #fff; font-weight: 600; font-size: 0.9rem; }
  .cart-header { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 20px; margin-bottom: 40px; animation: fadeIn 0.5s ease-out; }
  .header-content { display: flex; align-items: center; gap: 16px; }
  .header-icon { width: 56px; height: 56px; display: flex; align-items: center; justify-content: center; background: linear-gradient(135deg, rgba(234, 179, 8, 0.15), rgba(234, 179, 8, 0.05)); border: 1px solid rgba(234, 179, 8, 0.3); border-radius: 16px; color: #eab308; }
  .header-title { font-size: 2rem; font-weight: 900; color: #fff; letter-spacing: -0.02em; }
  .header-subtitle { color: rgba(255, 255, 255, 0.5); font-size: 0.95rem; margin-top: 4px; }
  .clear-btn { display: flex; align-items: center; gap: 8px; padding: 12px 20px; background: rgba(239, 68, 68, 0.1); border: 1px solid rgba(239, 68, 68, 0.2); border-radius: 12px; color: #f87171; font-size: 0.9rem; font-weight: 600; cursor: pointer; transition: all 0.2s; }
  .clear-btn:hover { background: rgba(239, 68, 68, 0.15); border-color: rgba(239, 68, 68, 0.3); }
  .empty-state { display: flex; flex-direction: column; align-items: center; padding: 80px 24px; background: rgba(255, 255, 255, 0.02); border: 1px solid rgba(255, 255, 255, 0.06); border-radius: 24px; text-align: center; animation: fadeIn 0.6s ease-out; }
  .empty-icon { width: 120px; height: 120px; display: flex; align-items: center; justify-content: center; background: linear-gradient(135deg, rgba(234, 179, 8, 0.1), rgba(234, 179, 8, 0.05)); border: 1px solid rgba(234, 179, 8, 0.2); border-radius: 50%; color: #eab308; margin-bottom: 24px; }
  .empty-title { font-size: 1.75rem; font-weight: 800; color: #fff; margin-bottom: 12px; }
  .empty-text { color: rgba(255, 255, 255, 0.5); font-size: 1rem; max-width: 400px; line-height: 1.6; margin-bottom: 32px; }
  .empty-cta { display: flex; align-items: center; gap: 10px; padding: 16px 32px; background: linear-gradient(135deg, #eab308, #f59e0b); border-radius: 14px; color: #000; text-decoration: none; font-size: 1rem; font-weight: 700; transition: all 0.3s; box-shadow: 0 4px 20px rgba(234, 179, 8, 0.3); }
  .empty-cta:hover { transform: translateY(-3px); box-shadow: 0 12px 35px rgba(234, 179, 8, 0.4); }
  .empty-features { display: flex; flex-wrap: wrap; justify-content: center; gap: 24px; margin-top: 48px; padding-top: 32px; border-top: 1px solid rgba(255, 255, 255, 0.06); }
  .feature-item { display: flex; align-items: center; gap: 8px; color: rgba(255, 255, 255, 0.5); font-size: 0.9rem; }
  .feature-item svg { color: #eab308; }
  .cart-content { display: grid; grid-template-columns: 1fr 420px; gap: 40px; align-items: start; }
  .products-column { display: flex; flex-direction: column; gap: 24px; }
  .products-list { display: flex; flex-direction: column; gap: 16px; }
  .product-card { display: flex; gap: 20px; padding: 20px; background: rgba(255, 255, 255, 0.02); border: 1px solid rgba(255, 255, 255, 0.06); border-radius: 20px; animation: fadeInUp 0.5s ease-out both; transition: all 0.3s; }
  .product-card:hover { border-color: rgba(234, 179, 8, 0.2); background: rgba(255, 255, 255, 0.03); }
