/* ── Lista de productos (card compacta) ── */
.cart-content { display: grid; grid-template-columns: 1fr 420px; gap: 40px; align-items: start; position: relative; z-index: 10; }
.products-column { display: flex; flex-direction: column; gap: 24px; }
