.variant-image-badge { position: absolute; top: 5px; right: 5px; z-index: 4; width: 22px; height: 22px; display: flex; align-items: center; justify-content: center; background: linear-gradient(135deg, var(--gold), var(--gold-2)); border-radius: 8px; box-shadow: inset 1px 1px 0 rgba(255,255,255,0.6); color: #2a1f04; }

.product-info { flex: 1; display: flex; flex-direction: row; align-items: center; justify-content: space-between; gap: 16px; flex-wrap: wrap; }
.product-details { flex: 1 1 200px; display: flex; flex-direction: column; gap: 5px; }
.product-name { font-size: 1rem; font-weight: 700; color: var(--txt); text-decoration: none; transition: color 0.2s; display: -webkit-box; -webkit-line-clamp: 1; -webkit-box-orient: vertical; overflow: hidden; }
