<script>
  import { CartCookiesClient } from '../../utils/cart-cookies';
  import { Confirm, Toast } from '../../utils/alerts';
  import { navigate } from 'astro:transitions/client';
  import { itemsInCart } from '@/store';

  function initializeCart() {
    // Solo inicializa si estamos en la página del carrito
    if (!document.getElementById('checkout-btn') && !document.querySelector('.remove-item')) {
      return;
    }

    const checkoutBtn = document.getElementById('checkout-btn') as HTMLButtonElement | null;

    // Eliminar producto individual
    document.querySelectorAll('.remove-item').forEach(btn => {
      btn.addEventListener('click', async (e) => {
        const t = e.currentTarget as HTMLButtonElement;
        const productId = t.dataset.id || '';
        const variantId = t.dataset.variantId || undefined;
        const combinationId = t.dataset.combinationId || undefined;

        const confirmed = await Confirm.delete('este producto del carrito');
        if (!confirmed) return;

        const cart = CartCookiesClient.removeItem(productId, variantId, combinationId);
        itemsInCart.set(cart.reduce((s, i) => s + i.quantity, 0));
        Toast.success('Producto eliminado');
        navigate('/cart');
      });
    });

    // Cambiar cantidad
    document.querySelectorAll('.qty-selector').forEach(sel => {
      sel.addEventListener('change', (e) => {
        const t = e.currentTarget as HTMLSelectElement;
        const productId = t.dataset.productId || '';
        const variantId = t.dataset.variantId || undefined;
        const combinationId = t.dataset.combinationId || undefined;
        const qty = parseInt(t.value);

        if (productId && qty > 0) {
          const cart = CartCookiesClient.updateItemQuantity(productId, qty, variantId, combinationId);
          itemsInCart.set(cart.reduce((s, i) => s + i.quantity, 0));
          navigate('/cart');
        }
      });
    });

    // Vaciar carrito completo
    document.getElementById('clear-cart-btn')?.addEventListener('click', async () => {
      const confirmed = await Confirm.clear('todos los productos del carrito');
      if (!confirmed) return;

      CartCookiesClient.clearCart();
      itemsInCart.set(0);
      localStorage.removeItem('selectedShipping');
      Toast.success('¡Carrito vaciado!');
      navigate('/cart');
    });

    // ✅ Navegar al checkout (el shipping se calcula ahí)
    checkoutBtn?.addEventListener('click', () => {
      navigate('/checkout');
    });
  }

  // ✅ Cubrir carga directa (sin ViewTransitions) y navegación SPA
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initializeCart);
  } else {
    initializeCart();
  }
  document.addEventListener('astro:page-load', initializeCart);
</script>