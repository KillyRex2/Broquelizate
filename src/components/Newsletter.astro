---
// src/components/Newsletter.astro
---
<section 
  class="relative py-20 bg-cover bg-center font-sans" 
  style="background-image: url('https://images.unsplash.com/photo-1610495232624-818713aaa33a?q=80&w=2070&auto=format&fit=crop');"
>
  <!-- Overlay oscuro para legibilidad -->
  <div class="absolute inset-0 bg-black bg-opacity-60"></div>

  <div class="relative z-10 max-w-3xl mx-auto px-6 text-center text-white">
    <h2 class="text-4xl sm:text-5xl font-semibold mb-4 tracking-tight text-amber-400">
      Únete a nuestro Círculo Exclusivo
    </h2>
    <p class="text-lg sm:text-xl mb-8 text-gray-200">
      Sé de los primeros en descubrir nuestras colecciones de alta joyería, ofertas secretas y consejos exclusivos para el cuidado de tus piezas.
    </p>

    <form id="newsletter-form" class="flex flex-col sm:flex-row items-center justify-center gap-4 max-w-lg mx-auto">
      <input
        type="email"
        name="email"
        placeholder="Tu correo electrónico"
        class="w-full sm:flex-1 px-6 py-4 bg-white/10 backdrop-blur-sm border border-gray-600 rounded-full text-white placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-amber-400 focus:border-amber-400 transition"
        required
      />
      <button
        type="submit"
        id="newsletter-submit-btn"
        class="w-full sm:w-auto px-10 py-4 bg-gradient-to-r from-amber-400 to-amber-500 text-gray-900 font-bold rounded-full shadow-lg hover:scale-105 transition-transform duration-300 disabled:opacity-50 disabled:cursor-not-allowed disabled:scale-100"
      >
        {/* ✅ CORRECCIÓN: Se movió la clase al atributo 'class' */}
        <span id="newsletter-btn-text" class="font-semibold">Suscribirme</span>
      </button>
    </form>

    <p class="text-xs text-gray-400 mt-6">
      Respetamos tu privacidad. Nunca compartiremos tu información.
    </p>
  </div>
</section>

<script>
  import { actions } from 'astro:actions';
  import Swal from 'sweetalert2';
  import 'sweetalert2/dist/sweetalert2.min.css';

  function setupNewsletterForm() {
    const form = document.getElementById('newsletter-form') as HTMLFormElement | null;
    const submitBtn = document.getElementById('newsletter-submit-btn') as HTMLButtonElement | null;
    const btnText = document.getElementById('newsletter-btn-text') as HTMLSpanElement | null;

    if (!form || !submitBtn || !btnText) return;

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      
      const originalBtnText = btnText.textContent;
      submitBtn.disabled = true;
      btnText.textContent = 'Enviando...';

      const formData = new FormData(form);

      try {
        const { data, error } = await actions.subscribeToNewsletter(formData);

        if (error) {
          throw new Error(error.message);
        }

        if (data.success) {
          Swal.fire({
            icon: 'success',
            title: '¡Gracias por suscribirte!',
            text: 'Hemos enviado un correo de bienvenida. ¡Revisa tu bandeja de entrada!',
            confirmButtonColor: '#f59e0b', // Color ámbar
            background: '#1f2937', // Fondo oscuro
            color: '#ffffff' // Texto blanco
          });
          form.reset();
        }

      } catch (err: unknown) {
        const message = err instanceof Error ? err.message : 'Ocurrió un error inesperado.';
        Swal.fire({
          icon: 'error',
          title: '¡Ups! Algo salió mal',
          text: message,
          confirmButtonColor: '#f59e0b',
          background: '#1f2937',
          color: '#ffffff'
        });
      } finally {
        submitBtn.disabled = false;
        btnText.textContent = originalBtnText;
      }
    });
  }

  document.addEventListener('astro:page-load', setupNewsletterForm);
</script>
