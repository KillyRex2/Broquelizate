---
// src/components/HeroSectionSimple.astro
// Hero Section Premium - Imagen de fondo completa y visible

interface Props {
  products?: Array<{
    name: string;
    price: number;
    image: string;
    slug: string;
  }>;
}

import { freeShippingLabel } from '@/utils/shipping';
import { trustItems } from '@/utils/policies';

// Los tres motivos salen de policies.ts porque el footer pinta los mismos.
const garantias = trustItems();

const { products = [] } = Astro.props;

const displayProducts = products.length > 0 ? products : [
  { name: "Arete Ramita", price: 299, image: "/images/products/ramita-verde.jpg", slug: "arete-ramita" },
  { name: "Arete Trébol", price: 320, image: "/images/products/trebol.jpg", slug: "arete-trebol" },
  { name: "Collar Colibrí", price: 330, image: "/images/products/colibri.jpg", slug: "colibri" },
  { name: "Arete Abeja", price: 360, image: "/images/products/abejita.jpg", slug: "arete-abejita" },
];
---

<section class="hero">
  <!-- FONDO CON IMAGEN COMPLETA Y VISIBLE -->
  <div class="hero-bg">
    <img 
      src="/assets/hero-bg-jewelry.jpg" 
      alt="Joyería Broquelizate" 
      class="hero-bg-image"
      loading="eager"
      fetchpriority="high"
    />
    
    <!-- Overlay muy sutil -->
    <div class="hero-overlay"></div>
    
    <!-- Brillo dorado -->
    <div class="hero-glow"></div>
    
    <!-- Destellos -->
    <div class="hero-sparkles"></div>
  </div>

  <!-- Contenido principal -->
  <div class="hero-container">
    <!-- Columna izquierda - Texto -->
    <div class="hero-content">
      <div class="content-wrapper">
        <div class="hero-badge">
          <span>Descubre nuestra colección</span>
        </div>

        <h1 class="hero-title">
          Detalles que <span class="gradient-text">enamoran</span>
        </h1>

        <p class="hero-tagline">Joyas que hablan de ti</p>

        <p class="hero-subtitle">
          Descubre nuestra selección de joyería y encuentra esas piezas
          especiales que realzan tu estilo, expresan tu esencia y te
          acompañan en cada momento.
        </p>

        <!-- Aviso de envío. El monto sale de freeShippingLabel(), no escrito
             a mano: es el mismo número que cobra el carrito y que dicen los
             términos y condiciones. Si algún día sube, sube en los tres. -->
        <div class="shipping-note">
          <strong>Envíos a todo México</strong>
          <span>Envío nacional gratis en compras mayores a {freeShippingLabel()} MXN</span>
        </div>

        <!-- Botones -->
        <div class="hero-actions">
          <a href="/products" class="btn-primary">
            Descubrir Joyería
            <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
            </svg>
          </a>
        </div>

        <p class="hero-footnote">Encuentra tu próxima pieza favorita</p>
      </div>
    </div>

    <!-- Columna derecha - Productos -->
    <div class="hero-showcase">
      <div class="showcase-label">
        <span class="label-text">Productos Destacados</span>
        <a href="/products" class="see-all">
          Ver todo
          <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
          </svg>
        </a>
      </div>

      <div class="products-showcase">
        {displayProducts.slice(0, 4).map((product, i) => (
          <a 
            href={`/products/${product.slug}`} 
            class="showcase-card"
            style={`animation-delay: ${i * 0.15}s`}
          >
            <div class="card-image">
              <img 
                src={product.image} 
                alt={product.name}
                loading={i < 2 ? "eager" : "lazy"}
                onerror="this.src='https://placehold.co/400x400/1a1a1a/eab308?text=Sin+Imagen'"
              />
              <div class="card-hover">
                <span class="quick-view">Ver producto</span>
              </div>
            </div>
            <div class="card-details">
              <h3>{product.name}</h3>
              <span class="price">${product.price.toLocaleString('es-MX')}</span>
            </div>
          </a>
        ))}
      </div>

    </div>
  </div>

  <!-- Franja de confianza. Ocupa el ancho del hero, debajo de las dos
       columnas, donde antes estaba el botón de "Descubre más". Traslúcida
       sobre la foto: pertenece al hero en vez de ser un bloque blanco
       pegado abajo. -->
  <ul class="hero-trust">
    {garantias.map(({ titulo, detalle }) => (
      <li class="hero-trust-item">
        <svg class="hero-trust-check" width="18" height="18" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
          <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
        </svg>
        <span>
          <strong>{titulo}</strong>
          <small>{detalle}</small>
        </span>
      </li>
    ))}
  </ul>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    /* En columna: antes era una fila con un solo hijo, y al agregar la
       franja de confianza se puso a su lado en vez de debajo, aplastando
       las dos columnas del contenido. */
    flex-direction: column;
    justify-content: center;
    align-items: center;
    padding: 80px 0 56px;
    overflow: hidden;
    /* Fondo oscuro por si la imagen no cubre todo */
    background: linear-gradient(135deg, #0a0a0a 0%, #1a1a1a 100%);
  }

  /* ========================================
     FONDO - IMAGEN COMPLETA Y ALEJADA
     ======================================== */
  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* IMAGEN MÁS ALEJADA - sin zoom, centrada */
  .hero-bg-image {
    position: absolute;
    width: 100%;
    height: 100%;
    /* SIN ZOOM - imagen a tamaño real/completo */
    object-fit: cover;
    /* Centrar la imagen para mostrar la joyería */
    object-position: center center;
    /* Sin transformación de escala */
    transform: scale(1);
    /* Imagen brillante y con colores vivos */
    filter: brightness(1.1) saturate(1.25) contrast(1.02);
    /* Animación muy sutil, casi imperceptible */
    animation: subtleMove 20s ease-in-out infinite alternate;
  }

  @keyframes subtleMove {
    0% { 
      transform: scale(1) translateY(0); 
    }
    100% { 
      transform: scale(1.02) translateY(-5px); 
    }
  }

  /* Overlay MÍNIMO - solo donde hay texto */
  .hero-overlay {
    position: absolute;
    inset: 0;
    background: 
      /* Gradiente lateral izquierdo MUY sutil */
      linear-gradient(
        90deg,
        rgba(0, 0, 0, 0.6) 0%,
        rgba(0, 0, 0, 0.35) 20%,
        rgba(0, 0, 0, 0.1) 40%,
        transparent 55%
      ),
      /* Bordes superior e inferior sutiles */
      linear-gradient(
        180deg,
        rgba(0, 0, 0, 0.25) 0%,
        transparent 15%,
        transparent 85%,
        rgba(0, 0, 0, 0.3) 100%
      );
    z-index: 1;
  }

  /* Brillo dorado que realza la joyería */
  .hero-glow {
    position: absolute;
    inset: 0;
    background: 
      radial-gradient(
        ellipse 90% 80% at 55% 50%,
        rgba(255, 215, 0, 0.06) 0%,
        transparent 70%
      ),
      radial-gradient(
        ellipse 60% 40% at 70% 60%,
        rgba(234, 179, 8, 0.08) 0%,
        transparent 50%
      );
    z-index: 2;
    mix-blend-mode: overlay;
    animation: glowPulse 6s ease-in-out infinite alternate;
  }

  @keyframes glowPulse {
    0% { opacity: 0.7; }
    100% { opacity: 1; }
  }

  /* Destellos como brillo de joyas */
  .hero-sparkles {
    position: absolute;
    inset: 0;
    background-image: 
      radial-gradient(2px 2px at 25% 35%, rgba(255, 255, 255, 0.7) 50%, transparent 50%),
      radial-gradient(2.5px 2.5px at 45% 65%, rgba(255, 215, 0, 0.6) 50%, transparent 50%),
      radial-gradient(2px 2px at 65% 25%, rgba(255, 255, 255, 0.8) 50%, transparent 50%),
      radial-gradient(2px 2px at 80% 50%, rgba(234, 179, 8, 0.5) 50%, transparent 50%),
      radial-gradient(1.5px 1.5px at 70% 75%, rgba(255, 255, 255, 0.6) 50%, transparent 50%),
      radial-gradient(2px 2px at 35% 80%, rgba(255, 215, 0, 0.5) 50%, transparent 50%);
    z-index: 3;
    animation: sparkle 3s ease-in-out infinite;
    pointer-events: none;
  }

  @keyframes sparkle {
    0%, 100% { opacity: 0.3; }
    50% { opacity: 1; }
  }

  /* ========================================
     CONTENIDO PRINCIPAL
     ======================================== */

  .hero-container {
    position: relative;
    z-index: 10;
    width: 100%;
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 32px;
    display: grid;
    grid-template-columns: 1fr 1.1fr;
    gap: 60px;
    align-items: center;
  }

  /* Contenido texto con glass card */
  .hero-content {
    display: flex;
    flex-direction: column;
    animation: slideInLeft 0.8s ease-out;
  }

  .content-wrapper {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 14px;
    padding: 26px 30px;
    background: rgba(0, 0, 0, 0.45);
    backdrop-filter: blur(25px);
    -webkit-backdrop-filter: blur(25px);
    border-radius: 24px;
    border: 1px solid rgba(255, 255, 255, 0.12);
    box-shadow: 
      0 25px 50px rgba(0, 0, 0, 0.4),
      inset 0 1px 0 rgba(255, 255, 255, 0.1);
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    padding: 9px 20px;
    background: linear-gradient(135deg, #eab308, #f59e0b);
    border-radius: 10px;
    width: fit-content;
    box-shadow: 0 4px 16px rgba(234, 179, 8, 0.35);
  }

  /* Texto oscuro sobre el dorado, no blanco. En la maqueta se ve claro,
     pero blanco sobre #eab308 da un contraste de ~2:1 y se vuelve ilegible
     en una pantalla con sol encima. En negro queda ~10:1. */
  .hero-badge span {
    color: #1a1403;
    font-size: 0.9rem;
    font-weight: 600;
  }

  .hero-title {
    font-size: clamp(2rem, 3.6vw, 3.1rem);
    font-weight: 800;
    line-height: 1.1;
    color: #fff;
  }

  .gradient-text {
    background: linear-gradient(135deg, #eab308 0%, #fbbf24 50%, #f59e0b 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    filter: drop-shadow(0 2px 10px rgba(234, 179, 8, 0.5));
  }

  .block {
    display: block;
  }

  .hero-tagline {
    font-size: clamp(1.15rem, 2vw, 1.6rem);
    font-weight: 700;
    color: #fff;
    margin-top: -8px;
  }

  .hero-subtitle {
    font-size: 1rem;
    color: rgba(255, 255, 255, 0.9);
    line-height: 1.55;
    max-width: 460px;
    font-weight: 600;
  }

  /* Caja de envíos: la única parte clara de la tarjeta, para que el dato
     que más pesa en la decisión de compra no se pierda entre lo demás. */
  .shipping-note {
    display: flex;
    flex-direction: column;
    gap: 4px;
    width: 100%;
    max-width: 460px;
    padding: 12px 20px;
    background: #fdf6dd;
    border: 1px solid rgba(234, 179, 8, 0.45);
    border-radius: 12px;
  }

  .shipping-note strong {
    font-size: 0.9rem;
    font-weight: 700;
    color: #1a1403;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .shipping-note span {
    font-size: 0.86rem;
    color: #4a3c0a;
  }

  .hero-footnote {
    font-size: 0.82rem;
    color: rgba(255, 255, 255, 0.7);
    margin-top: -6px;
  }

  /* Botones */
  .hero-actions {
    display: flex;
    gap: 14px;
    padding-top: 8px;
  }

  .btn-primary {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 16px 30px;
    background: linear-gradient(135deg, #eab308, #f59e0b);
    color: #000;
    font-size: 0.95rem;
    font-weight: 700;
    border-radius: 12px;
    text-decoration: none;
    transition: all 0.3s ease;
    box-shadow: 0 4px 20px rgba(234, 179, 8, 0.5);
  }

  .btn-primary:hover {
    transform: translateY(-3px);
    box-shadow: 0 10px 35px rgba(234, 179, 8, 0.6);
  }

  .btn-primary svg {
    transition: transform 0.3s ease;
  }

  .btn-primary:hover svg {
    transform: translateX(4px);
  }

  .btn-secondary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 16px 30px;
    background: rgba(255, 255, 255, 0.1);
    border: 2px solid rgba(255, 255, 255, 0.3);
    color: #fff;
    font-size: 0.95rem;
    font-weight: 600;
    border-radius: 12px;
    text-decoration: none;
    transition: all 0.3s ease;
  }

  .btn-secondary:hover {
    background: rgba(234, 179, 8, 0.2);
    border-color: rgba(234, 179, 8, 0.6);
    color: #eab308;
  }

  /* ========================================
     SHOWCASE PRODUCTOS - más transparente
     ======================================== */
  .hero-showcase {
    display: flex;
    flex-direction: column;
    gap: 16px;
    animation: slideInRight 0.8s ease-out 0.2s both;
  }

  .showcase-label {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0 8px;
  }

  .label-text {
    font-size: 0.75rem;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.9);
    text-transform: uppercase;
    letter-spacing: 2px;
    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.8);
  }

  .see-all {
    display: flex;
    align-items: center;
    gap: 6px;
    color: #eab308;
    font-size: 0.85rem;
    font-weight: 600;
    text-decoration: none;
    transition: gap 0.3s ease;
    text-shadow: 0 2px 10px rgba(0, 0, 0, 0.8);
  }

  .see-all:hover {
    gap: 10px;
  }

  /* Grid de productos - más transparentes */
  .products-showcase {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 14px;
  }

  .showcase-card {
    position: relative;
    background: rgba(0, 0, 0, 0.4);
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 16px;
    overflow: hidden;
    text-decoration: none;
    transition: all 0.4s ease;
    animation: fadeInUp 0.6s ease-out both;
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
  }

  .showcase-card:hover {
    transform: translateY(-8px) scale(1.02);
    border-color: rgba(234, 179, 8, 0.6);
    box-shadow: 
      0 20px 45px rgba(0, 0, 0, 0.5),
      0 0 40px rgba(234, 179, 8, 0.15);
  }

  .card-image {
    position: relative;
    aspect-ratio: 1;
    overflow: hidden;
    background: linear-gradient(135deg, #1a1a1a 0%, #2a2a2a 100%);
  }

  .card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  .showcase-card:hover .card-image img {
    transform: scale(1.1);
  }

  .card-hover {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(0,0,0,0.85) 0%, transparent 60%);
    display: flex;
    align-items: flex-end;
    justify-content: center;
    padding-bottom: 16px;
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .showcase-card:hover .card-hover {
    opacity: 1;
  }

  .quick-view {
    padding: 10px 20px;
    background: linear-gradient(135deg, #eab308, #f59e0b);
    color: #000;
    font-size: 0.8rem;
    font-weight: 600;
    border-radius: 50px;
    transform: translateY(15px);
    transition: transform 0.3s ease;
  }

  .showcase-card:hover .quick-view {
    transform: translateY(0);
  }

  .card-details {
    padding: 14px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: rgba(0, 0, 0, 0.5);
    backdrop-filter: blur(8px);
  }

  .card-details h3 {
    font-size: 0.85rem;
    font-weight: 500;
    color: #fff;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 55%;
  }

  .price {
    font-size: 1rem;
    font-weight: 700;
    color: #eab308;
  }

  /* Garantías */
  /* Franja de confianza */
  .hero-trust {
    position: relative;
    z-index: 10;
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 10px;
    width: 100%;
    max-width: 1400px;
    margin: 24px auto 0;
    padding: 0 32px;
    list-style: none;
  }

  .hero-trust-item {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 11px 20px;
    border-radius: 14px;
    /* El mismo vidrio de la tarjeta del texto, para que se lean como
       partes de la misma pieza y no como dos bloques distintos. */
    background: rgba(0, 0, 0, 0.38);
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
    border: 1px solid rgba(255, 255, 255, 0.14);
  }

  .hero-trust-check {
    flex-shrink: 0;
    color: #22c55e;
  }

  .hero-trust-item span {
    display: flex;
    flex-direction: column;
    line-height: 1.25;
  }

  .hero-trust-item strong {
    font-size: 0.85rem;
    font-weight: 700;
    color: #fff;
  }

  .hero-trust-item small {
    font-size: 0.74rem;
    color: rgba(255, 255, 255, 0.72);
  }

  @media (max-width: 900px) {
    .hero-trust {
      margin-top: 28px;
      padding: 0 20px;
    }

    .hero-trust-item {
      padding: 10px 16px;
    }
  }

  @media (max-width: 640px) {
    .hero-trust {
      flex-direction: column;
      align-items: stretch;
      gap: 8px;
      padding: 0 16px;
    }

    .hero-trust-item {
      justify-content: flex-start;
    }
  }

  /* El alto del hero lo manda la rejilla de productos: dos filas de
     imágenes cuadradas. En una laptop típica (760-900 px de alto) eso deja
     el botón y la franja de confianza bajo el pliegue, que es justo donde
     no sirven. Aplanando la foto a 3:2 entra todo. En monitores altos el
     diseño se queda como está. */
  @media (max-height: 940px) {
    .hero {
      /* min-height: 100vh sobraba: el hero arranca DEBAJO de la barra de
         anuncios y el navbar, así que una altura de pantalla completa lo
         hacía terminar siempre 118 px por debajo del pliegue, con ese
         hueco vacío justo donde iba la franja. Aquí se ajusta al
         contenido. */
      min-height: 0;
      padding: 56px 0 40px;
    }

    .hero .card-image {
      aspect-ratio: 3 / 2;
    }

    .hero-trust {
      margin-top: 18px;
    }
  }

  /* Animaciones */
  @keyframes slideInLeft {
    from { opacity: 0; transform: translateX(-50px); }
    to { opacity: 1; transform: translateX(0); }
  }

  @keyframes slideInRight {
    from { opacity: 0; transform: translateX(50px); }
    to { opacity: 1; transform: translateX(0); }
  }

  @keyframes fadeInUp {
    from { opacity: 0; transform: translateY(30px); }
    to { opacity: 1; transform: translateY(0); }
  }

  @keyframes fadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  @keyframes pulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.5; transform: scale(1.3); }
  }

  @keyframes bounce {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(5px); }
  }

  /* ========================================
     RESPONSIVE
     ======================================== */
  @media (max-width: 1200px) {
    .hero-container {
      gap: 40px;
    }

    .content-wrapper {
      padding: 30px;
    }
  }

  @media (max-width: 1024px) {
    .hero-container {
      grid-template-columns: 1fr;
      text-align: center;
      gap: 40px;
    }

    .hero-content {
      align-items: center;
    }

    .content-wrapper {
      align-items: center;
      max-width: 550px;
      margin: 0 auto;
    }

    .hero-subtitle {
      max-width: 100%;
    }

    .hero-actions {
      justify-content: center;
    }

    .products-showcase {
      grid-template-columns: repeat(4, 1fr);
      gap: 12px;
    }

    .card-details {
      flex-direction: column;
      align-items: flex-start;
      gap: 4px;
      padding: 12px;
    }

    .card-details h3 {
      max-width: 100%;
    }

    .hero-bg-image {
      object-position: 50% center;
    }

    .hero-overlay {
      background: 
        linear-gradient(
          180deg,
          rgba(0, 0, 0, 0.4) 0%,
          rgba(0, 0, 0, 0.15) 30%,
          rgba(0, 0, 0, 0.15) 70%,
          rgba(0, 0, 0, 0.4) 100%
        );
    }
  }

  @media (max-width: 768px) {
    .hero {
      padding: 80px 0 100px;
    }

    .hero-container {
      padding: 0 16px;
    }

    .content-wrapper {
      padding: 26px 22px;
    }

    .hero-title {
      font-size: 1.9rem;
    }

    .hero-actions {
      flex-direction: column;
      width: 100%;
    }

    .btn-primary,
    .btn-secondary {
      width: 100%;
      justify-content: center;
    }

    .products-showcase {
      grid-template-columns: repeat(2, 1fr);
    }

    .hero-overlay {
      background: 
        linear-gradient(
          180deg,
