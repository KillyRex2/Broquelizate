---
import { CartCounter } from '@/components';

const { isLoggedIn, isAdmin, user } = Astro.locals;

// Umbral de envío gratis. Debe coincidir con el de la ficha de producto.
const FREE_SHIPPING_THRESHOLD = 1099;

// ⚠️ Verifica que estos valores existan en tu BD:
//    type   → Anillos, Broqueles, Cadenas, Pulseras, Piercings...
//    Si "Piercings" no es un type, cambia el href por el que aplique.
const navLinks = [
  { href: '/products', label: 'Catálogo' },
  { href: '/products?type=Piercings', label: 'Piercings' },
  { href: '/products?engraving=true', label: 'Joyería personalizada' },
  { href: '/#services', label: 'Ayuda' },
];
---

<div class="header-stack" id="header-stack">
  <!-- 📣 Barra de envío gratis -->
  <div class="announcement-bar">
    <svg width="15" height="15" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
      <path d="M8 16.5a1.5 1.5 0 11-3 0 1.5 1.5 0 013 0zM15 16.5a1.5 1.5 0 11-3 0 1.5 1.5 0 013 0zM3 4a1 1 0 00-1 1v10a1 1 0 001 1h1.05a2.5 2.5 0 014.9 0H10a1 1 0 001-1V5a1 1 0 00-1-1H3zM14 7a1 1 0 011-1h4.05a1 1 0 01.866.5l1.08 1.875A1 1 0 0121 9v5a1 1 0 01-1 1h-.05a2.5 2.5 0 01-4.9 0H14a1 1 0 01-1-1V8z"/>
    </svg>
    <span>Envíos nacionales <strong>GRATIS</strong> en compras mayores a ${FREE_SHIPPING_THRESHOLD} MXN</span>
  </div>

  <nav class="navbar" id="navbar">
    <div class="nav-container">
      <!-- Izquierda: hamburguesa (móvil) + enlaces (escritorio) -->
      <div class="nav-left">
        <button id="menu-btn" class="mobile-menu-btn" aria-label="Menú" aria-expanded="false">
          <span class="hamburger-line"></span>
          <span class="hamburger-line"></span>
          <span class="hamburger-line"></span>
        </button>

        <ul class="nav-links">
          {navLinks.map(link => (
            <li>
              <a href={link.href} class="nav-link">
                {link.label}
                <span class="link-underline"></span>
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Centro: logo -->
      <a href="/" class="nav-logo" aria-label="Broquelizate — inicio">
        <img
          src="/assets/Broquelizate-logos/logo-blanco.png"
          alt="Broquelizate, joyería y piercings"
          class="logo-image"
        />
      </a>

      <!-- Derecha: buscar, carrito, cuenta -->
      <div class="nav-right">
        <button class="search-btn" aria-label="Buscar" id="search-btn">
          <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
          </svg>
          <span>Buscar</span>
        </button>

        <div class="cart-wrapper">
          <CartCounter client:load transition:persist />
        </div>

        {!isLoggedIn ? (
          <a href="/login" class="login-btn">
            <svg width="17" height="17" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
            </svg>
            <span>Ingresar</span>
          </a>
        ) : (
          <div class="profile-menu">
            <button id="profile-btn" class="profile-btn" aria-label="Menú de usuario">
              <div class="profile-avatar">
                {user?.name?.charAt(0).toUpperCase() || 'U'}
              </div>
              <span class="profile-name">{user?.name?.split(' ')[0] || 'Mi cuenta'}</span>
              <svg class="profile-arrow" id="profile-arrow" width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/>
              </svg>
            </button>

            <!-- Dropdown -->
            <div id="profile-dropdown" class="profile-dropdown">
              <div class="dropdown-header">
                <div class="dropdown-avatar">
                  {user?.name?.charAt(0).toUpperCase() || 'U'}
                </div>
                <div class="dropdown-user-info">
                  <p class="dropdown-name">{user?.name || 'Usuario'}</p>
                  <p class="dropdown-email">{user?.email}</p>
                </div>
              </div>

              <div class="dropdown-divider"></div>

              <ul class="dropdown-menu">
                <li>
                  <a href="/account/my-orders" class="dropdown-item">
                    <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"/>
                    </svg>
                    <span>Mis Pedidos</span>
                    <svg class="item-arrow" width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                    </svg>
                  </a>
                </li>
                <li>
                  <a href="/account/perfil" class="dropdown-item">
                    <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
                    </svg>
                    <span>Mi Perfil</span>
                    <svg class="item-arrow" width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                    </svg>
                  </a>
                </li>
                <li>
                  <a href="/account/user-data" class="dropdown-item">
                    <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
                    </svg>
                    <span>Direcciones</span>
                    <svg class="item-arrow" width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                    </svg>
                  </a>
                </li>
                {isAdmin && (
                  <li>
                    <a href="/admin/dashboard" class="dropdown-item admin-item">
                      <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/>
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                      </svg>
                      <span>Panel Admin</span>
                      <svg class="item-arrow" width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                      </svg>
                    </a>
                  </li>
                )}
              </ul>

              <div class="dropdown-divider"></div>

              <button id="logout" class="logout-btn">
                <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/>
                </svg>
                <span>Cerrar Sesión</span>
              </button>
            </div>
          </div>
        )}
      </div>
    </div>

    <!-- Mobile Menu -->
    <div id="mobile-menu" class="mobile-menu">
      <div class="mobile-menu-content">
        <ul class="mobile-links">
          {navLinks.map(link => (
            <li>
              <a href={link.href} class="mobile-link">{link.label}</a>
            </li>
          ))}
        </ul>

        <div class="mobile-divider"></div>

        {!isLoggedIn ? (
          <a href="/login" class="mobile-login-btn">
            <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
            </svg>
            <span>Ingresar a mi cuenta</span>
          </a>
        ) : (
          <div class="mobile-user-section">
            <div class="mobile-user-header">
              <div class="mobile-avatar">
                {user?.name?.charAt(0).toUpperCase() || 'U'}
              </div>
              <div class="mobile-user-info">
                <p class="mobile-user-name">{user?.name || 'Usuario'}</p>
                <p class="mobile-user-email">{user?.email}</p>
              </div>
            </div>

            <ul class="mobile-user-links">
              <li>
                <a href="/account/my-orders" class="mobile-user-link">
                  <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"/>
                  </svg>
                  <span>Mis Pedidos</span>
                </a>
              </li>
              <li>
                <a href="/account/perfil" class="mobile-user-link">
                  <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
                  </svg>
                  <span>Mi Perfil</span>
                </a>
              </li>
              <li>
                <a href="/account/user-data" class="mobile-user-link">
                  <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
                  </svg>
                  <span>Direcciones</span>
                </a>
              </li>
              {isAdmin && (
                <li>
                  <a href="/admin/dashboard" class="mobile-user-link admin">
                    <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/>
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                    </svg>
                    <span>Panel Admin</span>
                  </a>
                </li>
              )}
            </ul>

            <button id="logout-mobile" class="mobile-logout-btn">
              <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/>
              </svg>
              <span>Cerrar Sesión</span>
            </button>
          </div>
        )}

        <div class="mobile-footer">
          <p>© 2024 Broquelizate</p>
          <div class="mobile-social">
            <a href="#" aria-label="Instagram">
              <svg width="20" height="20" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
              </svg>
            </a>
            <a href="#" aria-label="Facebook">
              <svg width="20" height="20" fill="currentColor" viewBox="0 0 24 24">
                <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
              </svg>
            </a>
            <a href="#" aria-label="WhatsApp">
              <svg width="20" height="20" fill="currentColor" viewBox="0 0 24 24">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
              </svg>
            </a>
          </div>
        </div>
      </div>
    </div>
  </nav>

  <!-- Search Modal -->
  <div id="search-modal" class="search-modal">
    <div class="search-modal-content">
      <div class="search-header">
        <div class="search-input-wrapper">
          <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
          </svg>
          <input type="text" id="search-input" placeholder="Buscar productos..." autocomplete="off" />
        </div>
        <button id="close-search" class="close-search-btn" aria-label="Cerrar búsqueda">
          <svg width="24" height="24" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
          </svg>
        </button>
      </div>
      <div class="search-suggestions">
        <p class="suggestions-title">Búsquedas populares</p>
        <div class="suggestions-tags">
          <a href="/products?search=titanio" class="suggestion-tag">Titanio</a>
          <a href="/products?search=oro" class="suggestion-tag">Oro</a>
          <a href="/products?search=helix" class="suggestion-tag">Hélix</a>
          <a href="/products?search=argolla" class="suggestion-tag">Argollas</a>
          <a href="/products?search=broquel" class="suggestion-tag">Broqueles</a>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Spacer para compensar el header fijo -->
<div class="navbar-spacer"></div>

<style>
  /* Alturas en variables: el spacer y el menú móvil dependen de ellas */
  .header-stack {
    --bar-h: 36px;
    --nav-h: 80px;
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 1000;
  }

  .navbar-spacer {
    height: calc(36px + 80px);
  }

  /* 📣 Barra de envío */
  .announcement-bar {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 9px;
    height: var(--bar-h);
    padding: 0 16px;
    background: linear-gradient(90deg, #0a0a0a, #1a1508 50%, #0a0a0a);
    border-bottom: 1px solid rgba(234, 179, 8, 0.15);
    color: rgba(255, 255, 255, 0.75);
    font-size: 0.78rem;
    letter-spacing: 0.02em;
    text-align: center;
  }

  .announcement-bar svg { color: #eab308; flex-shrink: 0; }
  .announcement-bar strong { color: #eab308; font-weight: 700; }

  /* Base Navbar */
  .navbar {
    background: linear-gradient(180deg, #0a0a0a 0%, #111111 100%);
    border-bottom: 1px solid rgba(234, 179, 8, 0.1);
    backdrop-filter: blur(20px);
  }

  /* Tres columnas: enlaces · logo · acciones */
  .nav-container {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 16px;
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 24px;
    height: var(--nav-h);
  }

  .nav-left { display: flex; align-items: center; min-width: 0; }

  /* Logo centrado */
  .nav-logo {
    display: flex;
    align-items: center;
    justify-self: center;
    text-decoration: none;
    transition: opacity 0.2s;
  }

  .nav-logo:hover { opacity: 0.85; }

  .logo-image {
    height: 44px;
    width: auto;
    max-width: 240px;
    object-fit: contain;
    display: block;
    filter: drop-shadow(0 2px 8px rgba(0, 0, 0, 0.4));
    transition: filter 0.3s ease;
  }

  .nav-logo:hover .logo-image {
    filter: drop-shadow(0 2px 8px rgba(0, 0, 0, 0.4)) drop-shadow(0 0 12px rgba(234, 179, 8, 0.35));
  }

  /* Enlaces */
  .nav-links {
    display: flex;
    align-items: center;
    gap: 4px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav-link {
    position: relative;
    display: flex;
    align-items: center;
    padding: 10px 14px;
    color: rgba(255, 255, 255, 0.72);
    text-decoration: none;
    font-size: 0.74rem;
    font-weight: 700;
    letter-spacing: 0.11em;
    text-transform: uppercase;
    transition: color 0.2s;
    border-radius: 8px;
    white-space: nowrap;
  }

  .nav-link:hover { color: #fff; }

  .link-underline {
    position: absolute;
    bottom: 4px;
    left: 14px;
    right: 14px;
    height: 1.5px;
    background: linear-gradient(90deg, #eab308, #f59e0b);
    border-radius: 1px;
    transform: scaleX(0);
    transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .nav-link:hover .link-underline { transform: scaleX(1); }

  /* Derecha */
  .nav-right {
    display: flex;
    align-items: center;
