<script>
  document.addEventListener('astro:page-load', () => {
    const form = document.getElementById('footer-newsletter') as HTMLFormElement;
    
    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const input = form.querySelector('input[type="email"]') as HTMLInputElement;
      const email = input?.value.trim();
      
      if (!email) return;

      // Import SweetAlert2 dynamically
      const { default: Swal } = await import('sweetalert2');
      
      // Simulate subscription (replace with actual API call)
      try {
        await Swal.fire({
          title: '¡Suscrito!',
          html: `<p style="color: rgba(255,255,255,0.6);">Recibirás nuestras ofertas exclusivas en <strong>${email}</strong></p>`,
          icon: 'success',
          confirmButtonText: '¡Genial!',
          confirmButtonColor: '#eab308',
          background: '#111',
          color: '#fff',
        });
        
        input.value = '';
      } catch (error) {
        await Swal.fire({
          title: 'Error',
          text: 'No pudimos procesar tu suscripción. Intenta de nuevo.',
          icon: 'error',
          confirmButtonColor: '#eab308',
          background: '#111',
          color: '#fff',
        });
      }
    });
  });
</script>
