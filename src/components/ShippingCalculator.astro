---
// src/components/ShippingCalculator.astro
interface Props {
  subtotal: number;
  totalItems: number;
  originPostalCode?: string;
}

const { subtotal, totalItems, originPostalCode = "35000" } = Astro.props;
const estimatedWeight = Math.max(0.5, totalItems * 0.05);
---

<div class="shipping-calc-card">
  <div class="calc-header">
    <div class="calc-icon">
      <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 8h14M5 8a2 2 0 110-4h14a2 2 0 110 4M5 8v10a2 2 0 002 2h10a2 2 0 002-2V8m-9 4h4"/>
      </svg>
    </div>
    <div>
      <h3 class="calc-title">Método de envío</h3>
      <p class="calc-subtitle">Calcula tu envío según tu código postal</p>
    </div>
  </div>

  <div class="calc-body">
    <div class="calc-input-row">
      <div class="calc-input-wrapper">
        <input
          type="text"
          id="shipping-calc-postal"
          placeholder="Código postal (5 dígitos)"
          maxlength="5"
          pattern="[0-9]{5}"
          inputmode="numeric"
          class="calc-input"
        />
        <div id="calc-postal-ok" class="calc-validation hidden">
          <svg width="18" height="18" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
          </svg>
        </div>
      </div>
      <button id="calc-shipping-btn" type="button" class="calc-btn">
        <span id="calc-btn-text">Cotizar</span>
        <svg id="calc-btn-spinner" class="hidden calc-spinner" width="18" height="18" fill="none" viewBox="0 0 24 24">
          <circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4" opacity="0.25"></circle>
          <path fill="currentColor" opacity="0.75" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path>
        </svg>
      </button>
    </div>

    <div id="calc-error" class="calc-error hidden">
      <svg width="16" height="16" fill="currentColor" viewBox="0 0 20 20">
        <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"/>
      </svg>
      <span id="calc-error-text">Error al cotizar</span>
    </div>

    <div id="calc-results" class="calc-results hidden">
      <div class="calc-results-header">
        <span class="calc-results-title">Opciones disponibles</span>
        <button id="calc-clear-btn" type="button" class="calc-change-btn">Cambiar CP</button>
      </div>
      <div id="calc-options" class="calc-options"></div>
    </div>
  </div>

  <input type="hidden" id="calc-origin-cp" value={originPostalCode} />
  <input type="hidden" id="calc-weight" value={estimatedWeight} />
  <input type="hidden" id="calc-items-count" value={totalItems} />
  <input type="hidden" id="calc-subtotal" value={subtotal} />
</div>

<style>
  .shipping-calc-card {
    --lg-tint: rgba(255, 255, 255, 0.34);
    --lg-blur: blur(6px) saturate(200%) brightness(1.04);
    --lg-thickness:
      inset 1.5px 1.5px 0 -0.5px rgba(255, 255, 255, 1),
      inset -1.5px -1.5px 0 -0.5px rgba(255, 255, 255, 0.7),
      inset 0 0 16px -4px rgba(255, 255, 255, 0.75),
      inset 0 -14px 24px -18px rgba(0, 0, 0, 0.16),
      0 0 0 0.5px rgba(0, 0, 0, 0.05);
    --lg-drop: 0 6px 16px -8px rgba(0, 0, 0, 0.16), 0 20px 46px -22px rgba(0, 0, 0, 0.22);

    --txt: #1c1c1e;
    --txt-2: #55555c;
    --txt-3: #85858c;
    --gold: #eab308;
    --gold-2: #f59e0b;
    --gold-deep: #a16207;

    position: relative;
    isolation: isolate;
    padding: 22px;
    margin-bottom: 24px;
    border: none;
    border-radius: 28px;
    background: var(--lg-tint);
    backdrop-filter: var(--lg-blur);
    -webkit-backdrop-filter: var(--lg-blur);
    box-shadow: var(--lg-thickness), var(--lg-drop);
  }

  /* Anillo de refraccion */
  .shipping-calc-card::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 2;
    border-radius: inherit;
    padding: 9px;
    backdrop-filter: blur(6px) brightness(1.22) saturate(150%);
    -webkit-backdrop-filter: blur(6px) brightness(1.22) saturate(150%);
    -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
    mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
    mask-composite: exclude;
    pointer-events: none;
  }
  /* Reflejo especular */
  .shipping-calc-card::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    border-radius: inherit;
    background: linear-gradient(140deg, rgba(255,255,255,0.55) 0%, rgba(255,255,255,0.12) 26%, transparent 52%, rgba(255,255,255,0.18) 100%);
    pointer-events: none;
  }
  .shipping-calc-card > * { position: relative; z-index: 3; }

  @supports (corner-shape: squircle) {
    .shipping-calc-card { corner-shape: squircle; }
  }

  .calc-header { display: flex; align-items: center; gap: 14px; margin-bottom: 18px; padding-bottom: 16px; border-bottom: 1px solid rgba(255, 255, 255, 0.6); }
  .calc-icon { width: 44px; height: 44px; display: flex; align-items: center; justify-content: center; background: rgba(255, 255, 255, 0.55); box-shadow: var(--lg-thickness); border-radius: 16px; color: var(--gold-deep); flex-shrink: 0; }
  .calc-title { font-size: 1rem; font-weight: 700; color: var(--txt); }
  .calc-subtitle { font-size: 0.82rem; color: var(--txt-2); margin-top: 2px; }

  .calc-body { display: flex; flex-direction: column; gap: 14px; }
  .calc-input-row { display: flex; gap: 10px; }
  .calc-input-wrapper { flex: 1; position: relative; min-width: 0; }
  .calc-input { width: 100%; padding: 13px 42px 13px 18px; background: rgba(255, 255, 255, 0.7); border: none; box-shadow: var(--lg-thickness); border-radius: 999px; color: var(--txt); font-size: 0.95rem; transition: all 0.2s; }
  .calc-input::placeholder { color: var(--txt-3); }
  .calc-input:focus { outline: 2px solid rgba(234, 179, 8, 0.6); outline-offset: 1px; background: rgba(255, 255, 255, 0.9); }
  .calc-validation { position: absolute; right: 14px; top: 50%; transform: translateY(-50%); color: #15803d; }
  .calc-validation.hidden { display: none; }

  .calc-btn { display: flex; align-items: center; justify-content: center; gap: 8px; padding: 13px 24px; background: linear-gradient(140deg, rgba(255,255,255,0.5), transparent 45%), linear-gradient(135deg, var(--gold), var(--gold-2)); border: none; border-radius: 999px; color: #2a1f04; font-size: 0.9rem; font-weight: 700; cursor: pointer; white-space: nowrap; transition: all 0.25s cubic-bezier(0.34, 1.4, 0.64, 1); box-shadow: inset 1.5px 1.5px 0 -0.5px rgba(255,255,255,0.85), 0 8px 20px -10px rgba(234, 179, 8, 0.95); }
  .calc-btn:hover:not(:disabled) { transform: translateY(-2px) scale(1.01); box-shadow: inset 1.5px 1.5px 0 -0.5px rgba(255,255,255,0.85), 0 14px 26px -12px rgba(234, 179, 8, 1); }
  .calc-btn:active:not(:disabled) { transform: scale(0.97); }
  .calc-btn:disabled { opacity: 0.65; cursor: not-allowed; }
  .calc-spinner { animation: calc-spin 1s linear infinite; }
  .calc-spinner.hidden { display: none; }

  .calc-error { display: flex; align-items: center; gap: 10px; padding: 12px 16px; background: rgba(239, 68, 68, 0.12); box-shadow: var(--lg-thickness); border-radius: 16px; color: #b91c1c; font-size: 0.82rem; }
  .calc-error.hidden { display: none; }
  .calc-error svg { flex-shrink: 0; }

  .calc-results.hidden { display: none; }
  .calc-results-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px; gap: 12px; }
  .calc-results-title { font-size: 0.82rem; font-weight: 600; color: var(--txt-2); }
  .calc-change-btn { background: none; border: none; color: var(--gold-deep); font-size: 0.78rem; font-weight: 600; text-decoration: underline; cursor: pointer; padding: 4px; }
  .calc-change-btn:hover { color: var(--gold-2); }

  .calc-options { display: flex; flex-direction: column; gap: 8px; max-height: 260px; overflow-y: auto; padding-right: 6px; }
  .calc-options::-webkit-scrollbar { width: 4px; }
  .calc-options::-webkit-scrollbar-track { background: rgba(0, 0, 0, 0.04); border-radius: 2px; }
  .calc-options::-webkit-scrollbar-thumb { background: rgba(234, 179, 8, 0.5); border-radius: 2px; }

  /* ── Opciones de tarifa ──
     Se inyectan por innerHTML desde el bloque de script, asi que NO
     reciben el atributo de scope de Astro. Por eso van con :global(). */
  .calc-options :global(.rate-opt) {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 13px 14px;
    border: none;
    border-radius: 18px;
    background: rgba(255, 255, 255, 0.5);
    box-shadow: var(--lg-thickness);
    cursor: pointer;
    transition: all 0.25s cubic-bezier(0.34, 1.3, 0.64, 1);
  }
  .calc-options :global(.rate-opt:hover) { background: rgba(255, 255, 255, 0.78); transform: translateY(-1px); }
  .calc-options :global(.rate-opt.selected) { background: rgba(234, 179, 8, 0.18); box-shadow: var(--lg-thickness), 0 0 0 2px rgba(234, 179, 8, 0.55); }
  .calc-options :global(.rate-opt input) { display: none; }
  .calc-options :global(.rate-emoji) { font-size: 1.4rem; line-height: 1; flex-shrink: 0; }
  .calc-options :global(.rate-info) { flex: 1; min-width: 0; }
  .calc-options :global(.rate-top) { display: flex; align-items: center; gap: 6px; flex-wrap: wrap; }
  .calc-options :global(.rate-carrier) { font-weight: 700; font-size: 0.88rem; color: #1c1c1e; text-transform: capitalize; }
  .calc-options :global(.rate-badge) { font-size: 0.62rem; font-weight: 800; letter-spacing: 0.02em; padding: 3px 8px; border-radius: 999px; white-space: nowrap; }
  .calc-options :global(.rate-badge.best) { background: linear-gradient(135deg, #eab308, #f59e0b); color: #2a1f04; box-shadow: inset 0 1px 0 rgba(255,255,255,0.5); }
  .calc-options :global(.rate-badge.fast) { background: rgba(34, 197, 94, 0.9); color: #fff; box-shadow: inset 0 1px 0 rgba(255,255,255,0.35); }
  .calc-options :global(.rate-service) { font-size: 0.78rem; color: #55555c; margin-top: 3px; }
  .calc-options :global(.rate-days) { font-size: 0.72rem; color: #85858c; margin-top: 1px; }
  .calc-options :global(.rate-price) { font-size: 1rem; font-weight: 800; color: #1c1c1e; white-space: nowrap; }
  .calc-options :global(.rate-opt.selected .rate-price) { color: #a16207; }
  .calc-options :global(.rate-strike) { color: #85858c; font-weight: 500; font-size: 0.8rem; }
  .calc-options :global(.rate-free) { color: #15803d; font-weight: 800; }

  @supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
    .shipping-calc-card { background: rgba(255, 255, 255, 0.93); }
  }

  @keyframes calc-spin { to { transform: rotate(360deg); } }

  @media (prefers-reduced-motion: reduce) {
    .calc-btn, .calc-options :global(.rate-opt) { transition: none; }
  }

  /* ── Responsive ── */
  @media (max-width: 640px) {
    .shipping-calc-card { padding: 16px; border-radius: 22px; }
    .calc-header { gap: 12px; margin-bottom: 14px; padding-bottom: 14px; }
    .calc-icon { width: 38px; height: 38px; border-radius: 13px; }
    .calc-title { font-size: 0.95rem; }
    .calc-subtitle { font-size: 0.78rem; }
    .calc-input-row { flex-direction: column; }
    .calc-btn { width: 100%; padding: 14px 24px; }
    .calc-options { max-height: none; }
    .calc-options :global(.rate-opt) { padding: 12px; gap: 10px; border-radius: 16px; flex-wrap: wrap; }
    .calc-options :global(.rate-price) { font-size: 0.95rem; }
  }
  @media (max-width: 400px) {
    .calc-options :global(.rate-emoji) { font-size: 1.2rem; }
    .calc-options :global(.rate-carrier) { font-size: 0.84rem; }
    .calc-options :global(.rate-badge) { font-size: 0.58rem; padding: 2px 6px; }
  }
</style>

<script>
  import { actions } from 'astro:actions';

  interface ShippingRate { carrier: string; service: string; deliveryDays: number; totalPrice: number; currency: string; }

  function initShippingCalculator() {
    const _postalInput = document.getElementById('shipping-calc-postal') as HTMLInputElement | null;
    if (!_postalInput) return;
    const postalInput = _postalInput;

    const btn = document.getElementById('calc-shipping-btn') as HTMLButtonElement;
    const btnText = document.getElementById('calc-btn-text');
    const btnSpinner = document.getElementById('calc-btn-spinner');
    const postalOk = document.getElementById('calc-postal-ok');
    const errBox = document.getElementById('calc-error');
    const errText = document.getElementById('calc-error-text');
    const resultsBox = document.getElementById('calc-results');
    const optionsBox = document.getElementById('calc-options');
    const clearBtn = document.getElementById('calc-clear-btn');
    const originCp = (document.getElementById('calc-origin-cp') as HTMLInputElement)?.value || '35000';
    const weight = parseFloat((document.getElementById('calc-weight') as HTMLInputElement)?.value || '0.5');
    const itemsCount = parseInt((document.getElementById('calc-items-count') as HTMLInputElement)?.value || '0');
    const subtotal = parseFloat((document.getElementById('calc-subtotal') as HTMLInputElement)?.value || '0');

    // Debe coincidir con FREE_SHIPPING_THRESHOLD de @/utils/shipping.
    // Aquí va como constante local porque esto corre en el navegador.
    const FREE_SHIPPING_THRESHOLD = 1099;
    const isFree = subtotal >= FREE_SHIPPING_THRESHOLD;
    console.log('💰 subtotal:', subtotal, '| umbral:', FREE_SHIPPING_THRESHOLD, '| gratis:', isFree);

    // Input de CP del formulario de dirección (lo auto-sincroniza si existe)
    const addressCpInput = document.getElementById('postal-code') as HTMLInputElement | null;

    const fmt = (v: number) => new Intl.NumberFormat('es-MX', { style: 'currency', currency: 'MXN' }).format(v);
    const validCp = (cp: string) => /^\d{5}$/.test(cp);
    const emoji = (c: string) => (({ fedex:'🚚', dhl:'📦', estafeta:'📫', redpack:'🔴', ups:'🟤', paquetexpress:'📬', '99minutos':'⚡', sendex:'✉️' } as Record<string,string>)[c.toLowerCase()] || '📦');

    function setLoading(v: boolean) {
      if (btn) btn.disabled = v;
      if (btnText) btnText.textContent = v ? 'Cotizando...' : 'Cotizar';
      btnSpinner?.classList.toggle('hidden', !v);
    }
    function showErr(msg: string) { if (errBox && errText) { errText.textContent = msg; errBox.classList.remove('hidden'); } resultsBox?.classList.add('hidden'); }
    function hideErr() { errBox?.classList.add('hidden'); }

    function selectRate(r: ShippingRate, cp: string) {
      // La tarifa del carrier debe ser válida aunque al cliente no se le cobre:
      // si viene en 0 es que la API falló, no que el envío sea gratis.
      if (!(Number(r.totalPrice) > 0)) return;
      const selected = {
        carrier: r.carrier,
        service: r.service,
        price: isFree ? 0 : Number(r.totalPrice), // lo que paga el cliente
        carrierRate: Number(r.totalPrice),        // lo que cuesta la guía
        deliveryDays: r.deliveryDays,
        postalCode: cp,
      };
      try { localStorage.setItem('selectedShipping', JSON.stringify(selected)); } catch {}
      // Notifica al CheckoutForm para que actualice totales y UI
      window.dispatchEvent(new CustomEvent('shipping:selected', { detail: selected }));
    }

    function render(rates: ShippingRate[], cp: string) {
      if (!optionsBox) return;

      // Una tarifa en $0 casi siempre significa que la API respondió
      // sin precio (cuenta sin saldo, servicio no contratado, campo
      // distinto en la respuesta). Si se cuela, se cobra el envío en
      // cero: mejor descartarla que vender a pérdida.
      const valid = rates.filter(r => Number(r.totalPrice) > 0);
      if (valid.length === 0) {
        showErr('No pudimos obtener tarifas válidas para ese CP. Contáctanos por WhatsApp para cotizar tu envío.');
        resultsBox?.classList.add('hidden');
        return;
      }

      const sorted = [...valid].sort((a, b) => a.totalPrice - b.totalPrice);
      const minDays = Math.min(...sorted.map(x => x.deliveryDays));

      // Con envío gratis el cliente sigue eligiendo paquetería:
      // el título lo aclara para que no crea que le van a cobrar.
      const resultsTitle = optionsBox.closest('.calc-results')?.querySelector('.calc-results-title');
      if (resultsTitle) {
        resultsTitle.textContent = isFree
          ? '¡Tu envío es gratis! Elige paquetería'
          : 'Opciones disponibles';
      }

      // Sin estilos inline: todo por clases, para que el CSS del componente mande.
      optionsBox.innerHTML = sorted.map((r, i) => {
        const best = i === 0;
        const fast = r.deliveryDays === minDays && !best;
        const days = `${r.deliveryDays} día${r.deliveryDays !== 1 ? 's' : ''} hábil${r.deliveryDays !== 1 ? 'es' : ''}`;
        return `<label class="rate-opt${best ? ' selected' : ''}" data-idx="${i}">
          <input type="radio" name="calc-rate" value="${i}" ${best ? 'checked' : ''} />
          <span class="rate-emoji">${emoji(r.carrier)}</span>
          <div class="rate-info">
            <div class="rate-top">
              <span class="rate-carrier">${r.carrier}</span>
              ${best ? '<span class="rate-badge best">MEJOR PRECIO</span>' : ''}
              ${fast ? '<span class="rate-badge fast">MÁS RÁPIDO</span>' : ''}
            </div>
            <p class="rate-service">${r.service}</p>
            <p class="rate-days">${days}</p>
          </div>
          <span class="rate-price">${isFree ? `<s class="rate-strike">${fmt(r.totalPrice)}</s> <span class="rate-free">Gratis</span>` : fmt(r.totalPrice)}</span>
        </label>`;
      }).join('');

      optionsBox.querySelectorAll('input[name="calc-rate"]').forEach(inp => {
        inp.addEventListener('change', (e) => {
          const idx = parseInt((e.target as HTMLInputElement).value);
          selectRate(sorted[idx], cp);
          optionsBox.querySelectorAll('.rate-opt').forEach((l, i) => {
            l.classList.toggle('selected', i === idx);
          });
        });
      });

      if (sorted.length > 0) selectRate(sorted[0], cp);
    }

    async function calculate() {
      const cp = postalInput.value.trim();
      if (!validCp(cp)) { showErr('Ingresa un código postal válido de 5 dígitos'); return; }
      hideErr(); setLoading(true);
      try {
        const result = await actions.getShippingRates({
          originPostalCode: originCp,
          destinationPostalCode: cp,
          weight: Math.max(1, weight),
          length: Math.min(15 + (itemsCount * 2), 50),
          width: 15,
          height: 10,
        });
        if (result.error) { showErr('No pudimos obtener las tarifas. Intenta de nuevo.'); return; }
        const data = result.data;
        if (!data?.success || !data?.rates?.length) { showErr(data?.error || 'No hay opciones para ese código postal.'); return; }

        postalOk?.classList.remove('hidden');
        resultsBox?.classList.remove('hidden');
        render(data.rates, cp);

        // Auto-rellena el CP en el formulario de dirección si está vacío
        if (addressCpInput && !addressCpInput.value) addressCpInput.value = cp;
      } catch {
        showErr('Error de conexión. Verifica tu internet e intenta de nuevo.');
      } finally {
        setLoading(false);
      }
    }

    function clearAll() {
      postalInput.value = '';
      postalOk?.classList.add('hidden');
      resultsBox?.classList.add('hidden');
      try { localStorage.removeItem('selectedShipping'); } catch {}
      window.dispatchEvent(new CustomEvent('shipping:cleared'));
    }

    postalInput.addEventListener('input', (e) => {
      const t = e.target as HTMLInputElement;
      t.value = t.value.replace(/\D/g, '').slice(0, 5);
      postalOk?.classList.add('hidden');
      hideErr();
    });
    postalInput.addEventListener('keypress', (e) => { if (e.key === 'Enter') { e.preventDefault(); calculate(); } });
    btn?.addEventListener('click', calculate);
    clearBtn?.addEventListener('click', clearAll);

    // Sincronización: si el usuario escribe el CP en la dirección, pre-llenar aquí
    addressCpInput?.addEventListener('blur', () => {
      if (!postalInput.value && validCp(addressCpInput.value.trim())) {
        postalInput.value = addressCpInput.value.trim();
      }
    });

    // Restaurar selección previa
    try {
      const saved = localStorage.getItem('selectedShipping');
      if (saved) {
        const s = JSON.parse(saved);
        if (s.postalCode && validCp(s.postalCode)) {
          postalInput.value = s.postalCode;
          setTimeout(calculate, 300);
        }
      }
    } catch {}
  }

  document.addEventListener('astro:page-load', () => setTimeout(initShippingCalculator, 100));
</script>