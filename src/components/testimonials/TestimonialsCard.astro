---
// src/components/testimonials/TestimonialCard.astro

export interface Props {
  name: string;
  since: number;
  testimonial: string;
  imageUrl: string;
  rating: number;
  index?: number;
}

const { name, since, testimonial, imageUrl, rating, index = 0 } = Astro.props;

const stars = Array.from({ length: 5 }, (_, i) => i < rating);
const yearsAsClient = new Date().getFullYear() - since;
---

<article 
  class="testimonial-card"
  style={`--delay: ${index * 0.1}s`}
>
  <!-- Quote icon -->
  <div class="quote-icon">
    <svg width="32" height="32" fill="currentColor" viewBox="0 0 24 24">
      <path d="M4.583 17.321C3.553 16.227 3 15 3 13.011c0-3.5 2.457-6.637 6.03-8.188l.893 1.378c-3.335 1.804-3.987 4.145-4.247 5.621.537-.278 1.24-.375 1.929-.311 1.804.167 3.226 1.648 3.226 3.489a3.5 3.5 0 01-3.5 3.5c-1.073 0-2.099-.49-2.748-1.179zm10 0C13.553 16.227 13 15 13 13.011c0-3.5 2.457-6.637 6.03-8.188l.893 1.378c-3.335 1.804-3.987 4.145-4.247 5.621.537-.278 1.24-.375 1.929-.311 1.804.167 3.226 1.648 3.226 3.489a3.5 3.5 0 01-3.5 3.5c-1.073 0-2.099-.49-2.748-1.179z"/>
    </svg>
  </div>

  <!-- Stars -->
  <div class="stars-container">
    {stars.map((filled, i) => (
      <svg 
        class={`star ${filled ? 'filled' : 'empty'}`}
        style={`--star-delay: ${i * 0.05}s`}
        width="20" 
        height="20" 
        viewBox="0 0 24 24"
      >
        <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
      </svg>
    ))}
  </div>

  <!-- Testimonial text -->
  <blockquote class="testimonial-text">
    "{testimonial}"
  </blockquote>

  <!-- Author info -->
  <div class="author-info">
    <div class="author-avatar">
      <img src={imageUrl} alt={name} loading="lazy" />
      <div class="avatar-ring"></div>
    </div>
    <div class="author-details">
      <p class="author-name">{name}</p>
      <p class="author-since">
        <svg width="14" height="14" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
        </svg>
        Cliente desde {since} · {yearsAsClient} {yearsAsClient === 1 ? 'año' : 'años'}
      </p>
    </div>
  </div>

  <!-- Decorative glow -->
  <div class="card-glow"></div>
</article>

<style>
  .testimonial-card {
    position: relative;
    background: #fff;
    border: 1px solid rgba(0, 0, 0, 0.08);
    border-radius: 20px;
    padding: 28px;
    display: flex;
    flex-direction: column;
    gap: 20px;
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    animation: fadeInUp 0.6s ease-out var(--delay, 0s) both;
    overflow: hidden;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.04);
  }

  .testimonial-card:hover {
    background: #fff;
    border-color: rgba(234, 179, 8, 0.4);
    transform: translateY(-8px);
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.1);
  }

  /* Quote icon */
  .quote-icon {
    position: absolute;
    top: 20px;
    right: 20px;
    color: rgba(234, 179, 8, 0.2);
    transition: all 0.3s ease;
  }

  .testimonial-card:hover .quote-icon {
    color: rgba(234, 179, 8, 0.4);
    transform: scale(1.1) rotate(5deg);
  }

  /* Stars */
  .stars-container {
    display: flex;
    gap: 4px;
  }

  .star {
    transition: all 0.3s ease;
    transition-delay: var(--star-delay, 0s);
  }

  .star.filled {
    fill: #eab308;
    filter: drop-shadow(0 0 4px rgba(234, 179, 8, 0.4));
  }

  .star.empty {
    fill: rgba(0, 0, 0, 0.15);
  }

  .testimonial-card:hover .star.filled {
    transform: scale(1.15);
  }

  /* Testimonial text */
  .testimonial-text {
    font-size: 0.95rem;
    line-height: 1.7;
    color: #444;
    font-style: italic;
    flex-grow: 1;
    display: -webkit-box;
    -webkit-line-clamp: 5;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* Author info */
  .author-info {
    display: flex;
    align-items: center;
    gap: 14px;
    padding-top: 16px;
    border-top: 1px solid rgba(0, 0, 0, 0.08);
  }

  .author-avatar {
    position: relative;
    width: 52px;
    height: 52px;
    flex-shrink: 0;
  }

  .author-avatar img {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    object-fit: cover;
    border: 2px solid rgba(234, 179, 8, 0.3);
    transition: all 0.3s ease;
  }

  .testimonial-card:hover .author-avatar img {
    border-color: #eab308;
    transform: scale(1.05);
  }

  .avatar-ring {
    position: absolute;
    inset: -4px;
    border-radius: 50%;
    border: 2px solid transparent;
    background: linear-gradient(135deg, rgba(234, 179, 8, 0.4), transparent) border-box;
    -webkit-mask: linear-gradient(#fff 0 0) padding-box, linear-gradient(#fff 0 0);
    mask: linear-gradient(#fff 0 0) padding-box, linear-gradient(#fff 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .testimonial-card:hover .avatar-ring {
    opacity: 1;
  }

  .author-details {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .author-name {
    font-size: 1rem;
    font-weight: 700;
    color: #111;
    transition: color 0.3s ease;
  }

  .testimonial-card:hover .author-name {
    color: #b45309;
  }

  .author-since {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 0.8rem;
    color: #888;
  }

  .author-since svg {
    color: #d97706;
  }

  /* Glow effect */
  .card-glow {
    position: absolute;
    inset: 0;
    border-radius: 20px;
    opacity: 0;
    transition: opacity 0.4s ease;
    pointer-events: none;
    box-shadow: 
      inset 0 0 0 1px rgba(234, 179, 8, 0.3),
      0 0 40px rgba(234, 179, 8, 0.08);
  }

  .testimonial-card:hover .card-glow {
    opacity: 1;
  }

  /* Animations */
  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(30px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Responsive */
  @media (max-width: 768px) {
    .testimonial-card {
      padding: 24px;
    }

    .testimonial-text {
      font-size: 0.9rem;
      -webkit-line-clamp: 4;
    }

    .author-avatar {
      width: 46px;
      height: 46px;
    }
  }
</style>
