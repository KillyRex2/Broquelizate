/* Miniatura: fondo solido, sin vidrio ni squircle (rompen el <img>) */
.product-image-mini { position: relative; z-index: 3; isolation: isolate; width: 50px; height: 50px; border-radius: 14px; overflow: hidden; background: #fff; box-shadow: 0 0 0 1px rgba(0,0,0,0.06); corner-shape: normal; flex-shrink: 0; }
