.checkout-grid { display: grid; grid-template-columns: 1fr 400px; gap: 40px; align-items: start; position: relative; z-index: 10; }
.form-column { display: flex; flex-direction: column; gap: 32px; }
.checkout-section { border-radius: var(--lg-radius); padding: 28px; animation: fadeInUp 0.5s ease-out both; }
