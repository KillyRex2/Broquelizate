.form-input, .form-textarea { padding: 14px 16px; background: rgba(255, 255, 255, 0.6); border: none; box-shadow: var(--lg-thickness); border-radius: 16px; color: var(--txt); font-size: 0.95rem; transition: all 0.2s; }
