.warning-icon { width: 40px; height: 40px; display: flex; align-items: center; justify-content: center; background: rgba(255, 255, 255, 0.5); box-shadow: var(--lg-thickness); border-radius: 14px; color: #b91c1c; flex-shrink: 0; }
