/* Modales SweetAlert en claro */
:global(.swal2-container) { z-index: 99999 !important; }
:global(.swal2-popup) { background: rgba(255, 255, 255, 0.85) !important; backdrop-filter: blur(20px) saturate(180%); -webkit-backdrop-filter: blur(20px) saturate(180%); color: #1c1c1e !important; border: none; box-shadow: 0 0 0 0.5px rgba(0,0,0,0.06), 0 30px 60px -30px rgba(0,0,0,0.4); border-radius: 28px; }
