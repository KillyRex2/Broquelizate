/* Oscurece el texto pero respeta lo que tenga fondo propio (badges) */
.sc-fix :global(h1), .sc-fix :global(h2), .sc-fix :global(h3), .sc-fix :global(h4),
.sc-fix :global(p), .sc-fix :global(label), .sc-fix :global(li), .sc-fix :global(td),
