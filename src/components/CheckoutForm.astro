---
// src/components/CheckoutForm.astro
import { Formatter } from '../utils';
import { actions } from 'astro:actions';
import { getSession } from 'auth-astro/server';
import ShippingCalculator from '@/components/ShippingCalculator.astro';
import CheckoutProgress from '@/components/shared/CheckoutProgressBar.astro'; 

const session = await getSession(Astro.request);
const userEmail = session?.user?.email || '';
const userName = session?.user?.name || '';
const isAuthenticated = !!session?.user;

const cartCookie = Astro.cookies.get('cart');
let cartItems: Array<{ productId: string; quantity: number; variantId?: string; combinationId?: string; engraving?: { id: string; imageUrl: string; notes: string } }> = [];
try {
  if (cartCookie?.value) {
    cartItems = JSON.parse(cartCookie.value);
  }
} catch (e) {
  cartItems = [];
}

const { data: products, error } = await Astro.callAction(actions.loadProductsFromCart, cartItems);
if (error || !products) return Astro.redirect('/');

const subtotal = products.reduce((sum, p) => sum + (p.variantPrice ?? p.price) * p.quantity, 0);
const tax = 0;
const total = subtotal;
const totalItems = products.reduce((sum, p) => sum + p.quantity, 0);

const productsData = products.map(p => {
  const cartItem = cartItems.find(ci => ci.productId === p.productId && ci.variantId === p.variantId && ci.combinationId === p.combinationId);
  return { 
    id: p.productId, name: p.name, price: p.variantPrice ?? p.price, quantity: p.quantity,
    image: p.variantImage || p.image || '', variantCombination: p.variantCombination || null, variantSku: p.variantSku || null,
    engraving: cartItem?.engraving || null
  };
});
---

<div class="checkout-wrapper">
  <div class="bg-decoration">
    <div class="glow glow-1"></div>
    <div class="glow glow-2"></div>
    <div class="glow glow-3"></div>
    <div class="grid-pattern"></div>
  </div>

  <div class="checkout-container">
    <!-- Progress Steps -->
    <CheckoutProgress cartCount={totalItems} />

    <!-- Auth Status -->
    {isAuthenticated ? (
      <div class="auth-status success">
        <div class="auth-icon"><svg width="20" height="20" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg></div>
        <div class="auth-content">
          <span class="auth-title">Comprando como {userName}</span>
          <span class="auth-subtitle">{userEmail} · Tu pedido se guardará en "Mis Pedidos"</span>
        </div>
      </div>
    ) : (
      <div class="auth-status warning">
        <div class="auth-icon"><svg width="20" height="20" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd"/></svg></div>
        <div class="auth-content">
          <span class="auth-title">Comprando como invitado</span>
          <span class="auth-subtitle"><a href="/auth/login" class="auth-link">Inicia sesión</a> para guardar tu pedido y dar seguimiento</span>
        </div>
      </div>
    )}

    <!-- Shipping Warning -->
    <div id="shipping-warning" class="shipping-warning hidden">
      <div class="warning-icon">...</div>
      <div class="warning-content">
        <span class="warning-title">Calcula tu envío</span>
        <span class="warning-subtitle">Ingresa tu código postal abajo para ver opciones de envío antes de pagar.</span>
      </div>
    </div>

    <!-- Shipping Calculator (componente reutilizable) -->
    <div class="sc-fix">
      <ShippingCalculator subtotal={subtotal} totalItems={totalItems} />
    </div>

    <div class="checkout-grid">
      <!-- Main Form Column -->
      <div class="form-column">
        <!-- Shipping Section -->
        <section class="checkout-section">
          <div class="section-header">
            <div class="section-icon"><svg width="24" height="24" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg></div>
            <div><h2 class="section-title">Dirección de envío</h2><p class="section-subtitle">¿A dónde enviamos tu pedido?</p></div>
          </div>

          <div id="shipping-info-display" class="shipping-display hidden">
            <div class="shipping-display-content">
              <div class="shipping-display-icon"><svg width="24" height="24" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 8h14M5 8a2 2 0 110-4h14a2 2 0 110 4M5 8v10a2 2 0 002 2h10a2 2 0 002-2V8m-9 4h4"/></svg></div>
              <div class="shipping-display-info"><span id="display-carrier" class="shipping-carrier">-</span><span id="display-delivery" class="shipping-delivery">-</span></div>
              <div class="shipping-display-price"><span id="display-shipping-price" class="price-value">-</span><a href="/cart" class="change-link">Cambiar</a></div>
            </div>
          </div>

          <div class="form-grid">
            <div class="form-group"><label class="form-label">Calle y número <span class="required">*</span></label><input type="text" id="street-address" class="form-input" placeholder="Ej: Av. Reforma 123" required /></div>
            <div class="form-group"><label class="form-label">Colonia <span class="required">*</span></label><input type="text" id="neighborhood" class="form-input" placeholder="Ej: Centro" required /></div>
            <div class="form-group"><label class="form-label">Ciudad <span class="required">*</span></label><input type="text" id="city" class="form-input" placeholder="Ej: Ciudad de México" required /></div>
            <div class="form-group"><label class="form-label">Estado <span class="required">*</span></label><input type="text" id="state" class="form-input" placeholder="Ej: CDMX" required /></div>
            <div class="form-group"><label class="form-label">Código Postal <span class="required">*</span></label><input type="text" id="postal-code" class="form-input" placeholder="Ej: 06600" maxlength="5" required /></div>
            <div class="form-group"><label class="form-label">País</label><input type="text" id="country" value="México" class="form-input readonly" readonly /></div>
            <div class="form-group full-width"><label class="form-label">Correo Electrónico <span class="required">*</span></label><input type="email" id="email" value={userEmail} class:list={["form-input", isAuthenticated && "readonly"]} placeholder="tu@email.com" readonly={isAuthenticated} required />{isAuthenticated && <span class="form-hint">Este es el email de tu cuenta</span>}</div>
            <div class="form-group full-width"><label class="form-label">Teléfono de contacto <span class="required">*</span></label><input type="tel" id="phone" class="form-input" placeholder="Ej: 55 1234 5678" required /></div>
            <div class="form-group full-width"><label class="form-label">Notas de entrega (opcional)</label><textarea id="delivery-notes" class="form-textarea" rows="2" placeholder="Ej: Dejar con el portero, timbre 2B..."></textarea></div>
          </div>
        </section>

        <label class="privacy-check">
        <input type="checkbox" id="accept-privacy" />
        <span>
          He leído y acepto el <a href="/aviso-de-privacidad" target="_blank" rel="noopener">aviso de privacidad</a>,
          los <a href="/terminos-y-condiciones" target="_blank" rel="noopener">términos y condiciones</a> y la
          <a href="/cambios-y-devoluciones" target="_blank" rel="noopener">política de cambios y devoluciones</a>.
        </span>
      </label>

      <label class="privacy-check optional">
        <input type="checkbox" id="accept-marketing" />
        <span>Quiero recibir promociones y novedades por correo <em>(opcional)</em></span>
      </label>

        <!-- Payment Section -->
        <section class="checkout-section">
          <div class="section-header">
            <div class="section-icon"><svg width="24" height="24" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"/></svg></div>
            <div><h2 class="section-title">Método de pago</h2><p class="section-subtitle">Elige cómo deseas pagar</p></div>
          </div>

          <div class="payment-methods">
            <label class="payment-option">
              <input id="card" type="radio" name="payment-method" class="payment-radio" />
              <div class="payment-option-content">
                <div class="payment-option-main">
                  <div class="payment-icons"><img src="https://readymadeui.com/images/visa.webp" alt="Visa" class="payment-brand" /><img src="https://readymadeui.com/images/master.webp" alt="Mastercard" class="payment-brand" /></div>
                  <span class="payment-label">Tarjeta de crédito/débito</span>
                </div>
                <div class="payment-check"><svg width="20" height="20" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg></div>
              </div>
            </label>
            <label class="payment-option">
              <input id="paypal" type="radio" name="payment-method" class="payment-radio" />
              <div class="payment-option-content">
                <div class="payment-option-main"><img src="https://readymadeui.com/images/paypal.webp" alt="PayPal" class="payment-brand paypal" /><span class="payment-label">PayPal</span></div>
                <div class="payment-check"><svg width="20" height="20" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg></div>
              </div>
            </label>
            <label class="payment-option">
          <input id="mercadopago" type="radio" name="payment-method" class="payment-radio" />
          <div class="payment-option-content">
            <div class="payment-option-main">
              <span class="mp-logo">Mercado Pago</span>
              <span class="mp-badge">Tarjetas · OXXO · SPEI · MSI</span>
            </div>
            <div class="payment-check"><svg width="20" height="20" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg></div>
          </div>
      </label>
          </div>

          <div id="card-form" class="card-form hidden">
            <form id="payment-form">
              <div class="form-group"><label class="form-label">Nombre del titular <span class="required">*</span></label><input type="text" id="card-holder-name" class="form-input" placeholder="Como aparece en la tarjeta" required /></div>
              <div class="form-group"><label class="form-label">Datos de la tarjeta <span class="required">*</span></label><div id="card-element" class="stripe-element"></div></div>
              <div id="card-errors" class="card-errors" role="alert"></div>
              <button type="button" id="submit-card-payment" class="pay-button" disabled>
                <span class="pay-button-icon"><svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg></span>
                <span id="card-btn-text">Pagar ahora</span>
                <span class="pay-button-amount" id="pay-button-amount">{Formatter.currency(total)}</span>
              </button>
            </form>
          </div>

          <div id="paypal-container" class="paypal-container hidden"><div id="paypal-button-container" class="paypal-buttons"></div></div>
          <div id="mercadopago-container" class="mercadopago-container hidden">
          <p class="mp-helper">Serás redirigido a Mercado Pago para completar tu pago de forma segura. Puedes pagar con tarjeta, efectivo en OXXO, transferencia SPEI o a meses sin intereses.</p>
          <button type="button" id="submit-mp-payment" class="mp-button">
            <span>Pagar con Mercado Pago</span>
            <span class="pay-button-amount" id="mp-button-amount">{Formatter.currency(total)}</span>
          </button>
        </div>
        </section>

        <div class="security-badges">
          <div class="security-item"><svg width="16" height="16" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M5 9V7a5 5 0 0110 0v2a2 2 0 012 2v5a2 2 0 01-2 2H5a2 2 0 01-2-2v-5a2 2 0 012-2zm8-2v2H7V7a3 3 0 016 0z" clip-rule="evenodd"/></svg><span>Pago seguro SSL</span></div>
          <div class="security-item"><svg width="16" height="16" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M2.166 4.999A11.954 11.954 0 0010 1.944 11.954 11.954 0 0017.834 5c.11.65.166 1.32.166 2.001 0 5.225-3.34 9.67-8 11.317C5.34 16.67 2 12.225 2 7c0-.682.057-1.35.166-2.001zm11.541 3.708a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/></svg><span>Datos protegidos</span></div>
          <div class="security-item"><svg width="16" height="16" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg><span>Compra garantizada</span></div>
        </div>
      </div>

      <!-- Summary Column -->
      <aside class="summary-column">
        <div class="summary-card">
          <div class="summary-header">
            <h2 class="summary-title"><svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/></svg>Resumen del pedido</h2>
            <span class="summary-count">{totalItems} {totalItems === 1 ? 'producto' : 'productos'}</span>
          </div>

          <div class="summary-products">
            {products.map((p, index) => (
              <div class="summary-product" style={`animation-delay: ${index * 0.05}s`}>
                <div class="product-image-mini">
                  {(p.variantImage || p.image) ? <img src={p.variantImage || p.image} alt={p.name} /> : <div class="product-placeholder"><svg width="20" height="20" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M4 3a2 2 0 00-2 2v10a2 2 0 002 2h12a2 2 0 002-2V5a2 2 0 00-2-2H4zm12 12H4l4-8 3 6 2-4 3 6z" clip-rule="evenodd"/></svg></div>}
                  <span class="product-qty-badge">{p.quantity}</span>
                </div>
                <div class="product-info-mini"><span class="product-name-mini">{p.name}</span>{p.variantCombination && <span class="product-variant-mini">{p.variantCombination}</span>}</div>
                <span class="product-price-mini">{Formatter.currency((p.variantPrice ?? p.price) * p.quantity)}</span>
              </div>
            ))}
          </div>

          <div class="summary-divider"></div>

          <div class="summary-totals">
            <div class="summary-row"><span class="row-label">Subtotal</span><span class="row-value">{Formatter.currency(subtotal)}</span></div>
            <div class="summary-row"><span class="row-label">Envío</span><span id="summary-shipping" class="row-value muted">Por calcular</span></div>
            <div id="shipping-summary-details" class="shipping-summary hidden"><span class="shipping-icon" id="summary-carrier-icon">📦</span><div class="shipping-info-mini"><span id="summary-carrier-name" class="carrier-name">-</span><span id="summary-delivery-days" class="delivery-days">-</span></div></div>
            <div class="summary-divider"></div>
            <div class="summary-row total"><span class="row-label">Total a pagar</span><span id="summary-total" class="row-value">{Formatter.currency(total)}</span></div>
          </div>

          <a href="/cart" class="back-to-cart"><svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/></svg><span>Volver al carrito</span></a>
        </div>

        <div class="trust-card">
          <div class="trust-item"><div class="trust-icon"><svg width="20" height="20" fill="currentColor" viewBox="0 0 20 20"><path d="M8 16.5a1.5 1.5 0 11-3 0 1.5 1.5 0 013 0zM15 16.5a1.5 1.5 0 11-3 0 1.5 1.5 0 013 0z"/><path d="M3 4a1 1 0 00-1 1v10a1 1 0 001 1h1.05a2.5 2.5 0 014.9 0H10a1 1 0 001-1V5a1 1 0 00-1-1H3z"/></svg></div><div class="trust-text"><span class="trust-title">Envío asegurado</span><span class="trust-desc">Con número de rastreo</span></div></div>
          <div class="trust-item"><div class="trust-icon"><svg width="20" height="20" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-12a1 1 0 10-2 0v4a1 1 0 00.293.707l2.828 2.829a1 1 0 101.415-1.415L11 9.586V6z" clip-rule="evenodd"/></svg></div><div class="trust-text"><span class="trust-title">Entrega rápida</span><span class="trust-desc">2-5 días hábiles</span></div></div>
        </div>
      </aside>
    </div>
  </div>
</div>

<style>
  /* ============================================================
   src/components/CheckoutForm.astro
   Reemplaza TODO el contenido del bloque <style> por esto.

   OJO: las reglas de .progress-steps / .step / .step-line ya no
   estan aqui. Ese bloque de markup se borra y se sustituye por
   <CheckoutProgress /> (el componente trae sus propios estilos).
   ============================================================ */

.privacy-check { display: flex; align-items: flex-start; gap: 10px; margin: 16px 0 0; font-size: 0.82rem; color: var(--txt-2); line-height: 1.55; cursor: pointer; }
.privacy-check input { width: 18px; height: 18px; margin-top: 1px; accent-color: var(--gold-2); flex-shrink: 0; cursor: pointer; }
.privacy-check a { color: var(--gold-deep); text-decoration: underline; text-underline-offset: 2px; }
.privacy-check a:hover { color: var(--gold-2); }
.privacy-check.optional { margin-top: 10px; color: var(--txt-3); }
.privacy-check.optional em { font-style: normal; color: var(--txt-3); }

.checkout-wrapper {
  --lg-tint: rgba(255, 255, 255, 0.34);
  --lg-tint-strong: rgba(255, 255, 255, 0.46);
  --lg-blur: blur(6px) saturate(200%) brightness(1.04);
  --lg-radius: 28px;

  --lg-thickness:
    inset 1.5px 1.5px 0 -0.5px rgba(255, 255, 255, 1),
    inset -1.5px -1.5px 0 -0.5px rgba(255, 255, 255, 0.7),
    inset 0 0 16px -4px rgba(255, 255, 255, 0.75),
    inset 0 -14px 24px -18px rgba(0, 0, 0, 0.16),
    0 0 0 0.5px rgba(0, 0, 0, 0.05);
  --lg-drop: 0 6px 16px -8px rgba(0, 0, 0, 0.16), 0 20px 46px -22px rgba(0, 0, 0, 0.22);

  --txt: #1c1c1e;
  --txt-2: #55555c;
  --txt-3: #85858c;
  --gold: #eab308;
  --gold-2: #f59e0b;
  --gold-deep: #a16207;

  position: relative;
  min-height: 100vh;
  padding: 32px 0 80px;
  overflow: hidden;
  background: #fdfcfa;
}

/* Fondo champan */
.bg-decoration { position: absolute; inset: 0; pointer-events: none; z-index: 0; }
.glow { position: absolute; border-radius: 50%; filter: blur(100px); }
.glow-1 { width: 720px; height: 720px; background: radial-gradient(circle, rgba(234, 179, 8, 0.16), transparent 66%); top: -200px; right: -140px; }
.glow-2 { width: 640px; height: 640px; background: radial-gradient(circle, rgba(180, 83, 9, 0.07), transparent 66%); bottom: 40px; left: -200px; }
.glow-3 { display: none; }
.grid-pattern { position: absolute; inset: 0; background-image: linear-gradient(180deg, rgba(250, 246, 238, 0.9) 0%, transparent 30%, rgba(250, 246, 238, 0.7) 100%), linear-gradient(rgba(0, 0, 0, 0.022) 1px, transparent 1px), linear-gradient(90deg, rgba(0, 0, 0, 0.022) 1px, transparent 1px); background-size: 100% 100%, 46px 46px, 46px 46px; }

/* ── El material (sin contenedores de imagen) ── */
.checkout-section,
.summary-card,
.trust-card,
.auth-status,
.shipping-warning,
.shipping-display,
.summary-product,
.section-icon,
.back-to-cart {
  position: relative;
  isolation: isolate;
  background: var(--lg-tint);
  backdrop-filter: var(--lg-blur);
  -webkit-backdrop-filter: var(--lg-blur);
  border: none;
  box-shadow: var(--lg-thickness), var(--lg-drop);
}

/* Anillo de refraccion */
.checkout-section::after,
.summary-card::after,
.trust-card::after,
.auth-status::after {
  content: '';
  position: absolute;
  inset: 0;
  z-index: 2;
  border-radius: inherit;
  padding: 9px;
  backdrop-filter: blur(6px) brightness(1.22) saturate(150%);
  -webkit-backdrop-filter: blur(6px) brightness(1.22) saturate(150%);
  -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
  -webkit-mask-composite: xor;
  mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
  mask-composite: exclude;
  pointer-events: none;
}

/* Reflejo especular */
.checkout-section::before,
.summary-card::before,
.trust-card::before {
  content: '';
  position: absolute;
  inset: 0;
  z-index: 1;
  border-radius: inherit;
  background: linear-gradient(140deg, rgba(255,255,255,0.55) 0%, rgba(255,255,255,0.12) 26%, transparent 52%, rgba(255,255,255,0.18) 100%);
  pointer-events: none;
}
.checkout-section > *, .summary-card > *, .trust-card > *, .auth-status > * { position: relative; z-index: 3; }

@supports (corner-shape: squircle) {
