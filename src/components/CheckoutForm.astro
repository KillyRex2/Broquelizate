.pay-button:hover:not(:disabled) { transform: translateY(-3px) scale(1.01); box-shadow: inset 1.5px 1.5px 0 -0.5px rgba(255,255,255,0.85), 0 18px 34px -14px rgba(234, 179, 8, 1); }
