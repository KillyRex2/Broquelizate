    name: p.name,
    price: p.price,
    quantity: p.quantity,
    image: p.image || '',
    variantCombination: p.variantCombination,
    variantSku: p.variantSku
  })))}
</div>
<div id="products-images" class="hidden">
  {JSON.stringify(products.map(p => p.image || ''))}
</div>
