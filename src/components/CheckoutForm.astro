</style>

<script>
  // ✅ CAMBIO: Importar nuevo sistema de alertas en lugar de Swal
  import { CartCookiesClient } from '@/utils/cart-cookies';
  import { loadScript } from '@paypal/paypal-js';
  import { loadStripe } from '@stripe/stripe-js';
  import type { Stripe, StripeCardElement } from '@stripe/stripe-js';
  import { Alert, Toast } from '@/utils/alerts'; // ✅ Reemplaza: import Swal from 'sweetalert2';
  import { navigate } from 'astro:transitions/client';
  import { actions } from 'astro:actions';

  interface SelectedShipping { carrier: string; service: string; price: number; deliveryDays: number; postalCode: string; }
  interface CartProduct { id: string; name: string; price: number; quantity: number; image?: string; variantCombination?: string; variantSku?: string; engraving?: { id: string; imageUrl: string; notes: string } | null; }

  const Formatter = { currency: (value: number) => new Intl.NumberFormat('es-MX', { style: 'currency', currency: 'MXN' }).format(value) };
  function getCarrierIcon(c: string): string { const i: Record<string, string> = { 'fedex': '🚚', 'dhl': '📦', 'estafeta': '📫', 'redpack': '🔴', 'ups': '🟤', 'paquetexpress': '📬', '99minutos': '⚡', 'sendex': '✉️' }; return i[c.toLowerCase()] || '📦'; }

  let stripe: Stripe | null = null, cardElement: StripeCardElement | null = null, selectedShipping: SelectedShipping | null = null, subtotalValue = 0;
  let isProcessing = false;

function loadShippingInfo() {
  let saved: string | null = null;
  try { saved = localStorage.getItem('selectedShipping'); } catch {}
  const warn = document.getElementById('shipping-warning');
  const infoDisp = document.getElementById('shipping-info-display');
  const summaryDet = document.getElementById('shipping-summary-details');

  if (!saved) {
    warn?.classList.remove('hidden');
    infoDisp?.classList.add('hidden');
    summaryDet?.classList.add('hidden');
    selectedShipping = null;
    updateTotals();
    return;
  }

  try {
    const p: SelectedShipping = JSON.parse(saved);
    if (!p || typeof p.price !== 'number' || !p.carrier) {
      warn?.classList.remove('hidden');
      selectedShipping = null;
      updateTotals();
      return;
    }
    selectedShipping = { ...p };
    warn?.classList.add('hidden');

    if (infoDisp) {
      infoDisp.classList.remove('hidden');
      const dc = document.getElementById('display-carrier');
      const dd = document.getElementById('display-delivery');
      const dp = document.getElementById('display-shipping-price');
      if (dc) dc.textContent = `${p.carrier} - ${p.service}`;
      if (dd) dd.textContent = `Entrega en ${p.deliveryDays} día${p.deliveryDays !== 1 ? 's' : ''} hábil${p.deliveryDays !== 1 ? 'es' : ''}`;
      if (dp) dp.textContent = Formatter.currency(p.price);
    }
    if (summaryDet) {
      summaryDet.classList.remove('hidden');
      const sci = document.getElementById('summary-carrier-icon');
      const scn = document.getElementById('summary-carrier-name');
      const sdd = document.getElementById('summary-delivery-days');
      if (sci) sci.textContent = getCarrierIcon(p.carrier);
      if (scn) scn.textContent = p.carrier;
      if (sdd) sdd.textContent = `${p.deliveryDays} día${p.deliveryDays !== 1 ? 's' : ''}`;
    }

    // Auto-completa el CP en el form de dirección
    const pci = document.getElementById('postal-code') as HTMLInputElement;
    if (pci && p.postalCode && !pci.value) pci.value = p.postalCode;

    updateTotals();
  } catch {
    warn?.classList.remove('hidden');
    selectedShipping = null;
    updateTotals();
  }
}

  function updateTotals() {
    subtotalValue = parseFloat(document.getElementById('subtotal-data')?.textContent || '0');
    const sp = selectedShipping?.price || 0, t = subtotalValue + sp;
    const ss = document.getElementById('summary-shipping'); if (ss) { ss.textContent = selectedShipping ? Formatter.currency(sp) : 'Por calcular'; ss.className = selectedShipping ? 'row-value' : 'row-value muted'; }
    const st = document.getElementById('summary-total'); if (st) st.textContent = Formatter.currency(t);
    const pba = document.getElementById('pay-button-amount'); if (pba) pba.textContent = Formatter.currency(t);
    const td = document.getElementById('total-data'); if (td) td.textContent = t.toString();
  }

  async function initStripe() {
    const ce = document.getElementById('card-element'); if (!ce || (cardElement && ce.querySelector('.StripeElement'))) return;
    try {
      ce.innerHTML = '<div style="color:#85858c;font-size:0.9rem;">Cargando...</div>';
      if (!stripe) { const pk = import.meta.env.PUBLIC_STRIPE_PUBLIC_KEY; if (!pk) throw new Error('Sin clave Stripe'); const si = await loadStripe(pk); if (!si) throw new Error('Error Stripe'); stripe = si; }
      const el = stripe.elements({ locale: 'es' }); cardElement = el.create('card', { style: { base: { color: '#1c1c1e', fontFamily: 'Inter,sans-serif', fontSize: '16px', '::placeholder': { color: '#85858c' }, iconColor: '#a16207' }, invalid: { color: '#b91c1c', iconColor: '#b91c1c' } }, hidePostalCode: true });
      ce.innerHTML = ''; cardElement.mount(ce);
      cardElement.on('change', (e) => { const err = document.getElementById('card-errors'); if (err) err.textContent = e.error ? e.error.message : ''; const btn = document.getElementById('submit-card-payment') as HTMLButtonElement; if (btn) btn.disabled = !e.complete; });
    } catch { ce.innerHTML = '<div style="color:#f87171;font-size:0.9rem;">Error al cargar pasarela</div>'; }
  }

  async function processCard(): Promise<void> {
    if (isProcessing) return;
    
    // ✅ CAMBIO: Swal.fire → Alert.error
    if (!stripe || !cardElement) { 
      await Alert.error('Error', 'Pasarela no está lista'); 
      return; 
    }
    
    const v = validateForm(); 
    // ✅ CAMBIO: Swal.fire → Alert.warning
    if (!v.valid) { 
      await Alert.warning('Campos incompletos', `Faltan: ${v.missingFields.join(', ')}`); 
      return; 
    }
    
    const email = (document.getElementById('email') as HTMLInputElement)?.value.trim(), chn = (document.getElementById('card-holder-name') as HTMLInputElement)?.value.trim(), str = (document.getElementById('street-address') as HTMLInputElement)?.value.trim(), nb = (document.getElementById('neighborhood') as HTMLInputElement)?.value.trim(), ct = (document.getElementById('city') as HTMLInputElement)?.value.trim(), st = (document.getElementById('state') as HTMLInputElement)?.value.trim(), pc = (document.getElementById('postal-code') as HTMLInputElement)?.value.trim(), ph = (document.getElementById('phone') as HTMLInputElement)?.value.trim();
    
    // ✅ CAMBIO: Swal.fire → Alert.warning
    if (!chn) { 
      await Alert.warning('Nombre requerido', 'Ingresa el nombre del titular'); 
      return; 
    }
    
    const d = getCheckoutData(); 
    // ✅ CAMBIO: Swal.fire → Alert.error
    if (!d) { 
      await Alert.error('Error', 'Sin datos del pedido'); 
      return; 
    }
    
    const cs = selectedShipping, sc = cs?.price || 0, sub = d.totalValue - sc;
    const btn = document.getElementById('submit-card-payment') as HTMLButtonElement, txt = document.getElementById('card-btn-text'), orig = txt?.textContent || 'Pagar'; 
    
    isProcessing = true;
    if (btn) btn.disabled = true; 
    if (txt) txt.textContent = 'Procesando...';
    
    // ✅ CAMBIO: Swal.fire con loading → Toast.loading
    const loadingId = Toast.loading('Procesando tu pago...');
    
    try {
      const r = await fetch('/api/create-payment-intent', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ products: d.productsData, subtotal: sub, shippingCost: sc, total: d.totalValue, customerEmail: email, customerName: chn, shippingAddress: { line1: str, line2: nb, city: ct, state: st, postal_code: pc, country: 'MX', phone: ph }, shippingInfo: cs ? { carrier: cs.carrier, service: cs.service, price: cs.price, deliveryDays: cs.deliveryDays } : null }) });
      if (!r.ok) { const e = await r.json(); throw new Error(e.error || 'Error pago'); }
      const { clientSecret } = await r.json();
      const { error: se, paymentIntent: pi } = await stripe.confirmCardPayment(clientSecret, { payment_method: { card: cardElement, billing_details: { name: chn, email, phone: ph || undefined, address: { line1: str, line2: nb || undefined, city: ct, state: st, postal_code: pc, country: 'MX' } } } });
      if (se) throw new Error(se.message || 'Error tarjeta'); 
      if (pi?.status !== 'succeeded') throw new Error('Pago no completado');
      
      await updateStock(); 
      const o = await createOrder('card', pi.id);
      CartCookiesClient.clearCart(); 
      localStorage.removeItem('selectedShipping'); 
      
      // ✅ CAMBIO: Swal.close() + Swal.fire → Toast.dismiss + Toast.success
      Toast.dismiss(loadingId);
      Toast.success('¡Pago exitoso!', `Orden #${o.orderNumber} procesada`);
      
      setTimeout(() => navigate(`/order-success?order_id=${o.id}`), 1000);
      
    } catch (e) { 
      // ✅ CAMBIO: Swal.close() + Swal.fire → Toast.dismiss + Alert.error
      Toast.dismiss(loadingId);
      await Alert.error('Error en el pago', e instanceof Error ? e.message : 'Error desconocido'); 
    } finally { 
      isProcessing = false;
      if (btn) btn.disabled = false; 
      if (txt) txt.textContent = orig; 
    }
  }

  async function processMercadoPago(): Promise<void> {
  if (isProcessing) return;

  const v = validateForm();
  if (!v.valid) { await Alert.warning('Campos incompletos', `Faltan: ${v.missingFields.join(', ')}`); return; }

  const d = getCheckoutData();
  if (!d) { await Alert.error('Error', 'Sin datos del pedido'); return; }

  const email = (document.getElementById('email') as HTMLInputElement)?.value.trim();
  let userData: any = {};
  try { userData = JSON.parse(document.getElementById('user-data')?.textContent || '{}'); } catch {}
  const customerName = userData.name || email;

  const sa = (document.getElementById('street-address') as HTMLInputElement)?.value.trim();
  const nb = (document.getElementById('neighborhood') as HTMLInputElement)?.value.trim();
  const ct = (document.getElementById('city') as HTMLInputElement)?.value.trim();
  const st = (document.getElementById('state') as HTMLInputElement)?.value.trim();
  const pc = (document.getElementById('postal-code') as HTMLInputElement)?.value.trim();
  const ph = (document.getElementById('phone') as HTMLInputElement)?.value.trim();
  const dn = (document.getElementById('delivery-notes') as HTMLTextAreaElement)?.value || '';

  const cs = selectedShipping;
  const shippingInfo = cs ? { carrier: cs.carrier, service: cs.service, price: cs.price, deliveryDays: cs.deliveryDays } : null;

  isProcessing = true;
  const loadingId = Toast.loading('Redirigiendo a Mercado Pago...');
  try {
    const res = await fetch('/api/create-mercadopago-preference', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        channel: 'online',
        customerEmail: email,
        customerName,
        phone: ph,
        shippingCost: d.shippingValue,
        shippingAddress: {
          streetAddress: sa, neighborhood: nb, city: ct, state: st,
          postalCode: pc, country: 'México', phone: ph, deliveryNotes: dn,
        },
        shippingInfo,
        // El servidor recalcula precios y totales desde la base:
        // aquí solo viaja qué y cuánto, nunca a qué precio.
        products: d.productsData.map((p: CartProduct) => ({
          productId: p.id,
          quantity: p.quantity,
          combinationId: (p as any).combinationId ?? null,
          variantCombination: p.variantCombination ?? null,
          variantSku: p.variantSku ?? null,
          image: p.image,
        })),
      }),
    });
    const data = await res.json();
    if (!res.ok || !data.initPoint) throw new Error(data.error || 'No se pudo iniciar Mercado Pago');

    Toast.dismiss(loadingId);
    window.location.href = data.initPoint; // redirige a Checkout Pro
  } catch (e) {
    Toast.dismiss(loadingId);
    isProcessing = false;
    await Alert.error('Error', e instanceof Error ? e.message : 'Error al iniciar Mercado Pago');
  }
}


  function getCheckoutData() {
    const pd = document.getElementById('products-data'), pi = document.getElementById('products-images'), txd = document.getElementById('tax-data'), td = document.getElementById('total-data');
    if (!pd || !txd || !td) return null;
    const rpd = JSON.parse(pd.textContent || '[]'), pim = pi ? JSON.parse(pi.textContent || '[]') : [], txv = parseFloat(txd.textContent || '0'), tv = parseFloat(td.textContent || '0'), sv = selectedShipping?.price || 0;
    const pdata: CartProduct[] = rpd.map((p: any, i: number) => ({ id: p.id || '', name: p.name || '', price: p.price || 0, quantity: p.quantity || 1, image: pim[i] || p.image || '', variantCombination: p.variantCombination || null, variantSku: p.variantSku || null, engraving: p.engraving || null }));
    return { productsData: pdata, taxValue: txv, totalValue: tv, shippingValue: sv };
  }

  function validateForm(): { valid: boolean; missingFields: string[] } {
    const mf: string[] = [];
    const em = (document.getElementById('email') as HTMLInputElement)?.value.trim(), sa = (document.getElementById('street-address') as HTMLInputElement)?.value.trim(), nb = (document.getElementById('neighborhood') as HTMLInputElement)?.value.trim(), ct = (document.getElementById('city') as HTMLInputElement)?.value.trim(), st = (document.getElementById('state') as HTMLInputElement)?.value.trim(), pc = (document.getElementById('postal-code') as HTMLInputElement)?.value.trim(), ph = (document.getElementById('phone') as HTMLInputElement)?.value.trim();
    if (!em) mf.push('Email'); if (!sa) mf.push('Calle'); if (!nb) mf.push('Colonia'); if (!ct) mf.push('Ciudad'); if (!st) mf.push('Estado'); if (!pc) mf.push('CP'); if (!ph) mf.push('Teléfono'); if (!selectedShipping) mf.push('Método de envío');

    // Consentimiento: obligatorio y por acto afirmativo (casilla desmarcada por defecto)
    const privacy = document.getElementById('accept-privacy') as HTMLInputElement;
    if (!privacy?.checked) mf.push('Aceptar el aviso de privacidad');

    return { valid: mf.length === 0, missingFields: mf };
  }

  function setupFormValidation() { 
    ['email', 'street-address', 'neighborhood', 'city', 'state', 'postal-code', 'phone'].forEach(id => { 
      const f = document.getElementById(id); 
      if (f) f.addEventListener('blur', () => { 
        f.style.borderColor = !(f as HTMLInputElement).value.trim() ? '#ef4444' : 'rgba(255,255,255,0.1)'; 
      }); 
    }); 
  }

function updatePaymentVis() {
  const sm = document.querySelector('input[name="payment-method"]:checked') as HTMLInputElement; if (!sm) return;
  const cf = document.getElementById('card-form'),
        pc = document.getElementById('paypal-container'),
        mp = document.getElementById('mercadopago-container');
  if (cf) cf.classList.add('hidden');
  if (pc) pc.classList.add('hidden');
  if (mp) mp.classList.add('hidden');
  if (sm.id === 'card') { if (cf) cf.classList.remove('hidden'); initStripe(); }
  else if (sm.id === 'paypal') { if (pc) pc.classList.remove('hidden'); initPayPal(); }
  else if (sm.id === 'mercadopago') { if (mp) mp.classList.remove('hidden'); }
}

  async function createOrder(pm: string, piid?: string) {
    const em = (document.getElementById('email') as HTMLInputElement)?.value, chn = (document.getElementById('card-holder-name') as HTMLInputElement)?.value, sa = (document.getElementById('street-address') as HTMLInputElement)?.value, nb = (document.getElementById('neighborhood') as HTMLInputElement)?.value, ct = (document.getElementById('city') as HTMLInputElement)?.value, st = (document.getElementById('state') as HTMLInputElement)?.value, pc = (document.getElementById('postal-code') as HTMLInputElement)?.value, ph = (document.getElementById('phone') as HTMLInputElement)?.value, dn = (document.getElementById('delivery-notes') as HTMLTextAreaElement)?.value || '';
    const d = getCheckoutData(); if (!d) throw new Error('Sin datos');
    let si: { carrier: string; service: string; price: number; deliveryDays: number } | null = null; const cs = selectedShipping; if (cs) si = { carrier: cs.carrier, service: cs.service, price: cs.price, deliveryDays: cs.deliveryDays };
    const od = { customerEmail: em, customerName: chn || em, shippingAddress: { streetAddress: sa, neighborhood: nb, city: ct, state: st, postalCode: pc, country: 'México', phone: ph, deliveryNotes: dn }, shippingInfo: si, products: d.productsData.map((p: CartProduct) => ({ id: p.id, name: p.name, price: p.price, quantity: p.quantity, variantCombination: p.variantCombination, variantSku: p.variantSku, engraving: p.engraving || null })), subtotal: d.totalValue - d.shippingValue, shippingCost: d.shippingValue, tax: d.taxValue, total: d.totalValue, paymentMethod: pm, paymentIntentId: piid || null, clientId: null };
    const r = await fetch('/api/create-order', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(od) });
    if (!r.ok) { const e = await r.json(); throw new Error(e.error || 'Error'); } return await r.json();
  }

  async function updateStock() {
    const pd = document.getElementById('products-data'); if (!pd) throw new Error('Sin datos');
    const rpd = JSON.parse(pd.textContent || '[]'), sud = rpd.map((p: any) => ({ id: p.id, quantity: p.quantity }));
    const r = await fetch('/api/update-stock-online', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ products: sud }) });
    if (!r.ok) { const e = await r.json(); throw new Error(e.error || 'Error stock'); }
  }

  // ✅ CAMBIO: Swal.fire → Alert.warning/error
  function validatePaypal() { 
    const v = validateForm(); 
    if (!v.valid) { 
      Alert.warning('Campos incompletos', `Faltan: ${v.missingFields.join(', ')}`); 
      return null; 
    } 
    const d = getCheckoutData(); 
    if (!d?.totalValue) { 
      Alert.error('Error', 'Sin total'); 
      return null; 
    } 
    return { total: d.totalValue }; 
  }

  async function initPayPal() {
    const c = document.getElementById('paypal-button-container'); if (!c) return; c.innerHTML = '<div style="text-align:center;padding:20px;color:rgba(255,255,255,0.4);">Cargando PayPal...</div>';
    try {
      const pp = await loadScript({ clientId: import.meta.env.PUBLIC_PAYPAL_CLIENT_ID || "AcBeVZggGRidpLZa0RrTje-kNfh0Q6vhNY1H4qTVjFxaEHrF-ltd1D3erIxPNbjVrtUXjHM-5qsa8-3y", currency: "MXN", intent: "capture", commit: true, vault: false, components: "buttons", disableFunding: "venmo,giropay,sofort,sepa", locale: "es_MX" });
      if (pp?.Buttons) renderPayPal(pp); else c.innerHTML = '<div style="color:#f87171;text-align:center;">PayPal no disponible</div>';
    } catch { c.innerHTML = '<div style="color:#f87171;text-align:center;">Error PayPal</div>'; }
  }

  function renderPayPal(pp: any) {
    pp.Buttons({
      style: { layout: 'vertical', color: 'gold', shape: 'rect', label: 'paypal' },
      createOrder: async () => { 
        const d = validatePaypal(); 
        if (!d) return Promise.reject('Val fail'); 
        try { 
          const r = await actions.createPaypalOrder({ total: d.total }); 
          if (r.error) throw new Error(r.error.message); 
          return r.data.orderId; 
        } catch (e) { 
          // ✅ CAMBIO: Swal.fire → Alert.error
          Alert.error('Error', e instanceof Error ? e.message : 'Error'); 
          return Promise.reject(e); 
        } 
      },
      onApprove: async (data: any) => { 
        // ✅ CAMBIO: Swal.fire loading → Toast.loading
        const loadingId = Toast.loading('Procesando pago con PayPal...');
        try { 
          const r = await actions.capturePaypalOrder({ orderId: data.orderID }); 
          if (r.error) throw new Error(r.error.message); 
          await updateStock(); 
          const o = await createOrder('paypal'); 
          CartCookiesClient.clearCart(); 
          localStorage.removeItem('selectedShipping'); 
          // ✅ CAMBIO: Swal.close() → Toast.dismiss + Toast.success
          Toast.dismiss(loadingId);
          Toast.success('¡Pago exitoso!', `Orden #${o.orderNumber}`);
          setTimeout(() => navigate(`/order-success?order_id=${o.id}`), 1000);
        } catch (e) { 
          // ✅ CAMBIO: Swal.close() + Swal.fire → Toast.dismiss + Alert.error
          Toast.dismiss(loadingId);
          Alert.error('Error', e instanceof Error ? e.message : 'Error'); 
        } 
      },
      // ✅ CAMBIO: Swal.fire → Alert.error / Toast.info
      onError: () => Alert.error('Error', 'Error con PayPal'), 
      onCancel: () => Toast.info('Pago cancelado')
    }).render('#paypal-button-container');
  }

  function init() {
    if (!document.getElementById('products-data')) return;
    loadShippingInfo();
    setupFormValidation();
    document.querySelectorAll('input[name="payment-method"]').forEach(r => r.addEventListener('change', updatePaymentVis));
    document.getElementById('submit-card-payment')?.addEventListener('click', e => { e.preventDefault(); processCard(); });
    document.getElementById('submit-mp-payment')?.addEventListener('click', e => { e.preventDefault(); processMercadoPago(); });
    updatePaymentVis();

    // ✅ Escucha eventos del ShippingCalculator
    window.addEventListener('shipping:selected', () => loadShippingInfo());
    window.addEventListener('shipping:cleared', () => loadShippingInfo());
  }

  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init); else init();
  document.addEventListener('astro:page-load', init);
  setTimeout(() => { const w = document.getElementById('shipping-warning'); if (w && !w.classList.contains('hidden')) loadShippingInfo(); }, 500);
</script>


<div id="products-data" class="hidden">{JSON.stringify(productsData.map(p => ({ id: p.id || "", name: p.name, price: p.price, quantity: p.quantity, image: p.image || '', variantCombination: p.variantCombination, variantSku: p.variantSku, engraving: p.engraving || null })))}</div>
<div id="products-images" class="hidden">{JSON.stringify(products.map(p => p.variantImage || p.image || ''))}</div>
<div id="tax-data" class="hidden">{tax}</div>
<div id="total-data" class="hidden">{total}</div>
<div id="subtotal-data" class="hidden">{subtotal}</div>
<div id="user-data" class="hidden">{JSON.stringify({ email: userEmail, name: userName, isAuthenticated })}</div>
