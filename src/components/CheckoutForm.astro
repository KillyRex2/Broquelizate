.section-subtitle { font-size: 0.9rem; color: var(--txt-2); margin-top: 2px; }

.shipping-display { margin-bottom: 24px; padding: 16px 20px; background: rgba(234, 179, 8, 0.14); border-radius: 20px; }
.shipping-display.hidden { display: none; }
