  @media (max-width: 480px) { .auth-status { flex-direction: column; text-align: center; padding: 20px; } .shipping-display-content { flex-wrap: wrap; } .shipping-display-price { width: 100%; flex-direction: row; justify-content: space-between; margin-top: 12px; padding-top: 12px; border-top: 1px solid rgba(234, 179, 8, 0.2); } .payment-option-content { flex-direction: column; gap: 12px; text-align: center; } .payment-check { display: none; } }
