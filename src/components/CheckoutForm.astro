<script>
  import { CartCookiesClient } from '@/utils/cart-cookies';
  import { loadScript } from '@paypal/paypal-js';
  import { loadStripe } from '@stripe/stripe-js';
  import type { Stripe, StripeCardElement } from '@stripe/stripe-js';
  import Swal from 'sweetalert2';
  import { navigate } from 'astro:transitions/client';
  import { actions } from 'astro:actions';

  interface SelectedShipping { carrier: string; service: string; price: number; deliveryDays: number; postalCode: string; }
  interface CartProduct { id: string; name: string; price: number; quantity: number; image?: string; variantCombination?: string; variantSku?: string; }

  const Formatter = { currency: (value: number) => new Intl.NumberFormat('es-MX', { style: 'currency', currency: 'MXN' }).format(value) };
  function getCarrierIcon(c: string): string { const i: Record<string, string> = { 'fedex': '🚚', 'dhl': '📦', 'estafeta': '📫', 'redpack': '🔴', 'ups': '🟤', 'paquetexpress': '📬', '99minutos': '⚡', 'sendex': '✉️' }; return i[c.toLowerCase()] || '📦'; }

  let stripe: Stripe | null = null, cardElement: StripeCardElement | null = null, selectedShipping: SelectedShipping | null = null, subtotalValue = 0;

  function loadShippingInfo() {
    let saved: string | null = null;
    try { saved = localStorage.getItem('selectedShipping'); } catch {}
    const warn = document.getElementById('shipping-warning'), infoDisp = document.getElementById('shipping-info-display'), summaryDet = document.getElementById('shipping-summary-details');
    if (!saved) { if (warn) warn.classList.remove('hidden'); if (infoDisp) infoDisp.classList.add('hidden'); if (summaryDet) summaryDet.classList.add('hidden'); selectedShipping = null; updateTotals(); return; }
    try {
      const p: SelectedShipping = JSON.parse(saved);
      if (!p || typeof p.price !== 'number' || !p.carrier) { if (warn) warn.classList.remove('hidden'); selectedShipping = null; updateTotals(); return; }
      selectedShipping = { carrier: p.carrier, service: p.service, price: p.price, deliveryDays: p.deliveryDays, postalCode: p.postalCode };
      if (warn) warn.classList.add('hidden');
      if (infoDisp && selectedShipping) { infoDisp.classList.remove('hidden'); const s = selectedShipping; const dc = document.getElementById('display-carrier'), dd = document.getElementById('display-delivery'), dp = document.getElementById('display-shipping-price'); if (dc) dc.textContent = `${s.carrier} - ${s.service}`; if (dd) dd.textContent = `Entrega en ${s.deliveryDays} día${s.deliveryDays !== 1 ? 's' : ''} hábil${s.deliveryDays !== 1 ? 'es' : ''}`; if (dp) dp.textContent = Formatter.currency(s.price); }
      if (summaryDet && selectedShipping) { summaryDet.classList.remove('hidden'); const s = selectedShipping; const sci = document.getElementById('summary-carrier-icon'), scn = document.getElementById('summary-carrier-name'), sdd = document.getElementById('summary-delivery-days'); if (sci) sci.textContent = getCarrierIcon(s.carrier); if (scn) scn.textContent = s.carrier; if (sdd) sdd.textContent = `${s.deliveryDays} día${s.deliveryDays !== 1 ? 's' : ''}`; }
      if (selectedShipping) { const s = selectedShipping; const pci = document.getElementById('postal-code') as HTMLInputElement; if (pci && s.postalCode && !pci.value) pci.value = s.postalCode; }
      updateTotals();
    } catch { if (warn) warn.classList.remove('hidden'); selectedShipping = null; updateTotals(); }
  }

  function updateTotals() {
    subtotalValue = parseFloat(document.getElementById('subtotal-data')?.textContent || '0');
    const sp = selectedShipping?.price || 0, t = subtotalValue + sp;
    const ss = document.getElementById('summary-shipping'); if (ss) { ss.textContent = selectedShipping ? Formatter.currency(sp) : 'Por calcular'; ss.className = selectedShipping ? 'row-value' : 'row-value muted'; }
    const st = document.getElementById('summary-total'); if (st) st.textContent = Formatter.currency(t);
    const pba = document.getElementById('pay-button-amount'); if (pba) pba.textContent = Formatter.currency(t);
    const td = document.getElementById('total-data'); if (td) td.textContent = t.toString();
  }

  async function initStripe() {
    const ce = document.getElementById('card-element'); if (!ce || (cardElement && ce.querySelector('.StripeElement'))) return;
    try {
      ce.innerHTML = '<div style="color:rgba(255,255,255,0.4);font-size:0.9rem;">Cargando...</div>';
      if (!stripe) { const pk = import.meta.env.PUBLIC_STRIPE_PUBLIC_KEY; if (!pk) throw new Error('Sin clave Stripe'); const si = await loadStripe(pk); if (!si) throw new Error('Error Stripe'); stripe = si; }
      const el = stripe.elements({ locale: 'es' }); cardElement = el.create('card', { style: { base: { color: '#fff', fontFamily: 'Inter,sans-serif', fontSize: '16px', '::placeholder': { color: '#6b7280' }, iconColor: '#eab308' }, invalid: { color: '#ef4444', iconColor: '#ef4444' } }, hidePostalCode: true });
      ce.innerHTML = ''; cardElement.mount(ce);
      cardElement.on('change', (e) => { const err = document.getElementById('card-errors'); if (err) err.textContent = e.error ? e.error.message : ''; const btn = document.getElementById('submit-card-payment') as HTMLButtonElement; if (btn) btn.disabled = !e.complete; });
    } catch { ce.innerHTML = '<div style="color:#f87171;font-size:0.9rem;">Error al cargar pasarela</div>'; }
  }

  async function processCard(): Promise<void> {
    if (!stripe || !cardElement) { await Swal.fire({ title: 'Error', text: 'Pasarela no lista', icon: 'error', confirmButtonColor: '#eab308' }); return; }
    const v = validateForm(); if (!v.valid) { await Swal.fire({ title: 'Campos incompletos', html: `• ${v.missingFields.join('<br>• ')}`, icon: 'warning', confirmButtonColor: '#eab308' }); return; }
    const email = (document.getElementById('email') as HTMLInputElement)?.value.trim(), chn = (document.getElementById('card-holder-name') as HTMLInputElement)?.value.trim(), str = (document.getElementById('street-address') as HTMLInputElement)?.value.trim(), nb = (document.getElementById('neighborhood') as HTMLInputElement)?.value.trim(), ct = (document.getElementById('city') as HTMLInputElement)?.value.trim(), st = (document.getElementById('state') as HTMLInputElement)?.value.trim(), pc = (document.getElementById('postal-code') as HTMLInputElement)?.value.trim(), ph = (document.getElementById('phone') as HTMLInputElement)?.value.trim();
    if (!chn) { await Swal.fire({ title: 'Nombre requerido', icon: 'warning', confirmButtonColor: '#eab308' }); return; }
    const d = getCheckoutData(); if (!d) { await Swal.fire({ title: 'Error', text: 'Sin datos', icon: 'error', confirmButtonColor: '#eab308' }); return; }
    const cs = selectedShipping, sc = cs?.price || 0, sub = d.totalValue - sc;
    const btn = document.getElementById('submit-card-payment') as HTMLButtonElement, txt = document.getElementById('card-btn-text'), orig = txt?.textContent || 'Pagar'; if (btn) btn.disabled = true; if (txt) txt.textContent = 'Procesando...';
    try {
      Swal.fire({ title: 'Procesando...', allowOutsideClick: false, showConfirmButton: false, didOpen: () => Swal.showLoading() });
      const r = await fetch('/api/create-payment-intent', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ products: d.productsData, subtotal: sub, shippingCost: sc, total: d.totalValue, customerEmail: email, customerName: chn, shippingAddress: { line1: str, line2: nb, city: ct, state: st, postal_code: pc, country: 'MX', phone: ph }, shippingInfo: cs ? { carrier: cs.carrier, service: cs.service, price: cs.price, deliveryDays: cs.deliveryDays } : null }) });
      if (!r.ok) { const e = await r.json(); throw new Error(e.error || 'Error pago'); }
      const { clientSecret } = await r.json();
      const { error: se, paymentIntent: pi } = await stripe.confirmCardPayment(clientSecret, { payment_method: { card: cardElement, billing_details: { name: chn, email, phone: ph || undefined, address: { line1: str, line2: nb || undefined, city: ct, state: st, postal_code: pc, country: 'MX' } } } });
      if (se) throw new Error(se.message || 'Error tarjeta'); if (pi?.status !== 'succeeded') throw new Error('Pago no completado');
      await updateStock(); const o = await createOrder('card', pi.id);
      CartCookiesClient.clearCart(); localStorage.removeItem('selectedShipping'); Swal.close();
      await Swal.fire({ title: '¡Pago exitoso!', html: `Orden <strong>#${o.orderNumber}</strong> procesada`, icon: 'success', confirmButtonColor: '#eab308' });
      navigate(`/order-success?order_id=${o.id}`);
    } catch (e) { Swal.close(); await Swal.fire({ title: 'Error', text: e instanceof Error ? e.message : 'Error', icon: 'error', confirmButtonColor: '#eab308' }); } finally { if (btn) btn.disabled = false; if (txt) txt.textContent = orig; }
  }

  function getCheckoutData() {
    const pd = document.getElementById('products-data'), pi = document.getElementById('products-images'), txd = document.getElementById('tax-data'), td = document.getElementById('total-data');
    if (!pd || !txd || !td) return null;
    const rpd = JSON.parse(pd.textContent || '[]'), pim = pi ? JSON.parse(pi.textContent || '[]') : [], txv = parseFloat(txd.textContent || '0'), tv = parseFloat(td.textContent || '0'), sv = selectedShipping?.price || 0;
    const pdata: CartProduct[] = rpd.map((p: any, i: number) => ({ id: p.id || '', name: p.name || '', price: p.price || 0, quantity: p.quantity || 1, image: pim[i] || p.image || '', variantCombination: p.variantCombination || null, variantSku: p.variantSku || null }));
    return { productsData: pdata, taxValue: txv, totalValue: tv, shippingValue: sv };
  }

  function validateForm(): { valid: boolean; missingFields: string[] } {
    const mf: string[] = [];
    const em = (document.getElementById('email') as HTMLInputElement)?.value.trim(), sa = (document.getElementById('street-address') as HTMLInputElement)?.value.trim(), nb = (document.getElementById('neighborhood') as HTMLInputElement)?.value.trim(), ct = (document.getElementById('city') as HTMLInputElement)?.value.trim(), st = (document.getElementById('state') as HTMLInputElement)?.value.trim(), pc = (document.getElementById('postal-code') as HTMLInputElement)?.value.trim(), ph = (document.getElementById('phone') as HTMLInputElement)?.value.trim();
    if (!em) mf.push('Email'); if (!sa) mf.push('Calle'); if (!nb) mf.push('Colonia'); if (!ct) mf.push('Ciudad'); if (!st) mf.push('Estado'); if (!pc) mf.push('CP'); if (!ph) mf.push('Teléfono'); if (!selectedShipping) mf.push('Método de envío');
    return { valid: mf.length === 0, missingFields: mf };
  }

  function setupFormValidation() { ['email', 'street-address', 'neighborhood', 'city', 'state', 'postal-code', 'phone'].forEach(id => { const f = document.getElementById(id); if (f) f.addEventListener('blur', () => { f.style.borderColor = !(f as HTMLInputElement).value.trim() ? '#ef4444' : 'rgba(255,255,255,0.1)'; }); }); }

  function updatePaymentVis() {
    const sm = document.querySelector('input[name="payment-method"]:checked') as HTMLInputElement; if (!sm) return;
    const cf = document.getElementById('card-form'), pc = document.getElementById('paypal-container');
    if (cf) cf.classList.add('hidden'); if (pc) pc.classList.add('hidden');
    if (sm.id === 'card') { if (cf) cf.classList.remove('hidden'); initStripe(); }
    else if (sm.id === 'paypal') { if (pc) pc.classList.remove('hidden'); initPayPal(); }
  }

  async function createOrder(pm: string, piid?: string) {
    const em = (document.getElementById('email') as HTMLInputElement)?.value, chn = (document.getElementById('card-holder-name') as HTMLInputElement)?.value, sa = (document.getElementById('street-address') as HTMLInputElement)?.value, nb = (document.getElementById('neighborhood') as HTMLInputElement)?.value, ct = (document.getElementById('city') as HTMLInputElement)?.value, st = (document.getElementById('state') as HTMLInputElement)?.value, pc = (document.getElementById('postal-code') as HTMLInputElement)?.value, ph = (document.getElementById('phone') as HTMLInputElement)?.value, dn = (document.getElementById('delivery-notes') as HTMLTextAreaElement)?.value || '';
    const d = getCheckoutData(); if (!d) throw new Error('Sin datos');
    let si: { carrier: string; service: string; price: number; deliveryDays: number } | null = null; const cs = selectedShipping; if (cs) si = { carrier: cs.carrier, service: cs.service, price: cs.price, deliveryDays: cs.deliveryDays };
    const od = { customerEmail: em, customerName: chn || em, shippingAddress: { streetAddress: sa, neighborhood: nb, city: ct, state: st, postalCode: pc, country: 'México', phone: ph, deliveryNotes: dn }, shippingInfo: si, products: d.productsData.map((p: CartProduct) => ({ id: p.id, name: p.name, price: p.price, quantity: p.quantity, variantCombination: p.variantCombination, variantSku: p.variantSku })), subtotal: d.totalValue - d.shippingValue, shippingCost: d.shippingValue, tax: d.taxValue, total: d.totalValue, paymentMethod: pm, paymentIntentId: piid || null, clientId: null };
    const r = await fetch('/api/create-order', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(od) });
    if (!r.ok) { const e = await r.json(); throw new Error(e.error || 'Error'); } return await r.json();
  }

  async function updateStock() {
    const pd = document.getElementById('products-data'); if (!pd) throw new Error('Sin datos');
    const rpd = JSON.parse(pd.textContent || '[]'), sud = rpd.map((p: any) => ({ id: p.id, quantity: p.quantity }));
    const r = await fetch('/api/update-stock-online', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ products: sud }) });
    if (!r.ok) { const e = await r.json(); throw new Error(e.error || 'Error stock'); }
  }

  function validatePaypal() { const v = validateForm(); if (!v.valid) { Swal.fire({ title: 'Campos incompletos', html: `• ${v.missingFields.join('<br>• ')}`, icon: 'warning', confirmButtonColor: '#eab308' }); return null; } const d = getCheckoutData(); if (!d?.totalValue) { Swal.fire({ title: 'Error', text: 'Sin total', icon: 'error', confirmButtonColor: '#eab308' }); return null; } return { total: d.totalValue }; }

  async function initPayPal() {
    const c = document.getElementById('paypal-button-container'); if (!c) return; c.innerHTML = '<div style="text-align:center;padding:20px;color:rgba(255,255,255,0.4);">Cargando PayPal...</div>';
    try {
      const pp = await loadScript({ clientId: import.meta.env.PUBLIC_PAYPAL_CLIENT_ID || "AcBeVZggGRidpLZa0RrTje-kNfh0Q6vhNY1H4qTVjFxaEHrF-ltd1D3erIxPNbjVrtUXjHM-5qsa8-3y", currency: "MXN", intent: "capture", commit: true, vault: false, components: "buttons", disableFunding: "venmo,giropay,sofort,sepa", locale: "es_MX" });
      if (pp?.Buttons) renderPayPal(pp); else c.innerHTML = '<div style="color:#f87171;text-align:center;">PayPal no disponible</div>';
    } catch { c.innerHTML = '<div style="color:#f87171;text-align:center;">Error PayPal</div>'; }
  }

  function renderPayPal(pp: any) {
    pp.Buttons({
      style: { layout: 'vertical', color: 'gold', shape: 'rect', label: 'paypal' },
      createOrder: async () => { const d = validatePaypal(); if (!d) return Promise.reject('Val fail'); try { const r = await actions.createPaypalOrder({ total: d.total }); if (r.error) throw new Error(r.error.message); return r.data.orderId; } catch (e) { Swal.fire('Error', e instanceof Error ? e.message : 'Error', 'error'); return Promise.reject(e); } },
      onApprove: async (data: any) => { Swal.fire({ title: 'Procesando...', allowOutsideClick: false, didOpen: () => Swal.showLoading() }); try { const r = await actions.capturePaypalOrder({ orderId: data.orderID }); if (r.error) throw new Error(r.error.message); await updateStock(); const o = await createOrder('paypal'); CartCookiesClient.clearCart(); localStorage.removeItem('selectedShipping'); Swal.close(); navigate(`/order-success?order_id=${o.id}`); } catch (e) { Swal.close(); Swal.fire('Error', e instanceof Error ? e.message : 'Error', 'error'); } },
      onError: () => Swal.fire('Error', 'Error PayPal', 'error'), onCancel: () => {}
    }).render('#paypal-button-container');
  }

  function init() {
    if (!document.getElementById('products-data')) return;
    loadShippingInfo(); setupFormValidation();
    document.querySelectorAll('input[name="payment-method"]').forEach(r => r.addEventListener('change', updatePaymentVis));
    document.getElementById('submit-card-payment')?.addEventListener('click', e => { e.preventDefault(); processCard(); });
    updatePaymentVis();
  }

  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init); else init();
  document.addEventListener('astro:page-load', init);
  setTimeout(() => { const w = document.getElementById('shipping-warning'); if (w && !w.classList.contains('hidden')) loadShippingInfo(); }, 500);
</script>

<div id="products-data" class="hidden">{JSON.stringify(productsData.map(p => ({ id: p.id || "", name: p.name, price: p.price, quantity: p.quantity, image: p.image || '', variantCombination: p.variantCombination, variantSku: p.variantSku })))}</div>
<div id="products-images" class="hidden">{JSON.stringify(products.map(p => p.image || ''))}</div>
<div id="tax-data" class="hidden">{tax}</div>
<div id="total-data" class="hidden">{total}</div>
<div id="subtotal-data" class="hidden">{subtotal}</div>
<div id="user-data" class="hidden">{JSON.stringify({ email: userEmail, name: userName, isAuthenticated })}</div>
