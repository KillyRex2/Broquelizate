---
// src/components/TrustBar.astro
//
// Franja de confianza, justo debajo del hero. Responde las tres preguntas
// que frenan una compra en una tienda que el cliente no conoce: cuánto me
// cuesta el envío, qué pasa si la pieza sale mal, y si es seguro pagar
// aquí.
//
// Va entre el hero (oscuro) y los carruseles (claros), y por eso toma el
// mismo #fafafa con el que abre HomeCollections: así las dos se leen como
// una sola zona clara y no como dos franjas pegadas.

import { freeShippingLabel } from '@/utils/shipping';
import { warrantyLabel } from '@/utils/policies';

const items = [
  {
    title: 'Envío Gratis',
    // El monto sale del mismo sitio que lo cobra el carrito.
    detail: `En compras mayores a ${freeShippingLabel()}`,
    icon: 'envio',
  },
  {
    title: 'Garantía',
    detail: `${warrantyLabel()} contra defectos`,
    icon: 'garantia',
  },
  {
    title: 'Pago Seguro',
    detail: 'Tarjeta, PayPal y Mercado Pago',
    icon: 'pago',
  },
];
---

<section class="trust-bar" aria-label="Por qué comprar con nosotros">
  <div class="trust-inner">
    <ul class="trust-card">
      {items.map(({ title, detail, icon }) => (
        <li class="trust-item">
          <span class="trust-icon" aria-hidden="true">
            {icon === 'envio' && (
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
                   stroke-linecap="round" stroke-linejoin="round">
                <path d="M3 7h11v10H3z" />
                <path d="M14 10h4l3 3v4h-7z" />
                <circle cx="7" cy="18" r="1.8" />
                <circle cx="17" cy="18" r="1.8" />
              </svg>
            )}
            {icon === 'garantia' && (
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
                   stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 3l7 3v5c0 4.3-2.9 8.2-7 9.4C7.9 19.2 5 15.3 5 11V6z" />
                <path d="M9.2 11.8l2 2 3.6-3.8" />
              </svg>
            )}
            {icon === 'pago' && (
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
                   stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="5" width="18" height="14" rx="2.5" />
                <path d="M3 10h18" />
                <path d="M7 14.5h3" />
              </svg>
            )}
          </span>
          <span class="trust-text">
            <strong>{title}</strong>
            <small>{detail}</small>
          </span>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .trust-bar {
    background: #fafafa;
    /* Con el espacio de abajo en 0 se veía bien... mientras HomeCollections
       tuviera carruseles que pintar. Sin ellos la tarjeta quedaba pegada al
       bloque oscuro de Categorías. La franja se paga su propio aire. */
    padding: 40px 0;
  }

  .trust-inner {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .trust-card {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 8px;
    margin: 0;
    padding: 22px 16px;
    list-style: none;
    background: #fff;
    border: 1px solid rgba(0, 0, 0, 0.07);
    border-radius: 20px;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.05);
  }

  .trust-item {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 14px;
    padding: 6px 12px;
  }

  /* Separadores entre columnas, sin pintar uno suelto al final. */
  .trust-item + .trust-item {
    border-left: 1px solid rgba(0, 0, 0, 0.07);
  }

  .trust-icon {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 44px;
    height: 44px;
    border-radius: 12px;
    background: #fdf6dd;
    color: #b7791f;
  }

  .trust-icon svg {
    width: 22px;
    height: 22px;
  }

  .trust-text {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }

  .trust-text strong {
    font-size: 0.95rem;
    font-weight: 700;
    color: #1a1a1a;
    line-height: 1.25;
  }

  .trust-text small {
    font-size: 0.8rem;
    color: #6b6b6b;
    line-height: 1.35;
  }

  /* En tableta las tres caben, pero apretadas: se quitan los separadores
     y se deja que cada una respire. */
  @media (max-width: 900px) {
    .trust-item {
      gap: 10px;
      padding: 6px 4px;
    }

    .trust-text strong { font-size: 0.88rem; }
    .trust-text small  { font-size: 0.74rem; }
  }

  /* En celular, una debajo de otra con el ícono a la izquierda: tres
     columnas de 120px dejarían el texto ilegible. */
  @media (max-width: 640px) {
    .trust-bar {
      padding: 28px 0;
    }

    .trust-inner {
      padding: 0 16px;
    }

    .trust-card {
      grid-template-columns: 1fr;
      gap: 0;
      padding: 8px 14px;
    }

    .trust-item {
      justify-content: flex-start;
      gap: 14px;
      padding: 14px 2px;
    }

    .trust-item + .trust-item {
      border-left: 0;
      border-top: 1px solid rgba(0, 0, 0, 0.07);
    }
  }
</style>
