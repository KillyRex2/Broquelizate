---
// src/components/admin/SalesByPaymentMethod.astro
import { db, orders } from 'astro:db';
import { sql, gte } from 'drizzle-orm';

/*
  Server: obtenemos datos por día y por método de pago
  para los últimos 2 años (así el cliente puede filtrar 30/90/365 días).
*/
const now = new Date();
const twoYearsAgo = new Date(now.getFullYear() - 2, now.getMonth(), now.getDate());

type Row = {
  day: string; // 'YYYY-MM-DD'
  paymentMethod: string;
  totalSales: number;
  orderCount: number;
};

const paymentSeries: Row[] = await db.select({
  day: sql<string>`DATE(${orders.createdAt})`,
  paymentMethod: orders.paymentMethod,
  totalSales: sql<number>`SUM(${orders.total})`.mapWith(Number),
  orderCount: sql<number>`COUNT(*)`.mapWith(Number)
})
.from(orders)
.where(gte(orders.createdAt, twoYearsAgo))
.groupBy(sql`DATE(${orders.createdAt}), ${orders.paymentMethod}`)
.orderBy(sql`DATE(${orders.createdAt}) ASC`)
.all();

// Opcional: paleta de colores por método (si hay métodos nuevos, se rotan colores)
const colorPalette = [
  'rgb(212,175,55)', // dorado
  'rgb(59,130,246)', // azul
  'rgb(16,185,129)', // verde
  'rgb(139,92,246)', // violeta
  'rgb(245,158,11)', // naranja
  'rgb(236,72,153)'  // rosa
];

const serialized = {
  paymentSeries,
  colorPalette
};
---

<!-- UI: ahora apilamos los charts (uno debajo del otro) para una visualización más limpia y responsive -->
<div class="bg-white rounded-2xl shadow-lg p-6">
  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
    <div>
      <h3 class="text-xl font-semibold text-gray-800">Ventas por Método de Pago</h3>
      <p class="text-sm text-gray-500 mt-1">Selecciona un periodo para ver la distribución de ingresos y pedidos.</p>
    </div>

    <div class="flex items-center gap-4">
    
      <div class="flex gap-3 items-center">
        <div class="text-right">
          <div class="text-xs text-gray-500">Total (periodo)</div>
          <div id="kpi-total" class="text-lg font-bold text-gray-800">$0</div>
        </div>
        <div class="text-right">
          <div class="text-xs text-gray-500">Top método</div>
          <div id="kpi-top" class="text-lg font-semibold text-gray-800">—</div>
        </div>
        <div class="text-right">
          <div class="text-xs text-gray-500">Pedidos</div>
          <div id="kpi-orders" class="text-lg font-semibold text-gray-800">0</div>
        </div>
      </div>
    </div>
  </div>

  <!-- STACK: charts uno debajo del otro para que se vean mejor en la pantalla principal -->
  <div class="mt-5 flex flex-col gap-6">
    <div class="bg-white rounded-xl p-4 shadow-inner">
      <div class="text-sm text-gray-500 mb-3">Distribución de ingresos por método</div>
      <div class="relative h-[360px] md:h-[420px]">
        <canvas id="paymentMethodChart" class="w-full h-full"></canvas>
      </div>
    </div>

    <div class="bg-white rounded-xl p-4 shadow-inner">
      <div class="text-sm text-gray-500 mb-3">Pedidos por método</div>
      <div class="relative h-[220px] md:h-[300px]">
        <canvas id="paymentsBar" class="w-full h-full"></canvas>
      </div>

      <div class="mt-4 text-sm text-gray-600">
        <div>— Método con más ingresos: <span id="insight-top" class="font-medium">—</span></div>
        <div>— Total de métodos: <span id="insight-count" class="font-medium">0</span></div>
      </div>
    </div>
  </div>
</div>

<!-- Chart.js (UMD) -->
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.2/dist/chart.umd.min.js"></script>

<script define:vars={{ serialized }}>
  // Datos serializados desde server
  const { paymentSeries, colorPalette } = serialized;

  // Variables de estado
  let doughnutChart = null;
  let barChart = null;

  /* ---------------------------
     Utilidades
     --------------------------- */
  function isoToDate(s) { return new Date(s + 'T00:00:00'); }
  function formatMoney(v) {
    return new Intl.NumberFormat('es-MX', { style: 'currency', currency: 'MXN' }).format(v);
  }

  function dateInRange(dayStr, start, end) {
    const d = isoToDate(dayStr);
    // Normalizar tiempo para evitar problemas de huso horario
    d.setHours(0,0,0,0);
    start.setHours(0,0,0,0);
    end.setHours(23,59,59,999);
    return d >= start && d <= end;
  }

  function aggregateByPeriod(periodDays) {
    const end = new Date();
    const start = new Date();
    start.setDate(end.getDate() - (periodDays - 1));

    const revenueMap = new Map(); // method -> total revenue
    const countMap = new Map();   // method -> total orders
    let totalRevenue = 0;
    let totalOrders = 0;

    paymentSeries.forEach(row => {
      if (dateInRange(row.day, start, end)) {
        const method = row.paymentMethod || 'Otro';
        const rev = Number(row.totalSales || 0);
        const cnt = Number(row.orderCount || 0);
        revenueMap.set(method, (revenueMap.get(method) || 0) + rev);
        countMap.set(method, (countMap.get(method) || 0) + cnt);
        totalRevenue += rev;
        totalOrders += cnt;
      }
    });

    // Ordenar métodos por revenue desc
    const methods = Array.from(new Set([...revenueMap.keys(), ...countMap.keys()]));
    methods.sort((a, b) => (revenueMap.get(b) || 0) - (revenueMap.get(a) || 0));

    const labels = methods;
    const revenues = methods.map(m => revenueMap.get(m) || 0);
    const counts = methods.map(m => countMap.get(m) || 0);

    return {
      labels,
      revenues,
      counts,
      totalRevenue,
      totalOrders
    };
  }

  /* ---------------------------
     Chart builders
     --------------------------- */
  function buildDoughnut(ctx, labels, values, palette) {
    const bgColors = labels.map((_, i) => palette[i % palette.length]);
    const borderColors = bgColors.map(c => c);

    return new Chart(ctx, {
      type: 'doughnut',
      data: {
        labels,
        datasets: [{
          data: values,
          backgroundColor: bgColors,
          borderColor: borderColors,
          borderWidth: 1
        }]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        cutout: '58%',
        plugins: {
          legend: {
            position: 'bottom',
            labels: { usePointStyle: true, pointStyle: 'circle', padding: 8, boxWidth: 10, color: '#333' }
          },
          tooltip: {
            backgroundColor: '#111',
            titleColor: '#D4AF37',
            bodyColor: '#fff',
            borderColor: '#D4AF37',
            borderWidth: 1,
            callbacks: {
              label: (ctx) => {
                const label = ctx.label || '';
                const value = ctx.raw || 0;
                const total = ctx.dataset.data.reduce((a, b) => a + b, 0);
                const pct = total > 0 ? (value / total) * 100 : 0;
                return `${label}: ${formatMoney(value)} (${pct.toFixed(1)}%)`;
              }
            }
          }
        }
      }
    });
  }

  function buildBar(ctx, labels, counts, palette) {
    const bgColors = labels.map((_, i) => `${palette[i % palette.length]}`);

    return new Chart(ctx, {
      type: 'bar',
      data: {
        labels,
        datasets: [{
          label: 'Pedidos',
          data: counts,
          backgroundColor: bgColors,
          borderRadius: 6,
          barThickness: 18
        }]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        scales: {
          x: { ticks: { color: '#6b5e00' }, grid: { display: false } },
          y: { ticks: { color: '#6b5e00', beginAtZero: true, precision: 0 }, grid: { color: '#F3E9D2' } }
        },
        plugins: {
          legend: { display: false },
          tooltip: {
            callbacks: {
              label: ctx => `${ctx.dataset.label || ''}: ${ctx.raw || 0}`
            }
          }
        }
      }
    });
  }

  /* ---------------------------
     UI updates (KPIs + insights)
     --------------------------- */
  function updateKpisAndInsights(agg) {
    const elTotal = document.getElementById('kpi-total');
    const elTop = document.getElementById('kpi-top');
    const elOrders = document.getElementById('kpi-orders');
    const insightTop = document.getElementById('insight-top');
    const insightCount = document.getElementById('insight-count');

    if (elTotal) elTotal.textContent = formatMoney(agg.totalRevenue || 0);
    if (elOrders) elOrders.textContent = String(agg.totalOrders || 0);

    const topMethod = agg.labels && agg.labels.length ? agg.labels[0] : '—';
    if (elTop) elTop.textContent = topMethod;
    if (insightTop) insightTop.textContent = topMethod;
    if (insightCount) insightCount.textContent = String(agg.labels.length || 0);
  }

  /* ---------------------------
     Period handling & init
     --------------------------- */
  function renderForPeriod(periodDays) {
    const agg = aggregateByPeriod(periodDays);
    const labels = agg.labels;
    const revenues = agg.revenues;
    const counts = agg.counts;

    // Asignar colores
    const palette = colorPalette.map(c => c);

    // destruir charts previos
    if (doughnutChart) { try { doughnutChart.destroy(); } catch(e) {} doughnutChart = null; }
    if (barChart) { try { barChart.destroy(); } catch(e) {} barChart = null; }

    // crear nuevos
    const doughCtx = document.getElementById('paymentMethodChart').getContext('2d');
    doughnutChart = buildDoughnut(doughCtx, labels, revenues, palette);

    const barCtx = document.getElementById('paymentsBar').getContext('2d');
    barChart = buildBar(barCtx, labels, counts, palette);

    // KPIs y insights
    updateKpisAndInsights(agg);
  }

  // DOM ready (Astro page event)
  document.addEventListener('astro:page-load', () => {
    // botones periodo
    const filterContainer = document.getElementById('chart-filters');
    if (filterContainer) {
      const buttons = filterContainer.querySelectorAll('.period-btn');
      // default 365
      buttons.forEach(btn => {
        if (btn.dataset.period === '365') {
          btn.classList.add('bg-[#8B8000]', 'text-white');
          btn.classList.remove('bg-[#FAF3E0]');
        } else {
          btn.classList.remove('bg-[#8B8000]', 'text-white');
          btn.classList.add('bg-[#FAF3E0]');
        }
      });

      filterContainer.addEventListener('click', (e) => {
        const target = e.target.closest('button[data-period]');
        if (!target) return;
        const p = Number(target.dataset.period);
        filterContainer.querySelectorAll('.period-btn').forEach(b => {
          b.classList.remove('bg-[#8B8000]', 'text-white');
          b.classList.add('bg-[#FAF3E0]', 'text-[#8B8000]');
        });
        target.classList.add('bg-[#8B8000]', 'text-white');
        target.classList.remove('bg-[#FAF3E0]');

        // render new period
        renderForPeriod(p);
      });
    }

    // Init por defecto
    renderForPeriod(365);

    // Re-render on resize to adapt gradients/size if necessary (debounced)
    let resizeTimeout = null;
    window.addEventListener('resize', () => {
      clearTimeout(resizeTimeout);
      resizeTimeout = setTimeout(() => {
        const activeBtn = document.querySelector('#chart-filters .period-btn.bg-[#8B8000]') || document.querySelector('#chart-filters .period-btn[data-period="365"]');
        const period = activeBtn ? Number(activeBtn.dataset.period) : 365;
        renderForPeriod(period);
      }, 250);
    });
  });

  // limpieza al cambiar de página
  document.addEventListener('astro:before-swap', () => {
    if (doughnutChart) { try { doughnutChart.destroy(); } catch(e) {} doughnutChart = null; }
    if (barChart) { try { barChart.destroy(); } catch(e) {} barChart = null; }
  });
</script>
