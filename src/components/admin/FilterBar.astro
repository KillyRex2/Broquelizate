---
// Barra de filtros del inventario (admin)
// Rediseño: neutros cálidos + un solo acento dorado, sin emojis ni chips
// de colores. Categorías con selección múltiple (?category=A,B).

interface Props {
  categories: string[];
  initialSearch?: string;
  initialCategory?: string;
  initialStockFilter?: string;
  initialSortBy?: string;
  initialSortOrder?: string;
  initialMinPrice?: number;
  initialMaxPrice?: number;
  totalResults?: number;
}

const {
  categories,
  initialSearch = '',
  initialCategory = 'all',
  initialStockFilter = 'all',
  initialSortBy = 'name',
  initialSortOrder = 'asc',
  initialMinPrice = 0,
  initialMaxPrice = 99999,
  totalResults = 0,
} = Astro.props;

// Categorías múltiples: llegan en la URL separadas por coma
const selectedCategories =
  initialCategory && initialCategory !== 'all'
    ? initialCategory.split(',').map(c => c.trim()).filter(Boolean)
    : [];

// Stock múltiple: mismo formato (?stockFilter=out,low)
const selectedStock =
  initialStockFilter && initialStockFilter !== 'all'
    ? initialStockFilter.split(',').map(s => s.trim()).filter(Boolean)
    : [];

const hasPrice = initialMinPrice > 0 || initialMaxPrice < 99999;

let activeFiltersCount = 0;
if (selectedCategories.length > 0) activeFiltersCount += selectedCategories.length;
if (selectedStock.length > 0) activeFiltersCount += selectedStock.length;
if (hasPrice) activeFiltersCount++;

const stockOptions = [
  { value: 'all', label: 'Todos', hint: '', tone: 'neutral' },
  { value: 'out', label: 'Agotado', hint: '0', tone: 'red' },
  { value: 'low', label: 'Mínimo', hint: '1–5', tone: 'amber' },
  { value: 'available', label: 'Disponible', hint: '6–20', tone: 'green' },
  { value: 'high', label: 'Alto stock', hint: '+20', tone: 'blue' },
];

const money = (v: number) => `$${v.toLocaleString('es-MX')}`;
---

<div class="fb" data-astro-transition-persist="inventory-filters">
  <!-- Barra principal -->
  <div class="fb-bar">
    <!-- Búsqueda -->
    <div class="fb-search">
      <svg class="fb-search-icon" width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
      </svg>
      <input
        type="text"
        id="search-input"
        placeholder="Buscar por nombre o descripción"
        value={initialSearch}
        autocomplete="off"
        class="fb-search-input"
      />
      <button id="clear-search-btn" class:list={['fb-search-clear', { hidden: !initialSearch }]} aria-label="Limpiar búsqueda">
        <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M6 18L18 6M6 6l12 12"/>
        </svg>
      </button>
    </div>

    <!-- Filtros avanzados -->
    <button id="open-filters-btn" class:list={['fb-btn', { active: activeFiltersCount > 0 }]}>
      <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 6h18M6 12h12M10 18h4"/>
      </svg>
      <span>Filtros</span>
      {activeFiltersCount > 0 && <span class="fb-count">{activeFiltersCount}</span>}
    </button>

    <!-- Orden -->
    <div class="fb-select-wrap">
      <select id="sort-select" class="fb-select" aria-label="Ordenar">
        <option value="name-asc" selected={initialSortBy === 'name' && initialSortOrder === 'asc'}>Nombre A–Z</option>
        <option value="name-desc" selected={initialSortBy === 'name' && initialSortOrder === 'desc'}>Nombre Z–A</option>
        <option value="price-asc" selected={initialSortBy === 'price' && initialSortOrder === 'asc'}>Precio: menor a mayor</option>
        <option value="price-desc" selected={initialSortBy === 'price' && initialSortOrder === 'desc'}>Precio: mayor a menor</option>
        <option value="stock-asc" selected={initialSortBy === 'stock' && initialSortOrder === 'asc'}>Stock: menor a mayor</option>
        <option value="stock-desc" selected={initialSortBy === 'stock' && initialSortOrder === 'desc'}>Stock: mayor a menor</option>
      </select>
      <svg class="fb-select-chevron" width="14" height="14" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M19 9l-7 7-7-7"/>
      </svg>
    </div>

    <!-- Resultados -->
    <div class="fb-results">
      <span id="results-count" class="fb-results-num">{totalResults.toLocaleString('es-MX')}</span>
      <span class="fb-results-label">productos</span>
    </div>
  </div>

  <!-- Chips de filtros activos -->
  <div id="active-filters-chips" class:list={['fb-chips', { hidden: activeFiltersCount === 0 && !initialSearch }]}>
    {initialSearch && (
      <span class="fb-chip" data-filter="search">
        <span class="fb-chip-key">Búsqueda</span>
        <span class="fb-chip-val">“{initialSearch}”</span>
        <button class="remove-chip fb-chip-x" data-filter="search" aria-label="Quitar búsqueda">×</button>
      </span>
    )}

    {selectedCategories.map(cat => (
      <span class="fb-chip" data-filter="category">
        <span class="fb-chip-key">Categoría</span>
        <span class="fb-chip-val">{cat}</span>
        <button class="remove-chip fb-chip-x" data-filter="category" data-value={cat} aria-label={`Quitar ${cat}`}>×</button>
      </span>
    ))}

    {selectedStock.map(val => {
      const opt = stockOptions.find(s => s.value === val);
      return (
        <span class="fb-chip" data-filter="stock">
          <span class={`fb-dot tone-${opt?.tone ?? 'neutral'}`}></span>
          <span class="fb-chip-key">Stock</span>
          <span class="fb-chip-val">{opt?.label ?? val}</span>
          <button class="remove-chip fb-chip-x" data-filter="stock" data-value={val} aria-label={`Quitar ${opt?.label ?? val}`}>×</button>
        </span>
      );
    })}

    {hasPrice && (
      <span class="fb-chip" data-filter="price">
        <span class="fb-chip-key">Precio</span>
        <span class="fb-chip-val">
          {money(initialMinPrice)} – {initialMaxPrice >= 99999 ? 'sin límite' : money(initialMaxPrice)}
        </span>
        <button class="remove-chip fb-chip-x" data-filter="price" aria-label="Quitar filtro de precio">×</button>
      </span>
    )}

    {activeFiltersCount > 0 && (
      <button id="clear-all-filters" class="fb-clear-all">Limpiar todo</button>
    )}
  </div>
</div>

<!-- Panel lateral de filtros -->
<div id="filters-modal" class="fb-modal hidden">
  <div id="filters-backdrop" class="fb-backdrop"></div>

  <aside id="filters-panel" class="fb-panel translate-x-full" aria-label="Filtros avanzados">
    <header class="fb-panel-head">
      <div>
        <p class="fb-eyebrow">Inventario</p>
        <h2 class="fb-panel-title">Filtros</h2>
      </div>
      <button id="close-filters-btn" class="fb-icon-btn" aria-label="Cerrar">
        <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
        </svg>
      </button>
    </header>

    <div class="fb-panel-body">
      <!-- Stock -->
      <section class="fb-section">
        <div class="fb-section-head">
          <h3 class="fb-section-title">Stock</h3>
          <span class="fb-section-note">Puedes elegir varios</span>
        </div>
        <div class="fb-stock-list">
          {stockOptions.map(option => (
            <label class="fb-stock-opt">
              <input
                type="checkbox"
                name="stockFilter"
                value={option.value}
                checked={option.value === 'all' ? selectedStock.length === 0 : selectedStock.includes(option.value)}
                class="fb-check"
              />
              <span class={`fb-dot tone-${option.tone}`}></span>
              <span class="fb-stock-label">{option.label}</span>
              {option.hint && <span class="fb-stock-hint">{option.hint}</span>}
            </label>
          ))}
        </div>
      </section>

      <!-- Precio -->
      <section class="fb-section">
        <h3 class="fb-section-title">Rango de precio</h3>
        <div class="fb-price-row">
          <label class="fb-price-field">
            <span class="fb-price-label">Mínimo</span>
            <span class="fb-price-input-wrap">
              <span class="fb-price-sign">$</span>
              <input type="number" id="min-price-input" value={initialMinPrice} min="0" placeholder="0" class="fb-price-input" />
            </span>
          </label>
          <span class="fb-price-sep">—</span>
          <label class="fb-price-field">
            <span class="fb-price-label">Máximo</span>
            <span class="fb-price-input-wrap">
              <span class="fb-price-sign">$</span>
              <input type="number" id="max-price-input" value={initialMaxPrice === 99999 ? '' : initialMaxPrice} min="0" placeholder="Sin límite" class="fb-price-input" />
            </span>
          </label>
        </div>
        <div class="fb-quick">
          <button class="quick-price-btn fb-quick-btn" data-min="0" data-max="500">Hasta $500</button>
          <button class="quick-price-btn fb-quick-btn" data-min="500" data-max="1000">$500 – $1,000</button>
          <button class="quick-price-btn fb-quick-btn" data-min="1000" data-max="5000">$1,000 – $5,000</button>
          <button class="quick-price-btn fb-quick-btn" data-min="5000" data-max="99999">+$5,000</button>
        </div>
      </section>

      <!-- Categorías (selección múltiple) -->
      <section class="fb-section">
        <div class="fb-section-head">
          <h3 class="fb-section-title">Categorías</h3>
          <span class="fb-section-note">Puedes elegir varias</span>
        </div>
        <div class="fb-cat-grid">
          <label class="fb-cat-opt">
            <input type="checkbox" name="categoryFilter" value="all" checked={selectedCategories.length === 0} class="fb-check" />
            <span class="fb-cat-label">Todas</span>
          </label>
          {categories.map(cat => (
            <label class="fb-cat-opt">
              <input type="checkbox" name="categoryFilter" value={cat} checked={selectedCategories.includes(cat)} class="fb-check" />
              <span class="fb-cat-label">{cat}</span>
            </label>
          ))}
        </div>
      </section>
    </div>

    <footer class="fb-panel-foot">
      <button id="reset-filters-btn" class="fb-ghost">Restablecer</button>
      <button id="apply-filters-btn" class="fb-primary">Aplicar filtros</button>
    </footer>
  </aside>
</div>

<style>
  /* ── Tokens ── */
  .fb, .fb-modal {
    --ink: #1c1917;
    --ink-2: #57534e;
    --ink-3: #a8a29e;
    --line: #e7e5e4;
    --line-2: #d6d3d1;
    --soft: #fafaf9;
    --paper: #ffffff;
    --gold: #eab308;
    --gold-2: #f59e0b;
    --gold-deep: #a16207;
    --gold-wash: #fefce8;
    --radius: 14px;
    --shadow-sm: 0 1px 2px rgba(28, 25, 23, 0.05);
    --shadow: 0 1px 2px rgba(28, 25, 23, 0.04), 0 8px 24px -12px rgba(28, 25, 23, 0.16);
    --ring: 0 0 0 3px rgba(234, 179, 8, 0.22);
  }

  .hidden { display: none !important; }

  /* ── Barra principal ── */
  .fb-bar { display: flex; flex-wrap: wrap; align-items: stretch; gap: 10px; }

  .fb-search { position: relative; flex: 1 1 320px; min-width: 0; }
  .fb-search-icon { position: absolute; left: 14px; top: 50%; transform: translateY(-50%); color: var(--ink-3); pointer-events: none; }
  .fb-search-input {
    width: 100%; height: 46px; padding: 0 40px 0 42px;
    background: var(--paper); border: 1px solid var(--line); border-radius: var(--radius);
    color: var(--ink); font-size: 0.92rem; box-shadow: var(--shadow-sm);
    transition: border-color 0.2s, box-shadow 0.2s;
  }
  .fb-search-input::placeholder { color: var(--ink-3); }
  .fb-search-input:focus { outline: none; border-color: var(--gold); box-shadow: var(--ring); }
  .fb-search-clear {
    position: absolute; right: 8px; top: 50%; transform: translateY(-50%);
    width: 30px; height: 30px; display: flex; align-items: center; justify-content: center;
    background: var(--soft); border: none; border-radius: 50%; color: var(--ink-2); cursor: pointer;
    transition: background 0.2s, color 0.2s;
  }
  .fb-search-clear:hover { background: var(--line); color: var(--ink); }

  .fb-btn {
    position: relative; display: inline-flex; align-items: center; gap: 8px;
    height: 46px; padding: 0 18px;
    background: var(--paper); border: 1px solid var(--line); border-radius: var(--radius);
    color: var(--ink); font-size: 0.9rem; font-weight: 600; cursor: pointer; box-shadow: var(--shadow-sm);
    transition: border-color 0.2s, background 0.2s;
  }
  .fb-btn:hover { border-color: var(--line-2); background: var(--soft); }
  .fb-btn.active { border-color: rgba(234, 179, 8, 0.55); background: var(--gold-wash); }
  .fb-count {
    min-width: 20px; height: 20px; padding: 0 6px; display: inline-flex; align-items: center; justify-content: center;
    background: var(--ink); color: #fff; border-radius: 999px; font-size: 0.7rem; font-weight: 700;
  }

  .fb-select-wrap { position: relative; }
  .fb-select {
    height: 46px; padding: 0 38px 0 16px; appearance: none;
    background: var(--paper); border: 1px solid var(--line); border-radius: var(--radius);
    color: var(--ink); font-size: 0.88rem; font-weight: 500; cursor: pointer; box-shadow: var(--shadow-sm);
    transition: border-color 0.2s, box-shadow 0.2s;
  }
  .fb-select:focus { outline: none; border-color: var(--gold); box-shadow: var(--ring); }
  .fb-select-chevron { position: absolute; right: 14px; top: 50%; transform: translateY(-50%); color: var(--ink-3); pointer-events: none; }

  .fb-results { display: flex; align-items: baseline; gap: 6px; padding: 0 6px 0 10px; align-self: center; }
  .fb-results-num { font-size: 1.15rem; font-weight: 800; color: var(--ink); font-variant-numeric: tabular-nums; }
  .fb-results-label { font-size: 0.82rem; color: var(--ink-3); }

  /* ── Chips: un solo estilo, la jerarquía la da la tipografía ── */
  .fb-chips { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; margin-top: 12px; }
  .fb-chip {
    display: inline-flex; align-items: center; gap: 6px; height: 32px; padding: 0 6px 0 12px;
    background: var(--paper); border: 1px solid var(--line); border-radius: 999px; box-shadow: var(--shadow-sm);
    font-size: 0.8rem;
  }
  .fb-chip-key { color: var(--ink-3); font-weight: 500; }
  .fb-chip-val { color: var(--ink); font-weight: 600; max-width: 220px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .fb-chip-x {
    width: 22px; height: 22px; display: inline-flex; align-items: center; justify-content: center;
    background: transparent; border: none; border-radius: 50%; color: var(--ink-3); font-size: 1rem; line-height: 1; cursor: pointer;
    transition: background 0.2s, color 0.2s;
  }
  .fb-chip-x:hover { background: var(--soft); color: var(--ink); }
  .fb-clear-all {
    height: 32px; padding: 0 10px; background: none; border: none;
    color: var(--gold-deep); font-size: 0.8rem; font-weight: 600; cursor: pointer;
    text-decoration: underline; text-underline-offset: 3px;
  }
  .fb-clear-all:hover { color: var(--ink); }

  /* ── Panel lateral ── */
  .fb-modal { position: fixed; inset: 0; z-index: 50; }
  .fb-backdrop { position: absolute; inset: 0; background: rgba(28, 25, 23, 0.35); backdrop-filter: blur(3px); }
  .fb-panel {
    position: absolute; right: 0; top: 0; height: 100%; width: 100%; max-width: 440px;
    display: flex; flex-direction: column; background: var(--paper);
    box-shadow: -24px 0 60px -30px rgba(28, 25, 23, 0.45);
    transition: transform 0.3s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .translate-x-full { transform: translateX(100%); }

  .fb-panel-head {
    display: flex; align-items: flex-start; justify-content: space-between; gap: 12px;
    padding: 24px 24px 18px; border-bottom: 1px solid var(--line);
    background: linear-gradient(180deg, var(--gold-wash), var(--paper));
  }
  .fb-eyebrow { font-size: 0.68rem; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: var(--gold-deep); }
  .fb-panel-title { margin-top: 2px; font-size: 1.4rem; font-weight: 800; color: var(--ink); letter-spacing: -0.02em; }
  .fb-icon-btn {
    width: 36px; height: 36px; display: flex; align-items: center; justify-content: center;
    background: var(--paper); border: 1px solid var(--line); border-radius: 50%; color: var(--ink-2); cursor: pointer;
    transition: background 0.2s, color 0.2s;
  }
  .fb-icon-btn:hover { background: var(--soft); color: var(--ink); }

  .fb-panel-body { flex: 1; overflow-y: auto; padding: 8px 24px 24px; scrollbar-width: thin; scrollbar-color: var(--line-2) transparent; }
  .fb-section { padding: 20px 0; border-bottom: 1px solid var(--line); }
  .fb-section:last-child { border-bottom: none; }
  .fb-section-head { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; }
  .fb-section-title { margin-bottom: 12px; font-size: 0.72rem; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: var(--ink-2); }
  .fb-section-note { font-size: 0.74rem; color: var(--ink-3); }

  /* Stock */
  .fb-stock-list { display: flex; flex-direction: column; gap: 6px; }
  .fb-stock-opt {
    display: flex; align-items: center; gap: 12px; padding: 11px 14px;
    border: 1px solid var(--line); border-radius: 12px; cursor: pointer;
    transition: border-color 0.2s, background 0.2s;
  }
  .fb-stock-opt:hover { border-color: var(--line-2); background: var(--soft); }
  .fb-stock-opt:has(.fb-check:checked) { border-color: rgba(234, 179, 8, 0.6); background: var(--gold-wash); }
  .fb-stock-label { flex: 1; font-size: 0.88rem; font-weight: 600; color: var(--ink); }
  .fb-stock-hint { font-size: 0.74rem; color: var(--ink-3); font-variant-numeric: tabular-nums; }

  .fb-dot { width: 8px; height: 8px; border-radius: 50%; flex-shrink: 0; }
  .tone-neutral { background: var(--ink-3); }
  .tone-red { background: #dc2626; }
  .tone-amber { background: #f59e0b; }
  .tone-green { background: #16a34a; }
  .tone-blue { background: #2563eb; }

  /* Controles propios: el radio/checkbox nativo es lo que más delata "plantilla" */
  .fb-radio, .fb-check {
    appearance: none; flex-shrink: 0; width: 18px; height: 18px; margin: 0;
    border: 1.5px solid var(--line-2); background: var(--paper); cursor: pointer;
    display: grid; place-content: center; transition: border-color 0.2s, background 0.2s;
  }
  .fb-radio { border-radius: 50%; }
  .fb-check { border-radius: 5px; }
  .fb-radio::before { content: ''; width: 8px; height: 8px; border-radius: 50%; background: var(--ink); transform: scale(0); transition: transform 0.15s; }
  .fb-radio:checked { border-color: var(--ink); }
  .fb-radio:checked::before { transform: scale(1); }
  .fb-check::before {
    content: ''; width: 10px; height: 10px; transform: scale(0); transition: transform 0.15s;
    background: #fff; clip-path: polygon(14% 44%, 0 65%, 50% 100%, 100% 16%, 80% 0%, 43% 62%);
  }
  .fb-check:checked { background: var(--ink); border-color: var(--ink); }
  .fb-check:checked::before { transform: scale(1); }
  .fb-radio:focus-visible, .fb-check:focus-visible { outline: none; box-shadow: var(--ring); }

  /* Precio */
  .fb-price-row { display: flex; align-items: flex-end; gap: 10px; }
  .fb-price-field { flex: 1; display: flex; flex-direction: column; gap: 6px; }
  .fb-price-label { font-size: 0.74rem; color: var(--ink-3); }
  .fb-price-input-wrap { position: relative; }
  .fb-price-sign { position: absolute; left: 12px; top: 50%; transform: translateY(-50%); color: var(--ink-3); font-size: 0.88rem; }
  .fb-price-input {
    width: 100%; height: 42px; padding: 0 12px 0 26px;
    border: 1px solid var(--line); border-radius: 10px; background: var(--paper);
    color: var(--ink); font-size: 0.9rem; font-variant-numeric: tabular-nums;
    transition: border-color 0.2s, box-shadow 0.2s;
  }
  .fb-price-input:focus { outline: none; border-color: var(--gold); box-shadow: var(--ring); }
  .fb-price-sep { padding-bottom: 11px; color: var(--ink-3); }

  .fb-quick { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 12px; }
  .fb-quick-btn {
    height: 30px; padding: 0 12px; background: var(--paper); border: 1px solid var(--line); border-radius: 999px;
    color: var(--ink-2); font-size: 0.76rem; font-weight: 600; cursor: pointer;
    transition: border-color 0.2s, color 0.2s, background 0.2s;
  }
  .fb-quick-btn:hover { border-color: rgba(234, 179, 8, 0.6); color: var(--gold-deep); background: var(--gold-wash); }

  /* Categorías */
  .fb-cat-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 6px; max-height: 280px; overflow-y: auto; padding-right: 4px; scrollbar-width: thin; scrollbar-color: var(--line-2) transparent; }
  .fb-cat-opt {
    display: flex; align-items: center; gap: 10px; min-width: 0; padding: 10px 12px;
    border: 1px solid var(--line); border-radius: 10px; cursor: pointer;
    transition: border-color 0.2s, background 0.2s;
  }
  .fb-cat-opt:hover { border-color: var(--line-2); background: var(--soft); }
  .fb-cat-opt:has(.fb-check:checked) { border-color: rgba(234, 179, 8, 0.6); background: var(--gold-wash); }
  .fb-cat-label { font-size: 0.84rem; font-weight: 500; color: var(--ink); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

  /* Pie */
  .fb-panel-foot { display: flex; gap: 10px; padding: 16px 24px; border-top: 1px solid var(--line); background: var(--soft); }
  .fb-ghost {
    height: 46px; padding: 0 18px; background: var(--paper); border: 1px solid var(--line); border-radius: 12px;
    color: var(--ink-2); font-size: 0.88rem; font-weight: 600; cursor: pointer; transition: border-color 0.2s, color 0.2s;
  }
  .fb-ghost:hover { border-color: var(--line-2); color: var(--ink); }
  .fb-primary {
    flex: 1; height: 46px; background: var(--ink); border: none; border-radius: 12px;
    color: #fff; font-size: 0.9rem; font-weight: 700; cursor: pointer;
    box-shadow: 0 8px 20px -10px rgba(28, 25, 23, 0.6);
    transition: transform 0.15s, box-shadow 0.2s, background 0.2s;
  }
  .fb-primary:hover { background: #292524; box-shadow: 0 12px 24px -12px rgba(28, 25, 23, 0.7); }
  .fb-primary:active { transform: scale(0.98); }

  @media (prefers-reduced-motion: reduce) {
    .fb-panel { transition: none; }
  }

  @media (max-width: 640px) {
    .fb-search { flex-basis: 100%; }
    .fb-btn, .fb-select-wrap { flex: 1; }
    .fb-select { width: 100%; }
    .fb-results { display: none; }
    .fb-cat-grid { grid-template-columns: 1fr; }
    .fb-panel { max-width: 100%; }
  }
</style>

<script>
  function initFilterBar() {
    const searchInput = document.getElementById('search-input') as HTMLInputElement | null;
    const clearSearchBtn = document.getElementById('clear-search-btn');
    const openFiltersBtn = document.getElementById('open-filters-btn');
    const closeFiltersBtn = document.getElementById('close-filters-btn');
    const filtersModal = document.getElementById('filters-modal');
    const filtersBackdrop = document.getElementById('filters-backdrop');
    const filtersPanel = document.getElementById('filters-panel');
    const applyFiltersBtn = document.getElementById('apply-filters-btn');
    const resetFiltersBtn = document.getElementById('reset-filters-btn');
    const clearAllFilters = document.getElementById('clear-all-filters');
    const sortSelect = document.getElementById('sort-select') as HTMLSelectElement | null;
    const minPriceInput = document.getElementById('min-price-input') as HTMLInputElement | null;
    const maxPriceInput = document.getElementById('max-price-input') as HTMLInputElement | null;
    const activeFiltersChips = document.getElementById('active-filters-chips');

    let searchTimeout: ReturnType<typeof setTimeout>;

    // ── Navegación ──
    function buildUrl(params: Record<string, string>) {
      const url = new URL(window.location.href);
      url.searchParams.set('page', '1'); // reset a página 1 al filtrar

      Object.entries(params).forEach(([key, value]) => {
        if (value && value !== 'all' && value !== '0' && value !== '99999') {
          url.searchParams.set(key, value);
        } else {
          url.searchParams.delete(key);
        }
      });

      return url.toString();
    }

    function navigateWithFilters(params: Record<string, string>) {
      window.location.href = buildUrl(params);
    }

    function getCurrentParams(): Record<string, string> {
      const url = new URL(window.location.href);
      return {
        search: url.searchParams.get('search') || '',
        category: url.searchParams.get('category') || 'all',
        stockFilter: url.searchParams.get('stockFilter') || 'all',
        sortBy: url.searchParams.get('sortBy') || 'name',
        sortOrder: url.searchParams.get('sortOrder') || 'asc',
        minPrice: url.searchParams.get('minPrice') || '0',
        maxPrice: url.searchParams.get('maxPrice') || '99999',
      };
    }

    // ── Panel ──
    function openFiltersModal() {
      if (!filtersModal || !filtersPanel) return;
      filtersModal.classList.remove('hidden');
      document.body.style.overflow = 'hidden';
      requestAnimationFrame(() => filtersPanel.classList.remove('translate-x-full'));
    }

    function closeFiltersModal() {
      if (!filtersModal || !filtersPanel) return;
      filtersPanel.classList.add('translate-x-full');
      setTimeout(() => {
        filtersModal.classList.add('hidden');
        document.body.style.overflow = '';
      }, 300);
    }

    // ── Búsqueda con debounce ──
    searchInput?.addEventListener('input', e => {
      const value = (e.target as HTMLInputElement).value;
      clearSearchBtn?.classList.toggle('hidden', !value);

      clearTimeout(searchTimeout);
      searchTimeout = setTimeout(() => {
        const params = getCurrentParams();
        params.search = value;
        navigateWithFilters(params);
      }, 500);
    });

    clearSearchBtn?.addEventListener('click', () => {
      if (searchInput) searchInput.value = '';
      clearSearchBtn.classList.add('hidden');
      const params = getCurrentParams();
      params.search = '';
      navigateWithFilters(params);
    });

    openFiltersBtn?.addEventListener('click', openFiltersModal);
    closeFiltersBtn?.addEventListener('click', closeFiltersModal);
    filtersBackdrop?.addEventListener('click', closeFiltersModal);

    // ── Orden ──
    sortSelect?.addEventListener('change', () => {
      const [sortBy, sortOrder] = sortSelect.value.split('-');
      const params = getCurrentParams();
      params.sortBy = sortBy;
      params.sortOrder = sortOrder;
      navigateWithFilters(params);
    });

    // ── Aplicar ──
    applyFiltersBtn?.addEventListener('click', () => {
      const params = getCurrentParams();

      // Stock (selección múltiple)
      const checkedStock = Array.from(
        document.querySelectorAll<HTMLInputElement>('input[name="stockFilter"]:checked')
      )
        .map(el => el.value)
        .filter(v => v && v !== 'all');
      params.stockFilter = checkedStock.length > 0 ? checkedStock.join(',') : 'all';

      // Categorías (selección múltiple)
      const checkedCats = Array.from(
        document.querySelectorAll<HTMLInputElement>('input[name="categoryFilter"]:checked')
      )
        .map(el => el.value)
        .filter(v => v && v !== 'all');
      params.category = checkedCats.length > 0 ? checkedCats.join(',') : 'all';

      params.minPrice = minPriceInput?.value || '0';
      params.maxPrice = maxPriceInput?.value || '99999';

      navigateWithFilters(params);
    });

    // ── Restablecer ──
    resetFiltersBtn?.addEventListener('click', () => {
      navigateWithFilters({
        search: '',
        category: 'all',
        stockFilter: 'all',
        sortBy: 'name',
        sortOrder: 'asc',
        minPrice: '0',
        maxPrice: '99999',
      });
    });

    clearAllFilters?.addEventListener('click', () => {
      const params = getCurrentParams();
      params.search = searchInput?.value || '';
      params.category = 'all';
      params.stockFilter = 'all';
      params.minPrice = '0';
      params.maxPrice = '99999';
      navigateWithFilters(params);
    });

    // ── Quitar un chip ──
    activeFiltersChips?.addEventListener('click', e => {
      const btn = (e.target as HTMLElement).closest('.remove-chip') as HTMLButtonElement | null;
      if (!btn) return;

      const params = getCurrentParams();

      switch (btn.dataset.filter) {
        case 'search':
          params.search = '';
          if (searchInput) searchInput.value = '';
          break;
        case 'category': {
          // Quita solo esa categoría, conserva las demás
          const remaining = (params.category === 'all' ? [] : params.category.split(','))
            .filter(c => c !== btn.dataset.value);
          params.category = remaining.length > 0 ? remaining.join(',') : 'all';
          break;
        }
        case 'stock': {
          const remaining = (params.stockFilter === 'all' ? [] : params.stockFilter.split(','))
            .filter(s => s !== btn.dataset.value);
          params.stockFilter = remaining.length > 0 ? remaining.join(',') : 'all';
          break;
        }
        case 'price':
          params.minPrice = '0';
          params.maxPrice = '99999';
          break;
      }

      navigateWithFilters(params);
    });

    // ── Precios rápidos ──
    document.querySelectorAll<HTMLButtonElement>('.quick-price-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const min = btn.dataset.min || '0';
        const max = btn.dataset.max || '99999';
        if (minPriceInput) minPriceInput.value = min;
        if (maxPriceInput) maxPriceInput.value = max === '99999' ? '' : max;
      });
    });

    // ── "Todos/Todas" se excluye con el resto de opciones del grupo ──
    // Marcar una opción desmarca "Todos"; marcar "Todos" limpia las demás;
    // si se desmarca todo, "Todos" vuelve a quedar marcado.
    function bindExclusiveAll(groupName: string) {
      const boxes = document.querySelectorAll<HTMLInputElement>(`input[name="${groupName}"]`);
      const allBox = document.querySelector<HTMLInputElement>(`input[name="${groupName}"][value="all"]`);

      boxes.forEach(box => {
        box.addEventListener('change', () => {
          if (box.value === 'all') {
            if (box.checked) boxes.forEach(b => { if (b !== box) b.checked = false; });
          } else if (box.checked && allBox) {
            allBox.checked = false;
          }
          const anyChecked = Array.from(boxes).some(b => b.value !== 'all' && b.checked);
          if (!anyChecked && allBox) allBox.checked = true;
        });
      });
    }

    bindExclusiveAll('categoryFilter');
    bindExclusiveAll('stockFilter');

    // ── Escape ──
    document.addEventListener('keydown', e => {
      if (e.key === 'Escape' && !filtersModal?.classList.contains('hidden')) closeFiltersModal();
    });

    // ── Sincronizar orden con la URL ──
    if (sortSelect) {
      const params = getCurrentParams();
      sortSelect.value = `${params.sortBy}-${params.sortOrder}`;
    }
  }

  // astro:page-load también se dispara en la carga inicial:
  // llamar initFilterBar() aparte duplicaría todos los listeners.
  document.addEventListener('astro:page-load', initFilterBar);
</script>