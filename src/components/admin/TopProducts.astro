---
// src/components/admin/TopProducts.astro
import { db, order_items, Product, orders, ProductImage } from 'astro:db';
import { sql, eq, desc } from 'drizzle-orm';

const topProductsData = await db.select({
  id: Product.id,
  name: Product.name,
  category: Product.category,
  price: Product.price,
  total_sold: sql<number>`SUM(${order_items.quantity})`.mapWith(Number).as('total_sold')
})
.from(order_items)
.innerJoin(Product, eq(order_items.productId, Product.id))
.innerJoin(orders, eq(order_items.orderId, orders.id))
.groupBy(Product.id, Product.name, Product.category, Product.price)
.orderBy(desc(sql`total_sold`))
.limit(5);

const productIds = topProductsData.map(p => p.id);
const productImages = productIds.length > 0
  ? await db.select().from(ProductImage).where(sql`${ProductImage.productId} IN ${productIds}`)
  : [];

const imageMap = new Map();
productImages.forEach(img => { if (!imageMap.has(img.productId)) imageMap.set(img.productId, img.image); });

const topProducts = topProductsData.map(product => ({
  ...product,
  image: imageMap.get(product.id) || null
}));

const formatCurrency = (v: number) => new Intl.NumberFormat('es-MX', { style: 'currency', currency: 'MXN' }).format(v);
---

<div class="tp-list">
  {topProducts.length > 0 ? (
    topProducts.map((product, i) => (
      <div class="tp-item">
        <span class="tp-rank">{i + 1}</span>
        {product.image ? (
          <img src={product.image} alt={product.name} class="tp-img" loading="lazy" />
        ) : (
          <div class="tp-img-placeholder">
            <svg class="w-5 h-5 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
            </svg>
          </div>
        )}
        <div class="tp-info">
          <span class="tp-name">{product.name}</span>
          <span class="tp-category">{product.category || 'Sin categoría'}</span>
        </div>
        <div class="tp-stats">
          <span class="tp-price">{formatCurrency(product.price)}</span>
          <span class="tp-sold">{product.total_sold} ventas</span>
        </div>
      </div>
    ))
  ) : (
    <div class="tp-empty">
      <p>No hay productos vendidos aún</p>
      <p class="text-xs mt-1">Los más vendidos aparecerán aquí</p>
    </div>
  )}
</div>

<style>
  .tp-list { display: flex; flex-direction: column; gap: 10px; }
  .tp-item {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px 12px;
    background: rgba(255,255,255,0.02);
    border: 1px solid rgba(255,255,255,0.04);
    border-radius: 12px;
    transition: all 0.2s ease;
  }
  .tp-item:hover {
    background: rgba(255,255,255,0.04);
    border-color: rgba(234,179,8,0.15);
  }
  .tp-rank {
    width: 24px;
    height: 24px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.75rem;
    font-weight: 800;
    color: rgba(234,179,8,0.7);
    background: rgba(234,179,8,0.08);
    border-radius: 8px;
    flex-shrink: 0;
  }
  .tp-img {
    width: 44px;
    height: 44px;
    object-fit: cover;
    border-radius: 10px;
    border: 1px solid rgba(255,255,255,0.08);
    flex-shrink: 0;
  }
  .tp-img-placeholder {
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(255,255,255,0.03);
    border: 1px dashed rgba(255,255,255,0.1);
    border-radius: 10px;
    flex-shrink: 0;
  }
  .tp-info {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .tp-name {
    font-size: 0.85rem;
    font-weight: 600;
    color: #fff;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .tp-category {
    font-size: 0.7rem;
    color: rgba(255,255,255,0.35);
  }
  .tp-stats {
    text-align: right;
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .tp-price {
    font-size: 0.85rem;
    font-weight: 700;
    color: #eab308;
  }
  .tp-sold {
    font-size: 0.7rem;
    color: rgba(34,197,94,0.8);
    font-weight: 600;
  }
  .tp-empty {
    text-align: center;
    padding: 24px;
    color: rgba(255,255,255,0.35);
    font-size: 0.85rem;
  }
</style>