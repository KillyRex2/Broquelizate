---
// src/components/products/ProductSlideshow.astro
interface Props {
    images: string[];
    sliderId?: string;
}

const { images, sliderId = 'main-slider' } = Astro.props;

const fullImages = images.map(image => {
    return image.startsWith('http')
        ? image
        : `/images/products/${image}`;
});
---

<div class="product-slider" data-slider-id={sliderId} data-images={JSON.stringify(fullImages)}>
    <div class="slider-container">
        <div class="slider-wrapper">
            {fullImages.map((image, index) => (
                <div class={`slide ${index === 0 ? 'active' : ''}`} data-index={index}>
                    <img
                        src={image}
                        alt={`Producto ${index + 1}`}
                        loading={index === 0 ? "eager" : "lazy"}
                        class="slide-image"
                    />
                </div>
            ))}
        </div>
        
        <!-- Flechas de navegación -->
        {fullImages.length > 1 && (
            <button class="nav-arrow nav-prev" data-nav="prev" aria-label="Anterior">
                <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
                </svg>
            </button>
            <button class="nav-arrow nav-next" data-nav="next" aria-label="Siguiente">
                <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                </svg>
            </button>
        )}

        <!-- Indicadores -->
        <div class="indicators">
            {fullImages.map((_, index) => (
                <button 
                    class={`indicator ${index === 0 ? 'active' : ''}`} 
                    data-index={index}
                    aria-label={`Ir a imagen ${index + 1}`}
                >
                    <span class="indicator-fill"></span>
                </button>
            ))}
        </div>
        
        <!-- Contador -->
        <div class="counter">
            <span class="current">1</span> / <span class="total">{fullImages.length}</span>
        </div>
    </div>
</div>

<style>
    .product-slider {
        width: 100%;
        max-width: 100%;
        margin: 0 auto;
    }
    
    .slider-container {
        position: relative;
        width: 100%;
        height: 450px;
        background: #1a1a1a;
        border-radius: 16px;
        overflow: hidden;
    }
    
    .slider-wrapper {
        position: relative;
        width: 100%;
        height: 100%;
    }
    
    /* ========================================
       CROSSFADE + SUTIL KEN BURNS
       ======================================== */
    .slide {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        display: flex;
        justify-content: center;
        align-items: center;
        opacity: 0;
        visibility: hidden;
        transition: opacity 0.6s cubic-bezier(0.4, 0, 0.2, 1), 
                    visibility 0.6s cubic-bezier(0.4, 0, 0.2, 1);
        z-index: 1;
        background: transparent;
    }
    
    .slide.active {
        opacity: 1;
        visibility: visible;
        z-index: 2;
    }
    
    .slide img {
        max-width: 90%;
        max-height: 90%;
        width: auto;
        height: auto;
        object-fit: contain;
        display: block;
        border: 1.5px solid rgba(234, 179, 8, 0.15);
        border-radius: 12px;
        padding: 8px;
        background: rgba(30, 30, 30, 0.5);
        box-shadow: 0 4px 24px rgba(0, 0, 0, 0.3),
                    0 0 0 1px rgba(255, 255, 255, 0.03);
        transform: scale(1);
        transition: transform 8s cubic-bezier(0.25, 0.1, 0.25, 1),
                    border-color 0.4s ease,
                    box-shadow 0.4s ease;
    }

    /* Ken Burns sutil — zoom lento mientras el slide está activo */
    .slide.active img {
        transform: scale(1.03);
    }
    
    .slide img:hover {
        border-color: rgba(234, 179, 8, 0.35);
        box-shadow: 0 8px 32px rgba(0, 0, 0, 0.4),
                    0 0 0 1px rgba(234, 179, 8, 0.1);
    }

    /* ========================================
       FLECHAS DE NAVEGACIÓN
       ======================================== */
    .nav-arrow {
        position: absolute;
        top: 50%;
        transform: translateY(-50%);
        z-index: 10;
        width: 40px;
        height: 40px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: rgba(0, 0, 0, 0.5);
        backdrop-filter: blur(8px);
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 50%;
        color: rgba(255, 255, 255, 0.7);
        cursor: pointer;
        opacity: 0;
        transition: opacity 0.3s ease, 
                    background 0.3s ease, 
                    color 0.3s ease,
                    transform 0.3s ease;
    }

    .slider-container:hover .nav-arrow {
        opacity: 1;
    }

    .nav-arrow:hover {
        background: rgba(234, 179, 8, 0.2);
        border-color: rgba(234, 179, 8, 0.3);
        color: #eab308;
    }

    .nav-arrow:active {
        transform: translateY(-50%) scale(0.92);
    }

    .nav-prev { left: 14px; }
    .nav-next { right: 14px; }
    
    /* ========================================
       INDICADORES CON ANIMACIÓN DE PROGRESO
       ======================================== */
    .indicators {
        position: absolute;
        bottom: 20px;
        left: 50%;
        transform: translateX(-50%);
        display: flex;
        gap: 6px;
        background: rgba(0, 0, 0, 0.6);
        backdrop-filter: blur(12px);
        padding: 8px 14px;
        border-radius: 20px;
        border: 1px solid rgba(255, 255, 255, 0.06);
    }
    
    .indicator {
        position: relative;
        width: 8px;
        height: 8px;
        background: rgba(255, 255, 255, 0.2);
        border: none;
        border-radius: 10px;
        cursor: pointer;
        transition: width 0.4s cubic-bezier(0.4, 0, 0.2, 1),
                    background 0.4s ease;
        overflow: hidden;
        padding: 0;
    }
    
    .indicator.active {
        width: 28px;
        background: rgba(234, 179, 8, 0.25);
    }

    .indicator-fill {
        position: absolute;
        top: 0;
        left: 0;
        height: 100%;
        width: 0%;
        background: #eab308;
        border-radius: 10px;
        transition: width 0.3s ease;
    }

    .indicator.active .indicator-fill {
        width: 100%;
        transition: width 0.5s cubic-bezier(0.4, 0, 0.2, 1);
    }
    
    .indicator:hover:not(.active) {
        background: rgba(255, 255, 255, 0.35);
        width: 12px;
    }
    
    /* Contador */
    .counter {
        position: absolute;
        top: 16px;
        right: 16px;
        background: rgba(0, 0, 0, 0.5);
        backdrop-filter: blur(12px);
        color: rgba(255, 255, 255, 0.7);
        padding: 6px 14px;
        border-radius: 20px;
        font-size: 13px;
        font-weight: 500;
        border: 1px solid rgba(255, 255, 255, 0.06);
        letter-spacing: 0.5px;
        opacity: 0;
        transition: opacity 0.3s ease;
    }

    .slider-container:hover .counter {
        opacity: 1;
    }
    
    .counter .current {
        color: #eab308;
        font-weight: 700;
    }
    
    /* ========================================
       RESPONSIVE
       ======================================== */
    @media (max-width: 768px) {
        .slider-container {
            height: 350px;
        }
        
        .nav-arrow {
            opacity: 1;
            width: 36px;
            height: 36px;
        }

        .nav-prev { left: 10px; }
        .nav-next { right: 10px; }
        
        .indicators {
            bottom: 14px;
            padding: 6px 12px;
        }
        
        .counter {
            opacity: 1;
            top: 12px;
            right: 12px;
            font-size: 12px;
            padding: 4px 10px;
        }
    }
    
    @media (max-width: 480px) {
        .slider-container {
            height: 300px;
            border-radius: 12px;
        }

        .nav-arrow {
            width: 32px;
            height: 32px;
        }

        .nav-arrow svg {
            width: 16px;
            height: 16px;
        }
    }
</style>

<script>
    const slidersInitialized = new Set<string>();

    function updateSliderImages(sliderId: string, newImages: string[]): void {
        const slider = document.querySelector(`[data-slider-id="${sliderId}"]`);
        if (!slider) return;

        const wrapper = slider.querySelector('.slider-wrapper');
        const indicators = slider.querySelector('.indicators');
        const totalSpan = slider.querySelector('.counter .total');
        const currentSpan = slider.querySelector('.counter .current');
        
        if (!wrapper || !indicators) return;

        // Obtener el slide activo actual para hacer crossfade
        const currentActive = wrapper.querySelector('.slide.active') as HTMLElement;

        // Si hay un slide activo, hacer crossfade
        if (currentActive) {
            // Crear el nuevo slide encima con opacity 0
            const newSlide = document.createElement('div');
            newSlide.className = 'slide';
            newSlide.dataset.index = '0';
            newSlide.style.opacity = '0';
            newSlide.style.visibility = 'visible';
            newSlide.style.zIndex = '3';
            newSlide.innerHTML = `<img src="${newImages[0]}" alt="Producto 1" loading="eager" class="slide-image" />`;
            wrapper.appendChild(newSlide);

            // Forzar reflow para que la transición funcione
            newSlide.offsetHeight;

            // Fade out del viejo, fade in del nuevo
            currentActive.style.transition = 'opacity 0.5s cubic-bezier(0.4, 0, 0.2, 1)';
            currentActive.style.opacity = '0';
            newSlide.style.transition = 'opacity 0.5s cubic-bezier(0.4, 0, 0.2, 1)';
            newSlide.style.opacity = '1';

            // Después de la transición, limpiar y reconstruir
            setTimeout(() => {
                wrapper.innerHTML = '';
                indicators.innerHTML = '';

                newImages.forEach((image, index) => {
                    const slide = document.createElement('div');
                    slide.className = `slide ${index === 0 ? 'active' : ''}`;
                    slide.dataset.index = index.toString();
                    slide.innerHTML = `<img src="${image}" alt="Producto ${index + 1}" loading="${index === 0 ? 'eager' : 'lazy'}" class="slide-image" />`;
                    wrapper.appendChild(slide);

                    const indicator = document.createElement('button');
                    indicator.className = `indicator ${index === 0 ? 'active' : ''}`;
                    indicator.dataset.index = index.toString();
                    indicator.setAttribute('aria-label', `Ir a imagen ${index + 1}`);
                    indicator.innerHTML = '<span class="indicator-fill"></span>';
                    indicator.addEventListener('click', () => showSlide(sliderId, index));
                    indicators.appendChild(indicator);
                });

                if (totalSpan) totalSpan.textContent = newImages.length.toString();
                if (currentSpan) currentSpan.textContent = '1';
                slider.setAttribute('data-images', JSON.stringify(newImages));
            }, 520);

        } else {
            // No hay slide activo, insertar directo (primera carga)
            wrapper.innerHTML = '';
            indicators.innerHTML = '';

            newImages.forEach((image, index) => {
                const slide = document.createElement('div');
                slide.className = `slide ${index === 0 ? 'active' : ''}`;
                slide.dataset.index = index.toString();
                slide.innerHTML = `<img src="${image}" alt="Producto ${index + 1}" loading="${index === 0 ? 'eager' : 'lazy'}" class="slide-image" />`;
                wrapper.appendChild(slide);

                const indicator = document.createElement('button');
                indicator.className = `indicator ${index === 0 ? 'active' : ''}`;
                indicator.dataset.index = index.toString();
                indicator.setAttribute('aria-label', `Ir a imagen ${index + 1}`);
                indicator.innerHTML = '<span class="indicator-fill"></span>';
                indicator.addEventListener('click', () => showSlide(sliderId, index));
                indicators.appendChild(indicator);
            });

            if (totalSpan) totalSpan.textContent = newImages.length.toString();
            if (currentSpan) currentSpan.textContent = '1';
            slider.setAttribute('data-images', JSON.stringify(newImages));
        }
    }

    function showSlide(sliderId: string, index: number): void {
        const slider = document.querySelector(`[data-slider-id="${sliderId}"]`);
        if (!slider) return;

        const slides = slider.querySelectorAll('.slide');
        const indicators = slider.querySelectorAll('.indicator');
        const currentSpan = slider.querySelector('.counter .current');

        slides.forEach((slide) => {
            slide.classList.remove('active');
        });

        indicators.forEach(ind => ind.classList.remove('active'));

        if (slides[index]) {
            slides[index].classList.add('active');
        }
        if (indicators[index]) {
            indicators[index].classList.add('active');
        }

        if (currentSpan) {
            currentSpan.textContent = (index + 1).toString();
        }
    }

    function getActiveIndex(slider: Element): number {
        const slides = slider.querySelectorAll('.slide');
        return Array.from(slides).findIndex(s => s.classList.contains('active'));
    }

    function getTotalSlides(slider: Element): number {
        return slider.querySelectorAll('.slide').length;
    }

    function initializeSliders(): void {
        const sliders = document.querySelectorAll('.product-slider');
        
        sliders.forEach(slider => {
            const sliderId = slider.getAttribute('data-slider-id') || 'main-slider';
            
            if (slidersInitialized.has(sliderId)) return;
            slidersInitialized.add(sliderId);
            
            // Indicadores
            slider.querySelectorAll('.indicator').forEach((indicator, index: number) => {
                indicator.addEventListener('click', () => showSlide(sliderId, index));
            });

            // Flechas
            const prevBtn = slider.querySelector('.nav-prev');
            const nextBtn = slider.querySelector('.nav-next');

            prevBtn?.addEventListener('click', () => {
                const current = getActiveIndex(slider);
                const total = getTotalSlides(slider);
                showSlide(sliderId, (current - 1 + total) % total);
            });

            nextBtn?.addEventListener('click', () => {
                const current = getActiveIndex(slider);
                const total = getTotalSlides(slider);
                showSlide(sliderId, (current + 1) % total);
            });
            
            // Touch/Swipe
            let touchStartX = 0;
            let touchStartY = 0;
            let isSwiping = false;
            
            slider.addEventListener('touchstart', (e) => {
                const t = e as TouchEvent;
                touchStartX = t.changedTouches[0].screenX;
                touchStartY = t.changedTouches[0].screenY;
                isSwiping = true;
            }, { passive: true });
            
            slider.addEventListener('touchend', (e) => {
                if (!isSwiping) return;
                isSwiping = false;

                const t = e as TouchEvent;
                const deltaX = t.changedTouches[0].screenX - touchStartX;
                const deltaY = t.changedTouches[0].screenY - touchStartY;
                
                // Solo swipe horizontal (no vertical scroll)
                if (Math.abs(deltaX) < 50 || Math.abs(deltaY) > Math.abs(deltaX)) return;

                const current = getActiveIndex(slider);
                const total = getTotalSlides(slider);
                
                if (deltaX < 0) {
                    showSlide(sliderId, (current + 1) % total);
                } else {
                    showSlide(sliderId, (current - 1 + total) % total);
                }
            }, { passive: true });
        });
    }

    function cleanupSliders(): void {
        slidersInitialized.clear();
    }

    (window as any).updateSliderImages = updateSliderImages;
    (window as any).showSlide = showSlide;

    document.addEventListener('astro:page-load', () => {
        cleanupSliders();
        initializeSliders();
    });

    document.addEventListener('astro:before-preparation', cleanupSliders);

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initializeSliders, { once: true });
    } else {
        initializeSliders();
    }
</script>