---
// src/components/products/ProductSlideshow.astro
interface Props {
    images: string[];
    sliderId?: string;
}

const { images, sliderId = 'main-slider' } = Astro.props;

const fullImages = images.map(image => {
    return image.startsWith('http')
        ? image
        : `/images/products/${image}`;
});
---

<!-- Contenedor principal del slider -->
<div class="product-slider" data-slider-id={sliderId} data-images={JSON.stringify(fullImages)}>
    <div class="slider-container">
        <!-- Imágenes -->
        <div class="slider-wrapper">
            {fullImages.map((image, index) => (
                <div class={`slide ${index === 0 ? 'active' : ''}`} data-index={index}>
                    <img
                        src={image}
                        alt={`Producto ${index + 1}`}
                        loading={index === 0 ? "eager" : "lazy"}
                        class="slide-image"
                    />
                </div>
            ))}
        </div>
        
        <!-- Indicadores -->
        <div class="indicators">
            {fullImages.map((_, index) => (
                <button 
                    class={`indicator ${index === 0 ? 'active' : ''}`} 
                    data-index={index}
                    aria-label={`Ir a imagen ${index + 1}`}
                ></button>
            ))}
        </div>
        
        <!-- Contador -->
        <div class="counter">
            <span class="current">1</span> / <span class="total">{fullImages.length}</span>
        </div>
    </div>
</div>

<style>
    .product-slider {
        width: 100%;
        max-width: 100%;
        margin: 0 auto;
    }
    
    .slider-container {
        position: relative;
        width: 100%;
        height: 450px;
        background: #1E1E1E;
        border-radius: 16px;
        overflow: hidden;
    }
    
    .slider-wrapper {
        position: relative;
        width: 100%;
        height: 100%;
    }
    
    .slide {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        display: flex;
        justify-content: center;
        align-items: center;
        opacity: 0;
        transform: translateX(100%);
        transition: all 0.5s ease-in-out;
        background: transparent;
    }
    
    .slide.active {
        opacity: 1;
        transform: translateX(0);
    }
    
    .slide.prev {
        transform: translateX(-100%);
    }
    
    .slide img {
        max-width: 90%;
        max-height: 90%;
        width: auto;
        height: auto;
        object-fit: contain;
        display: block;
        border: 2px solid rgba(234, 179, 8, 0.2);
        border-radius: 12px;
        padding: 8px;
        background: rgba(30, 30, 30, 0.5);
        box-shadow: 0 4px 20px rgba(234, 179, 8, 0.1);
        transition: all 0.3s ease;
    }
    
    .slide img:hover {
        border-color: rgba(234, 179, 8, 0.4);
        box-shadow: 0 6px 30px rgba(234, 179, 8, 0.15);
    }
    
    /* Indicadores */
    .indicators {
        position: absolute;
        bottom: 20px;
        left: 50%;
        transform: translateX(-50%);
        display: flex;
        gap: 8px;
        background: rgba(0, 0, 0, 0.8);
        padding: 8px 16px;
        border-radius: 20px;
        backdrop-filter: blur(10px);
    }
    
    .indicator {
        width: 8px;
        height: 8px;
        background: rgba(255, 255, 255, 0.3);
        border: none;
        border-radius: 50%;
        cursor: pointer;
        transition: all 0.3s ease;
    }
    
    .indicator.active {
        width: 24px;
        background: #eab308;
        border-radius: 10px;
    }
    
    .indicator:hover:not(.active) {
        background: rgba(255, 255, 255, 0.5);
    }
    
    /* Contador */
    .counter {
        position: absolute;
        top: 20px;
        right: 20px;
        background: #1E1E1E;
        backdrop-filter: blur(10px);
        color: white;
        padding: 6px 14px;
        border-radius: 20px;
        font-size: 14px;
        font-weight: 500;
        border: 1px solid rgba(234, 179, 8, 0.2);
    }
    
    .counter .current {
        color: #eab308;
        font-weight: 600;
    }
    
    /* Responsive */
    @media (max-width: 768px) {
        .slider-container {
            height: 350px;
        }
        
        .indicators {
            bottom: 15px;
            padding: 6px 12px;
        }
        
        .counter {
            top: 15px;
            right: 15px;
            font-size: 12px;
            padding: 4px 10px;
        }
    }
    
    @media (max-width: 480px) {
        .slider-container {
            height: 300px;
            border-radius: 12px;
        }
    }
</style>

<script>
    // =====================================================
    // PRODUCT SLIDESHOW - Corregido para View Transitions
    // =====================================================

    // Flag para rastrear sliders inicializados (evita duplicación)
    const slidersInitialized = new Set<string>();

    /**
     * Actualiza las imágenes de un slider dinámicamente
     */
    function updateSliderImages(sliderId: string, newImages: string[]): void {
        const slider = document.querySelector(`[data-slider-id="${sliderId}"]`);
        if (!slider) return;

        const wrapper = slider.querySelector('.slider-wrapper');
        const indicators = slider.querySelector('.indicators');
        const totalSpan = slider.querySelector('.counter .total');
        
        if (!wrapper || !indicators) return;

        // Limpiar contenido existente
        wrapper.innerHTML = '';
        indicators.innerHTML = '';

        // Crear nuevos slides
        newImages.forEach((image, index) => {
            // Crear slide
            const slide = document.createElement('div');
            slide.className = `slide ${index === 0 ? 'active' : ''}`;
            slide.dataset.index = index.toString();
            slide.innerHTML = `
                <img
                    src="${image}"
                    alt="Producto ${index + 1}"
                    loading="${index === 0 ? 'eager' : 'lazy'}"
                    class="slide-image"
                />
            `;
            wrapper.appendChild(slide);

            // Crear indicador
            const indicator = document.createElement('button');
            indicator.className = `indicator ${index === 0 ? 'active' : ''}`;
            indicator.dataset.index = index.toString();
            indicator.setAttribute('aria-label', `Ir a imagen ${index + 1}`);
            indicator.addEventListener('click', () => showSlide(sliderId, index));
            indicators.appendChild(indicator);
        });

        // Actualizar contador total
        if (totalSpan) {
            totalSpan.textContent = newImages.length.toString();
        }

        // Actualizar data attribute
        slider.setAttribute('data-images', JSON.stringify(newImages));
        
        // Mostrar primer slide
        showSlide(sliderId, 0);
    }

    /**
     * Muestra un slide específico
     */
    function showSlide(sliderId: string, index: number): void {
        const slider = document.querySelector(`[data-slider-id="${sliderId}"]`);
        if (!slider) return;

        const slides = slider.querySelectorAll('.slide');
        const indicators = slider.querySelectorAll('.indicator');
        const currentSpan = slider.querySelector('.counter .current');

        // Actualizar clases de slides
        slides.forEach((slide, i) => {
            slide.classList.remove('active', 'prev');
            if (i < index) {
                slide.classList.add('prev');
            }
        });

        // Actualizar indicadores
        indicators.forEach(ind => ind.classList.remove('active'));

        // Activar slide e indicador actual
        if (slides[index]) {
            slides[index].classList.add('active');
        }
        if (indicators[index]) {
            indicators[index].classList.add('active');
        }

        // Actualizar contador
        if (currentSpan) {
            currentSpan.textContent = (index + 1).toString();
        }
    }

    /**
     * Inicializa todos los sliders en la página
     */
    function initializeSliders(): void {
        const sliders = document.querySelectorAll('.product-slider');
        
        sliders.forEach(slider => {
            const sliderId = slider.getAttribute('data-slider-id') || 'main-slider';
            
            // Evitar reinicialización del mismo slider
            if (slidersInitialized.has(sliderId)) {
                return;
            }
            slidersInitialized.add(sliderId);
            
            const indicators = slider.querySelectorAll('.indicator');
            
            // Event listeners para indicadores
            indicators.forEach((indicator, index: number) => {
                indicator.addEventListener('click', () => showSlide(sliderId, index));
            });
            
            // Touch/Swipe support
            let touchStartX = 0;
            let touchEndX = 0;
            
            slider.addEventListener('touchstart', (e) => {
                const touchEvent = e as TouchEvent;
                touchStartX = touchEvent.changedTouches[0].screenX;
            }, { passive: true });
            
            slider.addEventListener('touchend', (e) => {
                const touchEvent = e as TouchEvent;
                touchEndX = touchEvent.changedTouches[0].screenX;
                
                const slides = slider.querySelectorAll('.slide');
                const currentIndex = Array.from(slides).findIndex(s => s.classList.contains('active'));
                
                // Swipe izquierda - siguiente
                if (touchEndX < touchStartX - 50) {
                    const nextIndex = (currentIndex + 1) % slides.length;
                    showSlide(sliderId, nextIndex);
                }
                // Swipe derecha - anterior
                if (touchEndX > touchStartX + 50) {
                    const prevIndex = (currentIndex - 1 + slides.length) % slides.length;
                    showSlide(sliderId, prevIndex);
                }
            }, { passive: true });
        });
    }

    /**
     * Limpia el estado de inicialización
     */
    function cleanupSliders(): void {
        slidersInitialized.clear();
    }

    // Exponer funciones globalmente para uso externo
    (window as any).updateSliderImages = updateSliderImages;
    (window as any).showSlide = showSlide;

    // =====================================================
    // INICIALIZACIÓN
    // =====================================================

    // Para View Transitions de Astro - limpiar y reinicializar
    document.addEventListener('astro:page-load', () => {
        cleanupSliders();
        initializeSliders();
    });

    // Para navegación antes de salir - limpiar estado
    document.addEventListener('astro:before-preparation', cleanupSliders);

    // Inicialización en primera carga (sin View Transitions)
    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initializeSliders, { once: true });
    } else {
        // DOM ya está listo
        initializeSliders();
    }
</script>