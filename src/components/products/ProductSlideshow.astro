---
// src/components/products/ProductSlideshow.astro
interface Props {
    images: string[];
    sliderId?: string;
}

const { images, sliderId = 'main-slider' } = Astro.props;

const fullImages = images.map(image => {
    return image.startsWith('http')
        ? image
        : `/images/products/${image}`;
});

const isSingle = fullImages.length <= 1;
---

<div class="product-slider" data-slider-id={sliderId} data-images={JSON.stringify(fullImages)} tabindex="0" aria-label="Galería del producto">
    <div class="slider-container">
        <div class="slider-wrapper">
            {fullImages.map((image, index) => (
                <div class={`slide ${index === 0 ? 'active' : ''}`} data-index={index}>
                    <img
                        src={image}
                        alt={`Producto ${index + 1}`}
                        loading={index === 0 ? "eager" : "lazy"}
                        class="slide-image"
                        draggable="false"
                    />
                </div>
            ))}
        </div>
        
        <!-- Flechas de navegación (siempre en el DOM; se ocultan con .single
             para que sigan existiendo si una variante cambia el nº de imágenes) -->
        <button class={`nav-arrow nav-prev ${isSingle ? 'single' : ''}`} data-nav="prev" aria-label="Anterior">
            <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
            </svg>
        </button>
        <button class={`nav-arrow nav-next ${isSingle ? 'single' : ''}`} data-nav="next" aria-label="Siguiente">
            <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
            </svg>
        </button>

        <!-- Indicadores -->
        <div class={`indicators ${isSingle ? 'single' : ''}`}>
            {fullImages.map((_, index) => (
                <button 
                    class={`indicator ${index === 0 ? 'active' : ''}`} 
                    data-index={index}
                    aria-label={`Ir a imagen ${index + 1}`}
                >
                    <span class="indicator-fill"></span>
                </button>
            ))}
        </div>
        
        <!-- Contador -->
        <div class={`counter ${isSingle ? 'single' : ''}`}>
            <span class="current">1</span> / <span class="total">{fullImages.length}</span>
        </div>
    </div>
</div>

<style>
    .product-slider {
        width: 100%;
        max-width: 100%;
        margin: 0 auto;
        outline: none;
    }

    .product-slider:focus-visible .slider-container {
        border-color: rgba(234, 179, 8, 0.5);
    }
    
    /* ========================================
       CONTENEDOR: altura adaptativa (cuadrado),
       la foto ocupa casi todo el espacio
       ======================================== */
    .slider-container {
        position: relative;
        width: 100%;
        aspect-ratio: 1 / 1;
        max-height: 600px;
        background:
            radial-gradient(circle at 30% 20%, rgba(234, 179, 8, 0.05), transparent 55%),
            #141416;
        border: 1px solid rgba(255, 255, 255, 0.06);
        border-radius: 20px;
        overflow: hidden;
    }
    
    .slider-wrapper {
        position: relative;
        width: 100%;
        height: 100%;
    }
    
    /* ========================================
       CROSSFADE + SUTIL KEN BURNS
       ======================================== */
    .slide {
        position: absolute;
        inset: 0;
        display: flex;
        justify-content: center;
        align-items: center;
        padding: 14px;
        opacity: 0;
        visibility: hidden;
        transition: opacity 0.6s cubic-bezier(0.4, 0, 0.2, 1), 
                    visibility 0.6s cubic-bezier(0.4, 0, 0.2, 1);
        z-index: 1;
    }
    
    .slide.active {
        opacity: 1;
        visibility: visible;
        z-index: 2;
    }
    
    .slide img {
        width: 100%;
        height: 100%;
        object-fit: contain;
        display: block;
        border-radius: 12px;
        user-select: none;
        transform: scale(1);
        transition: transform 8s cubic-bezier(0.25, 0.1, 0.25, 1);
    }

    /* Ken Burns sutil — zoom lento mientras el slide está activo */
    .slide.active img {
        transform: scale(1.03);
    }

    /* Zoom suave al pasar el mouse (desktop) */
    @media (hover: hover) {
        .slider-container:hover .slide.active img {
            transform: scale(1.07);
            transition: transform 0.6s cubic-bezier(0.25, 0.1, 0.25, 1);
        }
    }

    /* ========================================
       FLECHAS DE NAVEGACIÓN
       ======================================== */
    .nav-arrow {
        position: absolute;
        top: 50%;
        transform: translateY(-50%);
        z-index: 10;
        width: 42px;
        height: 42px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: rgba(0, 0, 0, 0.55);
        backdrop-filter: blur(8px);
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 50%;
        color: rgba(255, 255, 255, 0.75);
        cursor: pointer;
        opacity: 0;
        transition: opacity 0.3s ease, 
                    background 0.3s ease, 
                    color 0.3s ease,
                    transform 0.3s ease;
    }

    .nav-arrow.single { display: none; }

    .slider-container:hover .nav-arrow:not(.single) {
        opacity: 1;
    }

    .nav-arrow:hover {
        background: rgba(234, 179, 8, 0.2);
        border-color: rgba(234, 179, 8, 0.3);
        color: #eab308;
    }

    .nav-arrow:active {
        transform: translateY(-50%) scale(0.92);
    }

    .nav-prev { left: 14px; }
    .nav-next { right: 14px; }
    
    /* ========================================
       INDICADORES CON ANIMACIÓN DE PROGRESO
       ======================================== */
    .indicators {
        position: absolute;
        bottom: 18px;
        left: 50%;
        transform: translateX(-50%);
        z-index: 10;
        display: flex;
        gap: 6px;
        background: rgba(0, 0, 0, 0.6);
        backdrop-filter: blur(12px);
        padding: 8px 14px;
        border-radius: 20px;
        border: 1px solid rgba(255, 255, 255, 0.06);
    }

    .indicators.single { display: none; }
    
    .indicator {
        position: relative;
        width: 8px;
        height: 8px;
        background: rgba(255, 255, 255, 0.2);
        border: none;
        border-radius: 10px;
        cursor: pointer;
        transition: width 0.4s cubic-bezier(0.4, 0, 0.2, 1),
                    background 0.4s ease;
        overflow: hidden;
        padding: 0;
    }
    
    .indicator.active {
        width: 28px;
        background: rgba(234, 179, 8, 0.25);
    }

    .indicator-fill {
        position: absolute;
        top: 0;
        left: 0;
        height: 100%;
        width: 0%;
        background: #eab308;
        border-radius: 10px;
        transition: width 0.3s ease;
    }

    .indicator.active .indicator-fill {
        width: 100%;
        transition: width 0.5s cubic-bezier(0.4, 0, 0.2, 1);
    }
    
    .indicator:hover:not(.active) {
        background: rgba(255, 255, 255, 0.35);
        width: 12px;
    }
    
    /* Contador */
    .counter {
        position: absolute;
        top: 16px;
        right: 16px;
        z-index: 10;
        background: rgba(0, 0, 0, 0.5);
        backdrop-filter: blur(12px);
        color: rgba(255, 255, 255, 0.7);
        padding: 6px 14px;
        border-radius: 20px;
        font-size: 13px;
        font-weight: 500;
        border: 1px solid rgba(255, 255, 255, 0.06);
        letter-spacing: 0.5px;
        opacity: 0;
        transition: opacity 0.3s ease;
    }

    .counter.single { display: none; }

    .slider-container:hover .counter:not(.single) {
        opacity: 1;
    }
    
    .counter .current {
        color: #eab308;
        font-weight: 700;
    }

    @media (prefers-reduced-motion: reduce) {
        .slide img,
        .slide.active img,
        .slider-container:hover .slide.active img {
            transform: none;
            transition: none;
        }
    }
    
    /* ========================================
       RESPONSIVE
       ======================================== */
    @media (max-width: 768px) {
        .slider-container {
            max-height: 480px;
        }
        
        .nav-arrow:not(.single) {
            opacity: 1;
            width: 38px;
            height: 38px;
        }

        .nav-prev { left: 10px; }
        .nav-next { right: 10px; }
        
        .indicators {
            bottom: 14px;
            padding: 6px 12px;
        }
        
        .counter:not(.single) {
            opacity: 1;
            top: 12px;
            right: 12px;
            font-size: 12px;
            padding: 4px 10px;
        }
    }
    
    @media (max-width: 480px) {
        .slider-container {
            max-height: 400px;
            border-radius: 14px;
        }

        .slide { padding: 10px; }

        .nav-arrow:not(.single) {
            width: 34px;
            height: 34px;
        }

        .nav-arrow svg {
            width: 16px;
            height: 16px;
        }
    }
</style>

<script>
    const slidersInitialized = new Set<string>();

    // Muestra u oculta flechas / indicadores / contador según el nº de imágenes
    function toggleControls(slider: Element, count: number): void {
        const single = count <= 1;
        slider.querySelectorAll('.nav-arrow').forEach(el => el.classList.toggle('single', single));
        slider.querySelector('.indicators')?.classList.toggle('single', single);
        slider.querySelector('.counter')?.classList.toggle('single', single);
    }

    function buildSlides(slider: Element, newImages: string[], sliderId: string): void {
        const wrapper = slider.querySelector('.slider-wrapper');
        const indicators = slider.querySelector('.indicators');
        const totalSpan = slider.querySelector('.counter .total');
        const currentSpan = slider.querySelector('.counter .current');
        if (!wrapper || !indicators) return;

        wrapper.innerHTML = '';
        indicators.innerHTML = '';

        newImages.forEach((image, index) => {
            const slide = document.createElement('div');
            slide.className = `slide ${index === 0 ? 'active' : ''}`;
            slide.dataset.index = index.toString();
            slide.innerHTML = `<img src="${image}" alt="Producto ${index + 1}" loading="${index === 0 ? 'eager' : 'lazy'}" class="slide-image" draggable="false" />`;
            wrapper.appendChild(slide);

            const indicator = document.createElement('button');
            indicator.className = `indicator ${index === 0 ? 'active' : ''}`;
            indicator.dataset.index = index.toString();
            indicator.setAttribute('aria-label', `Ir a imagen ${index + 1}`);
            indicator.innerHTML = '<span class="indicator-fill"></span>';
            indicator.addEventListener('click', () => showSlide(sliderId, index));
            indicators.appendChild(indicator);
        });

        if (totalSpan) totalSpan.textContent = newImages.length.toString();
        if (currentSpan) currentSpan.textContent = '1';
        slider.setAttribute('data-images', JSON.stringify(newImages));
        toggleControls(slider, newImages.length);
    }

    function updateSliderImages(sliderId: string, newImages: string[]): void {
        const slider = document.querySelector(`[data-slider-id="${sliderId}"]`);
        if (!slider || !newImages?.length) return;

        const wrapper = slider.querySelector('.slider-wrapper');
        if (!wrapper) return;

        // Evitar trabajo si son exactamente las mismas imágenes
        const currentImages = slider.getAttribute('data-images');
        if (currentImages === JSON.stringify(newImages)) return;

        const currentActive = wrapper.querySelector('.slide.active') as HTMLElement;

        if (currentActive) {
            // Crossfade: nuevo slide encima con opacity 0 → 1
            const newSlide = document.createElement('div');
            newSlide.className = 'slide';
            newSlide.dataset.index = '0';
            newSlide.style.opacity = '0';
            newSlide.style.visibility = 'visible';
            newSlide.style.zIndex = '3';
            newSlide.innerHTML = `<img src="${newImages[0]}" alt="Producto 1" loading="eager" class="slide-image" draggable="false" />`;
            wrapper.appendChild(newSlide);

            // Forzar reflow para que la transición funcione
            newSlide.offsetHeight;

            currentActive.style.transition = 'opacity 0.5s cubic-bezier(0.4, 0, 0.2, 1)';
            currentActive.style.opacity = '0';
            newSlide.style.transition = 'opacity 0.5s cubic-bezier(0.4, 0, 0.2, 1)';
            newSlide.style.opacity = '1';

            setTimeout(() => buildSlides(slider, newImages, sliderId), 520);
        } else {
            buildSlides(slider, newImages, sliderId);
        }
    }

    function showSlide(sliderId: string, index: number): void {
        const slider = document.querySelector(`[data-slider-id="${sliderId}"]`);
        if (!slider) return;

        const slides = slider.querySelectorAll('.slide');
        const indicators = slider.querySelectorAll('.indicator');
        const currentSpan = slider.querySelector('.counter .current');

        slides.forEach((slide) => slide.classList.remove('active'));
        indicators.forEach(ind => ind.classList.remove('active'));

        if (slides[index]) slides[index].classList.add('active');
        if (indicators[index]) indicators[index].classList.add('active');
        if (currentSpan) currentSpan.textContent = (index + 1).toString();

        // Precargar la siguiente imagen para que el cambio sea instantáneo
        const nextImg = slides[(index + 1) % slides.length]?.querySelector('img') as HTMLImageElement;
        if (nextImg?.loading === 'lazy') nextImg.loading = 'eager';
    }

    function getActiveIndex(slider: Element): number {
        const slides = slider.querySelectorAll('.slide');
        return Array.from(slides).findIndex(s => s.classList.contains('active'));
    }

    function getTotalSlides(slider: Element): number {
        return slider.querySelectorAll('.slide').length;
    }

    function goNext(slider: Element, sliderId: string): void {
        const total = getTotalSlides(slider);
        if (total <= 1) return;
        showSlide(sliderId, (getActiveIndex(slider) + 1) % total);
    }

    function goPrev(slider: Element, sliderId: string): void {
        const total = getTotalSlides(slider);
        if (total <= 1) return;
        showSlide(sliderId, (getActiveIndex(slider) - 1 + total) % total);
    }

    function initializeSliders(): void {
        const sliders = document.querySelectorAll('.product-slider');
        
        sliders.forEach(slider => {
            const sliderId = slider.getAttribute('data-slider-id') || 'main-slider';
            
            if (slidersInitialized.has(sliderId)) return;
            slidersInitialized.add(sliderId);
            
            // Indicadores
            slider.querySelectorAll('.indicator').forEach((indicator, index: number) => {
                indicator.addEventListener('click', () => showSlide(sliderId, index));
            });

            // Flechas
            slider.querySelector('.nav-prev')?.addEventListener('click', () => goPrev(slider, sliderId));
            slider.querySelector('.nav-next')?.addEventListener('click', () => goNext(slider, sliderId));

            // Teclado (cuando el carrusel tiene foco)
            slider.addEventListener('keydown', (e) => {
                const key = (e as KeyboardEvent).key;
                if (key === 'ArrowRight') { e.preventDefault(); goNext(slider, sliderId); }
                if (key === 'ArrowLeft') { e.preventDefault(); goPrev(slider, sliderId); }
            });
            
            // Touch/Swipe
            let touchStartX = 0;
            let touchStartY = 0;
            let isSwiping = false;
            
            slider.addEventListener('touchstart', (e) => {
                const t = e as TouchEvent;
                touchStartX = t.changedTouches[0].screenX;
                touchStartY = t.changedTouches[0].screenY;
                isSwiping = true;
            }, { passive: true });
            
            slider.addEventListener('touchend', (e) => {
                if (!isSwiping) return;
                isSwiping = false;

                const t = e as TouchEvent;
                const deltaX = t.changedTouches[0].screenX - touchStartX;
                const deltaY = t.changedTouches[0].screenY - touchStartY;
                
                // Solo swipe horizontal (no vertical scroll)
                if (Math.abs(deltaX) < 50 || Math.abs(deltaY) > Math.abs(deltaX)) return;

                if (deltaX < 0) goNext(slider, sliderId);
                else goPrev(slider, sliderId);
            }, { passive: true });

            // Estado inicial de controles
            toggleControls(slider, getTotalSlides(slider));
        });
    }

    function cleanupSliders(): void {
        slidersInitialized.clear();
    }

    (window as any).updateSliderImages = updateSliderImages;
    (window as any).showSlide = showSlide;

    document.addEventListener('astro:page-load', () => {
        cleanupSliders();
        initializeSliders();
    });

    document.addEventListener('astro:before-preparation', cleanupSliders);

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initializeSliders, { once: true });
    } else {
        initializeSliders();
    }
</script>