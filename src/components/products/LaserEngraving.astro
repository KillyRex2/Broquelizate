---
// =====================================================
// src/components/products/LaserEngraving.astro
// =====================================================
// Componente de subida de imagen para grabado láser
// Integrar en la página de producto [...slug].astro

interface Props {
  productId: string;
  productName: string;
}

const { productId, productName } = Astro.props;
---

<div class="engraving-section" id="engraving-section" data-product-id={productId}>
  <!-- Header -->
  <div class="engr-header">
    <div class="engr-icon-wrap">
      <svg width="24" height="24" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"/>
      </svg>
    </div>
    <div class="engr-title-group">
      <h3 class="engr-title">Grabado Láser Personalizado</h3>
      <p class="engr-subtitle">Sube tu imagen y la grabaremos en tu pieza</p>
    </div>
    <label class="engr-toggle">
      <input type="checkbox" id="engr-toggle-check" />
      <span class="toggle-track">
        <span class="toggle-thumb"></span>
      </span>
      <span class="toggle-label">Agregar grabado</span>
    </label>
  </div>

  <!-- Contenido colapsable -->
  <div id="engr-content" class="engr-content collapsed">
    
    <!-- Info banner -->
    <div class="engr-info-banner">
      <svg width="18" height="18" fill="currentColor" viewBox="0 0 20 20">
        <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd"/>
      </svg>
      <div>
        <p class="info-main">La calidad del grabado depende de la calidad de tu imagen.</p>
        <p class="info-sub">Recomendamos imágenes nítidas, con buen contraste y resolución mínima de 500x500px.</p>
      </div>
    </div>

    <!-- Zona de subida -->
    <div id="engr-drop-zone" class="engr-drop-zone">
      <input type="file" id="engr-file-input" accept="image/jpeg,image/png,image/webp,image/gif" class="engr-file-hidden" />
      
      <!-- Estado: Vacío -->
      <div id="engr-empty-state" class="engr-empty-state">
        <div class="engr-upload-icon">
          <svg width="48" height="48" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
          </svg>
        </div>
        <div class="engr-upload-text">
          <p class="upload-main">Arrastra tu imagen aquí</p>
          <p class="upload-or">o</p>
          <button type="button" id="engr-browse-btn" class="upload-browse-btn">
            <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 16.5V9.75m0 0l3 3m-3-3l-3 3M6.75 19.5a4.5 4.5 0 01-1.41-8.775 5.25 5.25 0 0110.233-2.33 3 3 0 013.758 3.848A3.752 3.752 0 0118 19.5H6.75z"/>
            </svg>
            Seleccionar imagen
          </button>
        </div>
        <p class="upload-formats">JPG, PNG, WEBP o GIF · Máximo 10MB</p>
      </div>

      <!-- Estado: Cargando -->
      <div id="engr-loading-state" class="engr-loading-state hidden">
        <div class="engr-spinner">
          <svg class="spin-svg" width="48" height="48" fill="none" viewBox="0 0 24 24">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
          </svg>
        </div>
        <p class="loading-text">Subiendo imagen...</p>
        <div class="engr-progress-bar">
          <div id="engr-progress-fill" class="engr-progress-fill"></div>
        </div>
      </div>
    </div>

    <!-- Preview de imagen subida -->
    <div id="engr-preview" class="engr-preview hidden">
      <div class="preview-image-wrap">
        <img id="engr-preview-img" src="" alt="Vista previa del grabado" />
        <div class="preview-badge">
          <svg width="14" height="14" fill="currentColor" viewBox="0 0 20 20">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
          </svg>
          <span>Imagen lista</span>
        </div>
      </div>
      <div class="preview-info">
        <div class="preview-details">
          <span id="engr-file-name" class="file-name">imagen.jpg</span>
          <span id="engr-file-size" class="file-size">2.4 MB</span>
        </div>
        <div class="preview-actions">
          <button type="button" id="engr-change-btn" class="action-change">
            <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/>
            </svg>
            Cambiar
          </button>
          <button type="button" id="engr-remove-btn" class="action-remove">
            <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
            </svg>
            Eliminar
          </button>
        </div>
      </div>
    </div>

    <!-- Nota adicional del cliente -->
    <div id="engr-notes-section" class="engr-notes hidden">
      <label class="engr-notes-label">
        <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 8h10M7 12h4m1 8l-4-4H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-3l-4 4z"/>
        </svg>
        Instrucciones adicionales <span class="optional-tag">(opcional)</span>
      </label>
      <textarea 
        id="engr-notes-input" 
        placeholder="Ej: Grabar solo el contorno, invertir colores, agregar texto 'Te amo'..."
        maxlength="500"
        rows="3"
      ></textarea>
      <div class="notes-counter">
        <span id="engr-char-count">0</span>/500
      </div>
    </div>

    <!-- Tips de calidad -->
    <div class="engr-tips">
      <h4 class="tips-title">
        <svg width="16" height="16" fill="currentColor" viewBox="0 0 20 20">
          <path d="M11 3a1 1 0 10-2 0v1a1 1 0 102 0V3zM15.657 5.757a1 1 0 00-1.414-1.414l-.707.707a1 1 0 001.414 1.414l.707-.707zM18 10a1 1 0 01-1 1h-1a1 1 0 110-2h1a1 1 0 011 1zM5.05 6.464A1 1 0 106.464 5.05l-.707-.707a1 1 0 00-1.414 1.414l.707.707zM5 10a1 1 0 01-1 1H3a1 1 0 110-2h1a1 1 0 011 1zM8 16v-1h4v1a2 2 0 11-4 0zM12 14c.015-.34.208-.646.477-.859a4 4 0 10-4.954 0c.27.213.462.519.476.859h4.002z"/>
        </svg>
        Consejos para un mejor grabado
      </h4>
      <div class="tips-grid">
        <div class="tip-item">
          <div class="tip-icon good">
            <svg width="14" height="14" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
            </svg>
          </div>
          <span>Imágenes nítidas y bien iluminadas</span>
        </div>
        <div class="tip-item">
          <div class="tip-icon good">
            <svg width="14" height="14" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
            </svg>
          </div>
          <span>Alto contraste entre sujeto y fondo</span>
        </div>
        <div class="tip-item">
          <div class="tip-icon bad">
            <svg width="14" height="14" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd"/>
            </svg>
          </div>
          <span>Evita imágenes borrosas o pixeladas</span>
        </div>
        <div class="tip-item">
          <div class="tip-icon bad">
            <svg width="14" height="14" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M4.293 4.293a1 1 0 011.414 0L10 8.586l4.293-4.293a1 1 0 111.414 1.414L11.414 10l4.293 4.293a1 1 0 01-1.414 1.414L10 11.414l-4.293 4.293a1 1 0 01-1.414-1.414L8.586 10 4.293 5.707a1 1 0 010-1.414z" clip-rule="evenodd"/>
            </svg>
          </div>
          <span>Evita fondos complejos o saturados</span>
        </div>
      </div>
    </div>
  </div>

  <!-- Hidden inputs para el carrito -->
  <input type="hidden" id="engr-image-url" value="" />
  <input type="hidden" id="engr-image-id" value="" />
</div>

<style>
  /* =====================================================
     LASER ENGRAVING SECTION - Premium Dark Theme
     ===================================================== */
  
  .engraving-section {
    margin-bottom: 28px;
    border-radius: 20px;
    overflow: hidden;
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.06);
    transition: border-color 0.4s ease;
  }

  .engraving-section:has(#engr-toggle-check:checked) {
    border-color: rgba(234, 179, 8, 0.3);
    background: rgba(234, 179, 8, 0.02);
  }

  /* --- Header --- */
  .engr-header {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 20px 24px;
    cursor: default;
  }

  .engr-icon-wrap {
    width: 46px;
    height: 46px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, rgba(234, 179, 8, 0.15), rgba(245, 158, 11, 0.08));
    border: 1px solid rgba(234, 179, 8, 0.25);
    border-radius: 14px;
    color: #eab308;
    flex-shrink: 0;
  }

  .engr-title-group {
    flex: 1;
    min-width: 0;
  }

  .engr-title {
    font-size: 1.05rem;
    font-weight: 700;
    color: #fff;
    margin: 0;
  }

  .engr-subtitle {
    font-size: 0.8rem;
    color: rgba(255, 255, 255, 0.45);
    margin: 2px 0 0;
  }

  /* --- Toggle Switch --- */
  .engr-toggle {
    display: flex;
    align-items: center;
    gap: 10px;
    cursor: pointer;
    flex-shrink: 0;
  }

  .engr-toggle input {
    position: absolute;
    opacity: 0;
    width: 0;
    height: 0;
  }

  .toggle-track {
    position: relative;
    width: 48px;
    height: 26px;
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 13px;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .toggle-thumb {
    position: absolute;
    top: 2px;
    left: 2px;
    width: 20px;
    height: 20px;
    background: rgba(255, 255, 255, 0.6);
    border-radius: 50%;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .engr-toggle input:checked ~ .toggle-track {
    background: rgba(234, 179, 8, 0.3);
    border-color: rgba(234, 179, 8, 0.5);
  }

  .engr-toggle input:checked ~ .toggle-track .toggle-thumb {
    left: 24px;
    background: #eab308;
    box-shadow: 0 0 12px rgba(234, 179, 8, 0.5);
  }

  .toggle-label {
    font-size: 0.8rem;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.5);
    transition: color 0.3s ease;
    display: none;
  }

  .engr-toggle input:checked ~ .toggle-label {
    color: #eab308;
  }

  /* --- Collapsible Content --- */
  .engr-content {
    padding: 0 24px 24px;
    max-height: 1200px;
    opacity: 1;
    transition: all 0.5s cubic-bezier(0.4, 0, 0.2, 1);
    overflow: hidden;
  }

  .engr-content.collapsed {
    max-height: 0;
    padding-top: 0;
    padding-bottom: 0;
    opacity: 0;
    pointer-events: none;
  }

  /* --- Info Banner --- */
  .engr-info-banner {
    display: flex;
    gap: 12px;
    padding: 14px 18px;
    background: rgba(234, 179, 8, 0.06);
    border: 1px solid rgba(234, 179, 8, 0.15);
    border-radius: 14px;
    margin-bottom: 20px;
  }

  .engr-info-banner svg {
    color: #eab308;
    flex-shrink: 0;
    margin-top: 1px;
  }

  .info-main {
    font-size: 0.85rem;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.8);
    margin: 0;
  }

  .info-sub {
    font-size: 0.78rem;
    color: rgba(255, 255, 255, 0.45);
    margin: 4px 0 0;
  }

  /* --- Drop Zone --- */
  .engr-drop-zone {
    position: relative;
    border: 2px dashed rgba(255, 255, 255, 0.12);
    border-radius: 18px;
    background: rgba(255, 255, 255, 0.015);
    transition: all 0.3s ease;
    overflow: hidden;
    margin-bottom: 16px;
  }

  .engr-drop-zone.drag-over {
    border-color: #eab308;
    background: rgba(234, 179, 8, 0.05);
    transform: scale(1.01);
  }

  .engr-drop-zone.has-error {
    border-color: #ef4444;
    background: rgba(239, 68, 68, 0.05);
  }

  .engr-file-hidden {
    position: absolute;
    opacity: 0;
    width: 0;
    height: 0;
  }

  /* --- Empty State --- */
  .engr-empty-state {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 40px 24px;
    text-align: center;
  }

  .engr-upload-icon {
    width: 80px;
    height: 80px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, rgba(234, 179, 8, 0.08), rgba(234, 179, 8, 0.03));
    border: 1px solid rgba(234, 179, 8, 0.15);
    border-radius: 24px;
    color: #eab308;
    margin-bottom: 16px;
    transition: transform 0.3s ease;
  }

  .engr-drop-zone:hover .engr-upload-icon {
    transform: translateY(-4px);
  }

  .engr-upload-text {
    margin-bottom: 12px;
  }

  .upload-main {
    font-size: 1rem;
    font-weight: 700;
    color: rgba(255, 255, 255, 0.8);
    margin: 0;
  }

  .upload-or {
    font-size: 0.8rem;
    color: rgba(255, 255, 255, 0.3);
    margin: 8px 0;
  }

  .upload-browse-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 24px;
    background: linear-gradient(135deg, rgba(234, 179, 8, 0.15), rgba(234, 179, 8, 0.08));
    border: 1px solid rgba(234, 179, 8, 0.3);
    border-radius: 12px;
    color: #eab308;
    font-size: 0.9rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.25s ease;
  }

  .upload-browse-btn:hover {
    background: rgba(234, 179, 8, 0.2);
    border-color: rgba(234, 179, 8, 0.5);
    transform: translateY(-2px);
    box-shadow: 0 4px 16px rgba(234, 179, 8, 0.15);
  }

  .upload-formats {
    font-size: 0.75rem;
    color: rgba(255, 255, 255, 0.3);
    margin: 0;
  }

  /* --- Loading State --- */
  .engr-loading-state {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 48px 24px;
    text-align: center;
  }

  .engr-loading-state.hidden {
    display: none;
  }

  .engr-spinner {
    margin-bottom: 16px;
    color: #eab308;
  }

  .spin-svg {
    animation: engr-spin 1s linear infinite;
  }

  @keyframes engr-spin {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
  }

  .loading-text {
    font-size: 0.9rem;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.7);
    margin: 0 0 16px;
  }

  .engr-progress-bar {
    width: 200px;
    height: 4px;
    background: rgba(255, 255, 255, 0.1);
    border-radius: 2px;
    overflow: hidden;
  }

  .engr-progress-fill {
    width: 0%;
    height: 100%;
    background: linear-gradient(90deg, #eab308, #fbbf24);
    border-radius: 2px;
    transition: width 0.3s ease;
  }

  /* --- Preview --- */
  .engr-preview {
    display: flex;
    gap: 16px;
    padding: 16px;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(34, 197, 94, 0.2);
    border-radius: 16px;
    margin-bottom: 16px;
    animation: engr-fadeIn 0.4s ease-out;
  }

  .engr-preview.hidden {
    display: none;
  }

  @keyframes engr-fadeIn {
    from { opacity: 0; transform: translateY(8px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .preview-image-wrap {
    position: relative;
    width: 100px;
    height: 100px;
    flex-shrink: 0;
    border-radius: 12px;
    overflow: hidden;
    border: 2px solid rgba(34, 197, 94, 0.3);
  }

  .preview-image-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .preview-badge {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 4px;
    padding: 4px;
    background: rgba(34, 197, 94, 0.9);
    color: #fff;
    font-size: 0.65rem;
    font-weight: 700;
  }

  .preview-info {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-width: 0;
  }

  .preview-details {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .file-name {
    font-size: 0.85rem;
    font-weight: 600;
    color: #fff;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .file-size {
    font-size: 0.75rem;
    color: rgba(255, 255, 255, 0.4);
  }

  .preview-actions {
    display: flex;
    gap: 8px;
  }

  .action-change,
  .action-remove {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 14px;
    border-radius: 8px;
    font-size: 0.78rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s ease;
    border: 1px solid;
  }

  .action-change {
    background: rgba(59, 130, 246, 0.1);
    border-color: rgba(59, 130, 246, 0.2);
    color: #60a5fa;
  }

  .action-change:hover {
    background: rgba(59, 130, 246, 0.2);
    border-color: rgba(59, 130, 246, 0.4);
  }

  .action-remove {
    background: rgba(239, 68, 68, 0.1);
    border-color: rgba(239, 68, 68, 0.2);
    color: #f87171;
  }

  .action-remove:hover {
    background: rgba(239, 68, 68, 0.2);
    border-color: rgba(239, 68, 68, 0.4);
  }

  /* --- Notes --- */
  .engr-notes {
    margin-bottom: 16px;
    animation: engr-fadeIn 0.3s ease-out;
  }

  .engr-notes.hidden {
    display: none;
  }

  .engr-notes-label {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.85rem;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.6);
    margin-bottom: 10px;
  }

  .engr-notes-label svg {
    color: #eab308;
  }

  .optional-tag {
    font-size: 0.7rem;
    color: rgba(255, 255, 255, 0.3);
    font-weight: 400;
  }

  .engr-notes textarea {
    width: 100%;
    padding: 14px 16px;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 12px;
    color: #fff;
    font-size: 0.9rem;
    line-height: 1.6;
    resize: vertical;
    transition: border-color 0.3s ease;
    font-family: inherit;
  }

  .engr-notes textarea::placeholder {
    color: rgba(255, 255, 255, 0.25);
  }

  .engr-notes textarea:focus {
    outline: none;
    border-color: rgba(234, 179, 8, 0.4);
  }

  .notes-counter {
    text-align: right;
    font-size: 0.7rem;
    color: rgba(255, 255, 255, 0.25);
    margin-top: 6px;
  }

  /* --- Tips --- */
  .engr-tips {
    padding: 16px 18px;
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-radius: 14px;
  }

  .tips-title {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.85rem;
    font-weight: 700;
    color: rgba(255, 255, 255, 0.6);
    margin: 0 0 12px;
  }

  .tips-title svg {
    color: #eab308;
  }

  .tips-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
  }

  .tip-item {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .tip-icon {
    width: 22px;
    height: 22px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 6px;
    flex-shrink: 0;
  }

  .tip-icon.good {
    background: rgba(34, 197, 94, 0.15);
    color: #22c55e;
  }

  .tip-icon.bad {
    background: rgba(239, 68, 68, 0.15);
    color: #ef4444;
  }

  .tip-item span {
    font-size: 0.75rem;
    color: rgba(255, 255, 255, 0.5);
    line-height: 1.3;
  }

  /* --- Responsive --- */
  @media (max-width: 768px) {
    .engr-header {
      flex-wrap: wrap;
      padding: 16px 18px;
      gap: 12px;
    }

    .engr-toggle {
      width: 100%;
      justify-content: space-between;
      padding-top: 12px;
      border-top: 1px solid rgba(255, 255, 255, 0.06);
    }

    .toggle-label {
      display: block;
    }

    .engr-content {
      padding: 0 18px 18px;
    }

    .engr-empty-state {
      padding: 32px 16px;
    }

    .engr-upload-icon {
      width: 64px;
      height: 64px;
      border-radius: 18px;
    }

    .engr-upload-icon svg {
      width: 36px;
      height: 36px;
    }

    .engr-preview {
      flex-direction: column;
      align-items: center;
      text-align: center;
    }

    .preview-image-wrap {
      width: 120px;
      height: 120px;
    }

    .preview-actions {
      justify-content: center;
    }

    .tips-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 480px) {
    .engr-icon-wrap {
      width: 40px;
      height: 40px;
      border-radius: 12px;
    }

    .engr-icon-wrap svg {
      width: 20px;
      height: 20px;
    }

    .engr-title {
      font-size: 0.95rem;
    }

    .engr-subtitle {
      font-size: 0.75rem;
    }
  }
</style>

<script>
  // =====================================================
  // LASER ENGRAVING - Client-side Logic
  // =====================================================
  import { actions } from "astro:actions";

  function setupEngraving(): void {
    const section = document.getElementById('engraving-section');
    if (!section) return;

    // Evitar doble inicialización
    if (section.hasAttribute('data-engr-init')) return;
    section.setAttribute('data-engr-init', 'true');

    const productId = section.dataset.productId || '';
    const toggleCheck = document.getElementById('engr-toggle-check') as HTMLInputElement;
    const content = document.getElementById('engr-content');
    const dropZone = document.getElementById('engr-drop-zone');
    const fileInput = document.getElementById('engr-file-input') as HTMLInputElement;
    const browseBtn = document.getElementById('engr-browse-btn');
    const emptyState = document.getElementById('engr-empty-state');
    const loadingState = document.getElementById('engr-loading-state');
    const progressFill = document.getElementById('engr-progress-fill');
    const preview = document.getElementById('engr-preview');
    const previewImg = document.getElementById('engr-preview-img') as HTMLImageElement;
    const fileName = document.getElementById('engr-file-name');
    const fileSize = document.getElementById('engr-file-size');
    const changeBtn = document.getElementById('engr-change-btn');
    const removeBtn = document.getElementById('engr-remove-btn');
    const notesSection = document.getElementById('engr-notes-section');
    const notesInput = document.getElementById('engr-notes-input') as HTMLTextAreaElement;
    const charCount = document.getElementById('engr-char-count');
    const hiddenUrl = document.getElementById('engr-image-url') as HTMLInputElement;
    const hiddenId = document.getElementById('engr-image-id') as HTMLInputElement;

    if (!toggleCheck || !content || !dropZone || !fileInput) return;

    let currentImageUrl: string | null = null;
    let isUploading = false;

    // --- Toggle ---
    toggleCheck.addEventListener('change', () => {
      if (toggleCheck.checked) {
        content.classList.remove('collapsed');
      } else {
        content.classList.add('collapsed');
        // Si hay imagen, no la eliminamos automáticamente
      }
    });

    // --- Browse Button ---
    browseBtn?.addEventListener('click', (e) => {
      e.preventDefault();
      e.stopPropagation();
      fileInput.click();
    });

    // --- Drop Zone Click ---
    dropZone.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('button')) return;
      if (!loadingState?.classList.contains('hidden') === false) return;
      if (isUploading) return;
      fileInput.click();
    });

    // --- Drag & Drop ---
    const preventDefaults = (e: Event) => {
      e.preventDefault();
      e.stopPropagation();
    };

    ['dragenter', 'dragover', 'dragleave', 'drop'].forEach(ev =>
      dropZone.addEventListener(ev, preventDefaults)
    );

    ['dragenter', 'dragover'].forEach(ev =>
      dropZone.addEventListener(ev, () => dropZone.classList.add('drag-over'))
    );

    ['dragleave', 'drop'].forEach(ev =>
      dropZone.addEventListener(ev, () => dropZone.classList.remove('drag-over'))
    );

    dropZone.addEventListener('drop', (e: DragEvent) => {
      const files = e.dataTransfer?.files;
      if (files && files.length > 0) {
        handleFile(files[0]);
      }
    });

    // --- File Input Change ---
    fileInput.addEventListener('change', () => {
      if (fileInput.files && fileInput.files.length > 0) {
        handleFile(fileInput.files[0]);
      }
    });

    // --- Handle File ---
    async function handleFile(file: File): Promise<void> {
      if (isUploading) return;

      // Validaciones client-side
      const allowedTypes = ['image/jpeg', 'image/png', 'image/webp', 'image/gif'];
      if (!allowedTypes.includes(file.type)) {
        showDropError('Formato no soportado. Usa JPG, PNG, WEBP o GIF.');
        return;
      }

      const MAX_SIZE = 10 * 1024 * 1024;
      if (file.size > MAX_SIZE) {
        showDropError('La imagen no debe superar 10MB.');
        return;
      }

      // Si ya hay una imagen, eliminarla primero
      if (currentImageUrl) {
        try {
          await actions.deleteEngravingImage({ imageUrl: currentImageUrl });
        } catch (e) {
          console.warn('No se pudo eliminar imagen anterior:', e);
        }
      }

      isUploading = true;
      showLoading();

      try {
        // Simular progreso
        let progress = 0;
        const progressInterval = setInterval(() => {
          progress = Math.min(progress + Math.random() * 15, 90);
          if (progressFill) progressFill.style.width = `${progress}%`;
        }, 200);

        // Subir a Cloudinary
        const formData = new FormData();
        formData.append('productId', productId);
        formData.append('imageFile', file);

        const { data, error } = await actions.uploadEngravingImage(formData);

        clearInterval(progressInterval);

        if (error || !data) {
          throw new Error(error?.message || 'Error desconocido');
        }

        if (progressFill) progressFill.style.width = '100%';

        // Esperar un momento para que se vea el 100%
        await new Promise(r => setTimeout(r, 300));

        // Guardar datos
        currentImageUrl = data.imageUrl;
        if (hiddenUrl) hiddenUrl.value = data.imageUrl;
        if (hiddenId) hiddenId.value = data.engravingId;

        // Mostrar preview
        showPreview(file, data.imageUrl);

      } catch (err: any) {
        console.error('Error subiendo imagen de grabado:', err);
        showDropError(err.message || 'Error al subir la imagen');
        showEmpty();
      } finally {
        isUploading = false;
        fileInput.value = '';
      }
    }

    // --- UI States ---
    function showLoading(): void {
      emptyState?.classList.add('hidden');
      loadingState?.classList.remove('hidden');
      dropZone?.style.setProperty('cursor', 'default');
      if (progressFill) progressFill.style.width = '0%';
    }

    function showEmpty(): void {
      emptyState?.classList.remove('hidden');
      loadingState?.classList.add('hidden');
      preview?.classList.add('hidden');
      notesSection?.classList.add('hidden');
      dropZone?.style.removeProperty('cursor');
      dropZone?.classList.remove('has-error');
      if (dropZone) dropZone.style.display = '';
    }

    function showPreview(file: File, imageUrl: string): void {
      loadingState?.classList.add('hidden');
      
      // Ocultar drop zone y mostrar preview
      if (dropZone) dropZone.style.display = 'none';
      preview?.classList.remove('hidden');
      notesSection?.classList.remove('hidden');

      if (previewImg) previewImg.src = imageUrl;
      if (fileName) fileName.textContent = file.name;
      if (fileSize) {
        const sizeMB = (file.size / 1024 / 1024).toFixed(2);
        fileSize.textContent = `${sizeMB} MB`;
      }
    }

    function showDropError(message: string): void {
      dropZone?.classList.add('has-error');
      setTimeout(() => dropZone?.classList.remove('has-error'), 3000);
      
      // Mostrar mensaje usando el sistema existente
      const variantMessage = document.getElementById('variant-message');
      if (variantMessage) {
        variantMessage.textContent = message;
        variantMessage.className = 'msg error';
        setTimeout(() => variantMessage.classList.add('hidden'), 4000);
      }
    }

    // --- Change Image ---
    changeBtn?.addEventListener('click', () => {
      fileInput.click();
    });

    // --- Remove Image ---
    removeBtn?.addEventListener('click', async () => {
      if (currentImageUrl) {
        try {
          await actions.deleteEngravingImage({ imageUrl: currentImageUrl });
        } catch (e) {
          console.warn('No se pudo eliminar de Cloudinary:', e);
        }
      }

      currentImageUrl = null;
      if (hiddenUrl) hiddenUrl.value = '';
      if (hiddenId) hiddenId.value = '';
      if (dropZone) dropZone.style.display = '';
      
      showEmpty();
    });

    // --- Notes Character Counter ---
    notesInput?.addEventListener('input', () => {
      if (charCount) {
        charCount.textContent = notesInput.value.length.toString();
      }
    });
  }

  // Lifecycle
  document.addEventListener('astro:page-load', setupEngraving);

  document.addEventListener('astro:before-preparation', () => {
    const section = document.getElementById('engraving-section');
    section?.removeAttribute('data-engr-init');
  });
</script>