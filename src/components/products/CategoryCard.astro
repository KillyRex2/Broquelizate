---
// src/components/products/CategoryCard.astro

interface Props {
  title: string;
  description: string;
  image: string;
  link: string;
  icon?: string;
  count?: number;
  index?: number;
}

const { 
  title, 
  description, 
  image, 
  link, 
  icon = "✨", 
  count = 20,
  index = 0 
} = Astro.props;
---

<a 
  href={link} 
  class="category-card"
  style={`--delay: ${index * 0.1}s`}
>
  <!-- Imagen de fondo -->
  <div class="card-image">
    <img src={image} alt={title} loading="lazy" />
    <div class="card-overlay"></div>
  </div>
  
  <!-- Contenido -->
  <div class="card-content">
    <span class="card-icon">{icon}</span>
    
    <div class="card-info">
      <h3 class="card-title">{title}</h3>
      <p class="card-description">{description}</p>
    </div>
    
    <div class="card-footer">
      <span class="card-count">{count}+ productos</span>
      <span class="card-arrow">
        <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
        </svg>
      </span>
    </div>
  </div>

  <!-- Borde brillante en hover -->
  <div class="card-glow"></div>
</a>

<style>
  .category-card {
    position: relative;
    height: 380px;
    border-radius: 24px;
    overflow: hidden;
    text-decoration: none;
    display: block;
    animation: fadeInUp 0.6s ease-out var(--delay, 0s) both;
    transition: all 0.5s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .category-card:hover {
    transform: translateY(-12px) scale(1.02);
  }

  .card-image {
    position: absolute;
    inset: 0;
  }

  .card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.7s ease;
  }

  .category-card:hover .card-image img {
    transform: scale(1.15);
  }

  .card-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(0, 0, 0, 0.2) 0%,
      rgba(0, 0, 0, 0.4) 40%,
      rgba(0, 0, 0, 0.9) 100%
    );
    transition: background 0.5s ease;
  }

  .category-card:hover .card-overlay {
    background: linear-gradient(
      180deg,
      rgba(234, 179, 8, 0.1) 0%,
      rgba(0, 0, 0, 0.5) 40%,
      rgba(0, 0, 0, 0.95) 100%
    );
  }

  .card-content {
    position: relative;
    z-index: 10;
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 28px;
  }

  .card-icon {
    position: absolute;
    top: 20px;
    right: 20px;
    width: 50px;
    height: 50px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(255, 255, 255, 0.1);
    backdrop-filter: blur(10px);
    border-radius: 14px;
    font-size: 24px;
    transition: all 0.3s ease;
    border: 1px solid rgba(255, 255, 255, 0.1);
  }

  .category-card:hover .card-icon {
    background: rgba(234, 179, 8, 0.2);
    border-color: rgba(234, 179, 8, 0.3);
    transform: scale(1.1) rotate(5deg);
  }

  .card-info {
    margin-bottom: 16px;
  }

  .card-title {
    font-size: 1.5rem;
    font-weight: 700;
    color: #fff;
    margin-bottom: 8px;
    transition: color 0.3s ease;
  }

  .category-card:hover .card-title {
    color: #eab308;
  }

  .card-description {
    font-size: 0.9rem;
    color: rgba(255, 255, 255, 0.7);
    line-height: 1.5;
    margin: 0;
  }

  .card-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 16px;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
  }

  .card-count {
    font-size: 0.85rem;
    color: rgba(255, 255, 255, 0.5);
    font-weight: 500;
  }

  .card-arrow {
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(234, 179, 8, 0.1);
    border-radius: 50%;
    color: #eab308;
    transition: all 0.3s ease;
  }

  .category-card:hover .card-arrow {
    background: #eab308;
    color: #000;
    transform: translateX(5px);
  }

  .card-glow {
    position: absolute;
    inset: 0;
    border-radius: 24px;
    opacity: 0;
    transition: opacity 0.5s ease;
    pointer-events: none;
    box-shadow: 
      inset 0 0 0 1px rgba(234, 179, 8, 0.3),
      0 0 40px rgba(234, 179, 8, 0.2);
  }

  .category-card:hover .card-glow {
    opacity: 1;
  }

  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(30px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Responsive */
  @media (max-width: 768px) {
    .category-card {
      height: 300px;
    }

    .card-content {
      padding: 20px;
    }

    .card-title {
      font-size: 1.25rem;
    }

    .card-icon {
      width: 44px;
      height: 44px;
      font-size: 20px;
    }
  }
</style>
