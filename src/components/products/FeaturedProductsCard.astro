---
// src/components/products/FeaturedProductCard.astro
// Componente Astro con View Transitions para animaciones entre páginas

interface Product {
  id: string;
  image: string;
  title: string;
  description: string;
  price: number;
  salePrice?: number;
  slug: string;
}

interface Props {
  product: Product;
  index?: number;
}

const { product, index = 0 } = Astro.props;
const { id, image, title, description, price, salePrice, slug } = product;

const discount = salePrice ? Math.round(((price - salePrice) / price) * 100) : 0;
---

<article 
  class="product-card"
  style={`--delay: ${index * 0.1}s`}
  data-product-id={id}
>
  <!-- Imagen con View Transition -->
  <a href={`/products/${slug}`} class="card-image-link">
    <div class="card-image">
      <img 
        src={image} 
        alt={title}
        loading={index < 2 ? "eager" : "lazy"}
        transition:name={`product-image-${id}`}
      />
      <div class="image-overlay"></div>
      
      <!-- Quick Actions -->
      <div class="quick-actions">
        <button class="action-btn favorite-btn" data-id={id} aria-label="Agregar a favoritos">
          <svg class="heart-outline" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/>
          </svg>
          <svg class="heart-filled" width="22" height="22" viewBox="0 0 24 24" fill="currentColor">
            <path d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/>
          </svg>
        </button>
        
        <a href={`/products/${slug}`} class="action-btn view-btn" aria-label="Vista rápida">
          <svg width="22" height="22" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
          </svg>
        </a>
      </div>

      <!-- Badges -->
      <div class="badges">
        {salePrice && (
          <span class="badge badge-sale">
            <svg width="14" height="14" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
            -{discount}%
          </span>
        )}
      </div>
    </div>
  </a>

  <!-- Contenido -->
  <div class="card-content">
    <a href={`/products/${slug}`} class="card-title-link">
      <h3 class="card-title" transition:name={`product-title-${id}`}>
        {title}
      </h3>
    </a>
    
    <p class="card-description">{description}</p>
    
    <!-- Rating (estático por ahora) -->
    <div class="card-rating">
      <div class="stars">
        {[1, 2, 3, 4, 5].map((star) => (
          <svg width="14" height="14" viewBox="0 0 24 24" fill="#eab308">
            <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
          </svg>
        ))}
      </div>
      <span class="rating-count">(24)</span>
    </div>

    <!-- Precio y CTA -->
    <div class="card-footer">
      <div class="card-price" transition:name={`product-price-${id}`}>
        {salePrice ? (
          <>
            <span class="price-current">${salePrice.toLocaleString('es-MX')}</span>
            <span class="price-original">${price.toLocaleString('es-MX')}</span>
          </>
        ) : (
          <span class="price-current">${price.toLocaleString('es-MX')}</span>
        )}
      </div>
      
      <a href={`/products/${slug}`} class="btn-add">
        <span>Ver más</span>
        <svg width="18" height="18" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
        </svg>
      </a>
    </div>
  </div>

  <!-- Glow effect -->
  <div class="card-glow"></div>
</article>

<style>
  .product-card {
    position: relative;
    background: #fff;
    border-radius: 20px;
    overflow: hidden;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.06);
    border: 1px solid rgba(0, 0, 0, 0.05);
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    animation: fadeInUp 0.6s ease-out var(--delay, 0s) both;
  }

  .product-card:hover {
    transform: translateY(-10px);
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.12);
    border-color: rgba(234, 179, 8, 0.3);
  }

  /* Imagen */
  .card-image-link {
    display: block;
    text-decoration: none;
  }

  .card-image {
    position: relative;
    aspect-ratio: 1;
    overflow: hidden;
    background: #f5f5f5;
  }

  .card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s ease;
  }

  .product-card:hover .card-image img {
    transform: scale(1.1);
  }

  .image-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      transparent 0%,
      transparent 60%,
      rgba(0, 0, 0, 0.03) 100%
    );
    transition: background 0.3s ease;
  }

  .product-card:hover .image-overlay {
    background: linear-gradient(
      180deg,
      rgba(0, 0, 0, 0.1) 0%,
      transparent 40%,
      rgba(0, 0, 0, 0.05) 100%
    );
  }

  /* Quick Actions */
  .quick-actions {
    position: absolute;
    top: 16px;
    right: 16px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    opacity: 0;
    transform: translateX(10px);
    transition: all 0.3s ease;
  }

  .product-card:hover .quick-actions {
    opacity: 1;
    transform: translateX(0);
  }

  .action-btn {
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #fff;
    border: none;
    border-radius: 12px;
    color: #666;
    cursor: pointer;
    transition: all 0.3s ease;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
    text-decoration: none;
  }

  .action-btn:hover {
    background: #111;
    color: #fff;
    transform: scale(1.1);
  }

  /* Favorite button states */
  .favorite-btn .heart-filled {
    display: none;
    color: #ef4444;
  }

  .favorite-btn.active .heart-outline {
    display: none;
  }

  .favorite-btn.active .heart-filled {
    display: block;
  }

  .favorite-btn.active {
    background: #fef2f2;
    color: #ef4444;
  }

  .favorite-btn.active:hover {
    background: #ef4444;
  }

  .favorite-btn.active:hover .heart-filled {
    color: #fff;
  }

  /* Badges */
  .badges {
    position: absolute;
    top: 16px;
    left: 16px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .badge {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 6px 12px;
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    border-radius: 8px;
  }

  .badge-sale {
    background: linear-gradient(135deg, #ef4444, #dc2626);
    color: #fff;
  }

  /* Contenido */
  .card-content {
    padding: 20px;
  }

  .card-title-link {
    text-decoration: none;
  }

  .card-title {
    font-size: 1.1rem;
    font-weight: 700;
    color: #111;
    margin-bottom: 8px;
    line-height: 1.3;
    transition: color 0.3s ease;
    display: -webkit-box;
    -webkit-line-clamp: 1;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .card-title-link:hover .card-title {
    color: #b45309;
  }

  .card-description {
    font-size: 0.85rem;
    color: #888;
    line-height: 1.5;
    margin-bottom: 12px;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* Rating */
  .card-rating {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 16px;
  }

  .stars {
    display: flex;
    gap: 2px;
  }

  .rating-count {
    font-size: 0.8rem;
    color: #999;
  }

  /* Footer */
  .card-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 16px;
    border-top: 1px solid rgba(0, 0, 0, 0.06);
  }

  .card-price {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .price-current {
    font-size: 1.25rem;
    font-weight: 800;
    color: #111;
  }

  .price-original {
    font-size: 0.85rem;
    color: #999;
    text-decoration: line-through;
  }

  .btn-add {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 12px 20px;
    background: linear-gradient(135deg, #eab308, #f59e0b);
    color: #000;
    font-size: 0.9rem;
    font-weight: 700;
    border-radius: 12px;
    text-decoration: none;
    transition: all 0.3s ease;
    box-shadow: 0 4px 15px rgba(234, 179, 8, 0.3);
  }

  .btn-add:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 25px rgba(234, 179, 8, 0.4);
  }

  .btn-add svg {
    transition: transform 0.3s ease;
  }

  .btn-add:hover svg {
    transform: translateX(4px);
  }

  /* Glow Effect */
  .card-glow {
    position: absolute;
    inset: 0;
    border-radius: 20px;
    opacity: 0;
    transition: opacity 0.4s ease;
    pointer-events: none;
    box-shadow: inset 0 0 0 2px rgba(234, 179, 8, 0.3);
  }

  .product-card:hover .card-glow {
    opacity: 1;
  }

  /* Animaciones */
  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(30px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Responsive */
  @media (max-width: 768px) {
    .product-card {
      border-radius: 16px;
    }

    .card-content {
      padding: 16px;
    }

    .card-title {
      font-size: 1rem;
    }

    .quick-actions {
      opacity: 1;
      transform: translateX(0);
    }

    .action-btn {
      width: 40px;
      height: 40px;
    }

    .btn-add {
      padding: 10px 16px;
      font-size: 0.85rem;
    }

    .btn-add span {
      display: none;
    }
  }
</style>

<script>
  // Script para manejar favoritos - compatible con View Transitions
  document.addEventListener('astro:page-load', () => {
    initFavorites();
  });

  function initFavorites() {
    const favoriteButtons = document.querySelectorAll('.favorite-btn');
    
    // Cargar estado inicial de favoritos
    const favorites = JSON.parse(localStorage.getItem('favorites') || '[]');
    
    favoriteButtons.forEach((btn) => {
      const productId = btn.getAttribute('data-id');
      
      // Establecer estado inicial
      if (favorites.includes(productId)) {
        btn.classList.add('active');
      }
      
      // Click handler
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        
        const currentFavorites = JSON.parse(localStorage.getItem('favorites') || '[]');
        const isActive = btn.classList.contains('active');
        
        if (isActive) {
          // Remover de favoritos
          const updated = currentFavorites.filter((f: string) => f !== productId);
          localStorage.setItem('favorites', JSON.stringify(updated));
          btn.classList.remove('active');
          
          // Animación de feedback
          btn.animate([
            { transform: 'scale(1)' },
            { transform: 'scale(0.8)' },
            { transform: 'scale(1)' }
          ], { duration: 300 });
        } else {
          // Agregar a favoritos
          currentFavorites.push(productId);
          localStorage.setItem('favorites', JSON.stringify(currentFavorites));
          btn.classList.add('active');
          
          // Animación de feedback
          btn.animate([
            { transform: 'scale(1)' },
            { transform: 'scale(1.3)' },
            { transform: 'scale(1)' }
          ], { duration: 300 });
        }
      });
    });
  }
</script>