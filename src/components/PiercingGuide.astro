---
// src/components/PiercingGuide.astro
//
// Sustituye a la vieja sección de categorías (Aretes, Anillos, Collares,
// Pulseras), que ordenaba el catálogo por tipo de joya. Aquí se ordena por
// tipo de perforación, que es como pregunta quien ya trae el piercing
// puesto: no llega buscando "un arete", llega buscando algo que le quede
// al helix.
//
// Las fotos son de la tienda y traen una flecha dibujada encima señalando
// la perforación. Por eso las tarjetas no llevan la imagen de fondo con
// degradado oscuro que usaba la sección anterior: taparía justo la flecha.
// La foto va completa arriba y el texto debajo.

interface Piercing {
  name: string;
  /** Debe coincidir EXACTO con validPiercings de
      get-products-by-page.action.ts, acentos incluidos, o el filtro
      devuelve una página vacía. */
  value: string;
  description: string;
  image: string;
}

const piercings: Piercing[] = [
  {
    name: 'Lóbulo',
    value: 'Lóbulo',
    description: 'La parte blanda de la oreja. El más común y el más fácil de llevar.',
    image: '/assets/piercings/lobulo.webp',
  },
  {
    name: 'Hélix',
    value: 'Hélix',
    description: 'El borde exterior de la oreja, en la parte alta del cartílago.',
    image: '/assets/piercings/helix.webp',
  },
  {
    name: 'Nóstril',
    value: 'Nóstril',
    description: 'En el ala de la nariz. Discreto y combina con todo.',
    image: '/assets/piercings/nostril.webp',
  },
  {
    name: 'Daith',
    value: 'Daith',
    description: 'El pliegue de cartílago justo encima del canal auditivo.',
    image: '/assets/piercings/daith.webp',
  },
];
---

<section class="categories-section">
  <!-- Decoración de fondo -->
  <div class="bg-decoration">
    <div class="glow glow-1"></div>
    <div class="glow glow-2"></div>
  </div>

  <div class="categories-container">
    <!-- Header -->
    <div class="section-header">
      <span class="section-badge">
        <span class="badge-dot"></span>
        Guía de piercings
      </span>

      <h2 class="section-title">
        Encuentra la joya ideal para tu <span class="gradient-text">piercing</span>
      </h2>

      <p class="section-description">
        Descubre la joyería que tanto buscabas para que luzcas tus piercings
        de la mejor manera.
      </p>
    </div>

    <!-- Rejilla de piercings -->
    <div class="categories-grid">
      {piercings.map((p, index) => (
        <a
          href={`/products?piercing=${encodeURIComponent(p.value)}`}
          class="category-card"
          style={`--delay: ${index * 0.1}s`}
        >
          <div class="card-photo">
            <img
              src={p.image}
              alt={`Piercing ${p.name}: la flecha señala dónde va la perforación`}
              width="385"
              height="481"
              loading="lazy"
              decoding="async"
            />
          </div>

          <div class="card-content">
            <div class="card-info">
              <h3 class="card-title">{p.name}</h3>
              <p class="card-description">{p.description}</p>
            </div>

            <span class="card-footer">
              <span class="card-more">Ver más</span>
              <span class="card-arrow">
                <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
                </svg>
              </span>
            </span>
          </div>

          <div class="card-glow"></div>
        </a>
      ))}
    </div>

    <!-- Stats -->
    <div class="categories-stats">
      <div class="stat-item">
        <div class="stat-icon">
          <svg width="28" height="28" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z"/>
          </svg>
        </div>
        <div class="stat-content">
          <span class="stat-number">150+</span>
          <span class="stat-label">Productos únicos</span>
        </div>
      </div>
      
      <div class="stat-divider"></div>
      
      <div class="stat-item">
        <div class="stat-icon">
          <svg width="28" height="28" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
          </svg>
        </div>
        <div class="stat-content">
          <span class="stat-number">100%</span>
          <span class="stat-label">Hipoalergénico</span>
        </div>
      </div>
      
      <div class="stat-divider"></div>
      
      <div class="stat-item">
        <div class="stat-icon">
          <svg width="28" height="28" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
          </svg>
        </div>
        <div class="stat-content">
          <span class="stat-number">24h</span>
          <span class="stat-label">Envío express</span>
        </div>
      </div>
    </div>

    <!-- CTA Button -->
    <div class="section-cta">
      <a href="/products" class="btn-primary">
        <span>Ver Toda la Colección</span>
        <svg width="20" height="20" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
        </svg>
      </a>
    </div>
  </div>
</section>

<style>
  .categories-section {
    position: relative;
    padding: 100px 0;
    background: linear-gradient(180deg, #000 0%, #0a0a0a 50%, #000 100%);
    overflow: hidden;
  }

  /* Decoración de fondo */
  .bg-decoration {
    position: absolute;
    inset: 0;
    pointer-events: none;
    overflow: hidden;
  }

  .glow {
    position: absolute;
    border-radius: 50%;
    filter: blur(100px);
    opacity: 0.5;
  }

  .glow-1 {
    width: 500px;
    height: 500px;
    background: radial-gradient(circle, rgba(234, 179, 8, 0.15) 0%, transparent 70%);
    top: -100px;
    left: -100px;
  }

  .glow-2 {
    width: 400px;
    height: 400px;
    background: radial-gradient(circle, rgba(234, 179, 8, 0.1) 0%, transparent 70%);
    bottom: -50px;
    right: -50px;
  }

  /* Container */
  .categories-container {
    position: relative;
    z-index: 10;
    max-width: 1300px;
    margin: 0 auto;
    padding: 0 24px;
  }

  /* Header */
  .section-header {
    text-align: center;
    margin-bottom: 60px;
  }

  .section-badge {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 10px 20px;
    background: rgba(234, 179, 8, 0.1);
    border: 1px solid rgba(234, 179, 8, 0.2);
    border-radius: 50px;
    margin-bottom: 24px;
    animation: fadeInDown 0.6s ease-out;
  }

  .badge-dot {
    width: 8px;
    height: 8px;
    background: #22c55e;
    border-radius: 50%;
    animation: pulse 2s ease-in-out infinite;
  }

  .section-badge {
    color: #eab308;
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 1.5px;
  }

  .section-title {
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 800;
    color: #fff;
    margin-bottom: 20px;
    animation: fadeInUp 0.6s ease-out 0.1s both;
  }

  .gradient-text {
    background: linear-gradient(135deg, #eab308 0%, #fbbf24 50%, #f59e0b 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .section-description {
    font-size: 1.1rem;
    color: rgba(255, 255, 255, 0.6);
    max-width: 600px;
    margin: 0 auto;
    line-height: 1.8;
    animation: fadeInUp 0.6s ease-out 0.2s both;
  }

  /* Grid de categorías */
  .categories-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 24px;
    margin-bottom: 60px;
  }

  /* Category Card */
  .category-card {
    position: relative;
    display: flex;
    flex-direction: column;
    border-radius: 24px;
    overflow: hidden;
    text-decoration: none;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.07);
    animation: fadeInUp 0.6s ease-out var(--delay) both;
    transition: all 0.5s cubic-bezier(0.4, 0, 0.2, 1);
  }

  /* La foto completa y sin nada encima: la flecha dibujada que señala la
     perforación es el contenido, taparla con un degradado la anula. */
  .card-photo {
    position: relative;
    aspect-ratio: 385 / 481;
    overflow: hidden;
    background: #111;
  }

  .card-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.7s ease;
  }

  .category-card:hover .card-photo img {
    transform: scale(1.06);
  }

  .category-card:hover {
    transform: translateY(-12px) scale(1.02);
  }

  /* Card Content */
  .card-content {
    position: relative;
    z-index: 10;
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 16px;
    padding: 20px 22px 22px;
  }

  .card-info {
    margin-bottom: 16px;
  }

  .card-title {
    font-size: 1.3rem;
    font-weight: 700;
    color: #fff;
    margin-bottom: 8px;
    transition: color 0.3s ease;
  }

  .category-card:hover .card-title {
    color: #eab308;
  }

  .card-description {
    font-size: 0.9rem;
    color: rgba(255, 255, 255, 0.7);
    line-height: 1.5;
  }

  .card-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 16px;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
  }

  .card-more {
    font-size: 0.88rem;
    color: #eab308;
    font-weight: 600;
  }

  .card-arrow {
    width: 36px;
    height: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(234, 179, 8, 0.1);
    border-radius: 50%;
    color: #eab308;
    transition: all 0.3s ease;
  }

  .category-card:hover .card-arrow {
    background: #eab308;
    color: #000;
    transform: translateX(5px);
  }

  /* Card Glow Effect */
  .card-glow {
    position: absolute;
    inset: 0;
    border-radius: 24px;
    opacity: 0;
    transition: opacity 0.5s ease;
    pointer-events: none;
    box-shadow: 
      inset 0 0 0 1px rgba(234, 179, 8, 0.3),
      0 0 40px rgba(234, 179, 8, 0.2);
  }

  .category-card:hover .card-glow {
    opacity: 1;
  }

  /* Stats */
  .categories-stats {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 40px;
    padding: 40px;
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-radius: 20px;
    margin-bottom: 50px;
    animation: fadeInUp 0.6s ease-out 0.5s both;
  }

  .stat-item {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .stat-icon {
    width: 56px;
    height: 56px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(234, 179, 8, 0.1);
    border-radius: 16px;
    color: #eab308;
  }

  .stat-content {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .stat-number {
    font-size: 1.5rem;
    font-weight: 800;
    color: #fff;
  }

  .stat-label {
    font-size: 0.85rem;
    color: rgba(255, 255, 255, 0.5);
  }

  .stat-divider {
    width: 1px;
    height: 50px;
    background: rgba(255, 255, 255, 0.1);
  }

  /* CTA Buttons */
  .section-cta {
    display: flex;
    justify-content: center;
    gap: 16px;
    animation: fadeInUp 0.6s ease-out 0.6s both;
  }

  .btn-primary {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    padding: 18px 36px;
    background: linear-gradient(135deg, #eab308, #f59e0b);
    color: #000;
    font-size: 1rem;
    font-weight: 700;
    border-radius: 14px;
    text-decoration: none;
    transition: all 0.3s ease;
    box-shadow: 0 4px 20px rgba(234, 179, 8, 0.3);
  }

  .btn-primary:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 40px rgba(234, 179, 8, 0.5);
  }

  .btn-primary svg {
    transition: transform 0.3s ease;
  }

  .btn-primary:hover svg {
    transform: translateX(5px);
  }

  .btn-secondary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 18px 36px;
    background: transparent;
    border: 2px solid rgba(255, 255, 255, 0.15);
    color: #fff;
    font-size: 1rem;
    font-weight: 600;
    border-radius: 14px;
    text-decoration: none;
    transition: all 0.3s ease;
  }

  .btn-secondary:hover {
    background: rgba(255, 255, 255, 0.05);
    border-color: rgba(234, 179, 8, 0.5);
    color: #eab308;
  }

  /* Animaciones */
  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(30px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes fadeInDown {
    from {
      opacity: 0;
      transform: translateY(-20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes pulse {
    0%, 100% {
      opacity: 1;
      transform: scale(1);
    }
    50% {
      opacity: 0.5;
      transform: scale(1.3);
    }
  }

  /* Responsive */
  @media (max-width: 1200px) {
    .categories-grid {
      grid-template-columns: repeat(2, 1fr);
    }

  }

  @media (max-width: 768px) {
    .categories-section {
      padding: 70px 0;
    }

    .section-header {
      margin-bottom: 40px;
    }

    .section-title {
      font-size: 1.8rem;
    }

    .section-description {
      font-size: 1rem;
    }

    /* Dos columnas, no una. Con cuatro fotos verticales a ancho completo
       la sección medía 3534 px en un celular: puro scroll para ver algo
       que se entiende igual a la mitad de tamaño. */
    .categories-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 14px;
    }

    .card-content {
      padding: 14px 14px 16px;
      gap: 12px;
    }

    .card-description {
      font-size: 0.82rem;
    }

    .card-footer {
      padding-top: 12px;
    }

    .card-arrow {
      width: 30px;
      height: 30px;
    }

    .card-arrow svg {
      width: 16px;
      height: 16px;
    }


    .categories-stats {
      flex-direction: column;
      gap: 24px;
      padding: 30px;
    }

    .stat-divider {
      width: 100px;
      height: 1px;
    }

    .section-cta {
      flex-direction: column;
    }

    .btn-primary,
    .btn-secondary {
      width: 100%;
      justify-content: center;
    }
  }

  @media (max-width: 480px) {
    .categories-container {
      padding: 0 16px;
    }

    .section-badge {
      padding: 8px 16px;
      font-size: 11px;
    }

    .section-title {
      font-size: 1.5rem;
    }

    .card-content {
      padding: 20px;
    }

    .card-title {
      font-size: 1.25rem;
    }

    .stat-icon {
      width: 48px;
      height: 48px;
    }

    .stat-number {
      font-size: 1.25rem;
    }

    .btn-primary,
    .btn-secondary {
      padding: 16px 28px;
    }
  }
</style>

<script>
  // Intersection Observer para animaciones al hacer scroll
  document.addEventListener('astro:page-load', () => {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('animate-in');
          }
        });
      },
      {
        threshold: 0.1,
        rootMargin: '0px 0px -50px 0px'
      }
    );

    // Observar elementos
    document.querySelectorAll('.category-card, .stat-item').forEach((el) => {
      observer.observe(el);
    });
  });
</script>
